function summary(){
  var agg={};
  $$('.mc').forEach(function(c){calc(c).forEach(function(o){if(!o.cuts)return;var a=agg[o.inch]=agg[o.inch]||{cuts:0,m:0,y:0};a.cuts+=o.cuts;a.m+=o.meters;a.y+=o.yards})});
  var h='',C=0,M=0,Y=0;
  INCHES.forEach(function(i){var a=agg[i];if(!a)return;C+=a.cuts;M+=a.m;Y+=a.y;
    h+='<tr><td>'+qn(i)+'</td><td>'+a.cuts+'</td><td>'+(i===40?'-':f(a.m))+'</td><td>'+(i===40?f(a.y):'-')+'</td></tr>'});
  $('#sumB').innerHTML=h||'<tr><td colspan="4" class="empty">No readings entered yet.</td></tr>';
  $('#tC').textContent=C;$('#tM').textContent=f(M);$('#tY').textContent=f(Y);
}
$('#machines').addEventListener('input',function(e){
  var c=e.target.closest('.mc');if(!c)return;
  if(e.target.classList.contains('cell')){
    var rows=$$('tbody tr',c),last=rows[rows.length-1];
    if(last.contains(e.target)&&e.target.value)$('tbody',c).insertAdjacentHTML('beforeend',tr(nCols(c)));
  }
  summary();
});
$('#machines').addEventListener('change',summary);
$('#machines').addEventListener('click',function(e){
  var c=e.target.closest('.mc');if(!c)return;var t=e.target;
  if(t.classList.contains('addC')){addCol(c);summary()}
  else if(t.classList.contains('addR')){$('tbody',c).insertAdjacentHTML('beforeend',tr(nCols(c)));calc(c)}
  else if(t.classList.contains('rmM')){if($$('.mc').length>1){c.remove();summary()}}
  else if(t.classList.contains('x')){
    if(nCols(c)<2)return;var idx=t.parentElement.cellIndex;
    $$('tr',c).forEach(function(r){r.children[idx].remove()});summary();
  }
});
$('#addM').onclick=addMachine;

function collect(){
  var entries=[],bad=false;
  $$('.mc').forEach(function(c){
    var m=$('.mno',c).value.trim(),by={};
    calc(c).forEach(function(o){if(!o.cuts)return;var b=by[o.inch]=by[o.inch]||{inch:o.inch,cuts:0,meters:0,yards:0,readings:[]};
      b.cuts+=o.cuts;b.meters+=o.meters;b.yards+=o.yards;b.readings=b.readings.concat(o.vals)});
    var list=Object.keys(by).map(function(k){return by[k]});
    if(list.length&&!m)bad=true;
    list.forEach(function(b){b.machine=m;entries.push(b)});
  });
  return bad?null:entries;
}
function say(el,t,ok){el.textContent=t;el.style.color=ok?'var(--ok)':'var(--bad)'}
$('#save').onclick=function(){
  var m=$('#msg'),en=collect();
  if(!$('#date').value)return say(m,'Select the date.');
  if(en===null)return say(m,'Enter the Machine No for every machine that has readings.');
  if(!en.length)return say(m,'Enter at least one meter reading.');
  var b=this;b.disabled=true;say(m,'Saving...',true);
  google.script.run.withSuccessHandler(function(r){
    b.disabled=false;say(m,'Saved '+r.count+' record(s).',true);
    $('#machines').innerHTML='';addMachine();
  }).withFailureHandler(function(er){b.disabled=false;say(m,er.message||'Save failed.')})
  .saveProduction({date:$('#date').value,shift:$('#shift').value,entries:en});
};

/* ---------- daily report ---------- */
var rows=[],allRows=[];
function addDays(d,n){var x=new Date(d+'T00:00:00');x.setDate(x.getDate()+n);return new Date(x-x.getTimezoneOffset()*6e4).toISOString().slice(0,10)}
function dash(v,y){return v?f(v):'-'}
function render(){
  var d=$('#rd').value,sh=$('#rs').value;
  var title=new Date(d+'T00:00:00').toLocaleDateString('en-IN',{weekday:'long',day:'2-digit',month:'long',year:'numeric'})+(sh?' - Shift '+sh:'')+($('#rmach').value?' - Machine '+$('#rmach').value:'');
  var o=$('#out');
  if(!rows.length){o.innerHTML='<div class="card"><h2>'+title+'</h2><div class="empty">No production was recorded for this day.</div></div>';return}
  var C=0,M=0,Y=0,mc={},q={};
  rows.forEach(function(r){C+=r.cuts;M+=r.meters;Y+=r.yards;
    var m=mc[r.machine]=mc[r.machine]||{cuts:0,v:{}};m.cuts+=r.cuts;m.v[r.inch]=(m.v[r.inch]||0)+(r.inch===40?r.yards:r.meters);
    var a=q[r.inch]=q[r.inch]||{c:0,m:0,y:0};a.c+=r.cuts;a.m+=r.meters;a.y+=r.yards});
  var h='<div class="card"><h2>'+title+'</h2><p class="sub">Lapping department - Bally Jute Mill</p>'+
   '<div class="kpis"><div class="kpi"><b>'+f(M)+' m</b><span>Total meters (30, 34, 38)</span></div><div class="kpi"><b>'+f(Y)+' yds</b><span>Victor 40" yards</span></div><div class="kpi"><b>'+C+'</b><span>Total cuts</span></div><div class="kpi"><b>'+Object.keys(mc).length+'</b><span>Machines running</span></div></div>';
  h+='<h3>Quality-wise production</h3><div class="tw"><table class="sum"><thead><tr><th>Quality (inch)</th><th>Cuts</th><th>Meters</th><th>Yards</th></tr></thead><tbody>';
  INCHES.forEach(function(i){var a=q[i];if(a)h+='<tr><td>'+qn(i)+'</td><td>'+a.c+'</td><td>'+(i===40?'-':f(a.m))+'</td><td>'+(i===40?f(a.y):'-')+'</td></tr>'});
  h+='</tbody><tfoot><tr><td>Total</td><td>'+C+'</td><td>'+f(M)+'</td><td>'+f(Y)+'</td></tr></tfoot></table></div>';
  h+='<h3>Machine-wise production</h3><div class="tw"><table class="sum"><thead><tr><th>Machine</th>'+INCHES.map(function(i){return '<th>'+(i===40?'Victor 40" (yds)':i+'" (m)')+'</th>'}).join('')+'<th>Cuts</th></tr></thead><tbody>';
  var tot={};
  Object.keys(mc).sort(function(a,b){return a.localeCompare(b,undefined,{numeric:true})}).forEach(function(k){
    h+='<tr><td>Machine '+esc(k)+'</td>'+INCHES.map(function(i){var v=mc[k].v[i]||0;tot[i]=(tot[i]||0)+v;return '<td>'+dash(v)+'</td>'}).join('')+'<td>'+mc[k].cuts+'</td></tr>'});
  h+='</tbody><tfoot><tr><td>Total</td>'+INCHES.map(function(i){return '<td>'+dash(tot[i])+'</td>'}).join('')+'<td>'+C+'</td></tr></tfoot></table></div></div>';
  h+='<div class="card noprint"><details><summary style="cursor:pointer;font-weight:700">Entries of the day (to correct a mistake)</summary><div class="tw" style="margin-top:12px"><table class="sum"><thead><tr><th>Shift</th><th>Machine</th><th>Quality</th><th>Cuts</th><th>Total</th><th>Readings</th><th></th></tr></thead><tbody>';
  rows.forEach(function(r){h+='<tr><td>'+esc(r.shift)+'</td><td>'+esc(r.machine)+'</td><td>'+qn(r.inch)+'</td><td>'+r.cuts+'</td><td>'+(r.inch===40?f(r.yards)+' yds':f(r.meters)+' m')+'</td><td style="text-align:left;word-break:break-word">'+esc(r.readings)+'</td><td><button class="del" data-id="'+esc(r.id)+'">Delete</button></td></tr>'});
  o.innerHTML=h+'</tbody></table></div></details></div>';
}
function fillMach(){
  var sel=$('#rmach'),cur=sel.value,ms={};allRows.forEach(function(r){ms[r.machine]=1});
  var k=Object.keys(ms).sort(function(a,b){return a.localeCompare(b,undefined,{numeric:true})});
  sel.innerHTML='<option value="">All machines</option>'+k.map(function(x){return '<option value="'+esc(x)+'">Machine '+esc(x)+'</option>'}).join('');
  sel.value=ms[cur]?cur:'';
}
function applyM(){var m=$('#rmach').value;rows=m?allRows.filter(function(r){return r.machine===m}):allRows;render()}
$('#rmach').onchange=applyM;
$('#csv').onclick=function(){
  if(!rows.length)return say($('#rmsg'),'No data to download for this day.');
  var q=function(v){return '"'+String(v).replace(/"/g,'""')+'"'};
  var t='Date,Shift,Machine,Bale Inch,Cuts,Meters,Yards,Readings\n'+rows.map(function(r){return [r.date,r.shift,r.machine,r.inch,r.cuts,r.meters,r.yards,r.readings].map(q).join(',')}).join('\n');
  var a=document.createElement('a');a.href=URL.createObjectURL(new Blob([t],{type:'text/csv'}));a.download='lapping_report_'+$('#rd').value+'.csv';a.click();
};
function load(){
  var m=$('#rmsg'),d=$('#rd').value;if(!d)return;say(m,'Loading...',true);
  google.script.run.withSuccessHandler(function(r){allRows=r;fillMach();applyM();say(m,'',true)})
  .withFailureHandler(function(e){say(m,e.message||'Could not load report.')})
  .getReport({from:d,to:d,shift:$('#rs').value});
}
$('#rd').onchange=load;$('#rs').onchange=load;
$('#prev').onclick=function(){$('#rd').value=addDays($('#rd').value,-1);load()};
$('#next').onclick=function(){$('#rd').value=addDays($('#rd').value,1);load()};
$('#out').addEventListener('click',function(e){
  var id=e.target.dataset&&e.target.dataset.id;if(!id)return;
  if(!confirm('Delete this entry permanently?'))return;
  google.script.run.withSuccessHandler(load).deleteRecord(id);
});

/* ---------- init ---------- */
$('#date').value=today();
$('#rd').value=today();
addMachine();
</script>
</body>
</html>

