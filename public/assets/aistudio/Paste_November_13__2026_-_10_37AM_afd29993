</div>

<!-- ================= APP SHELL ================= -->
<div id="app">

<div class="header">
  <div>
    <h1>Carding Department</h1>
    <div class="sub-label">Shift Operations ERP</div>
  </div>
  <div class="actions no-print">
    <button class="btn-back" onclick="showMainTab('logbook')">&#8962; Home</button>
    <button class="btn-logout" onclick="doLogout()">Logout</button>
