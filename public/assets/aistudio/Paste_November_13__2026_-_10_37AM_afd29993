    fr[0].children[k+1].textContent=t?f(t)+(o.inch===40?' yds':' m'):'';fr[1].children[k+1].textContent=o.cuts||''});
  var q={};out.forEach(function(o){if(!o.cuts)return;var a=q[o.inch]=q[o.inch]||{c:0,m:0,y:0};a.c+=o.cuts;a.m+=o.meters;a.y+=o.yards});
  var qh='';INCHES.forEach(function(i){var a=q[i];if(a)qh+='<tr><td>'+qn(i)+'</td><td>'+a.c+'</td><td>'+(i===40?'-':f(a.m))+'</td><td>'+(i===40?f(a.y):'-')+'</td></tr>'});
  $('.qs',c).innerHTML=qh?'<h3>Quality-wise (inch) summary</h3><table class="sum"><thead><tr><th>Quality (inch)</th><th>Cuts</th><th>Meters</th><th>Yards</th></tr></thead><tbody>'+qh+'</tbody><tfoot><tr><td>Total</td><td>'+tc+'</td><td>'+f(tm)+'</td><td>'+f(ty)+'</td></tr></tfoot></table>':'';
  $('.mt',c).textContent=tc?f(tm)+' m  |  '+f(ty)+' yds  |  '+tc+' cuts':'';
