<!DOCTYPE html>
<html>
<head>
  <base target="_top">
  <meta charset="utf-8">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <style>
    :root{
      --navy:#16305e;
      --navy-dark:#0e2144;
      --blue:#2b63c9;
      --blue-light:#eaf0fb;
      --green:#1f9d67;
      --green-light:#e7f7f0;
      --amber:#c8790f;
      --amber-light:#fdf1e0;
      --purple:#7a4fd1;
      --purple-light:#f0ebfb;
      --red:#c8402c;
      --red-light:#fdeee9;
      --bg:#f3f4f7;
      --card:#ffffff;
      --border:#e1e4ea;
      --text:#1c2434;
      --text-dim:#6b7280;
      --radius:10px;
    }
    *{box-sizing:border-box;}
    body{
      margin:0;
      font-family:'Inter',system-ui,-apple-system,sans-serif;
      background:var(--bg);
      color:var(--text);
    }
    #status-banner{
      display:none;
      background:#fdeee9;
      color:#8a2a15;
      border-bottom:1px solid #f3c8b9;
      padding:10px 20px;
      font-size:13px;
      font-weight:600;
    }
    #status-banner.show{ display:block; }
    #status-banner.ok{ background:#e7f7f0; color:#145c3a; border-bottom-color:#bfe9d3; }
    header.topbar{
      background:linear-gradient(180deg,var(--navy) 0%,var(--navy-dark) 100%);
      color:#fff;
      display:flex;
      align-items:center;
      flex-wrap:wrap;
      padding:0 24px;
