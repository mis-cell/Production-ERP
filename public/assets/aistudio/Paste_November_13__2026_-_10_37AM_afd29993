    border-radius:8px; font-size:14px; outline:none;
  }
  .login-box input:focus{ border-color:var(--primary); box-shadow:0 0 0 3px rgba(22,87,179,0.15); }
  .login-box button{
    width:100%; padding:12px; border:none; border-radius:8px; background:var(--primary);
    color:#fff; font-weight:bold; font-size:15px; cursor:pointer; transition:background .15s;
  }
  .login-box button:hover{ background:var(--primary-dark); }
  .login-err{ color:var(--red); font-size:13px; margin-top:10px; min-height:18px; font-weight:bold; }
