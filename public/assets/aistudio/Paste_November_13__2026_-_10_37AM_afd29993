    border:none;
    border-radius:8px;
    font-size:15px;
    font-weight:600;
    cursor:pointer;
    transition:background .15s;
  }
  #loginBtn:hover{background:var(--accent-dark);}
  #loginError{
    color:var(--danger);
    font-size:13px;
    margin-top:12px;
    min-height:16px;
  }
