      padding:18px 20px;
      margin-bottom:24px;
    }
    .filter-bar .field{ min-width:150px; }
    .filter-bar .field label{ font-size:11px; text-transform:uppercase; letter-spacing:.03em; color:var(--text-dim); }
    .filter-bar .actions{ margin-top:0; }
    .filter-status{
      font-size:12.5px;
      color:var(--blue);
      font-weight:600;
      margin-left:auto;
      align-self:center;
      background:var(--blue-light);
      padding:6px 12px;
      border-radius:999px;
    }

    /* Beam meter block */
    .beam-block{
      margin-top:26px;
      padding-top:22px;
      border-top:1px dashed var(--border);
    }
    .beam-head{
      display:flex;
      justify-content:space-between;
      align-items:center;
      margin-bottom:12px;
      flex-wrap:wrap;
      gap:10px;
    }
    .beam-head h3{ margin:0; font-size:15.5px; font-weight:800; color:var(--navy); }
    .beam-toggle{
      display:flex;
      align-items:center;
      gap:7px;
      font-size:13.5px;
      font-weight:700;
      color:var(--navy);
      cursor:pointer;
      user-select:none;
    }
    .beam-toggle input{ width:16px; height:16px; cursor:pointer; }
    .beam-status{
      font-size:13.5px;
      font-weight:700;
      padding:10px 14px;
      border-radius:8px;
      margin-bottom:18px;
    }
    .beam-status.warn{ background:var(--amber-light); color:#8a5407; }
    .beam-status.ok{ background:var(--green-light); color:#145c3a; }
    .beam-status.done{ background:var(--red-light); color:#8a2a15; }
    #p-production-calc.positive{ color:var(--green); }

    @media print{
      header.topbar, .actions, .refresh-row button, .btn-clear, .btn-stop, .btn-save, #status-banner, .filter-bar{ display:none !important; }
      main{ margin:0; padding:0; max-width:100%; }
      .card{ box-shadow:none; border:none; }
    }
    @media (max-width:900px){
      .grid, .grid.cols-3, .grid.cols-4{ grid-template-columns:repeat(2,1fr); }
      .field.span-2, .field.span-4{ grid-column:span 2; }
      .stat-grid{ grid-template-columns:repeat(2,1fr); }
    }
    @media (max-width:560px){
      .grid, .grid.cols-3, .grid.cols-4{ grid-template-columns:1fr; }
      .field.span-2, .field.span-4{ grid-column:span 1; }
      .stat-grid{ grid-template-columns:1fr; }
      .filter-status{ margin-left:0; }
    }
  </style>
</head>
<body>

  <div id="status-banner"></div>

  <header class="topbar">
    <div class="brand">Pre Beaming - Bally Jute Mill</div>
    <nav class="tabs" id="tabs">
      <button data-tab="logbook" class="active">Log Book</button>
      <button data-tab="production">Production</button>
      <button data-tab="verification">Verification</button>
      <button data-tab="report">Report</button>
    </nav>
  </header>

  <main>

    <!-- LOG BOOK -->
    <section id="tab-logbook" class="tabpanel">
      <div class="card">
        <h2>Log Book Entry</h2>
        <p class="hint">Fill in Date, Shift and Rotation of Staff first - you'll be moved to the Production tab automatically so you can carry on there. Come back here any time to finish the rest and save.</p>
        <div class="grid">
          <div class="field"><label>Date</label><input type="date" id="lb-date"></div>
          <div class="field"><label>Shift</label>
            <select id="lb-shift"><option value="A">A</option><option value="B">B</option><option value="C">C</option></select>
          </div>
          <div class="field"><label>Rotation of Staff</label><input type="text" id="lb-staff" placeholder="Staff / worker name"></div>
          <div class="field"><label>Batch</label><input type="text" id="lb-batch" placeholder="Batch no."></div>

          <div class="field"><label>Start Time</label><select id="lb-start"></select></div>
          <div class="field"><label>End Time</label><select id="lb-end"></select></div>
          <div class="field"><label>Hours Worked (auto)</label><input type="text" id="lb-hours" readonly placeholder="Pick start & end time"></div>
          <div class="field"><label>Detention Hours (manual)</label><input type="number" id="lb-detention" placeholder="e.g. 0.5" step="any"></div>

          <div class="field span-2"><label>Idle Machine When Shift Will Be Changed</label><input type="text" id="lb-idle" placeholder="Machine no. / reason"></div>
          <div class="field span-2"><label>If Batch Change</label><input type="text" id="lb-batchchange" placeholder="New batch details"></div>

          <div class="field span-4"><label>Instruction Given by Senior</label><textarea id="lb-instruction" placeholder="Notes / instructions..."></textarea></div>
        </div>
        <div class="actions">
          <button class="btn btn-save" id="btn-lb-save">Save Entry</button>
          <button class="btn btn-clear" id="btn-lb-clear">Clear</button>
        </div>
      </div>

      <div class="card">
        <div class="refresh-row">
          <div class="section-title" style="margin:0;">Recent Log Book Entries</div>
          <button class="btn btn-ghost" id="btn-lb-refresh">Refresh</button>
        </div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Date</th><th>Shift</th><th>Staff</th><th>Start</th><th>End</th><th>Hours</th><th>Detention</th><th>Idle Machine Note</th><th>Batch</th><th>Instruction</th></tr></thead>
            <tbody id="lb-table-body"><tr><td class="empty" colspan="10">Loading...</td></tr></tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- PRODUCTION -->
    <section id="tab-production" class="tabpanel" style="display:none;">
      <div class="card">
        <h2>Production Entry</h2>
        <p class="hint">Enter each piece, then Save. Click Stop Round when the round finishes - a new round starts automatically. The beam meter carries forward on its own until the target length is reached.</p>
        <div class="badge-row">
          <span class="badge round">Round #<span id="prod-round">1</span></span>
        </div>
        <div class="grid cols-3">
          <div class="field"><label>Fent No</label><input type="text" id="p-fent" placeholder="Fent number"></div>
          <div class="field"><label>SR No</label><input type="text" id="p-sr" placeholder="e.g. SR-0001"></div>
          <div class="field"><label>Machine No</label>
            <select id="p-machine"><option value="1">1</option><option value="2">2</option></select>
          </div>
          <div class="field"><label>Ends</label><input type="number" id="p-ends" placeholder="e.g. 1200"></div>
          <div class="field"><label>Operator Name</label><input type="text" id="p-operator" placeholder="Worker on this entry"></div>
          <div class="field"><label>Date</label><input type="date" id="p-date"></div>
          <div class="field"><label>Shift</label>
            <select id="p-shift"><option value="A">A</option><option value="B">B</option><option value="C">C</option></select>
          </div>
        </div>

        <div class="beam-block">
          <div class="beam-head">
            <h3>Beam Meter Tracking</h3>
            <label class="beam-toggle"><input type="checkbox" id="p-newbeam"> Start New Beam</label>
          </div>
          <div class="beam-status warn" id="p-beam-status">Checking beam status...</div>
          <div class="grid cols-4">
            <div class="field"><label>Beam Number</label><input type="text" id="p-beamno" placeholder="e.g. B-014"></div>
            <div class="field"><label>Beam Meter Target (today's length limit)</label><input type="number" id="p-beamtarget" placeholder="e.g. 3300"></div>
            <div class="field"><label>Start Meter (auto - carried from last shift)</label><input type="text" id="p-startmeter" readonly></div>
            <div class="field"><label>End Meter (current reading now)</label><input type="number" id="p-endmeter" placeholder="Reading off the machine" step="any"></div>
          </div>
          <div class="grid" style="margin-top:16px;">
            <div class="field span-2"><label>Production This Entry</label><input type="text" id="p-production-calc" readonly placeholder="End Meter minus Start Meter"></div>
          </div>
        </div>

        <div class="actions">
          <button class="btn btn-save" id="btn-p-save">Save</button>
          <button class="btn btn-stop" id="btn-p-stop">Stop Round</button>
          <button class="btn btn-clear" id="btn-p-clear">Clear</button>
        </div>
      </div>

      <div class="card">
        <div class="refresh-row">
          <div class="section-title" style="margin:0;">Entries in Current Round <span class="tag" id="prod-round-tag">Round 1</span></div>
          <button class="btn btn-ghost" id="btn-p-refresh">Refresh</button>
        </div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>SR No</th><th>Fent No</th><th>Ends</th><th>Beam No</th><th>Start Meter</th><th>End Meter</th><th>Production</th><th>Machine</th><th>Operator</th><th>Date</th><th>Shift</th></tr></thead>
            <tbody id="prod-table-body"><tr><td class="empty" colspan="11">Loading...</td></tr></tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- VERIFICATION -->
    <section id="tab-verification" class="tabpanel" style="display:none;">
      <div class="card">
        <div class="refresh-row">
          <h2 style="margin:0;">Round Verification</h2>
          <button class="btn btn-ghost" id="btn-ver-refresh">Refresh</button>
        </div>
        <p class="hint">A new table starts automatically whenever a new round begins. Each table groups its round's entries by Fent No + Sl No, with production split across the A / B / C shift columns, matching the paper register.</p>
        <div id="ver-tables-container"></div>
      </div>
    </section>

    <!-- REPORT -->
    <section id="tab-report" class="tabpanel" style="display:none;">
      <div class="card">
        <div class="refresh-row">
          <h2 style="margin:0;">Pre-Beaming Summary Report</h2>
          <div style="display:flex; gap:10px;">
            <button class="btn btn-ghost" id="btn-rp-refresh">Refresh</button>
            <button class="btn btn-save" id="btn-rp-print">Print / Export PDF</button>
          </div>
        </div>

        <div class="filter-bar">
          <div class="field">
            <label>From Date</label>
            <input type="date" id="rp-filter-from">
          </div>
          <div class="field">
            <label>To Date</label>
            <input type="date" id="rp-filter-to">
          </div>
          <div class="field">
            <label>Shift</label>
            <select id="rp-filter-shift">
              <option value="">All Shifts</option>
              <option value="A">A</option>
              <option value="B">B</option>
              <option value="C">C</option>
            </select>
          </div>
          <div class="field">
            <label>Machine No</label>
            <select id="rp-filter-machine">
              <option value="">All Machines</option>
              <option value="1">1</option>
              <option value="2">2</option>
            </select>
          </div>
          <div class="actions">
            <button class="btn btn-save" id="btn-rp-apply-filter">Apply Filter</button>
            <button class="btn btn-clear" id="btn-rp-clear-filter">Clear</button>
          </div>
          <div class="filter-status" id="rp-filter-status">Showing all data</div>
        </div>

        <div class="stat-grid">
          <div class="stat c1"><div class="num" id="rp-rounds">0</div><div class="lbl">Fent / SR Items</div></div>
          <div class="stat c2"><div class="num" id="rp-entries">0</div><div class="lbl">Production Entries</div></div>
          <div class="stat c3"><div class="num" id="rp-ends">0</div><div class="lbl">Total Ends</div></div>
          <div class="stat c4"><div class="num" id="rp-production">0</div><div class="lbl">Total Production</div></div>
          <div class="stat c5"><div class="num" id="rp-log">0</div><div class="lbl">Log Book Entries</div></div>
        </div>
        <div class="section-title">Fent-wise Production Summary <span class="count-pill" id="rp-round-count">0 items</span></div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>F No</th><th>Sl No</th><th>Ends</th><th>Length</th><th>M/C</th><th>Date</th><th>A Shift</th><th>B Shift</th><th>C Shift</th><th>Operator Name</th></tr></thead>
            <tbody id="rp-round-body"><tr><td class="empty" colspan="10">Loading...</td></tr></tbody>
          </table>
        </div>
        <div class="section-title">Log Book History <span class="count-pill" id="rp-log-count">0 entries</span></div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Date</th><th>Shift</th><th>Staff</th><th>Hours</th><th>Detention</th><th>Batch</th><th>Instruction</th></tr></thead>
            <tbody id="rp-log-body"><tr><td class="empty" colspan="7">Loading...</td></tr></tbody>
          </table>
        </div>
        <p class="hint" id="rp-generated" style="margin-top:18px;"></p>
      </div>
    </section>

  </main>

  <div class="toast" id="toast"></div>

  <script>
    // ---------------------------------------------------------------
    // If you see NOTHING happen at all (tables stuck on "Loading..."
    // forever, no red banner, no toast) then this script block itself
    // is not executing in your browser. Open DevTools (F12) > Console
    // and look for a red error - that will point at the exact problem.
    // This line below proves whether the script is running at all:
    // ---------------------------------------------------------------
    console.log('Pre Beaming app script loaded.');

    function byId(id) { return document.getElementById(id); }

    function showBanner(msg, kind) {
      var b = byId('status-banner');
      b.textContent = msg;
      b.className = 'show' + (kind === 'ok' ? ' ok' : '');
    }
    function hideBanner() {
      var b = byId('status-banner');
      b.className = '';
    }

    function showToast(msg, type) {
      var t = byId('toast');
      t.textContent = msg;
      t.className = 'toast show' + (type ? ' ' + type : '');
      window.clearTimeout(showToast._timer);
      showToast._timer = window.setTimeout(function () { t.className = 'toast'; }, 3200);
    }

    function todayStr() {
      var d = new Date();
      var mm = String(d.getMonth() + 1);
      if (mm.length < 2) mm = '0' + mm;
      var dd = String(d.getDate());
      if (dd.length < 2) dd = '0' + dd;
      return d.getFullYear() + '-' + mm + '-' + dd;
    }

    function fmtDate(v) {
      if (!v) return '';
      if (typeof v === 'string') return v;
      try {
        var d = new Date(v);
        if (isNaN(d.getTime())) return String(v);
        return d.toISOString().slice(0, 10);
      } catch (e) { return String(v); }
    }

    // Calls a server function that is wrapped with safeRun_ on the backend,
    // so the response is always { ok: true/false, data / error }.
    // A local timeout also guarantees onDone always fires even if the
    // server call itself never comes back.
    function callServer(fnName, args, onDone) {
      var finished = false;
      var timer = window.setTimeout(function () {
        if (finished) return;
        finished = true;
        showBanner('No response from the server for "' + fnName + '" after 15 seconds. Check Extensions > Apps Script > Executions in your sheet for the error, and confirm you deployed a NEW VERSION after the last code change.', 'error');
        onDone({ ok: false, error: 'timeout' });
      }, 15000);

      try {
        var runner = google.script.run
          .withSuccessHandler(function (res) {
            if (finished) return;
            finished = true;
            window.clearTimeout(timer);
            if (res && res.ok === false) {
              showBanner('Server error in ' + fnName + ': ' + res.error, 'error');
            } else {
              hideBanner();
            }
            onDone(res);
          })
          .withFailureHandler(function (err) {
            if (finished) return;
            finished = true;
            window.clearTimeout(timer);
            var msg = err && err.message ? err.message : String(err);
            showBanner('Connection error calling ' + fnName + ': ' + msg, 'error');
            onDone({ ok: false, error: msg });
          });
        var callArgs = args || [];

switch (fnName) {
  case 'getCurrentRound':
    runner.getCurrentRound();
    break;

  case 'saveLogEntry':
    runner.saveLogEntry.apply(runner, callArgs);
    break;

  case 'getLogEntries':
    runner.getLogEntries();
    break;

  case 'saveProductionEntry':
    runner.saveProductionEntry.apply(runner, callArgs);
    break;

  case 'stopRound':
    runner.stopRound();
    break;

  case 'getCurrentRoundEntries':
    runner.getCurrentRoundEntries();
    break;

  case 'getVerificationData':
    runner.getVerificationData();
    break;

  case 'getReportData':
    runner.getReportData();
    break;

  case 'getBeamStatus':
    runner.getBeamStatus.apply(runner, callArgs);
    break;

  default:
    throw new Error('Unknown server function: ' + fnName);
}
      } catch (syncErr) {
        finished = true;
        window.clearTimeout(timer);
        showBanner('Could not call server function ' + fnName + ': ' + syncErr.message, 'error');
        onDone({ ok: false, error: syncErr.message });
      }
    }

    // ---------- TAB SWITCHING ----------
    function switchTab(tabName) {
      var all = document.querySelectorAll('nav.tabs button');
      for (var i = 0; i < all.length; i++) all[i].classList.toggle('active', all[i].dataset.tab === tabName);
      var panels = document.querySelectorAll('.tabpanel');
      for (var j = 0; j < panels.length; j++) panels[j].style.display = 'none';
      byId('tab-' + tabName).style.display = 'block';
      if (tabName === 'production') { loadProductionMeta(); loadCurrentRoundTable(); loadBeamStatus(); }
      if (tabName === 'verification') loadVerification();
      if (tabName === 'report') loadReport();
    }

    byId('tabs').addEventListener('click', function (e) {
      var btn = e.target.closest ? e.target.closest('button[data-tab]') : null;
      if (!btn) return;
      switchTab(btn.dataset.tab);
    });

    // ---------- LOG BOOK: TIME SELECTS ----------
    function buildTimeOptions(selectEl) {
      var html = '<option value="">--</option>';
      for (var h = 0; h < 24; h++) {
        for (var m = 0; m < 60; m += 1) {
          var hh = h < 10 ? '0' + h : String(h);
          var mm = m < 10 ? '0' + m : String(m);
          var val = hh + ':' + mm;
          html += '<option value="' + val + '">' + val + '</option>';
        }
      }
      selectEl.innerHTML = html;
    }
    buildTimeOptions(byId('lb-start'));
    buildTimeOptions(byId('lb-end'));

    function toMinutes_(t) {
      var p = t.split(':');
      return Number(p[0]) * 60 + Number(p[1]);
    }

    function recomputeHoursWorked() {
      var s = byId('lb-start').value;
      var e = byId('lb-end').value;
      if (!s || !e) { byId('lb-hours').value = ''; return; }
      var diff = toMinutes_(e) - toMinutes_(s);
      if (diff <= 0) diff += 24 * 60; // shift crosses midnight
      var hrs = diff / 60;
      byId('lb-hours').value = hrs.toFixed(2) + ' h';
    }
    byId('lb-start').addEventListener('change', recomputeHoursWorked);
    byId('lb-end').addEventListener('change', recomputeHoursWorked);

    // ---------- LOG BOOK: AUTO-JUMP TO PRODUCTION ----------
    function maybeAutoJumpToProduction() {
      var d = byId('lb-date').value;
      var s = byId('lb-shift').value;
      var staff = byId('lb-staff').value.trim();
      if (d && s && staff) {
        byId('p-date').value = d;
        byId('p-shift').value = s;
        switchTab('production');
      }
    }
    byId('lb-date').addEventListener('change', maybeAutoJumpToProduction);
    byId('lb-shift').addEventListener('change', maybeAutoJumpToProduction);
    byId('lb-staff').addEventListener('blur', maybeAutoJumpToProduction);

    // ---------- LOG BOOK ----------
    function saveLogBook() {
      var data = {
        date: byId('lb-date').value,
        shift: byId('lb-shift').value,
        rotationOfStaff: byId('lb-staff').value,
        startTime: byId('lb-start').value,
        endTime: byId('lb-end').value,
        hoursWorked: byId('lb-hours').value,
        detentionHours: byId('lb-detention').value,
        idleMachine: byId('lb-idle').value,
        batch: byId('lb-batch').value,
        ifBatchChange: byId('lb-batchchange').value,
        instruction: byId('lb-instruction').value
      };
      if (!data.date) { showToast('Please select a date.', 'error'); return; }
      callServer('saveLogEntry', [data], function (res) {
        if (res.ok) {
          showToast(res.data.message, 'success');
          clearLogBook();
          loadLogTable();
        } else {
          showToast('Save failed: ' + res.error, 'error');
        }
      });
    }

    function clearLogBook() {
      byId('lb-date').value = todayStr();
      byId('lb-shift').value = 'A';
      byId('lb-staff').value = '';
      byId('lb-start').value = '';
      byId('lb-end').value = '';
      byId('lb-hours').value = '';
      byId('lb-detention').value = '';
      byId('lb-idle').value = '';
      byId('lb-batch').value = '';
      byId('lb-batchchange').value = '';
      byId('lb-instruction').value = '';
    }

    function loadLogTable() {
      var body = byId('lb-table-body');
      body.innerHTML = '<tr><td class="empty" colspan="10">Loading...</td></tr>';
      callServer('getLogEntries', [], function (res) {
        if (!res.ok) { body.innerHTML = '<tr><td class="empty" colspan="10">Could not load data: ' + res.error + '</td></tr>'; return; }
        var rows = res.data;
        if (!rows || !rows.length) { body.innerHTML = '<tr><td class="empty" colspan="10">No entries yet.</td></tr>'; return; }
        var html = '';
        for (var i = 0; i < Math.min(rows.length, 25); i++) {
          var r = rows[i];
          html += '<tr>' +
            '<td>' + fmtDate(r['Date']) + '</td>' +
            '<td>' + (r['Shift'] || '') + '</td>' +
            '<td>' + (r['Rotation of Staff'] || '') + '</td>' +
            '<td>' + (r['Start Time'] || '') + '</td>' +
            '<td>' + (r['End Time'] || '') + '</td>' +
            '<td>' + (r['Hours Worked'] || '') + '</td>' +
            '<td>' + (r['Detention Hours'] || '') + '</td>' +
            '<td>' + (r['Idle Machine When Shift Will Be Changed'] || '') + '</td>' +
            '<td>' + (r['Batch'] || '') + '</td>' +
            '<td>' + (r['Instruction Given by Senior'] || '') + '</td>' +
            '</tr>';
        }
        body.innerHTML = html;
      });
    }

    // ---------- PRODUCTION ----------
    function loadProductionMeta() {
      callServer('getCurrentRound', [], function (res) {
        if (res.ok) {
          byId('prod-round').textContent = res.data;
          byId('prod-round-tag').textContent = 'Round ' + res.data;
        }
      });
    }

    // ---------- BEAM METER TRACKING ----------
    // Beam Number is always editable - it's not locked to whatever beam is
    // currently running, since the F/beam label can change entry to entry.
    // Only the Target (and the auto-carried Start Meter) are locked to the
    // machine's running beam state.
    function setBeamFieldsEditable(targetEditable) {
      byId('p-beamno').readOnly = false;
      byId('p-beamtarget').readOnly = !targetEditable;
    }

    function recomputeProductionCalc() {
      var start = parseFloat(byId('p-startmeter').value);
      var end = parseFloat(byId('p-endmeter').value);
      var el = byId('p-production-calc');
      if (isNaN(start) || isNaN(end)) { el.value = ''; el.classList.remove('positive'); return; }
      var prod = end - start;
      el.value = prod >= 0 ? prod : 'End Meter must be >= Start Meter';
      el.classList.toggle('positive', prod >= 0);
    }
    byId('p-endmeter').addEventListener('input', recomputeProductionCalc);

    byId('p-newbeam').addEventListener('change', function () {
      if (this.checked) {
        setBeamFieldsEditable(true);
        byId('p-beamno').value = '';
        byId('p-beamtarget').value = '';
        byId('p-startmeter').value = '0';
      } else {
        loadBeamStatus();
      }
      recomputeProductionCalc();
    });

    byId('p-machine').addEventListener('change', function () {
      byId('p-newbeam').checked = false;
      loadBeamStatus();
    });

    function loadBeamStatus() {
      var machineNo = byId('p-machine').value;
      var statusEl = byId('p-beam-status');
      statusEl.className = 'beam-status warn';
      statusEl.textContent = 'Checking beam status...';
      callServer('getBeamStatus', [machineNo], function (res) {
        if (!res.ok) {
          statusEl.className = 'beam-status done';
          statusEl.textContent = 'Could not load beam status: ' + res.error;
          return;
        }
        var d = res.data;
        if (!d.hasRunningBeam) {
          statusEl.className = 'beam-status warn';
          statusEl.textContent = 'Round ' + d.currentRound + ' - No running beam on Machine ' + machineNo + ' - enter a new Beam Number and Beam Meter Target to start.';
          setBeamFieldsEditable(true);
          byId('p-newbeam').checked = true;
          byId('p-beamno').value = '';
          byId('p-beamtarget').value = '';
          byId('p-startmeter').value = '0';
        } else if (d.completed) {
          statusEl.className = 'beam-status done';
          statusEl.textContent = 'Beam ' + d.beamNo + ' complete at ' + d.startMeter + ' / ' + d.target + ' on Machine ' + machineNo + '. Starting a new beam - Start Meter is reset to 0. Change the Target below if it is different this time.';
          setBeamFieldsEditable(true);
          byId('p-newbeam').checked = true;
          byId('p-beamno').value = d.beamNo;
          byId('p-beamtarget').value = d.target;
          byId('p-startmeter').value = '0';
        } else {
          statusEl.className = 'beam-status ok';
          statusEl.textContent = 'Beam ' + d.beamNo + ' running on Machine ' + machineNo + ' - at ' + d.startMeter + ' of ' + d.target + ' (' + d.remaining + ' remaining).';
          setBeamFieldsEditable(false);
          byId('p-newbeam').checked = false;
          byId('p-beamno').value = d.beamNo;
          byId('p-beamtarget').value = d.target;
          byId('p-startmeter').value = d.startMeter;
        }
        byId('p-endmeter').value = '';
        recomputeProductionCalc();
      });
    }

    function saveProduction() {
      var data = {
        fentNo: byId('p-fent').value,
        srNo: byId('p-sr').value,
        ends: byId('p-ends').value,
        machineNo: byId('p-machine').value,
        date: byId('p-date').value,
        shift: byId('p-shift').value,
        operator: byId('p-operator').value,
        startNewBeam: byId('p-newbeam').checked,
        beamNo: byId('p-beamno').value,
        beamTarget: byId('p-beamtarget').value,
        endMeter: byId('p-endmeter').value
      };
      if (!data.fentNo || !data.srNo || !data.date) {
        showToast('Please fill Fent No, SR No and Date.', 'error');
        return;
      }
      if (data.endMeter === '') {
        showToast('Please enter the End Meter reading.', 'error');
        return;
      }
      callServer('saveProductionEntry', [data], function (res) {
        if (res.ok) {
          var d = res.data;
          var msg = d.message + ' (' + d.srNo + ') - Production ' + d.production;
          if (d.completed) msg += ' - Beam target reached!';
          showToast(msg, 'success');
          byId('p-fent').value = '';
          byId('p-sr').value = '';
          byId('p-ends').value = '';
          byId('prod-round').textContent = d.round;
          loadCurrentRoundTable();
          loadBeamStatus();
        } else {
          showToast('Save failed: ' + res.error, 'error');
        }
      });
    }

    function stopRoundClick() {
      if (!window.confirm('Stop the current round? A new round will start for the next entries.')) return;
      callServer('stopRound', [], function (res) {
        if (res.ok) {
          showToast(res.data.message, 'success');
          loadProductionMeta();
          loadCurrentRoundTable();
        } else {
          showToast('Could not stop round: ' + res.error, 'error');
        }
      });
    }

    function clearProduction() {
      byId('p-fent').value = '';
      byId('p-sr').value = '';
      byId('p-ends').value = '';
      byId('p-operator').value = '';
      byId('p-machine').value = '1';
      byId('p-date').value = todayStr();
      byId('p-shift').value = 'A';
      byId('p-newbeam').checked = false;
      loadBeamStatus();
    }

    function loadCurrentRoundTable() {
      var body = byId('prod-table-body');
      body.innerHTML = '<tr><td class="empty" colspan="11">Loading...</td></tr>';
      callServer('getCurrentRoundEntries', [], function (res) {
        if (!res.ok) { body.innerHTML = '<tr><td class="empty" colspan="11">Could not load data: ' + res.error + '</td></tr>'; return; }
        var data = res.data;
        byId('prod-round-tag').textContent = 'Round ' + data.round;
        if (!data.rows || !data.rows.length) { body.innerHTML = '<tr><td class="empty" colspan="11">No entries in this round yet.</td></tr>'; return; }
        var html = '';
        for (var i = 0; i < data.rows.length; i++) {
          var r = data.rows[i];
          html += '<tr>' +
            '<td>' + (r['SR No'] || '') + '</td>' +
            '<td>' + (r['Fent No'] || '') + '</td>' +
            '<td>' + (r['Ends'] || '') + '</td>' +
            '<td>' + (r['Beam No'] || '') + '</td>' +
            '<td>' + (r['Start Meter'] || '') + '</td>' +
            '<td>' + (r['End Meter'] || '') + '</td>' +
            '<td>' + (r['Production'] || '') + '</td>' +
            '<td>' + (r['Machine No'] || '') + '</td>' +
            '<td>' + (r['Operator Name'] || '') + '</td>' +
            '<td>' + fmtDate(r['Date']) + '</td>' +
            '<td>' + (r['Shift'] || '') + '</td>' +
            '</tr>';
        }
        body.innerHTML = html;
      });
    }

    // ---------- VERIFICATION ----------
    // Verification uses the same Fent No + SR No grouping as the Report's
    // Fent-wise Production Summary: one row per Fent/SR, with production
    // split across the A / B / C shift columns, matching the paper
    // register layout (F No, Sl No, Ends, Length, M/C, Date, A/B/C Shift,
    // Operator Name). Totals per row are still the sum of every production
    // entry saved under that Fent No + SR No - the calculation itself is
    // unchanged from the Report tab, just shown here unfiltered.
    // Splits raw production entries into buckets by Round ID, preserving
    // round order (numeric ascending when the IDs are numbers).
    function groupEntriesByRound(entries) {
      var groups = {};
      var order = [];
      entries.forEach(function (r) {
        var rid = r['Round ID'];
        var key = (rid === undefined || rid === null || rid === '') ? 'Unspecified' : String(rid);
        if (!groups[key]) { groups[key] = []; order.push(key); }
        groups[key].push(r);
      });
      order.sort(function (a, b) {
        var na = Number(a), nb = Number(b);
        if (!isNaN(na) && !isNaN(nb)) return na - nb;
        return String(a).localeCompare(String(b));
      });
      return { order: order, groups: groups };
    }

    function loadVerification() {
      var container = byId('ver-tables-container');
      container.innerHTML = '<div class="empty">Loading...</div>';
      callServer('getReportData', [], function (res) {
        if (!res.ok) { container.innerHTML = '<div class="empty">Could not load data: ' + res.error + '</div>'; return; }
        var entries = res.data.productionEntries || [];
        if (!entries.length) { container.innerHTML = '<div class="empty">No entries yet.</div>'; return; }
        var grouped = groupEntriesByRound(entries);
        var html = '';
        for (var gi = 0; gi < grouped.order.length; gi++) {
          var roundKey = grouped.order[gi];
          var fentRows = buildFentReport(grouped.groups[roundKey]);
          var totalEnds = 0;
          var rowsHtml = '';
          for (var i = 0; i < fentRows.length; i++) {
            var r = fentRows[i];
            totalEnds += Number(r.ends) || 0;
            rowsHtml += '<tr>' +
              '<td>' + r.fentNo + '</td>' +
              '<td>' + r.srNo + '</td>' +
              '<td>' + r.ends + '</td>' +
              '<td>' + r.length + '</td>' +
              '<td>' + r.machineNo + '</td>' +
              '<td>' + r.dates.join(', ') + '</td>' +
              '<td>' + (r.hasA ? r.shiftA : '') + '</td>' +
              '<td>' + (r.hasB ? r.shiftB : '') + '</td>' +
              '<td>' + (r.hasC ? r.shiftC : '') + '</td>' +
              '<td>' + r.operators.join(', ') + '</td>' +
              '</tr>';
          }
          rowsHtml += '<tr class="total-row">' +
            '<td colspan="2">Total</td>' +
            '<td>' + totalEnds + '</td>' +
            '<td colspan="6"></td>' +
            '</tr>';
          html += '<div class="section-title">Round ' + roundKey +
            ' <span class="count-pill">' + fentRows.length + (fentRows.length === 1 ? ' item' : ' items') + '</span></div>' +
            '<div class="table-wrap" style="margin-bottom:24px;">' +
            '<table>' +
            '<thead><tr><th>F No</th><th>Sl No</th><th>Ends</th><th>Length</th><th>M/C</th><th>Date</th><th>A Shift</th><th>B Shift</th><th>C Shift</th><th>Operator Name</th></tr></thead>' +
            '<tbody>' + rowsHtml + '</tbody>' +
            '</table>' +
            '</div>';
        }
        container.innerHTML = html;
      });
    }

    // ---------- REPORT ----------
    // The full, unfiltered report payload from the server. Filters below
    // operate on this cached copy rather than re-querying the sheet each time.
    var reportDataFull = null;

    function loadReport() {
      byId('rp-round-body').innerHTML = '<tr><td class="empty" colspan="10">Loading...</td></tr>';
      byId('rp-log-body').innerHTML = '<tr><td class="empty" colspan="7">Loading...</td></tr>';
      callServer('getReportData', [], function (res) {
        if (!res.ok) {
          byId('rp-round-body').innerHTML = '<tr><td class="empty" colspan="10">Could not load data: ' + res.error + '</td></tr>';
          byId('rp-log-body').innerHTML = '<tr><td class="empty" colspan="7">Could not load data: ' + res.error + '</td></tr>';
          return;
        }
        reportDataFull = res.data;
        byId('rp-generated').textContent = 'Report generated: ' + res.data.generatedAt + ' - Current open round: #' + res.data.currentRound;
        refreshReportView();
      });
    }

    function currentReportFilters() {
      return {
        from: byId('rp-filter-from').value || null,
        to: byId('rp-filter-to').value || null,
        shift: byId('rp-filter-shift').value || null,
        machine: byId('rp-filter-machine').value || null
      };
    }

    function dateInRange_(dateStr, from, to) {
      if (!dateStr) return !from && !to;
      var d = fmtDate(dateStr);
      if (from && d < from) return false;
      if (to && d > to) return false;
      return true;
    }

    // Raw production entries (one row per shift entry saved), after the
    // report filters (date range / shift / machine) are applied.
    function getFilteredProductionEntries() {
      if (!reportDataFull || !reportDataFull.productionEntries) return [];
      var f = currentReportFilters();
      return reportDataFull.productionEntries.filter(function (r) {
        if (!dateInRange_(r['Date'], f.from, f.to)) return false;
        if (f.shift && String(r['Shift']) !== f.shift) return false;
        if (f.machine && String(r['Machine No']) !== f.machine) return false;
        return true;
      });
    }

    function getFilteredReportLogEntries() {
      if (!reportDataFull) return [];
      var f = currentReportFilters();
      return reportDataFull.logEntries.filter(function (r) {
        if (!dateInRange_(r['Date'], f.from, f.to)) return false;
        if (f.shift && String(r['Shift']) !== f.shift) return false;
        return true;
      });
    }

    // Groups raw production rows by Fent No + SR No, matching the paper
    // register: one line per Fent/SR, with production split across the
    // A / B / C shift columns instead of one line per shift entry.
    function buildFentReport(entries) {
      var groups = {};
      var order = [];
      entries.forEach(function (r) {
        var fent = r['Fent No'] || '';
        var sr = r['SR No'] || '';
        var key = fent + '|' + sr;
        if (!groups[key]) {
          groups[key] = {
            fentNo: fent,
            srNo: sr,
            ends: '',
            length: '',
            machineNo: r['Machine No'] || '',
            dates: [],
            rounds: [],
            shiftA: 0, shiftB: 0, shiftC: 0,
            hasA: false, hasB: false, hasC: false,
            operators: []
          };
          order.push(key);
        }
        var g = groups[key];
        if (!g.ends && r['Ends']) g.ends = r['Ends'];
        if (!g.length && r['Beam Target']) g.length = r['Beam Target'];
        if (!g.machineNo && r['Machine No']) g.machineNo = r['Machine No'];
        var d = fmtDate(r['Date']);
        if (d && g.dates.indexOf(d) === -1) g.dates.push(d);
        var rid = r['Round ID'];
        if ((rid || rid === 0) && rid !== '' && g.rounds.indexOf(rid) === -1) g.rounds.push(rid);
        var prod = Number(r['Production']) || 0;
        var shift = r['Shift'];
        if (shift === 'A') { g.shiftA += prod; g.hasA = true; }
        else if (shift === 'B') { g.shiftB += prod; g.hasB = true; }
        else if (shift === 'C') { g.shiftC += prod; g.hasC = true; }
        var op = r['Operator Name'];
        if (op && g.operators.indexOf(op) === -1) g.operators.push(op);
      });
      return order.map(function (key) { return groups[key]; });
    }

    function refreshReportView() {
      var rawEntries = getFilteredProductionEntries();
      var fentRows = buildFentReport(rawEntries);
      renderReport(fentRows, rawEntries, getFilteredReportLogEntries());
    }

    function applyReportFilter() {
      if (!reportDataFull) return;
      var f = currentReportFilters();
      var anyFilter = f.from || f.to || f.shift || f.machine;
      var statusEl = byId('rp-filter-status');
      if (anyFilter) {
        var parts = [];
        if (f.from) parts.push('from ' + f.from);
        if (f.to) parts.push('to ' + f.to);
        if (f.shift) parts.push('shift ' + f.shift);
        if (f.machine) parts.push('machine ' + f.machine);
        statusEl.textContent = 'Filtered: ' + parts.join(', ');
      } else {
        statusEl.textContent = 'Showing all data';
      }
      refreshReportView();
    }

    function clearReportFilter() {
      byId('rp-filter-from').value = '';
      byId('rp-filter-to').value = '';
      byId('rp-filter-shift').value = '';
      byId('rp-filter-machine').value = '';
      byId('rp-filter-status').textContent = 'Showing all data';
      refreshReportView();
    }

    function renderReport(fentRows, rawEntries, logEntries) {
      var totalEnds = 0, totalProduction = 0;
      fentRows.forEach(function (r) {
        totalEnds += Number(r.ends) || 0;
        totalProduction += (r.shiftA + r.shiftB + r.shiftC);
      });

      byId('rp-rounds').textContent = fentRows.length;
      byId('rp-entries').textContent = rawEntries.length;
      byId('rp-ends').textContent = totalEnds;
      byId('rp-production').textContent = totalProduction;
      byId('rp-log').textContent = logEntries.length;
      byId('rp-round-count').textContent = fentRows.length + (fentRows.length === 1 ? ' item' : ' items');
      byId('rp-log-count').textContent = logEntries.length + (logEntries.length === 1 ? ' entry' : ' entries');

      var roundBody = byId('rp-round-body');
      if (!fentRows.length) {
        roundBody.innerHTML = '<tr><td class="empty" colspan="10">No entries match this filter.</td></tr>';
      } else {
        var rHtml = '';
        for (var i = 0; i < fentRows.length; i++) {
          var r = fentRows[i];
          rHtml += '<tr>' +
            '<td>' + r.fentNo + '</td>' +
            '<td>' + r.srNo + '</td>' +
            '<td>' + r.ends + '</td>' +
            '<td>' + r.length + '</td>' +
            '<td>' + r.machineNo + '</td>' +
            '<td>' + r.dates.join(', ') + '</td>' +
            '<td>' + (r.hasA ? r.shiftA : '') + '</td>' +
            '<td>' + (r.hasB ? r.shiftB : '') + '</td>' +
            '<td>' + (r.hasC ? r.shiftC : '') + '</td>' +
            '<td>' + r.operators.join(', ') + '</td>' +
            '</tr>';
        }
        roundBody.innerHTML = rHtml;
      }

      var logBody = byId('rp-log-body');
      if (!logEntries.length) {
        logBody.innerHTML = '<tr><td class="empty" colspan="7">No log book entries match this filter.</td></tr>';
      } else {
        var lHtml = '';
        for (var k = 0; k < Math.min(logEntries.length, 50); k++) {
          var lr = logEntries[k];
          lHtml += '<tr>' +
            '<td>' + fmtDate(lr['Date']) + '</td>' +
            '<td>' + (lr['Shift'] || '') + '</td>' +
            '<td>' + (lr['Rotation of Staff'] || '') + '</td>' +
            '<td>' + (lr['Hours Worked'] || '') + '</td>' +
            '<td>' + (lr['Detention Hours'] || '') + '</td>' +
            '<td>' + (lr['Batch'] || '') + '</td>' +
            '<td>' + (lr['Instruction Given by Senior'] || '') + '</td>' +
            '</tr>';
        }
        logBody.innerHTML = lHtml;
      }
    }

    // ---------- WIRE UP BUTTONS ----------
    byId('btn-lb-save').addEventListener('click', saveLogBook);
    byId('btn-lb-clear').addEventListener('click', clearLogBook);
    byId('btn-lb-refresh').addEventListener('click', loadLogTable);
    byId('btn-p-save').addEventListener('click', saveProduction);
    byId('btn-p-stop').addEventListener('click', stopRoundClick);
    byId('btn-p-clear').addEventListener('click', clearProduction);
    byId('btn-p-refresh').addEventListener('click', loadCurrentRoundTable);
    byId('btn-ver-refresh').addEventListener('click', loadVerification);
    byId('btn-rp-refresh').addEventListener('click', loadReport);
    byId('btn-rp-print').addEventListener('click', function () { window.print(); });
    byId('btn-rp-apply-filter').addEventListener('click', applyReportFilter);
    byId('btn-rp-clear-filter').addEventListener('click', clearReportFilter);

    // ---------- INIT ----------
    byId('lb-date').value = todayStr();
    byId('p-date').value = todayStr();
    loadLogTable();
    loadProductionMeta();
  </script>
</body>
</html>
