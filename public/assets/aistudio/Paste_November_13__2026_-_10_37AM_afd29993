    }

    function loadCurrentRoundTable() {
      var body = byId('prod-table-body');
      body.innerHTML = '<tr><td class="empty" colspan="13">Loading...</td></tr>';
      callServer('getCurrentRoundEntries', [], function (res) {
        if (!res.ok) { body.innerHTML = '<tr><td class="empty" colspan="13">Could not load data: ' + res.error + '</td></tr>'; return; }
        var data = res.data;
        if (!data.rows || !data.rows.length) { body.innerHTML = '<tr><td class="empty" colspan="13">No entries in this round yet.</td></tr>'; return; }
        var html = '';
        for (var i = 0; i < data.rows.length; i++) {
          var r = data.rows[i];
          html += '<tr>' +
            '<td>' + (r['Machine No'] || '') + '</td>' +
            '<td>' + (r['Quality'] || '') + '</td>' +
            '<td>' + (r['Sl No'] || '') + '</td>' +
            '<td>' + (r['Forma No'] || '') + '</td>' +
            '<td>' + (r['Cuts Target'] || '') + '</td>' +
            '<td>' + (r['Start Cut'] || '') + '</td>' +
