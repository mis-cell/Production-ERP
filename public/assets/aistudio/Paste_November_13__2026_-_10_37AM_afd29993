<!DOCTYPE html>
<html lang="en">
<head>
<base target="_top">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Bally Jute Mill - Press ERP</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;600;700&display=swap" rel="stylesheet">
<style>
  /* Palette taken from the mill's own register: pale green ledger paper, blue ruling, red serials, blue-black ink */
  :root{
    --paper:#f5f7fa; --sheet:#ffffff; --rule:#8fa0d4; --ink:#1b2447; --serial:#b3261e;
    --muted:#5d6788; --accent:#243a8c; --ok:#2e7d4f; --warn:#c77a00; --bad:#b3261e;
    --line:#cdd8e8; --radius:6px;
  }
  *{box-sizing:border-box}
  html,body{margin:0}
  body{font-family:"Source Sans 3",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;background:var(--paper);color:var(--ink);font-size:16px;line-height:1.4;font-variant-numeric:tabular-nums}
  h1,h2,h3{margin:0;font-weight:700}
  button,input,select,textarea{font:inherit;color:inherit}
  input,select,textarea{border:1px solid var(--line);background:#fff;border-radius:var(--radius);padding:8px 10px;width:100%;min-height:40px}
  input:focus,select:focus,textarea:focus,button:focus-visible{outline:2px solid var(--accent);outline-offset:1px}
  label{display:block;font-size:.85rem;color:var(--muted);margin-bottom:4px}
  button{cursor:pointer;border:1px solid var(--accent);background:var(--accent);color:#fff;border-radius:var(--radius);padding:8px 16px;min-height:40px;font-weight:600}
  button.ghost{background:transparent;color:var(--accent)}
  button.danger{background:transparent;color:var(--bad);border-color:var(--bad)}
  button.small{min-height:30px;padding:3px 10px;font-size:.85rem}
  button:disabled{opacity:.5;cursor:default}
  .hidden{display:none!important}

  /* shell */
  header{background:#14213d;color:#fff;padding:10px 24px;display:flex;flex-wrap:wrap;gap:12px 28px;align-items:center}
  header .brand h1{font-size:1.35rem;letter-spacing:.04em;text-transform:uppercase}
  header .brand small{display:block;font-weight:400;opacity:.85}
  header nav{display:flex;gap:6px;flex:1;background:transparent;padding:0;border:0;overflow-x:auto}
  header nav button{background:transparent;color:#e6ebf5;border:0;border-radius:10px;padding:10px 18px;white-space:nowrap;font-weight:400;font-size:1rem;box-shadow:none}
  header nav button.on{background:#fff;color:#14213d;font-weight:700}
  header .who{display:flex;gap:8px;align-items:center;font-size:.9rem}
  header .who input{width:150px;min-height:32px;padding:4px 8px}
  .seg{display:inline-flex;border:1px solid var(--accent);border-radius:var(--radius);overflow:hidden;margin-bottom:12px}
  .seg button{border:0;border-radius:0;background:transparent;color:var(--accent);min-height:36px}
  .seg button.on{background:var(--accent);color:#fff}
  main{padding:16px;max-width:1100px;margin:0 auto}
  .panel{background:var(--sheet);border:1px solid var(--line);border-radius:var(--radius);padding:16px;margin-bottom:16px}
  .bar{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px;align-items:end;margin-bottom:12px}
  .bar.tight{grid-template-columns:repeat(auto-fit,minmax(120px,1fr))}
  .row-actions{display:flex;gap:8px;flex-wrap:wrap;align-items:center}

  /* register-style grid */
  .reg{width:100%;border-collapse:collapse;background:var(--sheet)}
  .reg th{font-size:.82rem;text-align:left;color:var(--muted);font-weight:600;padding:6px 8px;border-bottom:2px solid var(--rule)}
  .reg td{padding:0 8px;border-bottom:1px solid var(--rule);height:40px}
  .reg td.sl{color:var(--serial);font-weight:700;width:56px}
  .reg td.num,.reg th.num{text-align:right}
  .reg input{border:0;background:transparent;border-radius:0;min-height:38px;padding:4px 2px;font-size:1.05rem}
  .reg input:focus{background:#fff;outline:2px solid var(--accent);outline-offset:-2px}
  .reg input.wt{text-align:right}
  .reg tfoot td{font-weight:700;border-top:2px solid var(--rule);background:#eef2f9}
  .scroll{overflow-x:auto}

  .stats{display:flex;gap:24px;flex-wrap:wrap;margin:12px 0}
  .stat b{display:block;font-size:1.5rem}
  .stat span{color:var(--muted);font-size:.85rem}

  .msg{padding:10px 12px;border-radius:var(--radius);margin:10px 0;border:1px solid}
  .msg.ok{background:#e3f3e8;border-color:#9fd0b1;color:#1c5a37}
  .msg.err{background:#fbe6e4;border-color:#e7aaa5;color:#8a1b14}
  .muted{color:var(--muted)}
  .empty{padding:24px;text-align:center;color:var(--muted)}
  textarea{min-height:130px;resize:vertical}
  .cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px}
  .tag{display:inline-block;padding:1px 8px;border-radius:99px;background:#dfe6f6;font-size:.8rem}

  @media print{
    header,.noprint,.row-actions,.bar{display:none!important}
    body{background:#fff}
    .panel{border:0;padding:0}
    .printhead{display:block!important}
  }
  .printhead{display:none;margin-bottom:10px}
  @media (prefers-reduced-motion:no-preference){ .msg{transition:opacity .2s} }
</style>
</head>
<body>

<!-- APP -->
<section id="app">
  <header>
    <div class="brand"><h1>Press Department</h1><small>Bally Jute Mill</small></div>
    <nav id="nav">
      <button data-tab="entry" class="on">&#128221; Entry</button>
      <button data-tab="reports">&#128202; Reports</button>
    </nav>
  </header>

  <main>
    <div id="toast"></div>

    <!-- ENTRY -->
    <div id="tab-entry">
      <div class="panel">
        <div class="bar">
          <div><label for="eDate">Date</label><input type="date" id="eDate"></div>
          <div><label for="ePress">Press no.</label><input id="ePress" list="pressList" inputmode="numeric" autocomplete="off"></div>
          <div><label for="eType">State</label><input id="eType" list="typeList" autocomplete="off" placeholder="e.g.Punjab"></div>
        </div>
        <datalist id="pressList"></datalist><datalist id="typeList"></datalist>
        <div class="muted" id="eInfo"></div>
      </div>
      <div class="panel">
        <div class="scroll">
          <table class="reg" id="entryTable">
            <thead><tr><th>Sl. no.</th><th>Bale number</th><th class="num">Bale weight (kg)</th><th></th></tr></thead>
            <tbody id="entryBody"></tbody>
            <tfoot><tr><td></td><td id="tCount">0 bales</td><td class="num" id="tWt">0</td><td id="tAvg"></td></tr></tfoot>
          </table>
        </div>
        <div class="row-actions" style="margin-top:12px">
          <button onclick="addRows(5)" class="ghost">Add 5 rows</button>
          <button onclick="clearEntry()" class="ghost">Clear</button>
          <button id="saveBtn" onclick="saveEntry()">Save entries</button>
        </div>
        <p class="muted" style="margin-bottom:0">Type the bale number, press Enter, type the weight, press Enter to go to the next row. Sl. no. fills automatically and can be changed.</p>
      </div>
    </div>

    <!-- REPORTS -->
    <div id="tab-reports" class="hidden">
    <div class="seg noprint" role="tablist"><button id="segReg" class="on" onclick="showReport('register')">Bale register</button><button id="segSum" onclick="showReport('summary')">Production summary</button></div>
    <div id="tab-register">
      <div class="panel">
        <div class="bar tight">
          <div><label for="rFrom">From</label><input type="date" id="rFrom"></div>
          <div><label for="rTo">To</label><input type="date" id="rTo"></div>
          <div><label for="rPress">Press no.</label><select id="rPress"></select></div>
          <div><label for="rType">State</label><select id="rType"></select></div>
          <div><button onclick="loadRegister()" style="width:100%">Show</button></div>
        </div>
        <div class="row-actions noprint">
          <button class="ghost small" onclick="exportCsv('register')">Download CSV</button>
          <button class="ghost small" onclick="window.print()">Print</button>
        </div>
      </div>
      <div class="panel">
        <div class="printhead"><h2>Bally Jute Mill - Press Register</h2><div id="rPrintInfo"></div></div>
        <div class="stats" id="rStats"></div>
        <div class="scroll"><table class="reg" id="regTable"></table></div>
      </div>
    </div>

    <!-- SUMMARY -->
    <div id="tab-summary" class="hidden">
      <div class="panel">
        <div class="bar tight">
          <div><label for="sFrom">From</label><input type="date" id="sFrom"></div>
          <div><label for="sTo">To</label><input type="date" id="sTo"></div>
          <div><label for="sPress">Press no.</label><select id="sPress"></select></div>
          <div><label for="sType">State</label><select id="sType"></select></div>
          <div><button onclick="loadSummary()" style="width:100%">Show</button></div>
        </div>
        <div class="row-actions noprint">
          <button class="ghost small" onclick="exportCsv('summary')">Download CSV</button>
          <button class="ghost small" onclick="window.print()">Print</button>
        </div>
      </div>
      <div class="panel">
        <div class="printhead"><h2>Bally Jute Mill - Production Summary</h2></div>
        <div class="stats" id="sStats"></div>
        <div class="scroll"><table class="reg" id="sumTable"></table></div>
      </div>
    </div>

    </div>
  </main>
</section>

<script>
var S = { regRows:[], sumRows:[], startSl:1, report:'register' };

/* ---------- helpers ---------- */
function $(id){ return document.getElementById(id); }
function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];}); }
function today(){ var d=new Date(); var m=('0'+(d.getMonth()+1)).slice(-2), dd=('0'+d.getDate()).slice(-2); return d.getFullYear()+'-'+m+'-'+dd; }
function monthStart(){ return today().slice(0,8)+'01'; }
function dmy(s){ var p=String(s).split('-'); return p.length===3?p[2]+'/'+p[1]+'/'+p[0]:s; }
function fmt(n){ return Number(n).toLocaleString('en-IN',{maximumFractionDigits:1}); }
function call(fn,p){
  return new Promise(function(resolve,reject){
    google.script.run
      .withSuccessHandler(function(r){ r&&r.ok?resolve(r.data):reject(new Error(r?r.error:'No response')); })
      .withFailureHandler(function(e){ reject(new Error(e.message||'Server error')); })
      .api(fn,p||{});
  });
}
function toast(text,kind){
  var t=$('toast'); t.innerHTML='<div class="msg '+(kind||'ok')+'" role="status">'+esc(text)+'</div>';
  clearTimeout(toast._t); toast._t=setTimeout(function(){ t.innerHTML=''; }, kind==='err'?9000:3500);
  window.scrollTo({top:0,behavior:'smooth'});
}
function fail(e){ toast(e.message,'err'); }
function fillSelect(id,list,allLabel){
  var el=$(id), cur=el.value, h=allLabel!=null?'<option value="">'+esc(allLabel)+'</option>':'';
  list.forEach(function(v){ h+='<option>'+esc(v)+'</option>'; });
  el.innerHTML=h; if(cur && list.indexOf(cur)>=0) el.value=cur;
}

/* ---------- init ---------- */
function fillList(id,list){ $(id).innerHTML=list.map(function(v){ return '<option value="'+esc(v)+'">'; }).join(''); }
function initApp(){
  $('eDate').value=today();
  ['rFrom','sFrom'].forEach(function(i){ $(i).value=today(); });
  ['rTo','sTo'].forEach(function(i){ $(i).value=today(); });
  ['ePress','eType','eDate'].forEach(function(i){ $(i).addEventListener('change',refreshSerial); });
  if(!$('entryBody').children.length) addRows(10);
  return loadOptions().then(refreshSerial);
}
function loadOptions(){
  return call('getOptions').then(function(o){
    fillList('pressList',o.press); fillList('typeList',o.type);
    fillSelect('rPress',o.press,'All'); fillSelect('rType',o.type,'All');
    fillSelect('sPress',o.press,'All'); fillSelect('sType',o.type,'All');
  }).catch(fail);
}

document.addEventListener('click',function(ev){
  var b=ev.target.closest('#nav button'); if(!b) return;
  var tab=b.getAttribute('data-tab');
  document.querySelectorAll('#nav button').forEach(function(x){ x.classList.toggle('on',x===b); });
  ['entry','reports'].forEach(function(t){ $('tab-'+t).classList.toggle('hidden',t!==tab); });
  if(tab==='reports') showReport(S.report||'register');
});
function showReport(which){
  S.report=which;
  $('tab-register').classList.toggle('hidden',which!=='register');
  $('tab-summary').classList.toggle('hidden',which!=='summary');
  $('segReg').classList.toggle('on',which==='register');
  $('segSum').classList.toggle('on',which==='summary');
  if(which==='register') loadRegister(); else loadSummary();
}

/* ---------- bale entry ---------- */
function refreshSerial(){
  var p=$('ePress').value.trim(), t=$('eType').value.trim(), d=$('eDate').value;
  if(!p||!t||!d){ $('eInfo').textContent=''; return; }
  call('nextSerial',{date:d,press:p,type:t}).then(function(r){
    S.startSl=r.next;
    $('eInfo').textContent = r.next>1 ? 'Already entered up to Sl. '+(r.next-1)+(r.lastBale?' (last bale number '+r.lastBale+')':'')+'. New rows continue from '+r.next+'.' : 'No entries yet for this date, press and type. Starting at Sl. 1.';
    renumber();
  }).catch(fail);
}
function addRows(n){
  var tb=$('entryBody');
  for(var i=0;i<n;i++){
    var tr=document.createElement('tr');
    tr.innerHTML='<td class="sl"><input class="sln" inputmode="numeric" aria-label="Serial number"></td>'+
      '<td><input class="bale" inputmode="numeric" aria-label="Bale number"></td>'+
      '<td><input class="wt" inputmode="decimal" aria-label="Bale weight in kg"></td>'+
      '<td><button class="ghost small" tabindex="-1" aria-label="Remove row" onclick="removeRow(this)">x</button></td>';
    tb.appendChild(tr);
  }
  renumber();
}
function removeRow(btn){ btn.closest('tr').remove(); renumber(); totals(); }
function renumber(){
  var rows=$('entryBody').children;
  for(var i=0;i<rows.length;i++){
    var s=rows[i].querySelector('.sln');
    if(!s.dataset.manual) s.value=S.startSl+i;
  }
}
$('entryBody').addEventListener('keydown',function(ev){
  if(ev.key!=='Enter') return;
  ev.preventDefault();
  var el=ev.target, tr=el.closest('tr');
  if(el.classList.contains('sln')) tr.querySelector('.bale').focus();
  else if(el.classList.contains('bale')) tr.querySelector('.wt').focus();
  else {
    var nx=tr.nextElementSibling; if(!nx){ addRows(5); nx=tr.nextElementSibling; }
    nx.querySelector('.bale').focus();
  }
});
$('entryBody').addEventListener('input',function(ev){
  if(ev.target.classList.contains('sln')) ev.target.dataset.manual='1';
  totals();
});
function totals(){
  var c=0,w=0;
  Array.prototype.forEach.call($('entryBody').children,function(tr){
    var wt=parseFloat(tr.querySelector('.wt').value), b=tr.querySelector('.bale').value.trim();
    if(b&&wt>0){ c++; w+=wt; }
  });
  $('tCount').textContent=c+' bales'; $('tWt').textContent=fmt(w);
  $('tAvg').textContent=c?'Average '+fmt(w/c)+' kg':'';
}
function clearEntry(){ $('entryBody').innerHTML=''; addRows(10); totals(); }
function saveEntry(){
  var rows=[];
  Array.prototype.forEach.call($('entryBody').children,function(tr){
    rows.push({sl:tr.querySelector('.sln').value.trim(), bale:tr.querySelector('.bale').value.trim(), wt:tr.querySelector('.wt').value.trim()});
  });
  var bad=rows.filter(function(r){ return (r.bale&&!r.wt)||(!r.bale&&r.wt); });
  if(bad.length){ toast('Sl. '+bad[0].sl+' is incomplete. Enter both bale number and weight.','err'); return; }
  var out=rows.filter(function(r){ return r.bale&&r.wt; });
  if(!out.length){ toast('Enter at least one bale.','err'); return; }
  $('saveBtn').disabled=true;
  call('saveBales',{date:$('eDate').value,press:$('ePress').value.trim(),type:$('eType').value.trim(),rows:out})
    .then(function(r){ toast(r.saved+' bales saved.'); clearEntry(); return loadOptions(); })
    .then(refreshSerial)
    .catch(fail).then(function(){ $('saveBtn').disabled=false; });
}

/* ---------- register ---------- */
function loadRegister(){
  var f={from:$('rFrom').value,to:$('rTo').value,press:$('rPress').value,type:$('rType').value};
  call('getBales',f).then(function(rows){
    S.regRows=rows;
    var w=0; rows.forEach(function(r){ w+=r.wt; });
    $('rStats').innerHTML=stat(rows.length,'bales')+stat(fmt(w),'total kg')+stat(rows.length?fmt(w/rows.length):'0','average kg');
    $('rPrintInfo').textContent=dmy(f.from)+' to '+dmy(f.to)+(f.press?'  Press '+f.press:'');
    var h='<thead><tr><th>Date</th><th>Press</th><th>Type</th><th>Sl. no.</th><th>Bale number</th><th class="num">Bale weight</th><th class="noprint"></th></tr></thead><tbody>';
    if(!rows.length) h+='<tr><td colspan="7" class="empty">No bales found for these filters.</td></tr>';
    rows.forEach(function(r){
      h+='<tr><td>'+dmy(r.date)+'</td><td>'+esc(r.press)+'</td><td>'+esc(r.type)+'</td><td class="sl">'+r.sl+'</td><td>'+esc(r.bale)+'</td><td class="num">'+r.wt+'</td><td class="noprint">'+
        '<button class="ghost small" onclick="editBale(\''+r.id+'\')">Edit</button> <button class="danger small" onclick="delBale(\''+r.id+'\')">Delete</button>'+'</td></tr>';
    });
    $('regTable').innerHTML=h+'</tbody>';
  }).catch(fail);
}
function stat(v,l){ return '<div class="stat"><b>'+esc(v)+'</b><span>'+esc(l)+'</span></div>'; }
function editBale(id){
  var r=S.regRows.filter(function(x){ return x.id===id; })[0]; if(!r) return;
  var s=prompt('Sl. no.',r.sl); if(s===null) return;
  var b=prompt('Bale number',r.bale); if(b===null) return;
  var w=prompt('Bale weight (kg)',r.wt); if(w===null) return;
  call('updateBale',{id:id,sl:s,bale:b,wt:w}).then(function(){ toast('Bale updated.'); loadRegister(); }).catch(fail);
}
function delBale(id){
  if(!confirm('Delete this bale entry? This cannot be undone.')) return;
  call('deleteBale',{id:id}).then(function(){ toast('Bale deleted.'); loadRegister(); }).catch(fail);
}

/* ---------- summary ---------- */
function loadSummary(){
  var f={from:$('sFrom').value,to:$('sTo').value,press:$('sPress').value,type:$('sType').value};
  call('getSummary',f).then(function(rows){
    S.sumRows=rows;
    var tb=0,tw=0; rows.forEach(function(r){ tb+=r.bales; tw+=r.wt; });
    $('sStats').innerHTML=stat(fmt(tb),'bales')+stat(fmt(tw),'total kg')+stat(fmt(tw/1000),'tonnes')+stat(tb?fmt(tw/tb):'0','average kg');
    var h='<thead><tr><th>Date</th><th>Press</th><th>Type</th><th class="num">Bales</th><th>Bale no. range</th><th class="num">Min</th><th class="num">Max</th><th class="num">Avg</th><th class="num">Total kg</th></tr></thead><tbody>';
    if(!rows.length) h+='<tr><td colspan="9" class="empty">No production found for these filters.</td></tr>';
    rows.sort(function(a,b){ return a.date<b.date?-1:a.date>b.date?1:(a.press<b.press?-1:1); });
    rows.forEach(function(r){
      h+='<tr><td>'+dmy(r.date)+'</td><td>'+esc(r.press)+'</td><td>'+esc(r.type)+'</td><td class="num">'+r.bales+'</td><td>'+esc(r.first)+' - '+esc(r.last)+'</td><td class="num">'+r.min+'</td><td class="num">'+r.max+'</td><td class="num">'+fmt(r.wt/r.bales)+'</td><td class="num">'+fmt(r.wt)+'</td></tr>';
    });
    h+='</tbody><tfoot><tr><td colspan="3">Total</td><td class="num">'+tb+'</td><td colspan="3"></td><td class="num">'+(tb?fmt(tw/tb):'')+'</td><td class="num">'+fmt(tw)+'</td></tr></tfoot>';
    $('sumTable').innerHTML=h;
  }).catch(fail);
}

/* ---------- CSV export ---------- */
function exportCsv(which){
  var rows,head,lines;
  if(which==='register'){
    head=['Date','Press','Type','Sl No','Bale Number','Bale Weight'];
    rows=S.regRows.map(function(r){ return [r.date,r.press,r.type,r.sl,r.bale,r.wt]; });
  } else {
    head=['Date','Press','Type','Bales','First Bale','Last Bale','Min','Max','Total Kg'];
    rows=S.sumRows.map(function(r){ return [r.date,r.press,r.type,r.bales,r.first,r.last,r.min,r.max,r.wt]; });
  }
  if(!rows.length){ toast('Nothing to download. Click Show first.','err'); return; }
  function q(v){ return '"'+String(v==null?'':v).replace(/"/g,'""')+'"'; }
  lines=[head].concat(rows).map(function(r){ return r.map(q).join(','); }).join('\r\n');
  var a=document.createElement('a');
  a.href=URL.createObjectURL(new Blob(['\ufeff'+lines],{type:'text/csv'}));
  a.download='press_'+which+'_'+today()+'.csv';
  document.body.appendChild(a); a.click(); a.remove();
}
initApp();
</script>
</body>
</html>

