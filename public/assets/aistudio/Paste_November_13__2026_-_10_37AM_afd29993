  .header .actions button:hover{ opacity:.85; }
  .btn-back { background:rgba(255,255,255,0.15); color:#fff; }
  .btn-logout { background:var(--red); color:#fff; }

  .tabs { display:flex; background:var(--primary-dark); flex-wrap:wrap; }
  .tabs button {
    flex:0 0 auto; background:transparent; border:none; color:#dbe6f7; padding:14px 24px;
