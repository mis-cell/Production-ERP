        <!-- Machine Breakdown report filter -->
        <div class="panel">
          <h3 style="margin-top:0;">⚙️ Machine Breakdown</h3>
          <div class="field-row">
            <div class="field">
              <label>From Date</label>
              <input type="date" id="rp-mb-start">
            </div>
            <div class="field">
              <label>To Date</label>
