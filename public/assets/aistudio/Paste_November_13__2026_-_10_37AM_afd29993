function runReport() {
  var type = document.querySelector('input[name="rp_type"]:checked').value;
  var filters = {
    dateFrom: document.getElementById('rp_from').value,
    dateTo: document.getElementById('rp_to').value,
    shift: document.getElementById('rp_shift').value
  };
  document.getElementById('rp_loading').classList.remove('hidden');

  if (type === 'production') {
    filters.unit = document.getElementById('rp_unit').value;
    filters.machine = document.getElementById('rp_machine').value;
    filters.worker = document.getElementById('rp_worker').value;
    filters.beamNumber = document.getElementById('rp_beamnumber').value;
    google.script.run.withSuccessHandler(renderProductionReport).getProduction(filters);
  } else {
    google.script.run.withSuccessHandler(renderLogBookReport).getLogBooks(filters);
  }
}

function renderProductionReport(rows) {
  document.getElementById('rp_loading').classList.add('hidden');
  var head = document.getElementById('rp_head');
  var body = document.getElementById('rp_body');
  var cols = ['Date','Shift','Unit','Machine','BeamNumber','Round','Worker','HoursWorked','Color','BeamTarget','StartMeter','EndMeter','Production','RingLength','Weight','BeamStatus'];
  head.innerHTML = '<tr>' + cols.map(function(c){ return '<th class="px-3 py-2 text-left">'+c+'</th>'; }).join('') + '</tr>';

  var totalProd = 0;
  var totalHours = 0;
  // Only count HoursWorked once per Machine+Date+Shift — it's the same
  // value repeated on every entry saved during that shift.
  var seenHourKeys = {};
  body.innerHTML = rows.map(function (r, i) {
    totalProd += Number(r.Production) || 0;
    var hourKey = r.Machine + '|' + r.Date + '|' + r.Shift;
    if (!seenHourKeys[hourKey]) {
      seenHourKeys[hourKey] = true;
      totalHours += Number(r.HoursWorked) || 0;
    }
    var statusColor = r.BeamStatus === 'Completed' ? 'text-green-700 font-semibold'
      : (r.BeamStatus === 'Stopped' ? 'text-amber-600 font-semibold' : 'text-orange-600');
    return '<tr class="' + (i % 2 ? 'bg-gray-50' : '') + ' border-b">' +
      cols.map(function (c) {
        if (c === 'BeamStatus') return '<td class="px-3 py-2 '+statusColor+'">' + r[c] + '</td>';
        return '<td class="px-3 py-2">' + r[c] + '</td>';
      }).join('') + '</tr>';
  }).join('');

  document.getElementById('rp_summary').textContent =
    rows.length + ' record(s) — Total production: ' + totalProd + ' m — Total hours worked: ' + totalHours;
  if (rows.length === 0) document.getElementById('rp_summary').textContent = 'No records found for the selected filters.';
}

function renderLogBookReport(rows) {
  document.getElementById('rp_loading').classList.add('hidden');
  var head = document.getElementById('rp_head');
  var body = document.getElementById('rp_body');
  var cols = ['Date','Shift','RotationOfStaff','HoursWorked','IdleMachine','Batch','IfBatchChange','Instruction'];
  head.innerHTML = '<tr>' + cols.map(function(c){ return '<th class="px-3 py-2 text-left">'+c+'</th>'; }).join('') + '</tr>';

  body.innerHTML = rows.map(function (r, i) {
    return '<tr class="' + (i % 2 ? 'bg-gray-50' : '') + ' border-b align-top">' +
      cols.map(function (c) { return '<td class="px-3 py-2">' + (r[c] || '') + '</td>'; }).join('') + '</tr>';
  }).join('');

  document.getElementById('rp_summary').textContent = rows.length + ' record(s) found.';
  if (rows.length === 0) document.getElementById('rp_summary').textContent = 'No records found for the selected filters.';
}
