 const t=fx(g('.a')+g('.b')+g('.o1')+g('.o2'));tr.querySelector('.tt b').textContent=t;P+=t;const s=tr.querySelector('.st').value,has=tr.querySelector('.op').value||tr.querySelector('.ot').value;
