  google.script.run
    .withSuccessHandler(function (res) {
      if (!res.success) {
        statusEl.textContent = 'Error: ' + res.error; statusEl.className = 'self-center text-sm font-semibold text-red-600';
        return;
      }
      var verb = res.status === 'Completed' ? 'Completed' : (res.status === 'Stopped' ? 'Stopped' : 'Saved');
      var hoursTxt = res.hoursWorked ? (', ' + res.hoursWorked + ' hrs worked') : '';
      statusEl.textContent = verb + ' ✓ — Beam ' + res.beamNumber + ', Round ' + res.round + ', ' + res.production + 'm this entry' + hoursTxt + '.';
      statusEl.className = 'self-center text-sm font-semibold text-green-600';
      document.getElementById('pr_newbeam').checked = false;
      onMachineChange();
    })
    .withFailureHandler(function (err) {
