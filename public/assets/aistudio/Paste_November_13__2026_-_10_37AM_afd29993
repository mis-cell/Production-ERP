      font-weight:600;
      margin-bottom:6px;
      color:#374151;
    }
    input[type=date],input[type=number],input[type=text],select,textarea{
      width:100%;
      padding:9px 10px;
      border:1px solid var(--border);
      border-radius:6px;
      font-size:14px;
      background:#fff;
      color:var(--text);
    }
    textarea{
      min-height:80px;
      resize:vertical;
      font-family:inherit;
    }
    .full{ grid-column:1 / -1; }
    .readonly-field{
      background:#f2f4f9;
      font-weight:700;
      color:var(--navy);
    }
    .btn-row{
      display:flex;
      gap:10px;
      margin-top:20px;
      flex-wrap:wrap;
    }
    button.btn{
      border:none;
      border-radius:6px;
      padding:10px 18px;
      font-size:14px;
      font-weight:600;
      cursor:pointer;
    }
    .btn-primary{ background:var(--navy); color:#fff; }
    .btn-primary:hover{ background:var(--navy-dark); }
    .btn-save{ background:var(--green); color:#fff; }
    .btn-save:hover{ background:#166e3c; }
    .btn-danger{ background:var(--red); color:#fff; }
    .btn-danger:hover{ background:#9c2c20; }
    .btn-outline{ background:#fff; color:var(--navy); border:1px solid var(--navy); }
    .btn-outline:hover{ background:var(--blue-light); }
    .btn-sm{ padding:6px 10px; font-size:12px; }
    button:disabled{ opacity:.5; cursor:not-allowed; }

    details.settings-panel{
      border:1px solid var(--border);
      border-radius:8px;
      padding:14px 16px;
      margin-bottom:18px;
      background:#fafbfd;
    }
    details.settings-panel summary{
      cursor:pointer;
      font-weight:600;
      color:var(--navy);
      font-size:14px;
      list-style:none;
    }
    details.settings-panel summary::-webkit-details-marker{ display:none; }
    details.settings-panel summary:before{
      content:'▸ ';
    }
    details.settings-panel[open] summary:before{
      content:'▾ ';
    }
    .row-cfg{
      display:flex;
      gap:8px;
      align-items:center;
      margin-bottom:8px;
    }
    .row-cfg select{ flex:1 1 170px; margin:0; }
    .row-cfg input[type=text]{ flex:2 1 220px; margin:0; }
    .row-cfg .r-remove{
      flex:0 0 auto;
      background:#fff;
      color:var(--red);
      border:1px solid var(--red);
      border-radius:6px;
      padding:7px 10px;
      cursor:pointer;
      font-size:12px;
    }

    .toolbar{
      display:flex;
      align-items:center;
      justify-content:space-between;
      flex-wrap:wrap;
      gap:12px;
      margin-bottom:16px;
    }
    .toolbar .left, .toolbar .right{
      display:flex;
      align-items:center;
      gap:12px;
      flex-wrap:wrap;
    }
    .stat-pill{
      background:var(--blue-light);
      color:var(--navy);
      font-size:13px;
      font-weight:600;
      padding:8px 12px;
      border-radius:6px;
      white-space:nowrap;
    }
    .table-wrap{
      overflow-x:auto;
      border:1px solid var(--border);
      border-radius:8px;
    }
    table.prod-table{
      border-collapse:collapse;
      width:100%;
      min-width:900px;
    }
    table.prod-table th, table.prod-table td{
      border:1px solid var(--border);
      padding:6px 8px;
      text-align:center;
      font-size:13px;
    }
    table.prod-table thead tr.shift-row th{
      background:var(--navy);
      color:#fff;
      font-size:13px;
      padding:10px 8px;
    }
    table.prod-table thead tr.field-row th{
      background:#eef1f8;
      color:var(--navy);
      font-weight:600;
      font-size:12px;
    }
    table.prod-table th.machine-col{
      background:var(--navy);
      color:#fff;
    }
    table.prod-table td.machine-id{
      font-weight:700;
      background:#fafbfd;
      color:var(--navy);
    }
    table.prod-table td input{
      width:72px;
      padding:5px 4px;
      border:1px solid var(--border);
      border-radius:4px;
      font-size:13px;
      text-align:center;
    }
    table.prod-table td.divider-left{
      border-left:3px solid var(--navy);
    }
    .pagination{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
      margin-top:16px;
      flex-wrap:wrap;
    }
    .pagination .page-controls{
      display:flex;
      align-items:center;
      gap:8px;
    }
    .page-controls button{
      padding:7px 12px;
      border:1px solid var(--border);
      background:#fff;
      border-radius:6px;
      cursor:pointer;
      font-size:13px;
    }
    .page-controls button:disabled{ opacity:.4; cursor:not-allowed; }
    .page-info{
      font-size:13px;
      color:#4b5563;
      font-weight:600;
    }
    .status-msg{
      margin-top:12px;
      font-size:13px;
      font-weight:600;
    }
    .status-ok{ color:var(--green); }
    .status-err{ color:var(--red); }
    .empty-state{
      text-align:center;
      color:#6b7280;
      padding:60px 20px;
      font-size:15px;
    }
    .spinner{
      display:inline-block;
      width:14px;height:14px;
      border:2px solid #ffffff55;
      border-top-color:#fff;
      border-radius:50%;
      animation:spin .7s linear infinite;
      vertical-align:middle;
      margin-right:6px;
    }
    @keyframes spin{ to{ transform:rotate(360deg); } }

    .shift-block{ margin-bottom:22px; }
    .shift-block h3{
      display:flex;
      align-items:center;
      gap:8px;
    }
    .shift-badge{
      display:inline-block;
      background:var(--navy);
      color:#fff;
      font-size:11px;
      font-weight:700;
      padding:3px 8px;
      border-radius:10px;
    }
    .section-title{
      font-size:12px;
      font-weight:700;
      color:#374151;
      margin:14px 0 6px;
      text-transform:uppercase;
      letter-spacing:.03em;
    }
    table.ver-table td.row-name{
      text-align:left;
      font-weight:700;
      background:#fafbfd;
      color:var(--navy);
      white-space:nowrap;
    }
    table.ver-table td input[type=number]{
      width:90px;
      padding:5px 4px;
      text-align:center;
      margin:0;
    }
  </style>
</head>
<body>

  <div class="topbar">
    <div class="title">S4 Loom — Bally Jute Mill</div>
    <div class="tabs">
      <button class="tab-btn active" data-tab="logbook" onclick="switchTab('logbook')">Log Book</button>
      <button class="tab-btn" data-tab="production" onclick="switchTab('production')">Production</button>
      <button class="tab-btn" data-tab="verification" onclick="switchTab('verification')">Verification</button>
      <button class="tab-btn" data-tab="report" onclick="switchTab('report')">Report</button>
    </div>
  </div>

  <div class="page">

    <!-- ===================== LOG BOOK TAB ===================== -->
    <div id="tab-logbook" class="tab-content">
      <div class="card">
        <h2>Log Book Entry</h2>
        <p class="sub">Fill this in at the start of every shift. Total Loom is calculated automatically from Company + Contractor readings.</p>

        <div class="form-grid">
          <div>
            <label>Date</label>
            <input type="date" id="lb-date">
          </div>
          <div>
            <label>Shift</label>
            <select id="lb-shift">
              <option value="A">A (2 PM)</option>
              <option value="B">B (10 PM)</option>
              <option value="C">C (6 AM)</option>
            </select>
          </div>
          <div>
            <label>Company Loom Reading</label>
            <input type="number" id="lb-company" placeholder="e.g. 210" oninput="recalcTotal()">
          </div>
          <div>
            <label>Contractor Loom Reading</label>
            <input type="number" id="lb-contractor" placeholder="e.g. 126" oninput="recalcTotal()">
          </div>
          <div>
            <label>Total Loom (Company + Contractor)</label>
            <input type="number" id="lb-total" class="readonly-field" readonly>
          </div>
        </div>

        <div class="form-grid" style="margin-top:16px;">
          <div class="full">
            <label>Machine Breakdown Reason</label>
            <textarea id="lb-breakdown" placeholder="e.g. Machine 234 - shuttle jam, 250 - motor tripped"></textarea>
          </div>
          <div class="full">
            <label>Instruction Given by Senior</label>
            <textarea id="lb-instruction" placeholder="Instructions for the next shift..."></textarea>
          </div>
        </div>

        <div class="btn-row">
          <button class="btn btn-outline" onclick="loadLogbook()">Load Entry</button>
          <button class="btn btn-danger" onclick="clearLogbook()">Clear</button>
          <button class="btn btn-save" onclick="saveLogbook()">Save</button>
        </div>
        <div id="lb-status" class="status-msg"></div>
      </div>
    </div>

    <!-- ===================== PRODUCTION TAB ===================== -->
    <div id="tab-production" class="tab-content" style="display:none;">
      <div class="card">
        <h2>Loom Production — Daily Machine Log</h2>
        <p class="sub">Enter data for all machines across the 3 shifts. Each shift captures Reading, A. Mtr, T. Mtr Efy. and Cuts.</p>

        <div class="toolbar">
          <div class="left">
            <div>
              <label style="margin-bottom:4px;">Date</label>
              <input type="date" id="prod-date" style="width:170px;">
            </div>
            <div>
              <label style="margin-bottom:4px;">Machines per page</label>
              <select id="prod-pagesize" onchange="renderProdPage(0)" style="width:100px;">
                <option value="6">6</option>
                <option value="10">10</option>
                <option value="20" selected>20</option>
                <option value="50">50</option>
                <option value="336">All (336)</option>
              </select>
            </div>
            <div>
              <label style="margin-bottom:4px;">Jump to Machine ID</label>
              <div style="display:flex;gap:6px;">
                <input type="text" id="prod-search" placeholder="e.g. 105" style="width:100px;" onkeydown="if(event.key==='Enter')jumpToMachine()">
                <button class="btn btn-outline" style="padding:9px 12px;" onclick="jumpToMachine()">Go</button>
              </div>
            </div>
          </div>
          <div class="right">
            <span class="stat-pill" id="prod-total-pill">Total Machines: 336</span>
          </div>
        </div>

        <div class="btn-row" style="margin-top:0;margin-bottom:16px;">
          <button class="btn btn-outline" onclick="loadTodaysData()">Load Today's Data</button>
          <button class="btn btn-danger" onclick="resetProduction()">Reset</button>
          <button class="btn btn-save" onclick="saveAllProduction()">Save All</button>
        </div>

        <div id="prod-table-container"></div>

        <div class="pagination">
          <div class="page-controls">
            <button id="prod-prev" onclick="renderProdPage(currentPage-1)">&laquo; Prev</button>
            <span class="page-info" id="prod-page-info">Page 1</span>
            <button id="prod-next" onclick="renderProdPage(currentPage+1)">Next &raquo;</button>
          </div>
          <div id="prod-status" class="status-msg"></div>
        </div>
      </div>
    </div>

    <!-- ===================== VERIFICATION TAB ===================== -->
    <div id="tab-verification" class="tab-content" style="display:none;">
      <div class="card">
        <h2>Shift Verification Summary</h2>
        <p class="sub">A digital copy of the register: for the selected date, each shift lists every operator/contractor group under "Company + O.S." and "Contractor", with Total Mtr, Avg Mtr, Avg Eff (%), Loom, Cut and Weight entered by hand — exactly as written in the log.</p>

        <details class="settings-panel" id="rows-panel">
          <summary>Manage Rows (operator / contractor names — same for every shift &amp; date)</summary>
          <p class="sub" style="margin-top:10px;">These names appear identically on every shift table below (A, B and C). Set this up once, e.g. <strong>Company + O.S.</strong>: Pravin, R. Chand, Ram Ch., Anil — <strong>Contractor</strong>: N/L + N.S., New/Contractor.</p>
          <div id="rows-list"></div>
          <div class="btn-row" style="margin-top:4px;">
            <button class="btn btn-outline btn-sm" onclick="addRowCfg()">+ Add Row</button>
            <button class="btn btn-save btn-sm" onclick="saveRowsNow()">Save Rows</button>
          </div>
          <div id="rows-status" class="status-msg"></div>
        </details>

        <div class="toolbar">
          <div class="left">
            <div>
              <label style="margin-bottom:4px;">Date</label>
              <input type="date" id="ver-date" style="width:170px;">
            </div>
          </div>
        </div>

        <div class="btn-row" style="margin-top:0;margin-bottom:16px;">
          <button class="btn btn-outline" onclick="loadVerification()">Load</button>
          <button class="btn btn-save" onclick="saveVerification()">Save All Shifts</button>
        </div>

        <div id="ver-tables-container"></div>

        <div id="ver-status" class="status-msg"></div>
      </div>
    </div>

    <!-- ===================== REPORT TAB ===================== -->
    <div id="tab-report" class="tab-content" style="display:none;">
      <div class="card">
        <h2>Report Dashboard</h2>
        <p class="sub">Filter Production data by date range and (optionally) machine number, then preview it below or download it as a CSV file.</p>

        <div class="form-grid">
          <div>
            <label>From Date</label>
            <input type="date" id="rep-from-date">
          </div>
          <div>
            <label>To Date</label>
            <input type="date" id="rep-to-date">
          </div>
          <div>
            <label>Machine ID (optional)</label>
            <input type="text" id="rep-machine" placeholder="e.g. 105 or 12,45,101 — blank = all">
          </div>
        </div>

        <div class="btn-row" style="margin-top:16px;margin-bottom:0;">
          <button class="btn btn-outline" onclick="loadReport()">Load</button>
          <button class="btn btn-save" id="rep-download-btn" onclick="downloadReportCSV()" disabled>Download CSV</button>
        </div>

        <div class="toolbar" style="margin-top:16px;margin-bottom:8px;">
          <div class="left">
            <span class="stat-pill" id="rep-count-pill">No data loaded</span>
          </div>
        </div>

        <div id="rep-table-container">
          <div class="empty-state">Choose a date range and click Load to view report data.</div>
        </div>

        <div id="rep-status" class="status-msg"></div>
      </div>
    </div>

  </div>

<script>
  /* ============================ GLOBAL STATE ============================ */
  let machineList = [];         // [1, 2, ... 336]
  let productionData = {};      // { machineId: {A_Reading, A_AMtr, A_TMtrEfy, A_Cuts, B_..., C_...} }
  let currentPage = 0;
  let reportData = [];          // rows loaded on the Report tab, used for both preview + CSV export

  const SECTIONS = ['Company + O.S.', 'Contractor'];
  let rowsConfig = [];          // [{section, name}, ...] loaded/edited on the Verification tab
  let verSummary = null;        // last summary returned by getVerificationSummary

  const FIELD_COLS = ['Reading', 'AMtr', 'TMtrEfy', 'Cuts'];
  const SHIFTS = [
    { key: 'A', label: 'A Shift (2 PM)' },
    { key: 'B', label: 'B Shift (10 PM)' },
    { key: 'C', label: 'C Shift (6 AM)' }
  ];
  // Column order shared by the report table and the CSV export.
  const REPORT_COLS = [
    'A_Reading', 'A_AMtr', 'A_TMtrEfy', 'A_Cuts',
    'B_Reading', 'B_AMtr', 'B_TMtrEfy', 'B_Cuts',
    'C_Reading', 'C_AMtr', 'C_TMtrEfy', 'C_Cuts'
  ];
  // Manually-entered columns shown for every operator row on the Verification tab.
  const VER_FIELDS = [
    { key: 'totalMtr', label: 'Total Mtr' },
    { key: 'avgMtr', label: 'Avg Mtr' },
    { key: 'avgEff', label: 'Avg Eff (%)' },
    { key: 'loom', label: 'Loom' },
    { key: 'cut', label: 'Cut' },
    { key: 'weight', label: 'Weight' }
  ];

  function todayStr(){
    const d = new Date();
    const tzOff = d.getTimezoneOffset() * 60000;
    return new Date(d - tzOff).toISOString().slice(0,10);
  }

  /* ============================ TABS ============================ */
  function switchTab(tab){
    document.querySelectorAll('.tab-content').forEach(el => el.style.display = 'none');
    document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
    document.getElementById('tab-' + tab).style.display = 'block';
    document.querySelector('.tab-btn[data-tab="' + tab + '"]').classList.add('active');
    if(tab === 'verification' && rowsConfig.length === 0){
      loadVerificationRows();
    }
  }

  /* ============================ INIT ============================ */
  window.onload = function(){
    document.getElementById('lb-date').value = todayStr();
    document.getElementById('prod-date').value = todayStr();
    document.getElementById('ver-date').value = todayStr();
    document.getElementById('rep-from-date').value = todayStr();
    document.getElementById('rep-to-date').value = todayStr();

    google.script.run.withSuccessHandler(function(list){
      machineList = list;
      document.getElementById('prod-total-pill').textContent = 'Total Machines: ' + machineList.length;
      renderProdPage(0);
    }).withFailureHandler(showProdError).getMachineList();

    // Event delegation: the table body is rebuilt on every page change,
    // so we bind ONE listener on the (static) container instead of
    // wiring inline handlers on every one of the 336*3*4 inputs.
    document.getElementById('prod-table-container').addEventListener('input', function(e){
      const el = e.target;
      if(el && el.tagName === 'INPUT' && el.dataset && el.dataset.machine){
        updateField(Number(el.dataset.machine), el.dataset.key, el.value);
      }
    });
  };

  /* ============================ LOG BOOK ============================ */
  function recalcTotal(){
    const c = Number(document.getElementById('lb-company').value) || 0;
    const t = Number(document.getElementById('lb-contractor').value) || 0;
    document.getElementById('lb-total').value = c + t;
  }

  function clearLogbook(){
    document.getElementById('lb-company').value = '';
    document.getElementById('lb-contractor').value = '';
    document.getElementById('lb-total').value = '';
    document.getElementById('lb-breakdown').value = '';
    document.getElementById('lb-instruction').value = '';
    document.getElementById('lb-status').textContent = '';
  }

  function loadLogbook(){
    const date = document.getElementById('lb-date').value;
    const shift = document.getElementById('lb-shift').value;
    if(!date){ setLbStatus('Please select a date first.', false); return; }
    setLbStatus('Loading...', true);
    google.script.run.withSuccessHandler(function(entry){
      if(!entry){
        setLbStatus('No existing entry found for this date/shift. Starting fresh.', true);
        clearLogbook();
        return;
      }
      document.getElementById('lb-company').value = entry.companyReading;
      document.getElementById('lb-contractor').value = entry.contractorReading;
      document.getElementById('lb-total').value = entry.total;
      document.getElementById('lb-breakdown').value = entry.breakdownReason || '';
      document.getElementById('lb-instruction').value = entry.instruction || '';
      setLbStatus('Entry loaded.', true);
    }).withFailureHandler(function(err){ setLbStatus('Error: ' + err.message, false); })
      .getLogbookEntry(date, shift);
  }

  function saveLogbook(){
    const date = document.getElementById('lb-date').value;
    const shift = document.getElementById('lb-shift').value;
    if(!date){ setLbStatus('Please select a date.', false); return; }
    recalcTotal();
    const entry = {
      date: date,
      shift: shift,
      companyReading: document.getElementById('lb-company').value,
      contractorReading: document.getElementById('lb-contractor').value,
      breakdownReason: document.getElementById('lb-breakdown').value,
      instruction: document.getElementById('lb-instruction').value
    };
    setLbStatus('Saving...', true);
    google.script.run.withSuccessHandler(function(res){
      setLbStatus('Saved successfully. Total Loom: ' + res.total, true);
    }).withFailureHandler(function(err){ setLbStatus('Error: ' + err.message, false); })
      .saveLogbookEntry(entry);
  }

  function setLbStatus(msg, ok){
    const el = document.getElementById('lb-status');
    el.textContent = msg;
    el.className = 'status-msg ' + (ok ? 'status-ok' : 'status-err');
  }

  /* ============================ PRODUCTION ============================ */

  function ensureMachineEntry(id){
    if(!productionData[id]){
      productionData[id] = {
        A_Reading:'', A_AMtr:'', A_TMtrEfy:'', A_Cuts:'',
        B_Reading:'', B_AMtr:'', B_TMtrEfy:'', B_Cuts:'',
        C_Reading:'', C_AMtr:'', C_TMtrEfy:'', C_Cuts:''
      };
    }
    return productionData[id];
  }

  function renderProdPage(page){
    if(machineList.length === 0) return;
    const pageSize = Number(document.getElementById('prod-pagesize').value);
    const totalPages = Math.max(1, Math.ceil(machineList.length / pageSize));
    if(page < 0) page = 0;
    if(page > totalPages - 1) page = totalPages - 1;
    currentPage = page;

    const start = page * pageSize;
    const end = Math.min(start + pageSize, machineList.length);
    const slice = machineList.slice(start, end);

    let html = '<div class="table-wrap"><table class="prod-table"><thead>';
    html += '<tr class="shift-row"><th class="machine-col" rowspan="2">Machine ID</th>';
    SHIFTS.forEach(s => { html += '<th colspan="4">' + s.label + '</th>'; });
    html += '</tr><tr class="field-row">';
    SHIFTS.forEach(() => {
      html += '<th>Reading</th><th>A. Mtr</th><th>T. Mtr Efy.</th><th>Cuts</th>';
    });
    html += '</tr></thead><tbody>';

    slice.forEach(id => {
      const d = ensureMachineEntry(id);
      html += '<tr id="row-' + id + '"><td class="machine-id">' + id + '</td>';
      SHIFTS.forEach((s, sIdx) => {
        FIELD_COLS.forEach((f, fIdx) => {
          const key = s.key + '_' + f;
          const cls = (fIdx === 0) ? ' class="divider-left"' : '';
          const val = d[key] === undefined ? '' : d[key];
          html += '<td' + cls + '><input type="number" step="any" value="' + val +
                  '" data-machine="' + id + '" data-key="' + key + '"></td>';
        });
      });
      html += '</tr>';
    });

    html += '</tbody></table></div>';
    document.getElementById('prod-table-container').innerHTML = html;

    document.getElementById('prod-page-info').textContent =
      'Page ' + (currentPage + 1) + ' of ' + totalPages + '  (machines ' + (start+1) + '–' + end + ' of ' + machineList.length + ')';
    document.getElementById('prod-prev').disabled = currentPage === 0;
    document.getElementById('prod-next').disabled = currentPage >= totalPages - 1;
  }

  function updateField(machineId, key, value){
    ensureMachineEntry(machineId)[key] = value;
  }

  function jumpToMachine(){
    const raw = document.getElementById('prod-search').value.trim();
    const id = Number(raw);
    if(raw === '' || isNaN(id)){
      setProdStatus('Enter a valid machine ID to jump to.', false);
      return;
    }
    if(machineList.indexOf(id) === -1){
      setProdStatus('Machine ID ' + id + ' not found (valid range: ' + machineList[0] + '–' + machineList[machineList.length-1] + ').', false);
      return;
    }
    const pageSize = Number(document.getElementById('prod-pagesize').value);
    const idx = machineList.indexOf(id);
    const page = Math.floor(idx / pageSize);
    renderProdPage(page);
    setTimeout(function(){
      const row = document.getElementById('row-' + id);
      if(row){
        row.scrollIntoView({behavior:'smooth', block:'center'});
        row.style.background = '#fff6cc';
        setTimeout(function(){ row.style.background = ''; }, 1500);
      }
    }, 50);
  }

  function loadTodaysData(){
    const date = document.getElementById('prod-date').value;
    if(!date){ setProdStatus('Please select a date.', false); return; }
    setProdStatus('Loading...', true);
    google.script.run.withSuccessHandler(function(data){
      productionData = {};
      Object.keys(data).forEach(id => { productionData[id] = data[id]; });
      renderProdPage(0);
      setProdStatus('Loaded existing data for ' + date + '.', true);
    }).withFailureHandler(showProdError).getProductionData(date);
  }

  function resetProduction(){
    if(!confirm('Clear all entered values on screen? This does not affect already-saved data until you Save All.')) return;
    productionData = {};
    renderProdPage(currentPage);
    setProdStatus('Form cleared.', true);
  }

  function saveAllProduction(){
    const date = document.getElementById('prod-date').value;
    if(!date){ setProdStatus('Please select a date.', false); return; }

    const rows = [];
    machineList.forEach(id => {
      const d = productionData[id];
      if(!d) return;
      const hasData = Object.values(d).some(v => v !== '' && v !== null && v !== undefined);
      if(hasData){
        rows.push(Object.assign({ machineId: id }, d));
      }
    });

    if(rows.length === 0){
      setProdStatus('No data entered to save.', false);
      return;
    }

    setProdStatus('Saving ' + rows.length + ' machine record(s)...', true);
    google.script.run.withSuccessHandler(function(res){
      setProdStatus('Saved. Updated: ' + res.updated + ', Inserted: ' + res.inserted + '.', true);
    }).withFailureHandler(showProdError).saveProductionData(date, rows);
  }

  function setProdStatus(msg, ok){
    const el = document.getElementById('prod-status');
    el.textContent = msg;
    el.className = 'status-msg ' + (ok ? 'status-ok' : 'status-err');
  }

  function showProdError(err){
    setProdStatus('Error: ' + err.message, false);
  }

  /* ============================ VERIFICATION — MANAGE ROWS ============================ */

  function loadVerificationRows(){
    document.getElementById('rows-status').textContent = 'Loading rows...';
    google.script.run.withSuccessHandler(function(rows){
      rowsConfig = (rows || []).map(r => ({ section: r.section, name: r.name }));
      if(rowsConfig.length === 0){
        // Nothing configured yet — seed with the register's default rows so it's obvious how to begin.
        rowsConfig = [
          { section: 'Company + O.S.', name: '' },
          { section: 'Contractor', name: '' }
        ];
        document.getElementById('rows-panel').open = true;
      }
      renderRowsList();
      document.getElementById('rows-status').textContent = '';
      loadVerification();
    }).withFailureHandler(function(err){
      document.getElementById('rows-status').textContent = 'Error loading rows: ' + err.message;
      document.getElementById('rows-status').className = 'status-msg status-err';
    }).getVerificationRows();
  }

  function renderRowsList(){
    const container = document.getElementById('rows-list');
    let html = '';
    rowsConfig.forEach((r, i) => {
      html += '<div class="row-cfg">' +
        '<select onchange="rowsConfig[' + i + '].section=this.value">' +
        SECTIONS.map(s => '<option value="' + s + '"' + (r.section === s ? ' selected' : '') + '>' + s + '</option>').join('') +
        '</select>' +
        '<input type="text" placeholder="Operator / contractor name, e.g. Pravin" value="' + (r.name || '').replace(/"/g,'&quot;') + '" oninput="rowsConfig[' + i + '].name=this.value">' +
        '<button class="r-remove" onclick="removeRowCfg(' + i + ')">Remove</button>' +
        '</div>';
    });
    container.innerHTML = html;
  }

  function addRowCfg(){
    rowsConfig.push({ section: 'Company + O.S.', name: '' });
    renderRowsList();
  }

  function removeRowCfg(i){
    rowsConfig.splice(i, 1);
    renderRowsList();
  }

  function saveRowsNow(){
    const el = document.getElementById('rows-status');
    const cleaned = rowsConfig.filter(r => r.name && r.name.trim() !== '');
    if(cleaned.length === 0){
      el.textContent = 'Add at least one named row before saving.';
      el.className = 'status-msg status-err';
      return;
    }
    el.textContent = 'Saving rows...';
    el.className = 'status-msg';
    google.script.run.withSuccessHandler(function(res){
      el.textContent = 'Saved ' + res.count + ' row(s). These apply to every shift & date.';
      el.className = 'status-msg status-ok';
      loadVerification();
    }).withFailureHandler(function(err){
      el.textContent = 'Error: ' + err.message;
      el.className = 'status-msg status-err';
    }).saveVerificationRows(cleaned);
  }

  /* ============================ VERIFICATION — SHIFT TABLES ============================ */

  function loadVerification(){
    const date = document.getElementById('ver-date').value;
    if(!date){ setVerStatus('Please select a date.', false); return; }
    if(rowsConfig.length === 0){ loadVerificationRows(); return; }
    setVerStatus('Loading...', true);
    google.script.run.withSuccessHandler(function(summary){
      verSummary = summary;
      renderVerificationTables(summary);
      setVerStatus('Loaded verification entries for ' + date + '.', true);
    }).withFailureHandler(function(err){ setVerStatus('Error: ' + err.message, false); })
      .getVerificationSummary(date);
  }

  function renderVerificationTables(summary){
    const container = document.getElementById('ver-tables-container');
    const rows = summary.rows || [];

    if(rows.length === 0){
      container.innerHTML = '<div class="empty-state">No rows configured yet. Open "Manage Rows" above to add your operator / contractor names.</div>';
      return;
    }

    let html = '';
    SHIFTS.forEach(shift => {
      const shiftData = (summary.shifts && summary.shifts[shift.key]) || {};
      html += '<div class="shift-block">';
      html += '<h3><span class="shift-badge">' + shift.label + '</span></h3>';

      SECTIONS.forEach(section => {
        const sectionRows = rows.filter(r => r.section === section);
        if(sectionRows.length === 0) return;
        html += '<div class="section-title">' + escapeHtml_(section) + '</div>';
        html += '<div class="table-wrap"><table class="prod-table ver-table"><thead><tr class="shift-row">';
        html += '<th class="machine-col">' + escapeHtml_(section) + '</th>';
        VER_FIELDS.forEach(f => { html += '<th>' + f.label + '</th>'; });
        html += '</tr></thead><tbody>';

        sectionRows.forEach(r => {
          const existing = shiftData[r.name] || {};
          html += '<tr><td class="row-name">' + escapeHtml_(r.name) + '</td>';
          VER_FIELDS.forEach(f => {
            const v = existing[f.key];
            html += '<td><input type="number" step="any" value="' + (v === undefined || v === null ? '' : v) +
                     '" data-shift="' + shift.key + '" data-section="' + escapeHtml_(section) +
                     '" data-name="' + escapeHtml_(r.name) + '" data-field="' + f.key + '" class="ver-input"></td>';
          });
          html += '</tr>';
        });

        html += '</tbody></table></div>';
      });

      html += '</div>';
    });

    container.innerHTML = html;
  }

  function escapeHtml_(s){
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function saveVerification(){
    const date = document.getElementById('ver-date').value;
    if(!date){ setVerStatus('Please select a date.', false); return; }

    // Build { A: [{section,name,totalMtr,...}], B: [...], C: [...] }
    const byShift = { A: {}, B: {}, C: {} };
    document.querySelectorAll('.ver-input').forEach(input => {
      const shift = input.dataset.shift;
      const section = input.dataset.section;
      const name = input.dataset.name;
      const field = input.dataset.field;
      const key = section + '|' + name;
      if(!byShift[shift][key]) byShift[shift][key] = { section: section, name: name };
      byShift[shift][key][field] = input.value;
    });

    setVerStatus('Saving...', true);
    const shiftsToSave = Object.keys(byShift);
    let remaining = shiftsToSave.length;
    let hadError = false;

    shiftsToSave.forEach(shift => {
      const entries = Object.values(byShift[shift]);
      google.script.run.withSuccessHandler(function(){
        remaining--;
        if(remaining === 0){
          if(!hadError){
            setVerStatus('All shifts saved.', true);
            loadVerification();
          }
        }
      }).withFailureHandler(function(err){
        hadError = true;
        setVerStatus('Error saving ' + shift + ' shift: ' + err.message, false);
      }).saveVerificationEntries(date, shift, entries);
    });
  }

  function setVerStatus(msg, ok){
    const el = document.getElementById('ver-status');
    el.textContent = msg;
    el.className = 'status-msg ' + (ok ? 'status-ok' : 'status-err');
  }

  /* ============================ REPORT ============================ */

  function loadReport(){
    const from = document.getElementById('rep-from-date').value;
    const to = document.getElementById('rep-to-date').value;
    const machine = document.getElementById('rep-machine').value.trim();

    if(!from || !to){ setRepStatus('Please select both a From and To date.', false); return; }
    if(from > to){ setRepStatus('From Date must be on or before To Date.', false); return; }

    setRepStatus('Loading...', true);
    document.getElementById('rep-download-btn').disabled = true;

    google.script.run.withSuccessHandler(function(rows){
      reportData = rows || [];
      renderReportTable(reportData);
      document.getElementById('rep-count-pill').textContent = reportData.length + ' row(s) found';
      document.getElementById('rep-download-btn').disabled = reportData.length === 0;
      setRepStatus(reportData.length === 0
        ? 'No production data found for that date range / machine filter.'
        : 'Loaded ' + reportData.length + ' row(s).', true);
    }).withFailureHandler(function(err){
      setRepStatus('Error: ' + err.message, false);
    }).getReportData(from, to, machine);
  }

  function renderReportTable(rows){
    const container = document.getElementById('rep-table-container');
    if(!rows || rows.length === 0){
      container.innerHTML = '<div class="empty-state">No data for the selected filters.</div>';
      return;
    }

    let html = '<div class="table-wrap"><table class="prod-table"><thead>';
    html += '<tr class="shift-row"><th class="machine-col" rowspan="2">Date</th><th class="machine-col" rowspan="2">Machine ID</th>';
    SHIFTS.forEach(s => { html += '<th colspan="4">' + s.label + '</th>'; });
    html += '</tr><tr class="field-row">';
    SHIFTS.forEach(() => {
      html += '<th>Reading</th><th>A. Mtr</th><th>T. Mtr Efy.</th><th>Cuts</th>';
    });
    html += '</tr></thead><tbody>';

    rows.forEach(r => {
      html += '<tr><td class="machine-id">' + r.date + '</td><td class="machine-id">' + r.machineId + '</td>';
      REPORT_COLS.forEach((c, i) => {
        const cls = (i % 4 === 0) ? ' class="divider-left"' : '';
        const val = (r[c] === undefined || r[c] === null) ? '' : r[c];
        html += '<td' + cls + '>' + val + '</td>';
      });
      html += '</tr>';
    });

    html += '</tbody></table></div>';
    container.innerHTML = html;
  }

  function csvEscape_(val){
    const s = (val === undefined || val === null) ? '' : String(val);
    if(/[",\n]/.test(s)){
      return '"' + s.replace(/"/g, '""') + '"';
    }
    return s;
  }

  function downloadReportCSV(){
    if(!reportData || reportData.length === 0){
      setRepStatus('Nothing to download — load some data first.', false);
      return;
    }

    const headers = ['Date', 'Machine ID'].concat(REPORT_COLS.map(c => c.replace('_', ' ')));
    const lines = [headers.map(csvEscape_).join(',')];

    reportData.forEach(r => {
      const row = [r.date, r.machineId].concat(REPORT_COLS.map(c => r[c]));
      lines.push(row.map(csvEscape_).join(','));
    });

    const csvContent = lines.join('\r\n');
    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);

    const from = document.getElementById('rep-from-date').value;
    const to = document.getElementById('rep-to-date').value;
    const machine = document.getElementById('rep-machine').value.trim();
    const machinePart = machine ? '_m' + machine.replace(/[^0-9,]/g, '') : '';
    const filename = 's4loom_report_' + from + '_to_' + to + machinePart + '.csv';

    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    setTimeout(function(){ URL.revokeObjectURL(url); }, 1000);

    setRepStatus('CSV downloaded: ' + filename, true);
  }

  function setRepStatus(msg, ok){
    const el = document.getElementById('rep-status');
    el.textContent = msg;
    el.className = 'status-msg ' + (ok ? 'status-ok' : 'status-err');
  }
</script>
</body>
</html>


