<!DOCTYPE html>
<html>
<head>
  <base target="_top">
  <meta charset="UTF-8">
  <style>
    :root{
      --navy:#132048;
      --navy-dark:#0d1733;
      --blue:#3459e6;
      --blue-dark:#2846c4;
      --bg:#f2f4f8;
      --border:#dfe3ec;
      --text:#1b2333;
      --muted:#8891a5;
      --amber:#fff4e0;
      --amber-border:#f0c374;
      --amber-text:#8a5b00;
    }
    *{box-sizing:border-box;}
    body{
      margin:0;
      font-family:'Segoe UI', Roboto, Arial, sans-serif;
      background:var(--bg);
      color:var(--text);
    }
    header{
      background:var(--navy);
      color:#fff;
      padding:16px 28px;
      display:flex;
      align-items:center;
      flex-wrap:wrap;
      gap:24px;
    }
    header h1{
      font-size:20px;
      margin:0;
      font-weight:700;
      white-space:nowrap;
    }
    nav{
      display:flex;
      gap:22px;
      flex-wrap:wrap;
    }
    nav button{
      background:none;
      border:none;
      color:#b8c0d9;
      font-size:15px;
      font-weight:600;
      padding:6px 2px;
      cursor:pointer;
      border-bottom:2px solid transparent;
    }
    nav button.active{
      color:#fff;
      border-bottom:2px solid var(--blue);
    }
    main{
      max-width:1100px;
      margin:24px auto;
      padding:0 20px 60px;
    }
    .card{
      background:#fff;
      border-radius:10px;
      box-shadow:0 1px 3px rgba(20,30,60,0.08);
      padding:28px 30px;
      margin-bottom:24px;
    }
    .card h2{
      margin:0 0 6px;
      font-size:22px;
      color:var(--navy);
    }
    .subtext{
      color:var(--muted);
      font-size:14px;
      margin:0 0 22px;
      line-height:1.4;
    }
    .grid{
      display:grid;
      grid-template-columns:repeat(4,1fr);
      gap:18px 20px;
    }
    @media(max-width:800px){ .grid{grid-template-columns:repeat(2,1fr);} }
    @media(max-width:480px){ .grid{grid-template-columns:1fr;} }
    .field label{
      display:block;
      font-weight:700;
      font-size:13.5px;
      margin-bottom:6px;
      color:#26304a;
    }
    .field label .req{ color:#d9455a; font-weight:700; }
    .field input, .field select, .field textarea{
      width:100%;
      padding:10px 12px;
      border:1px solid var(--border);
      border-radius:8px;
      font-size:14px;
      background:#fff;
      color:var(--text);
      font-family:inherit;
    }
    .field input:disabled, .field select:disabled{
      background:#eef1f7;
      color:#8891a5;
    }
    .field textarea{ resize:vertical; min-height:70px; }
    .full{ grid-column:1/-1; }
    .btn-row{
      margin-top:26px;
      display:flex;
      gap:16px;
      align-items:center;
      flex-wrap:wrap;
    }
    .btn{
      background:var(--blue);
      color:#fff;
      border:none;
      padding:11px 22px;
      border-radius:8px;
      font-weight:700;
      font-size:14px;
      cursor:pointer;
    }
    .btn:hover{ background:var(--blue-dark); }
    .btn.secondary{
      background:transparent;
      color:var(--muted);
      font-weight:600;
    }
    .btn.stop{
      background:#d9455a;
    }
    .btn.stop:hover{ background:#b8394b; }
    .msg{
      font-size:13.5px;
      font-weight:600;
      padding-top:4px;
    }
    .msg.ok{ color:#1a9c5b; }
    .msg.err{ color:#d9455a; }
    table{
      width:100%;
      border-collapse:collapse;
      font-size:13.5px;
    }
    th, td{
      border-bottom:1px solid var(--border);
      padding:9px 10px;
      text-align:left;
      white-space:nowrap;
    }
    th{
      background:#f6f8fc;
      color:#3a4359;
      font-size:12.5px;
      text-transform:uppercase;
      letter-spacing:.3px;
    }
    .table-wrap{ overflow-x:auto; }
    .totals{
      display:flex;
      gap:16px;
      flex-wrap:wrap;
      margin-bottom:20px;
    }
    .stat{
      flex:1;
      min-width:150px;
      background:#f6f8fc;
      border:1px solid var(--border);
      border-radius:8px;
      padding:14px 16px;
    }
    .stat .num{ font-size:22px; font-weight:800; color:var(--navy); }
    .stat .lbl{ font-size:12.5px; color:var(--muted); font-weight:600; margin-top:2px; }
    .tab-section{ display:none; }
    .tab-section.active{ display:block; }
    .badge{
      display:inline-block;
      background:#eaf1ff;
      color:var(--blue-dark);
      font-size:11.5px;
      font-weight:700;
      padding:2px 8px;
      border-radius:20px;
      margin-left:8px;
    }
    .badge.open{ background:#eaf1ff; color:var(--blue-dark); }
    .badge.done{ background:#e6f7ee; color:#1a9c5b; }
    .checkbox-row{
      display:flex;
      align-items:center;
      gap:8px;
      margin-bottom:18px;
      font-weight:700;
      font-size:14px;
    }
    .checkbox-row input{ width:18px; height:18px; }
    .alert{
      background:var(--amber);
      border:1px solid var(--amber-border);
      color:var(--amber-text);
      border-radius:8px;
      padding:12px 16px;
      font-size:13.5px;
      margin-bottom:18px;
      line-height:1.5;
    }
    .beam-readout{
      display:flex;
      gap:16px;
      flex-wrap:wrap;
      margin-top:6px;
    }
    .beam-readout .stat .num{ font-size:20px; }
    .load-err{
      background:#fdecec;
      border:1px solid #f2b8c1;
      color:#a3273f;
      border-radius:8px;
      padding:10px 14px;
      font-size:13px;
      margin-bottom:16px;
      display:none;
    }
  </style>
</head>
<body>

<header>
  <h1>VL Beaming - Bally Jute Mill</h1>
  <nav>
    <button class="tab-btn active" data-tab="logbook">Log Book</button>
    <button class="tab-btn" data-tab="production">Production</button>
    <button class="tab-btn" data-tab="verification">Verification</button>
    <button class="tab-btn" data-tab="report">Report</button>
  </nav>
</header>

<main>

  <!-- ================= LOG BOOK ================= -->
  <section id="tab-logbook" class="tab-section active">
    <div class="card">
      <h2>Log Book Entry</h2>
      <p class="subtext">Fill in Date, Shift and Operator Name first — you'll be moved to the Production tab automatically so you can carry on there. Come back here any time to finish the rest and save.</p>

      <div class="grid">
        <div class="field">
          <label>Date <span class="req">*</span></label>
          <input type="date" id="lb-date">
        </div>
        <div class="field">
          <label>Shift <span class="req">*</span></label>
          <select id="lb-shift">
            <option value="">Select</option>
            <option value="A">A</option>
            <option value="B">B</option>
            <option value="C">C</option>
          </select>
        </div>
        <div class="field">
          <label>Operator / Staff Name <span class="req">*</span></label>
          <input type="text" id="lb-operator" placeholder="Staff / worker name">
        </div>
        <div class="field">
          <label>Batch</label>
          <input type="text" id="lb-batch" placeholder="Batch no.">
        </div>

        <div class="field">
          <label>Start Time</label>
          <input type="time" id="lb-start">
        </div>
        <div class="field">
          <label>End Time</label>
          <input type="time" id="lb-end">
        </div>
        <div class="field">
          <label>Hours Worked (auto)</label>
          <input type="text" id="lb-hours" placeholder="Pick start & end time" disabled>
        </div>
        <div class="field">
          <label>Detention Hours (manual)</label>
          <input type="number" step="0.1" id="lb-detention" placeholder="e.g. 0.5">
        </div>

        <div class="field full">
          <label>Idle Machine When Shift Will Be Changed</label>
          <input type="text" id="lb-idle" placeholder="Machine no. / reason">
        </div>
        <div class="field full">
          <label>If Batch Change</label>
          <input type="text" id="lb-batchchange" placeholder="New batch details">
        </div>
        <div class="field full">
          <label>Instruction Given by Senior</label>
          <textarea id="lb-instructions" placeholder="Notes / instructions..."></textarea>
        </div>
      </div>

      <div class="btn-row">
        <button class="btn" onclick="saveLogBook()">Save Entry</button>
        <button class="btn secondary" onclick="clearLogBook()">Clear</button>
        <span id="lb-msg" class="msg"></span>
      </div>
    </div>

    <div class="card">
      <h2>Recent Log Book Entries</h2>
      <div class="load-err" id="lb-load-err"></div>
      <div class="table-wrap">
        <table id="lb-table">
          <thead>
            <tr><th>Date</th><th>Shift</th><th>Operator</th><th>Batch</th><th>Start</th><th>End</th><th>Hours</th><th>Detention</th></tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ================= PRODUCTION ================= -->
  <section id="tab-production" class="tab-section">

    <div class="card">
      <h2>Beam Meter Tracking</h2>
      <p class="subtext">Length Target, Start Meter and Beam No are tracked automatically. Enter the current meter reading below and save. Use Stop when the beam is finished.</p>

      <div class="load-err" id="pr-load-err"></div>
      <div id="pr-alert" class="alert" style="display:none;"></div>

      <div class="checkbox-row">
        <input type="checkbox" id="pr-startnew" onchange="onStartNewToggle()">
        <label for="pr-startnew" style="margin:0;">Start New Beam</label>
      </div>

      <div class="grid">
        <div class="field">
          <label>Beam Number <span class="req">*</span></label>
          <input type="text" id="pr-beamno" placeholder="e.g. V17">
        </div>
        <div class="field">
          <label>Beam Type <span class="req">*</span></label>
          <select id="pr-beamtype">
            <option value="">Select</option>
            <option value="300">300</option>
            <option value="340">340</option>
            <option value="360">360</option>
          </select>
        </div>
        <div class="field">
          <label>No of Cart</label>
          <input type="number" step="1" min="0" id="pr-noofcart" placeholder="e.g. 8">
        </div>
        <div class="field">
          <label>Beam Meter Target (today's length limit) <span class="req">*</span></label>
          <input type="number" step="0.01" id="pr-target" disabled placeholder="e.g. 12020">
        </div>
        <div class="field">
          <label>Start Meter (auto - carried from last shift)</label>
          <input type="text" id="pr-startmeter" disabled>
        </div>

        <div class="field full">
          <label>End Meter (current reading now) <span class="req">*</span></label>
          <input type="number" step="0.01" id="pr-endmeter" placeholder="Reading off the machine">
        </div>
      </div>

      <div class="beam-readout">
        <div class="stat"><div class="num" id="pr-live-production">-</div><div class="lbl">Production This Entry</div></div>
        <div class="stat"><div class="num" id="pr-live-remaining">-</div><div class="lbl">Remaining to Target</div></div>
      </div>

      <hr style="border:none;border-top:1px solid var(--border);margin:22px 0;">

      <p class="subtext" style="margin:0 0 18px;">These carry over from your Log Book entry, plus the pre-beaming details for this round.</p>
      <div class="grid">
        <div class="field">
          <label>Date <span class="req">*</span></label>
          <input type="date" id="pr-date" disabled>
        </div>
        <div class="field">
          <label>Shift <span class="req">*</span></label>
          <input type="text" id="pr-shift" disabled>
        </div>
        <div class="field">
          <label>Operator Name <span class="req">*</span></label>
          <input type="text" id="pr-operator" disabled>
        </div>
        <div class="field">
          <label>Pre Beaming Round No <span class="req">*</span></label>
          <input type="text" id="pr-round">
        </div>
        <div class="field">
          <label>Sl No <span class="req">*</span></label>
          <input type="text" id="pr-slno">
        </div>
      </div>

      <div class="btn-row">
        <button class="btn" onclick="saveProduction(false)">Save Entry</button>
        <button class="btn stop" onclick="saveProduction(true)">Stop / Complete Round</button>
        <span id="pr-msg" class="msg"></span>
      </div>
    </div>

    <div class="card">
      <h2>Current Round Entries</h2>
      <p class="subtext">Entries for the beam currently in progress. Once a round is stopped/completed, it moves to the Verification tab and this list starts fresh empty for the new beam.</p>
      <div class="table-wrap">
        <table id="pr-table">
          <thead>
            <tr>
              <th>Date</th><th>Shift</th><th>Operator</th><th>Beam No</th><th>Beam Type</th><th>No of Cart</th>
              <th>Target</th><th>Start</th><th>End</th><th>Production</th><th>Cumulative</th><th>Status</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ================= VERIFICATION ================= -->
  <section id="tab-verification" class="tab-section">
    <div class="load-err" id="vf-load-err"></div>

    <div class="card">
      <h2>Round Summary</h2>
      <p class="subtext">Cumulative V/L Beam Length reached so far for every round (Beam No), against its target, plus Total Beam Length = Cumulative x No of Cart.</p>
      <div class="table-wrap">
        <table id="vf-round-table">
          <thead>
            <tr><th>Round No</th><th>Beam No</th><th>Beam Type</th><th>Cumulative V/L Beam Length</th><th>No of Cart</th><th>Total Beam Length</th><th>Entries</th><th>Status</th></tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
    </div>

    <div class="card">
      <h2>Shift Cumulative Production</h2>
      <p class="subtext">Running total of production for each shift, day over day.</p>
      <div class="table-wrap">
        <table id="vf-shift-table">
          <thead>
            <tr><th>Date</th><th>Shift</th><th>Production This Day</th><th>Cumulative Production (Shift)</th></tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
    </div>

    <div class="card">
      <h2>Entry Log</h2>
      <p class="subtext">Every production entry, in log-book order. Detention / hours are matched in from the Log Book by Date, Shift and Operator where available.</p>
      <div class="table-wrap">
        <table id="vf-table">
          <thead>
            <tr>
              <th>Beaming Sr No</th><th>Beam No</th><th>Beam Type</th><th>No of Cart</th><th>Cumulative V/L Beam Length</th>
              <th>Shift</th><th>Production (This Entry)</th><th>Hours Worked</th>
              <th>Detention</th><th>Reason of Detention</th><th>Operator Name</th><th>Status</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ================= REPORT ================= -->
  <section id="tab-report" class="tab-section">
    <div class="card">
      <h2>Report</h2>
      <p class="subtext">Filter Log Book and Production data by date range, shift, or operator.</p>

      <div class="grid" style="grid-template-columns:repeat(4,1fr);">
        <div class="field">
          <label>From Date</label>
          <input type="date" id="rp-from">
        </div>
        <div class="field">
          <label>To Date</label>
          <input type="date" id="rp-to">
        </div>
        <div class="field">
          <label>Shift</label>
          <select id="rp-shift">
            <option value="">All</option>
            <option value="A">A</option>
            <option value="B">B</option>
            <option value="C">C</option>
          </select>
        </div>
        <div class="field">
          <label>Operator</label>
          <select id="rp-operator">
            <option value="">All</option>
          </select>
        </div>
      </div>
      <div class="btn-row">
        <button class="btn" onclick="loadReport()">Apply Filters</button>
        <button class="btn secondary" onclick="resetReport()">Reset</button>
        <span id="rp-msg" class="msg"></span>
      </div>
    </div>

    <div class="card">
      <div class="totals" id="rp-totals"></div>

      <h2>Production <span class="badge" id="rp-prod-count">0</span></h2>
      <div class="table-wrap" style="margin-bottom:26px;">
        <table id="rp-prod-table">
          <thead>
            <tr>
              <th>Date</th><th>Shift</th><th>Operator</th><th>Beam No</th><th>Beam Type</th><th>No of Cart</th>
              <th>Target</th><th>Start</th><th>End</th><th>Production</th><th>Cumulative</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>

      <h2>Log Book <span class="badge" id="rp-log-count">0</span></h2>
      <div class="table-wrap">
        <table id="rp-log-table">
          <thead>
            <tr><th>Date</th><th>Shift</th><th>Operator</th><th>Batch</th><th>Start</th><th>End</th><th>Hours</th><th>Detention</th></tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
    </div>
  </section>

</main>

<script>
/* ---------------- TAB NAVIGATION ---------------- */
document.querySelectorAll('.tab-btn').forEach(function(btn){
  btn.addEventListener('click', function(){ switchTab(btn.dataset.tab); });
});

function switchTab(name){
  document.querySelectorAll('.tab-btn').forEach(function(b){
    b.classList.toggle('active', b.dataset.tab === name);
  });
  document.querySelectorAll('.tab-section').forEach(function(s){
    s.classList.toggle('active', s.id === 'tab-' + name);
  });
  if (name === 'production') { prefillProductionHeader(); loadRoundState(); loadProductionTable(); }
  if (name === 'verification') loadVerificationTable();
  if (name === 'report') { loadOperatorList(); loadReport(); }
  if (name === 'logbook') loadLogBookTable();
}

/* Shows a load-error banner near the relevant table instead of leaving it
   silently blank when a google.script.run call fails server-side. */
function showLoadError(bannerId, err){
  var el = document.getElementById(bannerId);
  if (!el) return;
  el.style.display = 'block';
  el.textContent = 'Could not load data: ' + (err && err.message ? err.message : err);
}
function clearLoadError(bannerId){
  var el = document.getElementById(bannerId);
  if (el) el.style.display = 'none';
}

/* ---------------- LOG BOOK ---------------- */
function calcHoursLocal(start,end){
  if(!start || !end) return '';
  var s = start.split(':').map(Number), e = end.split(':').map(Number);
  var sm = s[0]*60+s[1], em = e[0]*60+e[1];
  var diff = em - sm;
  if (diff < 0) diff += 24*60;
  return (diff/60).toFixed(2);
}

['lb-start','lb-end'].forEach(function(id){
  document.getElementById(id).addEventListener('change', updateHours);
});
function updateHours(){
  var start = document.getElementById('lb-start').value;
  var end = document.getElementById('lb-end').value;
  document.getElementById('lb-hours').value = calcHoursLocal(start,end) || '';
}

/* Auto-move to Production once Date, Shift, Operator are filled */
var autoMoved = false;
['lb-date','lb-shift','lb-operator'].forEach(function(id){
  document.getElementById(id).addEventListener('change', maybeAutoMove);
});
function maybeAutoMove(){
  var d = document.getElementById('lb-date').value;
  var s = document.getElementById('lb-shift').value;
  var o = document.getElementById('lb-operator').value.trim();
  if (d && s && o && !autoMoved) {
    autoMoved = true;
    prefillProductionHeader({date:d, shift:s, operatorName:o});
    switchTab('production');
  }
}

function saveLogBook(){
  var data = {
    date: document.getElementById('lb-date').value,
    shift: document.getElementById('lb-shift').value,
    operatorName: document.getElementById('lb-operator').value.trim(),
    batch: document.getElementById('lb-batch').value,
    startTime: document.getElementById('lb-start').value,
    endTime: document.getElementById('lb-end').value,
    detentionHours: document.getElementById('lb-detention').value,
    idleMachine: document.getElementById('lb-idle').value,
    batchChange: document.getElementById('lb-batchchange').value,
    instructions: document.getElementById('lb-instructions').value
  };
  if (!data.date || !data.shift || !data.operatorName) {
    setMsg('lb-msg', 'Date, Shift and Operator Name are required.', false);
    return;
  }
  setMsg('lb-msg', 'Saving...', true);
  google.script.run
    .withSuccessHandler(function(res){
      setMsg('lb-msg', 'Saved. Hours worked: ' + (res.hoursWorked || '-'), true);
      loadLogBookTable();
    })
    .withFailureHandler(function(err){ setMsg('lb-msg', err.message, false); })
    .saveLogBookEntry(data);
}

function clearLogBook(){
  ['lb-batch','lb-detention','lb-idle','lb-batchchange','lb-instructions'].forEach(function(id){
    document.getElementById(id).value = '';
  });
  document.getElementById('lb-start').value = '';
  document.getElementById('lb-end').value = '';
  document.getElementById('lb-hours').value = '';
  setMsg('lb-msg', '', true);
}

function loadLogBookTable(){
  clearLoadError('lb-load-err');
  google.script.run
    .withSuccessHandler(function(rows){
      var tbody = document.querySelector('#lb-table tbody');
      tbody.innerHTML = '';
      rows.slice(0,15).forEach(function(r){
        tbody.innerHTML += '<tr><td>'+r['Date']+'</td><td>'+r['Shift']+'</td><td>'+r['Operator Name']+'</td>' +
          '<td>'+(r['Batch']||'')+'</td><td>'+(r['Start Time']||'')+'</td><td>'+(r['End Time']||'')+'</td>' +
          '<td>'+(r['Hours Worked']||'')+'</td><td>'+(r['Detention Hours']||'')+'</td></tr>';
      });
    })
    .withFailureHandler(function(err){ showLoadError('lb-load-err', err); })
    .getLogBookData();
}

/* ---------------- PRODUCTION / BEAM METER TRACKING ---------------- */
var currentRoundState = null;

function prefillProductionHeader(info){
  if (info) {
    document.getElementById('pr-date').value = info.date;
    document.getElementById('pr-shift').value = info.shift;
    document.getElementById('pr-operator').value = info.operatorName;
    return;
  }
  google.script.run
    .withSuccessHandler(function(last){
      document.getElementById('pr-date').value = last.date || '';
      document.getElementById('pr-shift').value = last.shift || '';
      document.getElementById('pr-operator').value = last.operatorName || '';
    })
    .withFailureHandler(function(err){ showLoadError('pr-load-err', err); })
    .getLastLogBookInfo();
}

function loadRoundState(){
  clearLoadError('pr-load-err');
  google.script.run
    .withSuccessHandler(renderRoundState)
    .withFailureHandler(function(err){ showLoadError('pr-load-err', err); })
    .getRoundState();
}

function renderRoundState(state){
  currentRoundState = state;

  var checkbox = document.getElementById('pr-startnew');
  var alertBox = document.getElementById('pr-alert');

  if (!state.initialized) {
    checkbox.checked = true;
    checkbox.disabled = true;
    alertBox.style.display = 'block';
    alertBox.textContent = 'Starting a new beam — Start Meter is reset to 0. ' +
      'Enter the Beam Number and Beam Type for this beam, and the Length Target' +
      (state.target ? ' (previous target ' + state.target + ' shown as a suggestion)' : '') + '.';
    // Beam No / Beam Type are cleared - they identify a NEW physical beam,
    // so the previous round's values should not carry over automatically.
    document.getElementById('pr-beamno').value = '';
    document.getElementById('pr-beamtype').value = '';
    document.getElementById('pr-noofcart').value = '';
    document.getElementById('pr-target').value = state.target || '';
    document.getElementById('pr-startmeter').value = '0';
  } else {
    checkbox.checked = false;
    checkbox.disabled = false;
    alertBox.style.display = 'none';
    document.getElementById('pr-beamno').value = state.beamNo || '';
    document.getElementById('pr-beamtype').value = state.beamType || '';
    document.getElementById('pr-target').value = state.target || '';
    document.getElementById('pr-startmeter').value = state.startMeter;
  }
  onStartNewToggle();
  updateLiveProduction();
}

function onStartNewToggle(){
  var checked = document.getElementById('pr-startnew').checked;
  document.getElementById('pr-target').disabled = !checked;
  if (checked) {
    document.getElementById('pr-startmeter').value = '0';
  } else if (currentRoundState) {
    document.getElementById('pr-target').value = currentRoundState.target || '';
    document.getElementById('pr-startmeter').value = currentRoundState.startMeter;
  }
  updateLiveProduction();
}

document.getElementById('pr-endmeter').addEventListener('input', updateLiveProduction);

function updateLiveProduction(){
  var start = parseFloat(document.getElementById('pr-startmeter').value) || 0;
  var end = parseFloat(document.getElementById('pr-endmeter').value);
  var target = parseFloat(document.getElementById('pr-target').value);
  var prodEl = document.getElementById('pr-live-production');
  var remEl = document.getElementById('pr-live-remaining');
  if (isNaN(end)) {
    prodEl.textContent = '-';
    remEl.textContent = '-';
    return;
  }
  var production = end - start;
  prodEl.textContent = production.toFixed(2);
  remEl.textContent = isNaN(target) ? '-' : (target - end).toFixed(2);
}

function saveProduction(completeRound){
  var data = {
    date: document.getElementById('pr-date').value,
    shift: document.getElementById('pr-shift').value,
    operatorName: document.getElementById('pr-operator').value,
    preBeamingRoundNo: document.getElementById('pr-round').value.trim(),
    slNo: document.getElementById('pr-slno').value.trim(),
    startNew: document.getElementById('pr-startnew').checked,
    beamNo: document.getElementById('pr-beamno').value.trim(),
    beamType: document.getElementById('pr-beamtype').value,
    noOfCart: document.getElementById('pr-noofcart').value.trim(),
    target: document.getElementById('pr-target').value,
    endMeter: document.getElementById('pr-endmeter').value,
    completeRound: !!completeRound
  };
  if (!data.date || !data.shift || !data.operatorName || !data.preBeamingRoundNo || !data.slNo || !data.endMeter || !data.beamNo || !data.beamType) {
    setMsg('pr-msg', 'Please fill all mandatory fields.', false);
    return;
  }
  setMsg('pr-msg', 'Saving...', true);
  google.script.run
    .withSuccessHandler(function(res){
      if (res.roundCompleted) {
        setMsg('pr-msg', 'Beam ' + res.beamNo + ' completed at ' + res.cumulative + ' / ' + res.target + '. Starting new beam — check Verification for the finished round.', true);
      } else {
        setMsg('pr-msg', 'Saved. Production this entry: ' + res.production + ' (cumulative ' + res.cumulative + ' / ' + res.target + ')', true);
      }
      document.getElementById('pr-round').value = '';
      document.getElementById('pr-slno').value = '';
      document.getElementById('pr-endmeter').value = '';
      loadRoundState();
      loadProductionTable();
    })
    .withFailureHandler(function(err){ setMsg('pr-msg', err.message, false); })
    .saveProductionEntry(data);
}

function loadProductionTable(){
  clearLoadError('pr-load-err');
  google.script.run
    .withSuccessHandler(function(rows){
      var tbody = document.querySelector('#pr-table tbody');
      tbody.innerHTML = '';
      rows.slice(0,15).forEach(function(r){
        tbody.innerHTML += '<tr><td>'+r['Date']+'</td><td>'+r['Shift']+'</td><td>'+r['Operator Name']+'</td>' +
          '<td>'+r['Beam No']+'</td><td>'+r['Beam Type']+'</td><td>'+(r['No of Cart']||'')+'</td><td>'+r['Length Target']+'</td>' +
          '<td>'+r['Start Meter']+'</td><td>'+r['End Meter']+'</td>' +
          '<td>'+r['Production (Mtrs)']+'</td><td>'+r['Cumulative (Mtrs)']+'</td></tr>';
      });
    })
    .withFailureHandler(function(err){ showLoadError('pr-load-err', err); })
    .getOpenRoundEntries();
}

/* ---------------- VERIFICATION ---------------- */
function loadVerificationTable(){
  clearLoadError('vf-load-err');
  google.script.run
    .withSuccessHandler(function(res){
      renderRoundSummary(res.roundSummary);
      renderShiftCumulative(res.shiftCumulative);
      renderEntryLog(res.entries);
    })
    .withFailureHandler(function(err){ showLoadError('vf-load-err', err); })
    .getVerificationData();
}

function renderRoundSummary(rows){
  var tbody = document.querySelector('#vf-round-table tbody');
  tbody.innerHTML = '';
  rows.forEach(function(r){
    var badge = r.status === 'Completed'
      ? '<span class="badge done">Completed</span>'
      : '<span class="badge open">Open</span>';
    tbody.innerHTML += '<tr>' +
      '<td>'+r.roundNo+'</td>' +
      '<td>'+r.beamNo+'</td>' +
      '<td>'+r.beamType+'</td>' +
      '<td>'+r.cumulative+' / '+r.target+'</td>' +
      '<td>'+(r.noOfCart||'-')+'</td>' +
      '<td>'+r.totalBeamLength+'</td>' +
      '<td>'+r.entries+'</td>' +
      '<td>'+badge+'</td>' +
      '</tr>';
  });
}

function renderShiftCumulative(rows){
  var tbody = document.querySelector('#vf-shift-table tbody');
  tbody.innerHTML = '';
  rows.forEach(function(r){
    tbody.innerHTML += '<tr>' +
      '<td>'+r.date+'</td>' +
      '<td>'+r.shift+'</td>' +
      '<td>'+r.dayProduction+'</td>' +
      '<td>'+r.cumulativeProduction+'</td>' +
      '</tr>';
  });
}

function renderEntryLog(rows){
  var tbody = document.querySelector('#vf-table tbody');
  tbody.innerHTML = '';
  rows.forEach(function(r){
    var badge = r.roundStatus === 'Completed'
      ? '<span class="badge done">Completed</span>'
      : '<span class="badge open">Open</span>';
    tbody.innerHTML += '<tr>' +
      '<td>'+r.beamingSrNo+'</td>' +
      '<td>'+r.beamNo+'</td>' +
      '<td>'+r.beamType+'</td>' +
      '<td>'+(r.noOfCart||'-')+'</td>' +
      '<td>'+r.cumulative+' / '+r.lengthTarget+'</td>' +
      '<td>'+r.shift+'</td>' +
      '<td>'+r.production+'</td>' +
      '<td>'+(r.hoursWorked||'-')+'</td>' +
      '<td>'+(r.detentionHours||'-')+'</td>' +
      '<td>'+(r.idleMachine||'-')+'</td>' +
      '<td>'+r.operatorName+'</td>' +
      '<td>'+badge+'</td>' +
      '</tr>';
  });
}

/* ---------------- REPORT ---------------- */
function loadOperatorList(){
  google.script.run
    .withSuccessHandler(function(names){
      var sel = document.getElementById('rp-operator');
      var current = sel.value;
      sel.innerHTML = '<option value="">All</option>';
      names.forEach(function(n){
        var opt = document.createElement('option');
        opt.value = n; opt.textContent = n;
        sel.appendChild(opt);
      });
      sel.value = current;
    })
    .withFailureHandler(function(err){ setMsg('rp-msg', err.message, false); })
    .getOperatorList();
}

function loadReport(){
  var filters = {
    fromDate: document.getElementById('rp-from').value,
    toDate: document.getElementById('rp-to').value,
    shift: document.getElementById('rp-shift').value,
    operatorName: document.getElementById('rp-operator').value
  };
  setMsg('rp-msg', 'Loading...', true);
  google.script.run
    .withSuccessHandler(function(res){
      setMsg('rp-msg', '', true);
      renderTotals(res.totals);
      renderReportTable('rp-prod-table', res.production,
        ['Date','Shift','Operator Name','Beam No','Beam Type','No of Cart','Length Target','Start Meter','End Meter','Production (Mtrs)','Cumulative (Mtrs)']);
      renderReportTable('rp-log-table', res.logbook,
        ['Date','Shift','Operator Name','Batch','Start Time','End Time','Hours Worked','Detention Hours']);
      document.getElementById('rp-prod-count').textContent = res.production.length;
      document.getElementById('rp-log-count').textContent = res.logbook.length;
    })
    .withFailureHandler(function(err){ setMsg('rp-msg', err.message, false); })
    .getReportSummary(filters);
}

function resetReport(){
  document.getElementById('rp-from').value = '';
  document.getElementById('rp-to').value = '';
  document.getElementById('rp-shift').value = '';
  document.getElementById('rp-operator').value = '';
  loadReport();
}

function renderTotals(t){
  document.getElementById('rp-totals').innerHTML =
    stat(t.totalProduction, 'Total Production (Mtrs)') +
    stat(t.totalHours, 'Total Hours Worked') +
    stat(t.totalDetention, 'Total Detention Hours') +
    stat(t.entries, 'Production Entries');
}
function stat(num, lbl){
  return '<div class="stat"><div class="num">'+num+'</div><div class="lbl">'+lbl+'</div></div>';
}

function renderReportTable(tableId, rows, cols){
  var tbody = document.querySelector('#'+tableId+' tbody');
  tbody.innerHTML = '';
  rows.forEach(function(r){
    var tr = '<tr>' + cols.map(function(c){ return '<td>'+(r[c]!==undefined?r[c]:'')+'</td>'; }).join('') + '</tr>';
    tbody.innerHTML += tr;
  });
}

/* ---------------- SHARED ---------------- */
function setMsg(id, text, ok){
  var el = document.getElementById(id);
  el.textContent = text;
  el.className = 'msg ' + (ok ? 'ok' : 'err');
}

/* ---------------- INIT ---------------- */
window.addEventListener('load', function(){
  loadLogBookTable();
  loadProductionTable();
});
</script>
</body>
</html>

