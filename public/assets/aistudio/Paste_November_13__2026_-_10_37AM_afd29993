      white-space:nowrap;
    }
    nav.tabs{ display:flex; gap:4px; flex:1; flex-wrap:wrap; }
    nav.tabs button{
      background:transparent;
      border:none;
      color:#c7d2e8;
      font-family:inherit;
      font-size:14.5px;
      font-weight:600;
      padding:18px 16px;
      cursor:pointer;
      border-bottom:3px solid transparent;
    }
    nav.tabs button:hover{ color:#fff; }
    nav.tabs button.active{ color:#fff; border-bottom-color:#4d8dff; }

    main{ max-width:1180px; margin:28px auto; padding:0 20px 60px; }
    .card{
      background:var(--card);
      border:1px solid var(--border);
      border-radius:var(--radius);
      padding:28px 30px;
      box-shadow:0 1px 3px rgba(20,25,40,.04);
    }
    .card + .card{ margin-top:20px; }
    .card h2{ margin:0 0 4px; font-size:20px; color:var(--navy); font-weight:800; }
    .card p.hint{ margin:0 0 22px; color:var(--text-dim); font-size:13.5px; line-height:1.5; }
    .grid{ display:grid; grid-template-columns:repeat(4,1fr); gap:18px 22px; }
    .grid.cols-3{ grid-template-columns:repeat(3,1fr); }
    .grid.cols-4{ grid-template-columns:repeat(4,1fr); }
    .field{ display:flex; flex-direction:column; gap:6px; }
    .field.span-2{ grid-column:span 2; }
    .field.span-4{ grid-column:span 4; }
    label{ font-size:13px; font-weight:700; color:var(--navy); }
    input, select, textarea{
      font-family:inherit;
      font-size:14px;
      padding:10px 12px;
      border:1px solid var(--border);
      border-radius:8px;
      background:#fff;
      color:var(--text);
      outline:none;
    }
    input:focus, select:focus, textarea:focus{
      border-color:var(--blue);
      box-shadow:0 0 0 3px rgba(43,99,201,.14);
    }
    input[readonly]{ background:#f4f6fa; color:var(--text-dim); font-family:'JetBrains Mono',monospace; font-weight:600; }
    textarea{ resize:vertical; min-height:78px; }

    .actions{ display:flex; gap:10px; margin-top:24px; flex-wrap:wrap; align-items:center; }
    button.btn{
      font-family:inherit;
      font-weight:700;
      font-size:14px;
      padding:11px 22px;
      border-radius:8px;
      border:1px solid transparent;
      cursor:pointer;
    }
    .btn-save{ background:var(--blue); color:#fff; }
    .btn-stop{ background:var(--red); color:#fff; }
    .btn-clear{ background:#fff; color:var(--text-dim); border-color:var(--border); }
    .btn-ghost{ background:var(--blue-light); color:var(--blue); }
    .btn-chip{
      background:#fff; color:var(--navy); border-color:var(--border);
      padding:8px 14px; font-size:13px;
    }
    .btn-chip.active{ background:var(--blue); color:#fff; border-color:var(--blue); }

    .badge-row{ display:flex; gap:10px; align-items:center; flex-wrap:wrap; margin-bottom:20px; }
    .badge{
      display:inline-flex;
      align-items:center;
      gap:7px;
      background:var(--blue-light);
      color:var(--blue);
      font-weight:700;
      font-size:13px;
      padding:7px 13px;
      border-radius:999px;
    }
    .badge.round{ background:#fdeee9; color:#b23a1c; }

    .toast{
      position:fixed;
      top:20px; right:20px;
      background:var(--navy-dark);
      color:#fff;
      padding:13px 18px;
      border-radius:9px;
      font-size:14px;
      font-weight:600;
      box-shadow:0 6px 20px rgba(0,0,0,.2);
      opacity:0;
      transform:translateY(-8px);
      pointer-events:none;
      transition:opacity .2s ease, transform .2s ease;
      z-index:999;
      max-width:340px;
    }
    .toast.show{ opacity:1; transform:translateY(0); }
    .toast.error{ background:var(--red); }
    .toast.success{ background:var(--green); }

    table{ width:100%; border-collapse:collapse; font-size:13.5px; }
    thead th{
      text-align:left;
      background:#f4f6fa;
      color:var(--navy);
      font-weight:700;
      padding:10px 12px;
      border-bottom:2px solid var(--border);
      white-space:nowrap;
    }
    tbody td{ padding:10px 12px; border-bottom:1px solid var(--border); color:var(--text); white-space:nowrap; }
    tbody tr:last-child td{ border-bottom:none; }
    tbody tr:hover td{ background:#f7f9fd; }
    .table-wrap{ overflow-x:auto; border-radius:8px; border:1px solid var(--border); }
    tr.total-row td{ font-weight:800; background:#f4f6fa; border-top:2px solid var(--border); color:var(--navy); }
    .empty{ color:var(--text-dim); font-size:13.5px; padding:22px; text-align:center; }
    .pill-open{
      display:inline-block;
      font-size:11px;
      font-weight:700;
      color:var(--green);
      background:var(--green-light);
      padding:2px 9px;
      border-radius:999px;
    }

    .stat-grid{ display:grid; grid-template-columns:repeat(5,1fr); gap:14px; margin-bottom:26px; }
    .stat{
      position:relative;
      overflow:hidden;
      background:linear-gradient(160deg,#fff, #f7f9fd);
      border:1px solid var(--border);
      border-radius:10px;
      padding:16px 18px 16px 22px;
    }
    .stat::before{ content:''; position:absolute; left:0; top:0; bottom:0; width:4px; }
    .stat.c1::before{ background:var(--blue); }
    .stat.c2::before{ background:var(--green); }
    .stat.c3::before{ background:var(--amber); }
    .stat.c4::before{ background:var(--purple); }
    .stat.c5::before{ background:var(--red); }
    .stat .num{ font-size:22px; font-weight:800; color:var(--navy); font-family:'JetBrains Mono',monospace; line-height:1.2; word-break:break-word; }
    .stat .lbl{ font-size:11.5px; color:var(--text-dim); font-weight:700; margin-top:3px; text-transform:uppercase; letter-spacing:.03em; }

    .section-title{ font-size:15px; font-weight:800; color:var(--navy); margin:26px 0 12px; display:flex; align-items:center; gap:8px; }
