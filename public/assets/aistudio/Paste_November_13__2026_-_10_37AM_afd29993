  <button id="tab-report" onclick="showMainTab('report')">&#128196; Report</button>
</div>

<!-- ================= LOG BOOK ================= -->
<div id="page-logbook" class="page active">
  <div class="card">
    <div class="form-row">
      <div class="form-group">
        <label>Date</label>
        <input type="date" id="lb_date">
      </div>
      <div class="form-group">
        <label>Shift</label>
        <select id="lb_shift"><option>A</option><option>B</option><option>C</option></select>
      </div>
      <div class="form-group">
