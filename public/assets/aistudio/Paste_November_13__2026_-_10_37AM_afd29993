    .section-title .count-pill{ font-size:11.5px; font-weight:700; color:var(--text-dim); background:#f0f2f6; padding:2px 9px; border-radius:999px; }
    .refresh-row{ display:flex; justify-content:space-between; align-items:center; margin-bottom:18px; flex-wrap:wrap; gap:10px; }
    .tag{ font-family:'JetBrains Mono',monospace; font-size:12px; background:#f4f6fa; padding:2px 7px; border-radius:5px; color:var(--text-dim); }
    .pill-open{
