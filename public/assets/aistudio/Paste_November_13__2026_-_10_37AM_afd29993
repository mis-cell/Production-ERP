<!DOCTYPE html>
<html>
<head>
  <base target="_top">
  <meta charset="utf-8">
  <title>VL Loom Dept ERP</title>
  <style>
    :root{
      --navy:#1e3a8a;
      --navy-dark:#152a63;
      --accent:#2563eb;
      --green:#16a34a;
      --red:#dc2626;
      --border:#dfe3ea;
      --bg:#f2f4f8;
      --text:#1f2937;
      --muted:#6b7280;
    }
    *{box-sizing:border-box;}
    body{
      margin:0; font-family:'Segoe UI',Arial,sans-serif; background:var(--bg); color:var(--text);
    }
    header.top{
      background:var(--navy); color:#fff; padding:14px 20px;
      display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap;
    }
    header.top h1{ font-size:18px; margin:0; font-weight:600; }
    header.top .sub{ font-size:12px; opacity:.8; }
    nav.tabs{
      background:var(--navy); display:flex; gap:4px; padding:0 16px;
      border-top:1px solid rgba(255,255,255,.15);
    }
    nav.tabs button{
      background:transparent; border:none; color:#cdd6f4; padding:12px 18px;
      font-size:14px; cursor:pointer; border-bottom:3px solid transparent;
    }
    nav.tabs button.active{ color:#fff; border-bottom:3px solid #fff; font-weight:600; }
    nav.tabs button:hover{ color:#fff; }

    main{ max-width:1100px; margin:20px auto; padding:0 16px 60px; }
    .card{
      background:#fff; border:1px solid var(--border); border-radius:10px;
      padding:22px; margin-bottom:20px; box-shadow:0 1px 2px rgba(0,0,0,.04);
    }
    .card h2{ margin:0 0 4px; font-size:18px; color:var(--navy-dark); }
    .card p.hint{ margin:0 0 18px; font-size:13px; color:var(--muted); }

    .grid{
      display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:16px;
    }
    label{ font-size:13px; font-weight:600; color:#334155; display:block; margin-bottom:6px; }
    input, select, textarea{
      width:100%; padding:9px 10px; border:1px solid var(--border); border-radius:6px;
      font-size:14px; font-family:inherit; background:#fff;
    }
    textarea{ resize:vertical; min-height:70px; }
    .field{ margin-bottom:0; }

    table.rowtable{ width:100%; border-collapse:collapse; margin-top:16px; }
    table.rowtable th{
      text-align:left; font-size:12px; color:var(--muted); text-transform:uppercase;
      padding:6px 8px; border-bottom:2px solid var(--border);
    }
    table.rowtable td{ padding:6px 8px; border-bottom:1px solid var(--border); }
    table.rowtable input{ padding:7px 8px; }
    .rm-btn{
      background:#fee2e2; color:var(--red); border:none; border-radius:6px;
      width:30px; height:30px; cursor:pointer; font-size:16px; line-height:1;
    }
    .add-row-btn{
      margin-top:10px; background:#eef2ff; color:var(--accent); border:1px dashed var(--accent);
      padding:8px 14px; border-radius:6px; cursor:pointer; font-size:13px; font-weight:600;
    }
    .actions{ margin-top:20px; display:flex; gap:10px; }
    .btn{
      padding:10px 20px; border:none; border-radius:6px; font-size:14px; font-weight:600;
      cursor:pointer;
    }
    .btn-save{ background:var(--green); color:#fff; }
    .btn-save:hover{ background:#128a3e; }
    .btn-clear{ background:#e5e7eb; color:#374151; }
    .btn-clear:hover{ background:#d1d5db; }
    .btn-secondary{ background:var(--accent); color:#fff; }

    .toast{
      position:fixed; top:16px; right:16px; background:var(--green); color:#fff;
      padding:12px 18px; border-radius:8px; font-size:14px; box-shadow:0 4px 12px rgba(0,0,0,.15);
      display:none; z-index:999;
    }
    .toast.error{ background:var(--red); }

    .filter-bar{ display:flex; gap:12px; align-items:flex-end; margin-bottom:16px; flex-wrap:wrap; }
    .filter-bar .field{ min-width:160px; }

    .entry-card{
      border:1px solid var(--border); border-radius:8px; padding:14px 16px; margin-bottom:12px;
      background:#fafbfe;
    }
    .entry-card .meta{ font-size:12px; color:var(--muted); margin-bottom:8px; }
    .entry-card table{ width:100%; border-collapse:collapse; font-size:13px; }
    .entry-card table td{ padding:4px 6px; }
    .badge{
      display:inline-block; background:var(--navy); color:#fff; font-size:11px;
      padding:2px 8px; border-radius:12px; margin-right:6px;
    }
    .del-link{ float:right; color:var(--red); font-size:12px; cursor:pointer; text-decoration:underline; }

    .summary-grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:14px; margin-bottom:20px; }
    .summary-box{ background:#eef2ff; border-radius:8px; padding:14px; text-align:center; }
    .summary-box .num{ font-size:24px; font-weight:700; color:var(--navy-dark); }
    .summary-box .lbl{ font-size:12px; color:var(--muted); margin-top:4px; }

    table.report-table{ width:100%; border-collapse:collapse; }
    table.report-table th{
      background:var(--navy); color:#fff; padding:8px 10px; font-size:12px; text-align:left;
    }
    table.report-table td{ padding:7px 10px; border-bottom:1px solid var(--border); font-size:13px; }
    table.report-table tr:nth-child(even){ background:#f8fafc; }

    .empty-state{ text-align:center; color:var(--muted); padding:30px; font-size:13px; }
    .loading{ text-align:center; color:var(--muted); padding:20px; font-size:13px; }
  </style>
</head>
<body>

  <header class="top">
    <div>
      <h1>VL Loom Department — Bally Jute Mill</h1>
      <div class="sub">ERP · Logbook · Production · Report</div>
    </div>
  </header>

  <nav class="tabs">
    <button class="tab-btn active" data-tab="logbook">📘 Log Book</button>
    <button class="tab-btn" data-tab="production">⚙️ Production</button>
    <button class="tab-btn" data-tab="report">📊 Report</button>
  </nav>

  <div class="toast" id="toast"></div>

  <main>

    <!-- ================= LOGBOOK TAB ================= -->
    <section id="tab-logbook" class="tab-panel">
      <div class="card">
        <h2>Log Book Entry</h2>
        <p class="hint">Fill this in first at the start of every round / shift. Add multiple operator + machine rows using "+ Add Row".</p>

        <div class="grid">
          <div class="field">
            <label>Date</label>
            <input type="date" id="lb-date">
          </div>
          <div class="field">
            <label>Shift</label>
            <select id="lb-shift">
              <option value="A">A</option>
              <option value="B">B</option>
              <option value="C">C</option>
            </select>
          </div>
          <div class="field">
            <label>Hours Worked</label>
            <input type="number" id="lb-hours" placeholder="e.g. 8">
          </div>
          <div class="field">
            <label>Idle Machine When Shift Will Be Changed</label>
            <input type="text" id="lb-idle" placeholder="Machine no(s)">
          </div>
          <div class="field">
            <label>Batch</label>
            <input type="text" id="lb-batch" placeholder="Batch no">
          </div>
          <div class="field">
            <label>If Batch Change</label>
            <input type="text" id="lb-batchchange" placeholder="New batch no">
          </div>
        </div>

        <div class="field" style="margin-top:16px;">
          <label>Instruction Given by Senior</label>
          <textarea id="lb-instructions" placeholder="Instructions..."></textarea>
        </div>

        <table class="rowtable" id="lb-rowtable">
          <thead>
            <tr>
              <th style="width:40%">Operator / Staff Name</th>
              <th style="width:40%">Machine No.</th>
              <th style="width:10%"></th>
            </tr>
          </thead>
          <tbody id="lb-rows"></tbody>
        </table>
        <button class="add-row-btn" id="lb-add-row">+ Add Row</button>

        <div class="actions">
          <button class="btn btn-save" id="lb-save">Save</button>
          <button class="btn btn-clear" id="lb-clear">Clear</button>
        </div>
      </div>

      <div class="card">
        <h2>Recent Log Book Entries</h2>
        <div class="filter-bar">
          <div class="field">
            <label>Filter by date</label>
            <input type="date" id="lb-filter-date">
          </div>
          <button class="btn btn-secondary" id="lb-filter-btn">Filter</button>
          <button class="btn btn-clear" id="lb-filter-clear">Show All</button>
        </div>
        <div id="lb-list"><div class="loading">Loading...</div></div>
      </div>
    </section>

    <!-- ================= PRODUCTION TAB ================= -->
    <section id="tab-production" class="tab-panel" style="display:none;">
      <div class="card">
        <h2>Production Entry</h2>
        <p class="hint">
          Enter the cumulative meter reading for each machine per shift (A / B / C). Production is
          calculated automatically: A = A − previous reading, B = B − A, C = C − B.
        </p>

        <div class="grid" style="max-width:260px;">
          <div class="field">
            <label>Date</label>
            <input type="date" id="pr-date">
          </div>
        </div>

        <table class="rowtable" id="pr-rowtable">
          <thead>
            <tr>
              <th style="width:20%">Machine No.</th>
              <th style="width:22%">A Reading</th>
              <th style="width:22%">B Reading</th>
              <th style="width:22%">C Reading</th>
              <th style="width:8%"></th>
            </tr>
          </thead>
          <tbody id="pr-rows"></tbody>
        </table>
        <button class="add-row-btn" id="pr-add-row">+ Add Row</button>

        <div class="actions">
          <button class="btn btn-save" id="pr-save">Save &amp; Calculate</button>
          <button class="btn btn-clear" id="pr-clear">Clear</button>
        </div>
      </div>

      <div class="card">
        <h2>Production Entries</h2>
        <div class="filter-bar">
          <div class="field">
            <label>Filter by date</label>
            <input type="date" id="pr-filter-date">
          </div>
          <button class="btn btn-secondary" id="pr-filter-btn">Filter</button>
          <button class="btn btn-clear" id="pr-filter-clear">Show All</button>
        </div>
        <div id="pr-list"><div class="loading">Loading...</div></div>
      </div>
    </section>

    <!-- ================= REPORT TAB ================= -->
    <section id="tab-report" class="tab-panel" style="display:none;">
      <div class="card">
        <h2>Report</h2>
        <p class="hint">Select a date range to see machine-wise production totals.</p>
        <div class="filter-bar">
          <div class="field">
            <label>From</label>
            <input type="date" id="rp-from">
          </div>
          <div class="field">
            <label>To</label>
            <input type="date" id="rp-to">
          </div>
          <button class="btn btn-secondary" id="rp-generate">Generate Report</button>
        </div>

        <div id="rp-summary"></div>
        <div id="rp-content"></div>
      </div>
    </section>

  </main>

<script>
/* ============================================================
 *  GLOBAL STATE / UTILS
 * ============================================================ */
function todayStr(){
  const d = new Date();
  return d.toISOString().slice(0,10);
}
function showToast(msg, isError){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.className = 'toast' + (isError ? ' error' : '');
  t.style.display = 'block';
  setTimeout(() => t.style.display = 'none', 2500);
}
function callServer(fnName, args, onSuccess, onError){
  google.script.run
    .withSuccessHandler(onSuccess)
    .withFailureHandler(err => {
      console.error(err);
      showToast('Error: ' + (err && err.message ? err.message : err), true);
      if (onError) onError(err);
    })[fnName].apply(null, args || []);
}

/* ============================================================
 *  TAB NAVIGATION
 * ============================================================ */
document.querySelectorAll('.tab-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.tab-panel').forEach(p => p.style.display = 'none');
    btn.classList.add('active');
    document.getElementById('tab-' + btn.dataset.tab).style.display = 'block';
    if (btn.dataset.tab === 'production') loadProductionList();
    if (btn.dataset.tab === 'logbook') loadLogbookList();
  });
});

/* ============================================================
 *  LOGBOOK MODULE
 * ============================================================ */
function lbAddRow(operatorName, machineNo){
  const tbody = document.getElementById('lb-rows');
  const tr = document.createElement('tr');
  tr.innerHTML = `
    <td><input type="text" class="lb-operator" placeholder="Operator name" value="${operatorName||''}"></td>
    <td><input type="text" class="lb-machine" placeholder="Machine no" value="${machineNo||''}"></td>
    <td><button class="rm-btn" onclick="this.closest('tr').remove()">×</button></td>
  `;
  tbody.appendChild(tr);
}
document.getElementById('lb-add-row').addEventListener('click', () => lbAddRow());

function lbClearForm(){
  document.getElementById('lb-date').value = todayStr();
  document.getElementById('lb-shift').value = 'A';
  document.getElementById('lb-hours').value = '';
  document.getElementById('lb-idle').value = '';
  document.getElementById('lb-batch').value = '';
  document.getElementById('lb-batchchange').value = '';
  document.getElementById('lb-instructions').value = '';
  document.getElementById('lb-rows').innerHTML = '';
  lbAddRow();
}
document.getElementById('lb-clear').addEventListener('click', lbClearForm);

document.getElementById('lb-save').addEventListener('click', () => {
  const rows = [];
  document.querySelectorAll('#lb-rows tr').forEach(tr => {
    const operatorName = tr.querySelector('.lb-operator').value.trim();
    const machineNo = tr.querySelector('.lb-machine').value.trim();
    if (operatorName || machineNo) rows.push({operatorName, machineNo});
  });
  const data = {
    date: document.getElementById('lb-date').value,
    shift: document.getElementById('lb-shift').value,
    hoursWorked: document.getElementById('lb-hours').value,
    idleMachine: document.getElementById('lb-idle').value,
    batch: document.getElementById('lb-batch').value,
    batchChange: document.getElementById('lb-batchchange').value,
    instructions: document.getElementById('lb-instructions').value,
    rows: rows
  };
  if (!data.date){ showToast('Please select a date', true); return; }

  callServer('saveLogbookEntry', [data], () => {
    showToast('Log book entry saved');
    lbClearForm();
    loadLogbookList();
  });
});

function loadLogbookList(filterDate){
  document.getElementById('lb-list').innerHTML = '<div class="loading">Loading...</div>';
  callServer('getLogbookEntries', [filterDate || null], (groups) => {
    const el = document.getElementById('lb-list');
    if (!groups.length){ el.innerHTML = '<div class="empty-state">No log book entries yet.</div>'; return; }
    el.innerHTML = groups.map(g => `
      <div class="entry-card">
        <span class="del-link" onclick="deleteLogbookGroup('${g.groupId}')">Delete</span>
        <div class="meta">
          <span class="badge">${g.date}</span>
          <span class="badge">Shift ${g.shift}</span>
          Hours: ${g.hoursWorked || '-'} &nbsp;|&nbsp; Batch: ${g.batch || '-'}
          ${g.batchChange ? ' → ' + g.batchChange : ''}
          ${g.idleMachine ? ' &nbsp;|&nbsp; Idle: ' + g.idleMachine : ''}
        </div>
        ${g.instructions ? `<div style="font-size:13px;margin-bottom:8px;"><em>${g.instructions}</em></div>` : ''}
        <table>
          <tr><td style="font-weight:600;">Operator</td><td style="font-weight:600;">Machine No.</td></tr>
          ${g.rows.map(r => `<tr><td>${r.operatorName || '-'}</td><td>${r.machineNo || '-'}</td></tr>`).join('')}
        </table>
      </div>
    `).join('');
  });
}
function deleteLogbookGroup(groupId){
  if (!confirm('Delete this log book entry?')) return;
  callServer('deleteLogbookGroup', [groupId], () => {
    showToast('Deleted');
    loadLogbookList();
  });
}
document.getElementById('lb-filter-btn').addEventListener('click', () => {
  loadLogbookList(document.getElementById('lb-filter-date').value);
});
document.getElementById('lb-filter-clear').addEventListener('click', () => {
  document.getElementById('lb-filter-date').value = '';
  loadLogbookList();
});

/* ============================================================
 *  PRODUCTION MODULE
 * ============================================================ */
function prAddRow(machineNo, a, b, c){
  const tbody = document.getElementById('pr-rows');
  const tr = document.createElement('tr');
  tr.innerHTML = `
    <td><input type="text" class="pr-machine" placeholder="e.g. 1" value="${machineNo||''}"></td>
    <td><input type="number" class="pr-a" placeholder="A reading" value="${a!==undefined?a:''}"></td>
    <td><input type="number" class="pr-b" placeholder="B reading" value="${b!==undefined?b:''}"></td>
    <td><input type="number" class="pr-c" placeholder="C reading" value="${c!==undefined?c:''}"></td>
    <td><button class="rm-btn" onclick="this.closest('tr').remove()">×</button></td>
  `;
  tbody.appendChild(tr);
}
document.getElementById('pr-add-row').addEventListener('click', () => prAddRow());

function prClearForm(){
  document.getElementById('pr-date').value = todayStr();
  document.getElementById('pr-rows').innerHTML = '';
  prAddRow();
}
document.getElementById('pr-clear').addEventListener('click', prClearForm);

document.getElementById('pr-save').addEventListener('click', () => {
  const rows = [];
  document.querySelectorAll('#pr-rows tr').forEach(tr => {
    const machineNo = tr.querySelector('.pr-machine').value.trim();
    const a = tr.querySelector('.pr-a').value;
    const b = tr.querySelector('.pr-b').value;
    const c = tr.querySelector('.pr-c').value;
    if (machineNo) rows.push({machineNo, a, b, c});
  });
  const date = document.getElementById('pr-date').value;
  if (!date){ showToast('Please select a date', true); return; }
  if (!rows.length){ showToast('Add at least one machine row', true); return; }

  callServer('saveProductionEntry', [{date, rows}], (res) => {
    showToast('Production saved & calculated');
    prClearForm();
    loadProductionList();
  });
});

function loadProductionList(filterDate){
  document.getElementById('pr-list').innerHTML = '<div class="loading">Loading...</div>';
  callServer('getProductionEntries', [filterDate || null], (entries) => {
    const el = document.getElementById('pr-list');
    if (!entries.length){ el.innerHTML = '<div class="empty-state">No production entries yet.</div>'; return; }
    el.innerHTML = `
      <table class="report-table">
        <thead>
          <tr>
            <th>Date</th><th>Machine</th>
            <th>A Reading</th><th>A Prod</th>
            <th>B Reading</th><th>B Prod</th>
            <th>C Reading</th><th>C Prod</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          ${entries.map(e => `
            <tr>
              <td>${e.date}</td><td>${e.machineNo}</td>
              <td>${e.a ?? ''}</td><td>${e.aProd ?? ''}</td>
              <td>${e.b ?? ''}</td><td>${e.bProd ?? ''}</td>
              <td>${e.c ?? ''}</td><td>${e.cProd ?? ''}</td>
              <td><span class="del-link" onclick="deleteProductionRow('${e.rowId}')">Delete</span></td>
            </tr>
          `).join('')}
        </tbody>
      </table>
    `;
  });
}
function deleteProductionRow(rowId){
  if (!confirm('Delete this production row?')) return;
  callServer('deleteProductionRow', [rowId], () => {
    showToast('Deleted');
    loadProductionList();
  });
}
document.getElementById('pr-filter-btn').addEventListener('click', () => {
  loadProductionList(document.getElementById('pr-filter-date').value);
});
document.getElementById('pr-filter-clear').addEventListener('click', () => {
  document.getElementById('pr-filter-date').value = '';
  loadProductionList();
});

/* ============================================================
 *  REPORT MODULE
 * ============================================================ */
document.getElementById('rp-generate').addEventListener('click', () => {
  const from = document.getElementById('rp-from').value;
  const to = document.getElementById('rp-to').value;
  if (!from || !to){ showToast('Select both From and To dates', true); return; }
  document.getElementById('rp-summary').innerHTML = '<div class="loading">Generating...</div>';
  document.getElementById('rp-content').innerHTML = '';

  callServer('getReportData', [from, to], (data) => {
    document.getElementById('rp-summary').innerHTML = `
      <div class="summary-grid">
        <div class="summary-box"><div class="num">${data.grandTotal}</div><div class="lbl">Total Production</div></div>
        <div class="summary-box"><div class="num">${data.machineTotals.length}</div><div class="lbl">Machines Reported</div></div>
        <div class="summary-box"><div class="num">${data.logCount}</div><div class="lbl">Log Book Entries</div></div>
      </div>
    `;

    let html = `<h3 style="margin-top:0;color:#152a63;">Machine-wise Totals</h3>`;
    if (!data.machineTotals.length){
      html += `<div class="empty-state">No production data in this range.</div>`;
    } else {
      html += `
        <table class="report-table">
          <thead><tr><th>Machine</th><th>A Total</th><th>B Total</th><th>C Total</th><th>Total Production</th><th>Days Logged</th></tr></thead>
          <tbody>
            ${data.machineTotals.map(m => `
              <tr>
                <td>${m.machineNo}</td><td>${m.totalA}</td><td>${m.totalB}</td><td>${m.totalC}</td>
                <td><strong>${m.totalProd}</strong></td><td>${m.days}</td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      `;
    }
    document.getElementById('rp-content').innerHTML = html;
  });
});

/* ============================================================
 *  INIT
 * ============================================================ */
window.addEventListener('DOMContentLoaded', () => {
  lbClearForm();
  prClearForm();
  document.getElementById('rp-from').value = todayStr();
  document.getElementById('rp-to').value = todayStr();
  loadLogbookList();
});
</script>

</body>
</html>
