            '</tr>';
        }
        body.innerHTML = html;
      });
    }

    // ---------- VERIFICATION ----------
    function buildDateRoundShiftSummary(entries) {
      var groups = {};
      var order = [];
      entries.forEach(function (e) {
        var date = fmtDate(e['Date']) || '(no date)';
        var round = (e['Round ID'] === '' || e['Round ID'] === undefined || e['Round ID'] === null) ? '(none)' : e['Round ID'];
        var shift = e['Shift'] || '(none)';
        var key = date + '|' + round + '|' + shift;
        if (!groups[key]) {
          groups[key] = {
            date: date, round: round, shift: shift,
            entries: 0, totalCuts: 0, totalProduction: 0, lengthValues: []
          };
          order.push(key);
        }
        var g = groups[key];
        g.entries += 1;
        g.totalCuts += Number(e['No of Cuts']) || 0;
        g.totalProduction += Number(e['Production']) || 0;
        if (e['Length per Cut'] !== '' && g.lengthValues.indexOf(e['Length per Cut']) === -1) g.lengthValues.push(e['Length per Cut']);
      });
      var list = order.map(function (k) { return groups[k]; });
      list.sort(function (a, b) {
        if (a.date !== b.date) return a.date < b.date ? 1 : -1; // newest date first
        var rd = Number(b.round) - Number(a.round);
        if (!isNaN(rd) && rd !== 0) return rd;
        return String(a.shift).localeCompare(String(b.shift));
      });
      return list;
    }

    function loadVerification() {
      var container = byId('ver-tables-container');
      var summaryBody = byId('ver-summary-body');
      var drsBody = byId('ver-drs-body');
      container.innerHTML = '<div class="empty">Loading...</div>';
      summaryBody.innerHTML = '<tr><td class="empty" colspan="6">Loading...</td></tr>';
      drsBody.innerHTML = '<tr><td class="empty" colspan="7">Loading...</td></tr>';
      callServer('getReportData', [], function (res) {
        if (!res.ok) {
          container.innerHTML = '<div class="empty">Could not load data: ' + res.error + '</div>';
          summaryBody.innerHTML = '<tr><td class="empty" colspan="6">Could not load data: ' + res.error + '</td></tr>';
          drsBody.innerHTML = '<tr><td class="empty" colspan="7">Could not load data: ' + res.error + '</td></tr>';
          return;
        }
        var rounds = res.data.rounds || [];
        var entries = res.data.productionEntries || [];
        var currentRound = res.data.currentRound;
        byId('ver-summary-count').textContent = rounds.length + (rounds.length === 1 ? ' round' : ' rounds');

        // --- Date / Round / Shift summary table ---
        var drsRows = buildDateRoundShiftSummary(entries);
        byId('ver-drs-count').textContent = drsRows.length + (drsRows.length === 1 ? ' row' : ' rows');
        if (!drsRows.length) {
          drsBody.innerHTML = '<tr><td class="empty" colspan="7">No entries yet.</td></tr>';
        } else {
          var drsHtml = '';
          drsRows.forEach(function (g) {
            drsHtml += '<tr>' +
              '<td>' + g.date + '</td>' +
              '<td>' + g.round + '</td>' +
              '<td>' + g.shift + '</td>' +
              '<td>' + g.entries + '</td>' +
              '<td>' + g.totalCuts + '</td>' +
              '<td>' + (g.lengthValues.join(' / ') || '-') + '</td>' +
              '<td>' + g.totalProduction + '</td>' +
              '</tr>';
          });
          drsBody.innerHTML = drsHtml;
        }

        if (!rounds.length) {
          container.innerHTML = '<div class="empty">No entries yet.</div>';
          summaryBody.innerHTML = '<tr><td class="empty" colspan="6">No entries yet.</td></tr>';
          return;
        }

        // --- Round Summary table ---
        var summaryHtml = '';
        rounds.forEach(function (r) {
          var isOpen = String(r.roundId) === String(currentRound);
          var cutsDisplay = (r.cutsValues && r.cutsValues.length) ? r.cutsValues.join(' / ') : '-';
          var lengthDisplay = (r.lengthValues && r.lengthValues.length) ? r.lengthValues.join(' / ') : '-';
          summaryHtml += '<tr>' +
            '<td>' + r.roundId + '</td>' +
            '<td>' + r.entries + '</td>' +
            '<td>' + cutsDisplay + '</td>' +
            '<td>' + lengthDisplay + '</td>' +
            '<td>' + r.totalProduction + '</td>' +
            '<td><span class="pill-open" style="' + (isOpen ? '' : 'color:#6b7280;background:#f0f2f6;') + '">' + (isOpen ? 'Open' : 'Completed') + '</span></td>' +
            '</tr>';
        });
        summaryBody.innerHTML = summaryHtml;

        // --- Per-round detail blocks ---
        var html = '';
        for (var i = 0; i < rounds.length; i++) {
          var r = rounds[i];
          var roundEntries = entries.filter(function (e) { return String(e['Round ID']) === String(r.roundId); });
          html += '<div class="section-title">Round ' + r.roundId +
            ' <span class="count-pill">' + r.entries + (r.entries === 1 ? ' entry' : ' entries') + '</span></div>';
          html += '<div class="stat-grid" style="grid-template-columns:repeat(4,1fr); margin-bottom:14px;">' +
            '<div class="stat c1"><div class="num">' + r.totalCuts + '</div><div class="lbl">Total Cuts</div></div>' +
            '<div class="stat c2"><div class="num">' + r.totalProduction + '</div><div class="lbl">Total Production</div></div>' +
            '<div class="stat c3"><div class="num">' + (r.machines.join(', ') || '-') + '</div><div class="lbl">Machines</div></div>' +
            '<div class="stat c4"><div class="num">' + (r.qualities.join(', ') || '-') + '</div><div class="lbl">Qualities</div></div>' +
            '</div>';
          var rowsHtml = '';
          roundEntries.forEach(function (e) {
            rowsHtml += '<tr>' +
              '<td>' + (e['Machine No'] || '') + '</td>' +
              '<td>' + (e['Operator Name'] || '') + '</td>' +
              '<td>' + (e['Quality'] || '') + '</td>' +
              '<td>' + (e['Sl No'] || '') + '</td>' +
              '<td>' + (e['Forma No'] || '') + '</td>' +
              '<td>' + (e['Cuts Target'] || '') + '</td>' +
              '<td>' + (e['Start Cut'] || '') + '</td>' +
              '<td>' + (e['End Cut'] || '') + '</td>' +
              '<td>' + (e['No of Cuts'] || '') + '</td>' +
              '<td>' + (e['Length per Cut'] || '') + '</td>' +
              '<td>' + (e['Production'] || '') + '</td>' +
              '<td>' + fmtDate(e['Date']) + '</td>' +
              '<td>' + (e['Shift'] || '') + '</td>' +
              '</tr>';
          });
          html += '<div class="table-wrap" style="margin-bottom:26px;"><table>' +
            '<thead><tr><th>M/C</th><th>Operator</th><th>Quality</th><th>Sl No</th><th>Forma No</th><th>Target</th><th>Start Cut</th><th>End Cut</th><th>Cuts</th><th>Length/Cut</th><th>Production</th><th>Date</th><th>Shift</th></tr></thead>' +
            '<tbody>' + (rowsHtml || '<tr><td class="empty" colspan="13">No entries.</td></tr>') + '</tbody>' +
            '</table></div>';
        }
        container.innerHTML = html;
      });
    }

    // ---------- REPORT ----------
    var reportDataFull = null;

    function loadReport() {
      byId('rp-prod-body').innerHTML = '<tr><td class="empty" colspan="14">Loading...</td></tr>';
      byId('rp-log-body').innerHTML = '<tr><td class="empty" colspan="7">Loading...</td></tr>';
      callServer('getReportData', [], function (res) {
        if (!res.ok) {
          byId('rp-prod-body').innerHTML = '<tr><td class="empty" colspan="14">Could not load data: ' + res.error + '</td></tr>';
          byId('rp-log-body').innerHTML = '<tr><td class="empty" colspan="7">Could not load data: ' + res.error + '</td></tr>';
          return;
        }
        reportDataFull = res.data;
        byId('rp-generated').textContent = 'Report generated: ' + res.data.generatedAt + ' - Current open round: #' + res.data.currentRound;
        refreshReportView();
      });
    }

    function currentReportFilters() {
      return {
        from: byId('rp-filter-from').value || null,
        to: byId('rp-filter-to').value || null,
        shift: byId('rp-filter-shift').value || null,
        machine: byId('rp-filter-machine').value.trim().toLowerCase() || null,
        quality: byId('rp-filter-quality').value.trim().toLowerCase() || null
      };
    }

    function dateInRange_(dateStr, from, to) {
      if (!dateStr) return !from && !to;
      var d = fmtDate(dateStr);
      if (from && d < from) return false;
      if (to && d > to) return false;
      return true;
    }

    function getFilteredProductionEntries() {
      if (!reportDataFull || !reportDataFull.productionEntries) return [];
      var f = currentReportFilters();
      return reportDataFull.productionEntries.filter(function (r) {
        if (!dateInRange_(r['Date'], f.from, f.to)) return false;
        if (f.shift && String(r['Shift']) !== f.shift) return false;
        if (f.machine && String(r['Machine No'] || '').toLowerCase().indexOf(f.machine) === -1) return false;
        if (f.quality && String(r['Quality'] || '').toLowerCase().indexOf(f.quality) === -1) return false;
        return true;
      });
    }

    function getFilteredReportLogEntries() {
      if (!reportDataFull) return [];
      var f = currentReportFilters();
      return reportDataFull.logEntries.filter(function (r) {
        if (!dateInRange_(r['Date'], f.from, f.to)) return false;
        if (f.shift && String(r['Shift']) !== f.shift) return false;
        return true;
      });
    }

    function refreshReportView() {
      renderReport(getFilteredProductionEntries(), getFilteredReportLogEntries());
    }

    function applyReportFilter() {
      if (!reportDataFull) return;
      var f = currentReportFilters();
      var anyFilter = f.from || f.to || f.shift || f.machine || f.quality;
      var statusEl = byId('rp-filter-status');
      if (anyFilter) {
        var parts = [];
        if (f.from) parts.push('from ' + f.from);
        if (f.to) parts.push('to ' + f.to);
        if (f.shift) parts.push('shift ' + f.shift);
        if (f.machine) parts.push('machine ' + f.machine);
        if (f.quality) parts.push('quality "' + f.quality + '"');
        statusEl.textContent = 'Filtered: ' + parts.join(', ');
      } else {
        statusEl.textContent = 'Showing all data';
      }
      refreshReportView();
    }

    function clearReportFilter() {
      byId('rp-filter-from').value = '';
      byId('rp-filter-to').value = '';
      byId('rp-filter-shift').value = '';
      byId('rp-filter-machine').value = '';
      byId('rp-filter-quality').value = '';
      byId('rp-filter-status').textContent = 'Showing all data';
      refreshReportView();
    }

    function renderReport(prodEntries, logEntries) {
      var totalCuts = 0, totalProduction = 0;
      var roundSet = {};
      prodEntries.forEach(function (r) {
        totalCuts += Number(r['No of Cuts']) || 0;
        totalProduction += Number(r['Production']) || 0;
        if (r['Round ID'] !== '' && r['Round ID'] !== undefined) roundSet[String(r['Round ID'])] = true;
      });

      byId('rp-rounds').textContent = Object.keys(roundSet).length;
      byId('rp-entries').textContent = prodEntries.length;
      byId('rp-cuts').textContent = totalCuts;
      byId('rp-production').textContent = totalProduction;
      byId('rp-log').textContent = logEntries.length;
      byId('rp-entry-count').textContent = prodEntries.length + (prodEntries.length === 1 ? ' entry' : ' entries');
      byId('rp-log-count').textContent = logEntries.length + (logEntries.length === 1 ? ' entry' : ' entries');

      var prodBody = byId('rp-prod-body');
      if (!prodEntries.length) {
        prodBody.innerHTML = '<tr><td class="empty" colspan="14">No entries match this filter.</td></tr>';
      } else {
        var pHtml = '';
        for (var i = 0; i < prodEntries.length; i++) {
          var r = prodEntries[i];
          pHtml += '<tr>' +
            '<td>' + (r['Round ID'] || '') + '</td>' +
            '<td>' + (r['Machine No'] || '') + '</td>' +
            '<td>' + (r['Operator Name'] || '') + '</td>' +
            '<td>' + (r['Quality'] || '') + '</td>' +
            '<td>' + (r['Sl No'] || '') + '</td>' +
            '<td>' + (r['Forma No'] || '') + '</td>' +
            '<td>' + (r['Cuts Target'] || '') + '</td>' +
            '<td>' + (r['Start Cut'] || '') + '</td>' +
            '<td>' + (r['End Cut'] || '') + '</td>' +
            '<td>' + (r['No of Cuts'] || '') + '</td>' +
            '<td>' + (r['Length per Cut'] || '') + '</td>' +
            '<td>' + (r['Production'] || '') + '</td>' +
            '<td>' + fmtDate(r['Date']) + '</td>' +
            '<td>' + (r['Shift'] || '') + '</td>' +
            '</tr>';
        }
        prodBody.innerHTML = pHtml;
      }

      var logBody = byId('rp-log-body');
      if (!logEntries.length) {
        logBody.innerHTML = '<tr><td class="empty" colspan="7">No log book entries match this filter.</td></tr>';
      } else {
        var lHtml = '';
        for (var k = 0; k < Math.min(logEntries.length, 50); k++) {
          var lr = logEntries[k];
          lHtml += '<tr>' +
            '<td>' + fmtDate(lr['Date']) + '</td>' +
            '<td>' + (lr['Shift'] || '') + '</td>' +
            '<td>' + (lr['Operator Name'] || '') + '</td>' +
            '<td>' + (lr['Hours Worked'] || '') + '</td>' +
            '<td>' + (lr['Detention Hours'] || '') + '</td>' +
            '<td>' + (lr['Idle Reason'] || '') + '</td>' +
            '<td>' + (lr['Instruction'] || '') + '</td>' +
            '</tr>';
        }
        logBody.innerHTML = lHtml;
      }
    }

    // ---------- WIRE UP BUTTONS ----------
    byId('btn-lb-save').addEventListener('click', saveLogBook);
    byId('btn-lb-clear').addEventListener('click', clearLogBook);
    byId('btn-lb-refresh').addEventListener('click', loadLogTable);
    byId('btn-p-save').addEventListener('click', saveProduction);
    byId('btn-p-stop').addEventListener('click', stopRoundClick);
    byId('btn-p-clear').addEventListener('click', clearProduction);
    byId('btn-p-refresh').addEventListener('click', loadCurrentRoundTable);
    byId('btn-ver-refresh').addEventListener('click', loadVerification);
    byId('btn-rp-refresh').addEventListener('click', loadReport);
    byId('btn-rp-print').addEventListener('click', function () { window.print(); });
    byId('btn-rp-apply-filter').addEventListener('click', applyReportFilter);
    byId('btn-rp-clear-filter').addEventListener('click', clearReportFilter);

    // ---------- INIT ----------
    byId('lb-date').value = todayStr();
    loadLogTable();
    loadProductionMeta();
  </script>
</body>
