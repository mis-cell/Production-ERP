<script>
var MACHINES = { Indotex: ['8','9','10'], Krishna: ['7','11','12'] };

document.addEventListener('DOMContentLoaded', function () {
  google.script.run.withSuccessHandler(function (m) {
    MACHINES = m;
    populateMachineDropdown('pr_machine', document.getElementById('pr_unit').value);
    onMachineChange();
    populateMachineDropdown('pv_machine', document.getElementById('pv_unit').value);
    onVerifyMachineChange();
  }).getMachines();

  google.script.run.withSuccessHandler(function (colors) {
    populateColorDropdown('pr_color', colors);
    populateColorDropdown('po_color', colors);
    populateColorDropdown('po_view_color', colors);
    onPOViewColorChange();
  }).getOrderColors();

  var today = new Date().toISOString().slice(0, 10);
  document.getElementById('lb_date').value = today;
  document.getElementById('pr_date').value = today;
  document.getElementById('pv_date').value = today;
  document.getElementById('po_date').value = today;

  refreshLogBookInfo();
});

/* ---------------- TAB SWITCHING ---------------- */
function showTab(id, btn) {
  ['logbook', 'production', 'verification', 'purchaseorder', 'report'].forEach(function (t) {
    document.getElementById(t).classList.add('hidden');
  });
  document.getElementById(id).classList.remove('hidden');
  document.querySelectorAll('.tab-btn').forEach(function (b) { b.classList.remove('active'); });
  btn.classList.add('active');
  if (id === 'production') refreshLogBookInfo();
  if (id === 'report') runReport();
  if (id === 'verification') onVerifyMachineChange();
  if (id === 'purchaseorder') { loadPurchaseOrderSummary(); onPOViewColorChange(); }
}

function populateColorDropdown(selectId, colors) {
  var sel = document.getElementById(selectId);
  var current = sel.value;
  sel.innerHTML = '';
  colors.forEach(function (c) {
    var o = document.createElement('option');
    o.value = c; o.textContent = c;
    sel.appendChild(o);
  });
  if ([...sel.options].some(function (o) { return o.value === current; })) sel.value = current;
}

/* ---------------- LOG BOOK ---------------- */
function saveLogBook() {
  var data = {
    date: document.getElementById('lb_date').value,
    shift: document.getElementById('lb_shift').value,
    rotation: document.getElementById('lb_rotation').value,
    hoursWorked: document.getElementById('lb_hours').value,
    idleMachine: document.getElementById('lb_idle').value,
    batch: document.getElementById('lb_batch').value,
    ifBatchChange: document.getElementById('lb_batchchange').value,
    instruction: document.getElementById('lb_instruction').value
  };
  if (!data.date) { alert('Please select a date.'); return; }
  if (!data.rotation) { alert('Please enter the Rotation of Staff (worker) name.'); return; }
  if (data.hoursWorked === '') { alert('Please enter Hours Worked.'); return; }
  var statusEl = document.getElementById('lb_status');
  statusEl.textContent = 'Saving...'; statusEl.className = 'self-center text-sm font-semibold text-gray-500';
  google.script.run
    .withSuccessHandler(function () {
      statusEl.textContent = 'Saved ✓'; statusEl.className = 'self-center text-sm font-semibold text-green-600';
      clearLogBook(true);
      refreshLogBookInfo();
    })
    .withFailureHandler(function (err) {
      statusEl.textContent = 'Error: ' + err.message; statusEl.className = 'self-center text-sm font-semibold text-red-600';
    })
    .saveLogBook(data);
}

function clearLogBook(keepDate) {
  document.getElementById('lb_rotation').value = '';
  document.getElementById('lb_hours').value = '';
  document.getElementById('lb_idle').value = '';
  document.getElementById('lb_batch').value = '';
  document.getElementById('lb_batchchange').value = '';
  document.getElementById('lb_instruction').value = '';
  if (!keepDate) document.getElementById('lb_date').value = '';
}

/* ---------------- PRODUCTION ---------------- */
function populateMachineDropdown(selectId, unit) {
  var sel = document.getElementById(selectId);
  var current = sel.value;
  sel.innerHTML = '';
  if (selectId === 'rp_machine') sel.innerHTML = '<option value="">All</option>';
  (MACHINES[unit] || []).forEach(function (m) {
    var o = document.createElement('option');
    o.value = m; o.textContent = 'Machine ' + m;
    sel.appendChild(o);
  });
  if ([...sel.options].some(function (o) { return o.value === current; })) sel.value = current;
}

function onUnitChange() {
  populateMachineDropdown('pr_machine', document.getElementById('pr_unit').value);
  onMachineChange();
}

/**
 * Looks up the Log Book entry for the current Date + Shift and auto-fills
 * the read-only Worker / Hours Worked fields on the Production tab. A Log
 * Book entry must exist before Production can be saved — Save/Stop stay
 * disabled until one is found.
 */
function refreshLogBookInfo() {
  var date = document.getElementById('pr_date').value;
  var shift = document.getElementById('pr_shift').value;
  var infoEl = document.getElementById('pr_logbook_status');
  var saveBtn = document.getElementById('pr_save_btn');
  var stopBtn = document.getElementById('pr_stop_btn');

  if (!date || !shift) return;

  google.script.run.withSuccessHandler(function (res) {
    if (!res) {
      document.getElementById('pr_worker').value = '';
      document.getElementById('pr_hours').value = '';
      infoEl.textContent = '⚠️ No Log Book entry found for ' + date + ', Shift ' + shift + '. Please fill the Log Book first.';
      infoEl.className = 'mb-6 text-sm font-semibold px-4 py-3 rounded border border-orange-300 bg-orange-50 text-orange-700';
      saveBtn.disabled = true;
      stopBtn.disabled = true;
    } else {
      document.getElementById('pr_worker').value = res.worker;
      document.getElementById('pr_hours').value = res.hoursWorked;
      infoEl.textContent = '✓ Worker: ' + res.worker + ' — Hours Worked: ' + res.hoursWorked + ' (from Log Book, ' + date + ' Shift ' + shift + ')';
      infoEl.className = 'mb-6 text-sm font-semibold px-4 py-3 rounded border border-green-300 bg-green-50 text-green-700';
      saveBtn.disabled = false;
      stopBtn.disabled = false;
    }
  }).getLogBookForShift(date, shift);
}

function onMachineChange() {
  document.getElementById('pr_newbeam').checked = false;
  var machine = document.getElementById('pr_machine').value;
  if (!machine) return;
  google.script.run.withSuccessHandler(function (res) {
    var statusEl = document.getElementById('pr_beam_status');
    var roundLabel = 'Round ' + res.round + ' — ';
    document.getElementById('pr_beamnumber').value = res.beamNumber || '';
    if (res.newBeam) {
      document.getElementById('pr_startmeter').value = 0;
      document.getElementById('pr_beamtarget').value = '';
      document.getElementById('pr_beamtarget').readOnly = false;
      statusEl.textContent = roundLabel + 'No running beam on this machine — enter a new Beam Number and Beam Meter Target to start.';
      statusEl.className = 'mb-4 text-sm font-semibold text-orange-600';
    } else {
      document.getElementById('pr_startmeter').value = res.startMeter;
      document.getElementById('pr_beamtarget').value = res.beamTarget;
      document.getElementById('pr_beamtarget').readOnly = true;
      if (res.color) document.getElementById('pr_color').value = res.color;
      if (res.ringLength) document.getElementById('pr_ringlength').value = res.ringLength;
      if (res.weight) document.getElementById('pr_weight').value = res.weight;
      var stateWord = res.status === 'Stopped' ? 'Stopped — resume' : 'Beam in progress — continuing';
      statusEl.textContent = roundLabel + 'Beam ' + res.beamNumber + ' — ' + stateWord + ' from ' + res.startMeter + 'm toward target ' + res.beamTarget + 'm.';
      statusEl.className = 'mb-4 text-sm font-semibold ' + (res.status === 'Stopped' ? 'text-amber-600' : 'text-blue-700');
    }
    document.getElementById('pr_endmeter').value = '';
    computeLive();
  }).getLastMeterForMachine(machine);

  refreshLogBookInfo();
  refreshProductionLog();
}

function toggleNewBeam() {
  var forceNew = document.getElementById('pr_newbeam').checked;
  var statusEl = document.getElementById('pr_beam_status');
  if (forceNew) {
    document.getElementById('pr_startmeter').value = 0;
    document.getElementById('pr_beamtarget').value = '';
    document.getElementById('pr_beamtarget').readOnly = false;
    document.getElementById('pr_beamnumber').value = '';
    statusEl.textContent = 'Manual override — enter a new Beam Number to start a fresh beam on this machine.';
    statusEl.className = 'mb-4 text-sm font-semibold text-orange-600';
  } else {
    onMachineChange();
  }
  computeLive();
}

function computeLive() {

  var start = Number(document.getElementById('pr_startmeter').value) || 0;
  var entered = Number(document.getElementById('pr_endmeter').value);
  var target = Number(document.getElementById('pr_beamtarget').value) || 0;

  var thisShiftEl = document.getElementById('pr_thisshift');
  var remainEl = document.getElementById('pr_remaining');

  if (!isNaN(entered) && document.getElementById('pr_endmeter').value !== '') {

    // If continuing a beam, entered value is today's production.
    // If new beam, entered value is the actual end meter.
    var actualEnd = (start > 0) ? start + entered : entered;

    thisShiftEl.value = actualEnd + ' m';

    var remaining = target - actualEnd;

    if (target > 0) {

      remainEl.textContent =
        remaining > 0
          ? remaining + ' m remaining to reach target of ' + target + ' m.'
          : 'Target reached — this beam will be marked Completed on save.';

      remainEl.className =
        'mt-2 text-sm ' +
        (remaining > 0
          ? 'text-gray-600'
          : 'text-green-700 font-semibold');

    } else {
      remainEl.textContent = '';
    }

  } else {

    thisShiftEl.value = '';
    remainEl.textContent = '';

  }

}

function saveProduction(isStop) {
  var worker = document.getElementById('pr_worker').value;
  var hours = document.getElementById('pr_hours').value;
  if (!worker) {
    alert('No Log Book entry found for this Date/Shift. Please fill the Log Book first.');
