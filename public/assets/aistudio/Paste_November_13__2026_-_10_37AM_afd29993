</header>

<main>
<!-- ================= ENTRY ================= -->
<section id="entry">
  <div class="card">
    <div class="row">
      <div class="f"><label for="eDate">Date</label><input type="date" id="eDate"></div>
      <div class="f"><label for="eShift">Shift</label>
        <select id="eShift"><option>A</option><option>B</option><option>C</option></select></div>
      <div class="f"><label for="eSup">Supervisor</label><input id="eSup" placeholder="e.g. Ravin Kumar Gupta"></div>
      <div class="f"><label for="eMode">Mode</label><input id="eMode" value="New entry" readonly tabindex="-1"></div>
    </div>
  </div>

  <div class="card">
    <div class="legend hint">
      <span><i style="background:#fff"></i>Type or scan</span>
      <span><i style="background:var(--calc)"></i>Calculated automatically</span>
      <span><i style="background:var(--warn-bg)"></i>Check this value</span>
      <span>Scan the roll barcode into <b>Roll / Beam ID</b>; the scanner's Enter key moves you to the next field.</span>
    </div>
    <div class="tbl-wrap">
      <table id="grid">
        <thead><tr>
          <th>#</th><th>Operator</th><th>T. No.</th><th>Machine</th><th>Roll / Beam ID</th>
          <th class="num">Input Wt (kg)</th>
          <th class="num">Input Length (<span class="lu">m</span>)</th>
          <th class="num" title="Target length + seam allowance">Cut Length Setting (<span class="lu">m</span>)</th>
          <th class="num">Target Wt / Piece (kg)</th>
          <th class="num">Cut Pieces (Good)</th>
          <th class="num">Rejected Pieces</th>
          <th class="num">Scrap Wt (kg)</th>
          <th class="num c" title="Cut Pieces × Target Weight per Piece">Expected Output (kg)</th>
          <th class="num c" title="Scrap Weight ÷ Input Weight × 100">Visible Waste %</th>
          <th class="num c" title="Input Weight − (Expected Output + Scrap)">Invisible Loss (kg)</th>
          <th class="num c" title="Invisible Loss ÷ Input Weight × 100">Invisible Loss %</th>
          <th class="num c" title="(Cut Pieces × Cut Length) ÷ Input Length × 100">Linear Eff. %</th>
          <th class="num c" title="Rejected ÷ (Good + Rejected) × 100">Rejection %</th>
          <th></th>
        </tr></thead>
        <tbody></tbody>
        <tfoot><tr>
          <td colspan="5">Total</td>
          <td class="num" id="tIW">0</td><td class="num" id="tIL">0</td><td></td><td></td>
          <td class="num" id="tP">0</td><td class="num" id="tRJ">0</td><td class="num" id="tSC">0</td>
          <td class="num" id="tEX">0</td><td class="num" id="tVIS">–</td><td class="num" id="tINV">–</td>
          <td class="num" id="tINVP">–</td><td class="num" id="tEFF">–</td><td class="num" id="tREJ">–</td><td></td>
        </tr></tfoot>
      </table>
    </div>
    <div style="margin-top:12px" class="row noprint">
      <button class="btn sec sm" id="addRow">+ Add row</button>
      <span class="hint">New rows copy the previous row's operator and machine. Press Enter in the last field to add another row.</span>
    </div>
  </div>

  <div class="card">
    <h2>Shift summary</h2>
    <div class="kpis">
      <div class="kpi"><b id="kRuns">0</b><span>Cutting runs</span></div>
      <div class="kpi"><b id="kIW">0</b><span>Input fabric (kg)</span></div>
      <div class="kpi"><b id="kIL">0</b><span>Input length (<span class="lu">m</span>)</span></div>
      <div class="kpi"><b id="kP">0</b><span>Good pieces</span></div>
      <div class="kpi"><b id="kRJ">0</b><span>Rejected pieces</span></div>
      <div class="kpi"><b id="kSC">0</b><span>Scrap (kg)</span></div>
      <div class="kpi calc"><b id="kEX">0</b><span>Expected output (kg)</span></div>
      <div class="kpi calc"><b id="kVIS">–</b><span>Visible wastage</span></div>
      <div class="kpi calc"><b id="kINV">–</b><span>Invisible loss (kg)</span></div>
      <div class="kpi calc"><b id="kINVP">–</b><span>Invisible loss %</span></div>
      <div class="kpi calc"><b id="kEFF">–</b><span>Machine linear efficiency</span></div>
      <div class="kpi calc"><b id="kREJ">–</b><span>Piece rejection rate</span></div>
    </div>
    <div style="margin-top:14px"><label for="eRem">Remarks</label>
      <input id="eRem" placeholder="Optional"></div>
  </div>

  <div class="row noprint">
    <button class="btn ok" id="saveBtn">Save sheet</button>
    <button class="btn sec" id="clearBtn">Clear form</button>
    <button class="btn bad" id="delBtn">Delete this sheet</button>
  </div>
</section>

<!-- ================= REPORT ================= -->
<section id="report" class="hidden">
  <div class="card noprint">
    <div class="row">
      <div class="f"><label for="rFrom">From</label><input type="date" id="rFrom"></div>
      <div class="f"><label for="rTo">To</label><input type="date" id="rTo"></div>
      <div class="f"><label for="rShift">Shift</label>
        <select id="rShift"><option value="">All</option><option>A</option><option>B</option><option>C</option></select></div>
      <div class="f w2"><label for="rSearch">Search (operator / T.No / machine / roll ID)</label><input id="rSearch" placeholder="Type to filter…"></div>
      <button class="btn" id="rGo">Load</button>
    </div>
    <div class="chips" style="margin-top:14px">
      <button class="chip" data-q="today">Today</button>
      <button class="chip" data-q="yest">Yesterday</button>
      <button class="chip" data-q="week">Last 7 days</button>
      <button class="chip" data-q="month">This month</button>
      <button class="chip" data-q="lmonth">Last month</button>
    </div>
  </div>

  <div class="kpis" id="rKpis"></div>

  <div class="card" id="trendCard">
    <h2>Daily good pieces</h2>
    <div class="bars" id="trend"></div>
  </div>

  <div class="card">
    <div class="row noprint" style="justify-content:space-between;margin-bottom:14px">
      <div class="seg" id="rMode">
        <button data-m="detail" class="on">Detailed</button>
        <button data-m="operator">Operator-wise</button>
        <button data-m="machine">Machine-wise</button>
        <button data-m="day">Day / Shift-wise</button>
      </div>
      <div class="row">
        <button class="btn sec" onclick="window.print()">Print</button>
        <button class="btn" id="csvBtn">⬇ Download CSV</button>
      </div>
    </div>
    <div class="tbl-wrap"><table id="rTable"></table></div>
    <p class="hint" style="margin:10px 0 0">Percentages in the Total row and in grouped views are calculated from the summed quantities, not averaged. Amber values need checking: efficiency above 100%, or negative invisible loss.</p>
  </div>
</section>

<!-- ================= LOGBOOK ================= -->
<section id="logbook" class="hidden">
  <div class="two">
    <div class="card">
      <h2>Operators</h2>
      <div class="row" style="margin-bottom:12px">
        <div class="f w2"><input id="mOpName" placeholder="Operator name" aria-label="Operator name"></div>
        <div class="f"><input id="mOpNo" placeholder="T. No." aria-label="Operator T. No."></div>
        <button class="btn" data-add="op">Add</button>
      </div>
      <div class="tbl-wrap" style="max-height:50vh"><table id="mOps"></table></div>
    </div>
    <div class="card">
      <h2>Machines</h2>
      <div class="row" style="margin-bottom:12px">
        <div class="f w2"><input id="mMcName" placeholder="Machine name / No." aria-label="Machine name"></div>
        <div class="f"><input id="mMcNo" placeholder="Note" aria-label="Machine note"></div>
        <button class="btn" data-add="mc">Add</button>
      </div>
      <div class="tbl-wrap" style="max-height:50vh"><table id="mMcs"></table></div>
    </div>
  </div>
  <div class="card">
    <h2>Settings</h2>
    <div class="row">
      <div class="f" style="max-width:260px"><label for="setUnit">Fabric length unit</label>
        <select id="setUnit"><option value="m">Meters (m)</option><option value="yd">Yards (yd)</option></select></div>
      <span class="hint" style="padding-bottom:12px">Applies to Input Length and Cut Length Setting everywhere. Use one unit consistently for the efficiency % to be correct.</span>
    </div>
  </div>
  <p class="hint">Names are also added to the Logbook automatically each time you save a sheet.</p>
</section>
</main>

<datalist id="dlOps"></datalist>
<datalist id="dlMcs"></datalist>
<div id="toast"></div>

<script>
const $ = s => document.querySelector(s);
const $$ = s => [...document.querySelectorAll(s)];
const esc = s => String(s ?? '').replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const num = v => { const x = parseFloat(v); return isNaN(x) || x < 0 ? 0 : x; };
const fmt = n => n === null || n === undefined ? '–' : (Math.round(n * 100) / 100).toLocaleString('en-IN', { maximumFractionDigits: 2 });
const pct = n => n === null || n === undefined ? '–' : fmt(n) + '%';
const r2 = v => v === null || v === undefined ? null : Math.round(v * 100) / 100;
const fmtD = d => d ? d.split('-').reverse().join('/') : '';

function api(fn, ...args) {
  return new Promise((res, rej) => {
    google.script.run.withSuccessHandler(res).withFailureHandler(e => rej(new Error(e.message || e)))[fn](...args);
  });
}
function toast(msg, err) {
  const t = $('#toast'); t.textContent = msg; t.className = 'show' + (err ? ' err' : '');
  clearTimeout(toast.t); toast.t = setTimeout(() => t.className = '', 3200);
}

/* ---------- Calculation core (used by Entry and Reports) ---------- */
const toS = l => {
  const p = num(l.pieces);
  return { runs: 1, inWt: num(l.inwt), inLen: num(l.inlen), p, rj: num(l.rej), sc: num(l.scrap),
           exp: p * num(l.tgtwt), cutM: p * num(l.cutlen) };
};
const zeroS = () => ({ runs: 0, inWt: 0, inLen: 0, p: 0, rj: 0, sc: 0, exp: 0, cutM: 0 });
const addS = (a, b) => { for (const k in b) a[k] = (a[k] || 0) + b[k]; return a; };
const metrics = s => {
  const iw = s.inWt, inv = iw > 0 ? iw - (s.exp + s.sc) : null;
  return {
    vis: iw > 0 ? s.sc / iw * 100 : null,                         // Visible Wastage %
    inv: inv,                                                     // Invisible Loss weight
    invPct: iw > 0 ? inv / iw * 100 : null,                       // Invisible Loss %
    eff: s.inLen > 0 ? s.cutM / s.inLen * 100 : null,             // Machine Linear Efficiency %
    rej: (s.p + s.rj) > 0 ? s.rj / (s.p + s.rj) * 100 : null      // Piece Rejection Rate %
  };
};
const hasData = l => !!(l.roll || num(l.inwt) || num(l.inlen) || num(l.pieces) || num(l.rej) || num(l.scrap));

let M = { operators: [], machines: [], unit: 'm' };
let dirty = false;
const MIN_ROWS = 10;
const setMode = editing => { $('#eMode').value = editing ? 'Editing saved sheet' : 'New entry'; };
const applyUnit = () => $$('.lu').forEach(e => e.textContent = M.unit);

/* ---------- Tabs ---------- */
$$('nav button').forEach(b => b.onclick = () => {
  $$('nav button').forEach(x => x.classList.toggle('active', x === b));
  ['entry', 'report', 'logbook'].forEach(id => $('#' + id).classList.toggle('hidden', id !== b.dataset.tab));
  if (b.dataset.tab === 'report' && !R.loaded) loadReport();
  if (b.dataset.tab === 'logbook') renderLogbook();
});

/* ---------- Init ---------- */
(async function init() {
  try {
    const d = await api('getInitData');
    M = d; fillLists(); applyUnit();
    $('#eDate').value = d.today;
    setRange(d.today, d.today);
    for (let i = 0; i < MIN_ROWS; i++) addRow();
    recalc();
    await loadShift(true);
  } catch (e) { toast(e.message, true); }
})();

function fillLists() {
  $('#dlOps').innerHTML = M.operators.map(o => `<option value="${esc(o.name)}">${esc(o.no)}</option>`).join('');
  $('#dlMcs').innerHTML = M.machines.map(o => `<option value="${esc(o.name)}">${esc(o.no)}</option>`).join('');
}

/* ---------- Entry grid ---------- */
const rowData = tr => { const o = {}; tr.querySelectorAll('input').forEach(i => o[i.dataset.f] = i.value.trim()); return o; };

function addRow(d = {}) {
  const tb = $('#grid tbody'), tr = document.createElement('tr');
  const txt = (f, cls, aria, ph) => `<td><input class="${cls}" data-f="${f}" value="${esc(d[f])}" aria-label="${aria}" placeholder="${ph || ''}"></td>`;
  const nm = (f, aria, step) => `<td><input class="n" type="number" min="0" step="${step || 'any'}" inputmode="decimal" data-f="${f}" value="${esc(d[f])}" aria-label="${aria}"></td>`;
  tr.innerHTML = `
    <td class="sn" style="color:var(--muted)"></td>
    <td><input class="nm" data-f="operator" list="dlOps" value="${esc(d.operator)}" aria-label="Operator"></td>
    ${txt('tno', 'n', 'Operator T. No.')}
    <td><input class="nm" data-f="machine" list="dlMcs" value="${esc(d.machine)}" aria-label="Machine"></td>
    ${txt('roll', 'id', 'Roll or beam ID', 'Scan or type')}
    ${nm('inwt', 'Input weight kg')}
    ${nm('inlen', 'Input length')}
    ${nm('cutlen', 'Cut length setting')}
    ${nm('tgtwt', 'Target weight per piece kg')}
    ${nm('pieces', 'Good cut pieces', 1)}
    ${nm('rej', 'Rejected pieces', 1)}
    ${nm('scrap', 'Scrap weight kg')}
    <td class="calc" data-c="exp">–</td><td class="calc" data-c="vis">–</td><td class="calc" data-c="inv">–</td>
    <td class="calc" data-c="invPct">–</td><td class="calc" data-c="eff">–</td><td class="calc" data-c="rej">–</td>
    <td><button class="x" title="Remove row" aria-label="Remove row">×</button></td>`;
  tb.appendChild(tr);
  tr.querySelector('.x').onclick = () => { tr.remove(); renumber(); recalc(); dirty = true; };
  tr.addEventListener('input', e => {
    dirty = true;
    if (e.target.dataset.f === 'operator') {
      const m = M.operators.find(o => o.name.toLowerCase() === e.target.value.trim().toLowerCase());
      const t = tr.querySelector('[data-f=tno]'); if (m && !t.value) t.value = m.no;
    }
    recalc();
  });
  tr.addEventListener('keydown', e => {
    if (e.key !== 'Enter' || e.target.tagName !== 'INPUT') return;
    e.preventDefault();                                   // barcode scanners send Enter after each scan
    const ins = [...tr.querySelectorAll('input')], i = ins.indexOf(e.target);
    if (i < ins.length - 1) { ins[i + 1].focus(); ins[i + 1].select(); return; }
    let next = tr.nextElementSibling;
    if (!next) { addRow(inherit(tr)); next = tb.lastElementChild; }
    focusStart(next);
  });
  renumber();
  return tr;
}
const inherit = tr => { const o = rowData(tr); return { operator: o.operator, tno: o.tno, machine: o.machine }; };
const focusStart = tr => tr.querySelector(tr.querySelector('[data-f=operator]').value ? '[data-f=roll]' : '[data-f=operator]').focus();
function renumber() { $$('#grid tbody tr').forEach((r, i) => r.querySelector('.sn').textContent = i + 1); }
$('#addRow').onclick = () => {
  const last = $('#grid tbody').lastElementChild;
  const tr = addRow(last ? inherit(last) : {}); recalc(); focusStart(tr);
};

function collect() { return $$('#grid tbody tr').map(rowData).filter(hasData); }

function recalc() {
  const tot = zeroS();
  $$('#grid tbody tr').forEach(tr => {
    const l = rowData(tr), has = hasData(l), s = toS(l), m = metrics(s);
    const set = (k, txt, warn, title) => {
      const c = tr.querySelector(`[data-c=${k}]`);
      c.textContent = txt; c.classList.toggle('warn', !!warn); c.title = warn ? title : '';
    };
    const negMsg = 'Negative: expected output + scrap is more than the input weight. Check the target weight per piece.';
    set('exp', has ? fmt(s.exp) : '–');
    set('vis', fmt(m.vis));
    set('inv', fmt(m.inv), m.inv !== null && m.inv < 0, negMsg);
    set('invPct', fmt(m.invPct), m.invPct !== null && m.invPct < 0, negMsg);
    set('eff', fmt(m.eff), m.eff !== null && m.eff > 100, 'Above 100%: pieces × cut length is more than the input length. Check the lengths.');
    set('rej', fmt(m.rej));
    if (has) addS(tot, s);
  });
  const m = metrics(tot);
  const put = (id, v) => $(id).textContent = v;
  put('#tIW', fmt(tot.inWt)); put('#tIL', fmt(tot.inLen)); put('#tP', fmt(tot.p)); put('#tRJ', fmt(tot.rj));
  put('#tSC', fmt(tot.sc)); put('#tEX', fmt(tot.exp)); put('#tVIS', fmt(m.vis)); put('#tINV', fmt(m.inv));
  put('#tINVP', fmt(m.invPct)); put('#tEFF', fmt(m.eff)); put('#tREJ', fmt(m.rej));
  put('#kRuns', tot.runs); put('#kIW', fmt(tot.inWt)); put('#kIL', fmt(tot.inLen)); put('#kP', fmt(tot.p));
  put('#kRJ', fmt(tot.rj)); put('#kSC', fmt(tot.sc)); put('#kEX', fmt(tot.exp)); put('#kVIS', pct(m.vis));
  put('#kINV', fmt(m.inv)); put('#kINVP', pct(m.invPct)); put('#kEFF', pct(m.eff)); put('#kREJ', pct(m.rej));
}

['input', 'change'].forEach(ev => document.querySelectorAll('#eSup,#eRem')
  .forEach(el => el.addEventListener(ev, () => dirty = true)));

function resetForm() {
  $('#grid tbody').innerHTML = '';
  for (let i = 0; i < MIN_ROWS; i++) addRow();
  ['#eSup', '#eRem'].forEach(s => $(s).value = '');
  recalc(); dirty = false;
}

async function loadShift(silent) {
  try {
    const r = await api('getShift', $('#eDate').value, $('#eShift').value);
    resetForm();
    if (r.exists) {
      $('#grid tbody').innerHTML = '';
      r.lines.forEach(l => addRow(l));
      for (let i = r.lines.length; i < MIN_ROWS; i++) addRow();
      if (r.meta) { $('#eSup').value = r.meta.supervisor; $('#eRem').value = r.meta.remarks; }
      recalc();
    }
    dirty = false;
    setMode(r.exists);
    if (r.exists && !silent) toast('Loaded saved sheet');
  } catch (e) { toast(e.message, true); }
}
['#eDate', '#eShift'].forEach(s => $(s).addEventListener('change', () => {
  if (dirty && !confirm('You have unsaved changes. Discard and switch?')) return;
  loadShift();
}));

$('#saveBtn').onclick = async () => {
  const rows = $$('#grid tbody tr'), lines = [];
  for (let i = 0; i < rows.length; i++) {
    const l = rowData(rows[i]);
    if (!hasData(l)) continue;
    if (!l.operator) return toast(`Row ${i + 1}: enter the operator name`, true);
    lines.push(l);
  }
  if (!lines.length) return toast('Add at least one cutting run', true);
  const ids = lines.map(l => l.roll.toLowerCase()).filter(Boolean);
  const dup = ids.find((n, i) => ids.indexOf(n) !== i);
  if (dup && !confirm(`Roll / Beam ID "${dup}" appears more than once on this sheet. Save anyway?`)) return;
  const btn = $('#saveBtn'); btn.disabled = true; btn.textContent = 'Saving…';
  try {
    await api('saveShift', {
      date: $('#eDate').value, shift: $('#eShift').value, supervisor: $('#eSup').value,
      remarks: $('#eRem').value, lines
    });
    dirty = false; toast('Saved ✔'); setMode(true);
    M = await api('getInitData'); fillLists(); R.loaded = false;
  } catch (e) { toast(e.message, true); }
  btn.disabled = false; btn.textContent = 'Save sheet';
};
$('#clearBtn').onclick = () => { if (confirm('Clear the form? (Saved data is not deleted)')) resetForm(); };
$('#delBtn').onclick = async () => {
  if (!confirm(`Delete saved sheet for ${fmtD($('#eDate').value)} shift ${$('#eShift').value}? This cannot be undone.`)) return;
  try { await api('deleteShift', $('#eDate').value, $('#eShift').value); resetForm();
    setMode(false); R.loaded = false; toast('Deleted'); }
  catch (e) { toast(e.message, true); }
};

/* ---------- Reports ---------- */
const R = { loaded: false, lines: [], shifts: [], mode: 'detail', cols: [], rows: [], foot: null };
const iso = d => d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
function setRange(a, b) { $('#rFrom').value = a; $('#rTo').value = b; }

$$('.chip').forEach(c => c.onclick = () => {
  const t = new Date(), q = c.dataset.q; let a = new Date(t), b = new Date(t);
  if (q === 'yest') { a.setDate(a.getDate() - 1); b = new Date(a); }
  if (q === 'week') a.setDate(a.getDate() - 6);
  if (q === 'month') a = new Date(t.getFullYear(), t.getMonth(), 1);
  if (q === 'lmonth') { a = new Date(t.getFullYear(), t.getMonth() - 1, 1); b = new Date(t.getFullYear(), t.getMonth(), 0); }
  setRange(iso(a), iso(b)); loadReport();
});
$('#rGo').onclick = loadReport;
$('#rShift').onchange = $('#rSearch').oninput = renderReport;
$$('#rMode button').forEach(b => b.onclick = () => {
  R.mode = b.dataset.m; $$('#rMode button').forEach(x => x.classList.toggle('on', x === b)); renderReport();
});

async function loadReport() {
  const a = $('#rFrom').value, b = $('#rTo').value;
  if (!a || !b || a > b) return toast('Choose a valid date range', true);
  $('#rTable').innerHTML = '<tr><td class="empty">Loading…</td></tr>';
  try {
    const d = await api('getReport', a, b);
    R.lines = d.lines; R.shifts = d.shifts; R.loaded = true; renderReport();
  } catch (e) { toast(e.message, true); }
}

function filtered() {
  const sh = $('#rShift').value, q = $('#rSearch').value.trim().toLowerCase();
  const lines = R.lines.filter(l => (!sh || l.shift === sh) &&
    (!q || [l.operator, l.tno, l.machine, l.roll].some(v => String(v).toLowerCase().includes(q))));
  const shifts = R.shifts.filter(s => !sh || s.shift === sh);
  return { lines, shifts };
}

function group(lines, keyFn, labelFn) {
  const g = {};
  lines.forEach(l => {
    const k = keyFn(l), lab = labelFn(l);
    const o = g[k] = g[k] || { label: lab.slice(), s: zeroS() };
    lab.forEach((v, i) => { if (v !== '') o.label[i] = v; });
    addS(o.s, toS(l));
  });
  return Object.values(g);
}
const sCells = s => {
  const m = metrics(s);
  return [s.runs, r2(s.inWt), r2(s.inLen), r2(s.p), r2(s.rj), r2(s.sc), r2(s.exp),
          r2(m.vis), r2(m.inv), r2(m.invPct), r2(m.eff), r2(m.rej)];
};

function renderReport() {
  if (!R.loaded) return;
  const u = M.unit, { lines, shifts } = filtered();
  const all = lines.reduce((a, l) => addS(a, toS(l)), zeroS()), am = metrics(all);
  const sheetKeys = new Set(lines.map(l => l.date + '|' + l.shift));

  $('#rKpis').innerHTML = `
    <div class="kpi"><b>${lines.length}</b><span>Cutting runs (${sheetKeys.size} sheets)</span></div>
    <div class="kpi"><b>${fmt(all.inWt)}</b><span>Input fabric (kg)</span></div>
    <div class="kpi"><b>${fmt(all.p)}</b><span>Good pieces</span></div>
    <div class="kpi"><b>${pct(am.vis)}</b><span>Visible wastage</span></div>
    <div class="kpi"><b>${pct(am.invPct)}</b><span>Invisible loss</span></div>
    <div class="kpi"><b>${pct(am.eff)}</b><span>Linear efficiency</span></div>
    <div class="kpi"><b>${pct(am.rej)}</b><span>Rejection rate</span></div>`;

  const byDate = {};
  lines.forEach(l => byDate[l.date] = (byDate[l.date] || 0) + l.pieces);
  const dates = Object.keys(byDate).sort(), mx = Math.max(1, ...Object.values(byDate));
  $('#trend').innerHTML = dates.length ? dates.map(d =>
    `<div class="bar" title="${fmtD(d)}: ${byDate[d]}"><em>${fmt(byDate[d])}</em><i style="height:${Math.max(2, byDate[d] / mx * 70)}px"></i><small>${d.slice(8)}/${d.slice(5, 7)}</small></div>`).join('')
    : '<div class="empty" style="width:100%">No data for this range</div>';

  const mc = ['Runs', 'Input Wt (kg)', `Input Length (${u})`, 'Good Pcs', 'Rejected Pcs', 'Scrap (kg)', 'Expected Out (kg)',
              'Visible Waste %', 'Invisible Loss (kg)', 'Invisible Loss %', 'Linear Eff. %', 'Rejection %'];
  let cols, rows, foot, nf;
  if (R.mode === 'detail') {
    nf = 7;
    cols = ['Date', 'Shift', 'S.No', 'Operator', 'T.No', 'Machine', 'Roll / Beam ID', 'Input Wt (kg)', `Input Length (${u})`,
            `Cut Length Setting (${u})`, 'Target Wt / Pc (kg)', 'Good Pcs', 'Rejected Pcs', 'Scrap (kg)', 'Expected Out (kg)',
            'Visible Waste %', 'Invisible Loss (kg)', 'Invisible Loss %', 'Linear Eff. %', 'Rejection %'];
    rows = lines.slice().sort((a, b) => (a.date + a.shift).localeCompare(b.date + b.shift) || a.sno - b.sno).map(l => {
      const s = toS(l), m = metrics(s);
      return [fmtD(l.date), l.shift, String(l.sno), l.operator, l.tno, l.machine, l.roll, l.inwt, l.inlen, l.cutlen, l.tgtwt,
              l.pieces, l.rej, l.scrap, r2(s.exp), r2(m.vis), r2(m.inv), r2(m.invPct), r2(m.eff), r2(m.rej)];
    });
    foot = ['Total', '', '', '', '', '', '', r2(all.inWt), r2(all.inLen), '', '', r2(all.p), r2(all.rj), r2(all.sc), r2(all.exp),
            r2(am.vis), r2(am.inv), r2(am.invPct), r2(am.eff), r2(am.rej)];
  } else if (R.mode === 'operator') {
    nf = 2; cols = ['Operator', 'T.No', ...mc];
    rows = group(lines, l => l.operator.toLowerCase(), l => [l.operator, l.tno])
      .sort((a, b) => b.s.p - a.s.p).map(o => [...o.label, ...sCells(o.s)]);
    foot = ['Total', '', ...sCells(all)];
  } else if (R.mode === 'machine') {
    nf = 1; cols = ['Machine', ...mc];
    rows = group(lines, l => l.machine.toLowerCase(), l => [l.machine || '(none)'])
      .sort((a, b) => a.label[0].localeCompare(b.label[0])).map(o => [...o.label, ...sCells(o.s)]);
    foot = ['Total', ...sCells(all)];
  } else {
    nf = 3; cols = ['Date', 'Shift', 'Supervisor', ...mc, 'Remarks'];
    const meta = {}; shifts.forEach(s => meta[s.date + '|' + s.shift] = s);
    rows = group(lines, l => l.date + '|' + l.shift, l => [l.date, l.shift])
      .sort((a, b) => (a.label[0] + a.label[1]).localeCompare(b.label[0] + b.label[1]))
      .map(o => { const m = meta[o.label[0] + '|' + o.label[1]] || {};
        return [fmtD(o.label[0]), o.label[1], m.supervisor || '', ...sCells(o.s), m.remarks || '']; });
    foot = ['Total', '', '', ...sCells(all), ''];
  }
  R.cols = cols; R.rows = rows; R.foot = rows.length ? foot : null;

  // amber flags in the detailed view: efficiency > 100 or negative invisible loss
  const bad = (i, v) => R.mode === 'detail' && typeof v === 'number' && ((i === 16 || i === 17) && v < 0 || i === 18 && v > 100);
  const cell = (v, i, f) => `<td class="${i >= nf ? 'num' : ''}${f && bad(i, v) ? ' warn' : ''}">${v === null ? '–' : esc(typeof v === 'number' ? fmt(v) : v)}</td>`;
  $('#rTable').innerHTML = rows.length
    ? `<thead><tr>${cols.map((c, i) => `<th class="${i >= nf && i < cols.length - (R.mode === 'day' ? 1 : 0) ? 'num' : ''}">${esc(c)}</th>`).join('')}</tr></thead>
       <tbody>${rows.map(r => `<tr>${r.map((v, i) => cell(v, i, true)).join('')}</tr>`).join('')}</tbody>
       <tfoot><tr>${foot.map((v, i) => cell(v, i, false)).join('')}</tr></tfoot>`
    : '<tr><td class="empty">No records for the selected filters. Try a wider date range.</td></tr>';
}

$('#csvBtn').onclick = () => {
  if (!R.rows.length) return toast('Nothing to download', true);
  const q = v => { v = String(v ?? ''); return /[",\n]/.test(v) ? '"' + v.replace(/"/g, '""') + '"' : v; };
  const all = [R.cols, ...R.rows, R.foot].filter(Boolean);
  const csv = '\uFEFF' + all.map(r => r.map(q).join(',')).join('\r\n');
  const a = document.createElement('a');
  a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8;' }));
  a.download = `cutting_${R.mode}_${$('#rFrom').value}_to_${$('#rTo').value}.csv`;
  document.body.appendChild(a); a.click(); a.remove();
  toast('CSV downloaded');
};

/* ---------- Logbook ---------- */
function renderLogbook() {
  const draw = (id, arr, type, noLabel) => $(id).innerHTML = arr.length
    ? `<thead><tr><th>Name</th><th>${noLabel}</th><th></th></tr></thead><tbody>` +
      arr.map(o => `<tr><td>${esc(o.name)}</td><td>${esc(o.no)}</td>
        <td style="text-align:right"><button class="btn bad sm" data-del="${type}" data-name="${esc(o.name)}">Delete</button></td></tr>`).join('') + '</tbody>'
    : '<tr><td class="empty">No names yet. Add one above, or save a sheet.</td></tr>';
  draw('#mOps', M.operators, 'op', 'T. No.'); draw('#mMcs', M.machines, 'mc', 'Note');
  $('#setUnit').value = M.unit;
}
$('#setUnit').onchange = async e => {
  try { M = await api('saveSetting', 'unit', e.target.value); applyUnit(); R.loaded = false; toast('Unit saved'); }
  catch (err) { toast(err.message, true); }
};
document.addEventListener('click', async e => {
  const t = e.target;
  try {
    if (t.dataset.add) {
      const op = t.dataset.add === 'op';
      const nameEl = $(op ? '#mOpName' : '#mMcName'), noEl = $(op ? '#mOpNo' : '#mMcNo');
      if (!nameEl.value.trim()) return toast('Enter a name', true);
      M = await api('saveMaster', t.dataset.add, nameEl.value.trim(), noEl.value.trim());
      nameEl.value = ''; noEl.value = '';
      fillLists(); renderLogbook(); toast('Added');
    }
    if (t.dataset.del) {
      if (!confirm('Delete ' + t.dataset.name + ' from the Logbook? (Past records stay unchanged)')) return;
      M = await api('deleteMaster', t.dataset.del, t.dataset.name); fillLists(); renderLogbook();
    }
  } catch (err) { toast(err.message, true); }
});
</script>
</body>
</html>


