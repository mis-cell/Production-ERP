<!DOCTYPE html>
<html>
<head>
<base target="_top">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Damping Department</title>
<style>
  :root{
    --nav:#14213d; --nav-sub:#b9c4dc;
    --bg:#f7f8fa; --card:#ffffff; --ink:#18213a; --muted:#6a7489; --line:#e4e8ef; --line2:#eef1f6;
    --head:#eef1f6; --headc:#e1e9fb; --calc:#f5f8ff; --pri:#2557e6; --pri-d:#1b44bd; --soft:#eef3ff;
    --ok:#12926b; --warn:#c76a0a; --warn-bg:#fff3e2; --bad:#d6384a;
  }
  *{box-sizing:border-box}
  html,body{margin:0}
  body{font-family:"Segoe UI",system-ui,-apple-system,Roboto,Arial,sans-serif;background:var(--bg);color:var(--ink);font-size:15px}

  /* ---------- Top bar ---------- */
  header{background:var(--nav);color:#fff;padding:16px 22px;display:flex;align-items:center;gap:26px;flex-wrap:wrap;
    position:sticky;top:0;z-index:30}
  .brand h1{margin:0;font-size:21px;font-weight:800;letter-spacing:.3px;text-transform:uppercase;line-height:1.15}
  .brand small{display:block;color:var(--nav-sub);font-size:15px;margin-top:3px}
  nav{display:flex;gap:10px;flex-wrap:wrap}
  nav button{display:flex;align-items:center;gap:9px;background:transparent;color:#d9e0f0;border:0;padding:11px 18px;
    border-radius:10px;cursor:pointer;font:inherit;font-size:16px}
  nav button:hover{background:rgba(255,255,255,.08)}
  nav button.active{background:#fff;color:var(--ink);font-weight:700}
  nav button:focus-visible{outline:2px solid #8fb0ff;outline-offset:2px}
  nav .ic{font-size:17px;line-height:1}

  main{max-width:1400px;margin:20px auto;padding:0 20px 70px}
  .card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-bottom:16px}
  .card h2{margin:0 0 14px;font-size:16px}

  /* ---------- Fields ---------- */
  .row{display:flex;gap:14px;flex-wrap:wrap;align-items:flex-end}
  label{display:block;font-size:14px;color:var(--muted);margin-bottom:6px}
  input,select,textarea{font:inherit;font-size:15px;padding:11px 12px;border:1px solid #d5dbe6;border-radius:10px;
    background:#fff;color:var(--ink);width:100%;height:44px}
  input::placeholder{color:#9aa3b5}
  input:focus,select:focus,textarea:focus{outline:2px solid #c3d4ff;border-color:var(--pri)}
  input[readonly]{background:#fff;color:var(--ink)}
  .f{flex:1;min-width:150px}
  .f.w2{flex:2;min-width:220px}

  /* ---------- Buttons ---------- */
  .btn{background:var(--pri);color:#fff;border:1px solid var(--pri);padding:0 20px;height:42px;border-radius:10px;cursor:pointer;
    font:inherit;font-weight:600;font-size:15px}
  .btn:hover{background:var(--pri-d)}
  .btn.sec{background:#fff;color:var(--pri);border-color:#c7d3f5}
  .btn.sec:hover{background:var(--soft)}
  .btn.ok{background:var(--ok);border-color:var(--ok)}
  .btn.bad{background:#fff;color:var(--bad);border-color:#f0c4ca}
  .btn.bad:hover{background:#fff4f5}
  .btn.sm{height:34px;padding:0 13px;font-size:13px}
  .btn:disabled{opacity:.55;cursor:wait}
  .btn:focus-visible,.chip:focus-visible,.seg button:focus-visible{outline:2px solid #8fb0ff;outline-offset:2px}

  /* ---------- Tables ---------- */
  .tbl-wrap{overflow:auto;border:1px solid var(--line);border-radius:12px;max-height:66vh;background:#fff}
  table{border-collapse:collapse;width:100%}
  th{background:var(--head);position:sticky;top:0;z-index:2;font-size:13px;font-weight:700;color:#1f2a44;
    padding:12px 10px;text-align:left;white-space:nowrap}
  th.c{background:var(--headc)}
  td{padding:8px 10px;border-bottom:1px solid var(--line2);white-space:nowrap}
  tbody tr:last-child td{border-bottom:0}
  td.num,th.num{text-align:right}
  td.ctr,th.ctr{text-align:center}
  tfoot td{background:var(--head);font-weight:700;position:sticky;bottom:0;border-top:1px solid var(--line)}

  #grid td{padding:6px 5px}
  #grid th:first-child,#grid td:first-child{padding-left:12px;width:44px}
  #grid input{height:42px;padding:9px 10px;min-width:96px}
  #grid input.nm{min-width:160px}
  #grid input.id{min-width:170px}
  #grid input.n{text-align:right;min-width:98px}
  #grid td.calc{background:var(--calc);text-align:right;font-weight:600;min-width:92px;padding-right:12px}
  #grid td.calc.st{text-align:center;min-width:80px}
  #grid td.calc.warn,td.warn{background:var(--warn-bg);color:var(--warn)}
  #grid td.calc.good{color:var(--ok)}
  td.warn{font-weight:600}
  .x{width:38px;height:38px;border:1px solid #d5dbe6;background:#fff;color:var(--pri);border-radius:9px;font-size:18px;cursor:pointer}
  .x:hover{background:#fff4f5;color:var(--bad);border-color:#f0c4ca}

  /* ---------- Summary / KPIs ---------- */
  .kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px;margin-bottom:16px}
  .kpi{background:#fff;border:1px solid var(--line);border-radius:12px;padding:14px 16px}
  .kpi b{display:block;font-size:24px;color:var(--ink);line-height:1.2}
  .kpi span{font-size:13px;color:var(--muted)}
  .card .kpis{margin:0}
  .card .kpi{background:var(--soft);border-color:transparent}
  .card .kpi.calc{background:#fff;border:1px solid #c9d7fb}

  .chips{display:flex;gap:8px;flex-wrap:wrap}
  .chip{padding:7px 14px;border:1px solid #d5dbe6;background:#fff;border-radius:20px;cursor:pointer;font-size:13px;color:var(--ink)}
  .chip:hover{border-color:var(--pri);color:var(--pri)}
  .seg{display:inline-flex;background:var(--head);border-radius:10px;padding:4px;gap:4px;flex-wrap:wrap}
  .seg button{border:0;background:transparent;color:var(--muted);padding:8px 14px;cursor:pointer;font:inherit;font-size:14px;border-radius:7px}
  .seg button.on{background:#fff;color:var(--ink);font-weight:700;box-shadow:0 1px 2px rgba(20,33,61,.12)}

  .bars{display:flex;align-items:flex-end;gap:6px;height:120px;padding:6px 0;overflow-x:auto}
  .bar{flex:0 0 auto;min-width:40px;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:100%}
  .bar i{display:block;width:22px;background:var(--nav);border-radius:5px 5px 0 0;min-height:2px}
  .bar small{font-size:10px;color:var(--muted);margin-top:4px}
  .bar em{font-size:10px;font-style:normal;color:var(--ink);margin-bottom:2px}

  #toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%);background:var(--nav);color:#fff;padding:12px 22px;
    border-radius:10px;opacity:0;pointer-events:none;transition:opacity .25s;z-index:99;max-width:90vw;text-align:center}
  #toast.show{opacity:1}
  #toast.err{background:var(--bad)}
  .empty{padding:34px;text-align:center;color:var(--muted)}
  .two{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  .two .card{margin-bottom:16px}
  .hidden{display:none}
  .hint{color:var(--muted);font-size:13px}
  .legend{display:flex;gap:16px;flex-wrap:wrap;align-items:center;margin-bottom:12px}
  .legend i{display:inline-block;width:14px;height:14px;border-radius:4px;vertical-align:-2px;margin-right:6px;border:1px solid var(--line)}

  @media(max-width:800px){
    .two{grid-template-columns:1fr}
    header{gap:12px;padding:12px 14px}
    .brand h1{font-size:18px}
    nav button{padding:9px 13px;font-size:15px}
    main{padding:0 10px 70px}
  }
  @media(prefers-reduced-motion:reduce){#toast{transition:none}}
  @media print{header,.noprint{display:none!important} .tbl-wrap{max-height:none;overflow:visible} body{background:#fff}}
</style>
</head>
<body>
<header>
  <div class="brand">
    <h1>Daamping Department</h1>
    <small>Bally Jute Mill</small>
  </div>
  <nav>
    <button data-tab="entry" class="active"><span class="ic">📝</span>Entry</button>
    <button data-tab="report"><span class="ic">📊</span>Reports</button>
    <button data-tab="logbook"><span class="ic">📒</span>Logbook</button>
  </nav>
</header>

<main>
<!-- ================= ENTRY ================= -->
<section id="entry">
  <div class="card">
    <div class="row">
      <div class="f"><label for="eDate">Date</label><input type="date" id="eDate"></div>
      <div class="f"><label for="eShift">Shift</label>
        <select id="eShift"><option>A</option><option>B</option><option>C</option></select></div>
      <div class="f"><label for="eSup">Supervisor</label><input id="eSup" placeholder="e.g. Ravin Kumar Gupta"></div>
      <div class="f"><label for="eMode">Mode</label><input id="eMode" value="New entry" readonly tabindex="-1"></div>
    </div>
  </div>

  <div class="card">
    <div class="legend hint">
      <span><i style="background:#fff"></i>Type or scan</span>
      <span><i style="background:var(--calc)"></i>Calculated automatically</span>
      <span><i style="background:var(--warn-bg)"></i>Check this value</span>
      <span>Scan the roll barcode into <b>Roll / Beam ID</b>; Enter moves to the next field. Moisture % is on a wet basis (water ÷ total weight).</span>
    </div>
    <div class="tbl-wrap">
      <table id="grid">
        <thead><tr>
          <th>#</th><th>Operator</th><th>T. No.</th><th>Machine</th><th>Roll / Beam ID</th>
          <th class="num" title="Weight before damping">Input Wt (kg)</th>
          <th class="num">Input Length (<span class="lu">m</span>)</th>
          <th class="num" title="Moisture meter reading before damping">Moisture Before %</th>
          <th class="num" title="Moisture the process is aiming for">Target Moisture %</th>
          <th class="num" title="Moisture meter reading after damping">Moisture After %</th>
          <th class="num" title="Weight after damping">Output Wt (kg)</th>
          <th class="num" title="Water / emulsion consumed (1 litre ≈ 1 kg)">Water Used (L)</th>
          <th class="num">Run Time (min)</th>
          <th class="num c" title="Input Wt × (1 − Moisture Before)">Dry Wt (kg)</th>
          <th class="num c" title="Output Wt − Input Wt">Water Added (kg)</th>
          <th class="num c" title="Water Added ÷ Input Wt × 100">Pick-up %</th>
          <th class="num c" title="Moisture After − Target (percentage points)">Moisture Dev (pts)</th>
          <th class="num c" title="Output Wt − Dry Wt ÷ (1 − Moisture After)">Wt Variance (kg)</th>
          <th class="num c" title="Variance ÷ expected output × 100">Wt Variance %</th>
          <th class="num c" title="Water Added ÷ Water Used × 100">Water Eff. %</th>
          <th class="num c" title="Input Length ÷ Run Time">Throughput (<span class="lu">m</span>/min)</th>
          <th class="ctr c" title="OK if moisture deviation is within the tolerance set in the Logbook">Status</th>
          <th></th>
        </tr></thead>
        <tbody></tbody>
        <tfoot><tr>
          <td colspan="5">Total / average</td>
          <td class="num" id="tIW">0</td><td class="num" id="tIL">0</td><td class="num" id="tMB">–</td>
          <td class="num" id="tTM">–</td><td class="num" id="tMA">–</td><td class="num" id="tOW">0</td>
          <td class="num" id="tUS">0</td><td class="num" id="tTI">0</td>
          <td class="num" id="tDRY">–</td><td class="num" id="tWAT">–</td><td class="num" id="tPICK">–</td>
          <td class="num" id="tDEV">–</td><td class="num" id="tVK">–</td><td class="num" id="tVP">–</td>
          <td class="num" id="tEFF">–</td><td class="num" id="tTHR">–</td><td class="ctr" id="tST">–</td><td></td>
        </tr></tfoot>
      </table>
    </div>
    <div style="margin-top:12px" class="row noprint">
      <button class="btn sec sm" id="addRow">+ Add row</button>
      <span class="hint">New rows copy the previous row's operator, machine and target moisture. Press Enter in the last field to add another row.</span>
    </div>
  </div>

  <div class="card">
    <h2>Shift summary</h2>
    <div class="kpis">
      <div class="kpi"><b id="kRuns">0</b><span>Damping runs</span></div>
      <div class="kpi"><b id="kIW">0</b><span>Input fabric (kg)</span></div>
      <div class="kpi"><b id="kOW">0</b><span>Output fabric (kg)</span></div>
      <div class="kpi"><b id="kUS">0</b><span>Water used (L)</span></div>
      <div class="kpi calc"><b id="kMB">–</b><span>Avg moisture before</span></div>
      <div class="kpi calc"><b id="kTM">–</b><span>Avg target moisture</span></div>
      <div class="kpi calc"><b id="kMA">–</b><span>Avg moisture after</span></div>
      <div class="kpi calc"><b id="kDEV">–</b><span>Moisture deviation (pts)</span></div>
      <div class="kpi calc"><b id="kWAT">–</b><span>Water added (kg)</span></div>
      <div class="kpi calc"><b id="kPICK">–</b><span>Water pick-up</span></div>
      <div class="kpi calc"><b id="kEFF">–</b><span>Water efficiency</span></div>
      <div class="kpi calc"><b id="kVP">–</b><span>Weight variance</span></div>
      <div class="kpi calc"><b id="kTHR">–</b><span>Throughput (<span class="lu">m</span>/min)</span></div>
      <div class="kpi calc"><b id="kOK">–</b><span>Runs within tolerance</span></div>
    </div>
    <div style="margin-top:14px"><label for="eRem">Remarks</label>
      <input id="eRem" placeholder="Optional"></div>
  </div>

  <div class="row noprint">
    <button class="btn ok" id="saveBtn">Save sheet</button>
    <button class="btn sec" id="clearBtn">Clear form</button>
    <button class="btn bad" id="delBtn">Delete this sheet</button>
  </div>
</section>

<!-- ================= REPORT ================= -->
<section id="report" class="hidden">
  <div class="card noprint">
    <div class="row">
      <div class="f"><label for="rFrom">From</label><input type="date" id="rFrom"></div>
      <div class="f"><label for="rTo">To</label><input type="date" id="rTo"></div>
      <div class="f"><label for="rShift">Shift</label>
        <select id="rShift"><option value="">All</option><option>A</option><option>B</option><option>C</option></select></div>
      <div class="f w2"><label for="rSearch">Search (operator / T.No / machine / roll ID)</label><input id="rSearch" placeholder="Type to filter…"></div>
      <button class="btn" id="rGo">Load</button>
    </div>
    <div class="chips" style="margin-top:14px">
      <button class="chip" data-q="today">Today</button>
      <button class="chip" data-q="yest">Yesterday</button>
      <button class="chip" data-q="week">Last 7 days</button>
      <button class="chip" data-q="month">This month</button>
      <button class="chip" data-q="lmonth">Last month</button>
    </div>
  </div>

  <div class="kpis" id="rKpis"></div>

  <div class="card" id="trendCard">
    <h2>Daily output (kg)</h2>
    <div class="bars" id="trend"></div>
  </div>

  <div class="card">
    <div class="row noprint" style="justify-content:space-between;margin-bottom:14px">
      <div class="seg" id="rMode">
        <button data-m="detail" class="on">Detailed</button>
        <button data-m="operator">Operator-wise</button>
        <button data-m="machine">Machine-wise</button>
        <button data-m="day">Day / Shift-wise</button>
      </div>
      <div class="row">
        <button class="btn sec" onclick="window.print()">Print</button>
        <button class="btn" id="csvBtn">⬇ Download CSV</button>
      </div>
    </div>
    <div class="tbl-wrap"><table id="rTable"></table></div>
    <p class="hint" style="margin:10px 0 0">Averages are weighted by fabric weight, and percentages are calculated from summed quantities, not averaged. Amber values need checking: moisture outside tolerance, weight variance beyond ±2%, or water efficiency above 100%.</p>
  </div>
</section>

<!-- ================= LOGBOOK ================= -->
<section id="logbook" class="hidden">
  <div class="two">
    <div class="card">
      <h2>Operators</h2>
      <div class="row" style="margin-bottom:12px">
        <div class="f w2"><input id="mOpName" placeholder="Operator name" aria-label="Operator name"></div>
        <div class="f"><input id="mOpNo" placeholder="T. No." aria-label="Operator T. No."></div>
        <button class="btn" data-add="op">Add</button>
      </div>
      <div class="tbl-wrap" style="max-height:50vh"><table id="mOps"></table></div>
    </div>
    <div class="card">
      <h2>Machines</h2>
      <div class="row" style="margin-bottom:12px">
        <div class="f w2"><input id="mMcName" placeholder="Machine name / No." aria-label="Machine name"></div>
        <div class="f"><input id="mMcNo" placeholder="Note" aria-label="Machine note"></div>
        <button class="btn" data-add="mc">Add</button>
      </div>
      <div class="tbl-wrap" style="max-height:50vh"><table id="mMcs"></table></div>
