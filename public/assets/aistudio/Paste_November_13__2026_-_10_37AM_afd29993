            <tr class="text-left text-gray-500 uppercase text-xs border-b">
              <th class="pb-2 pr-4">Quality</th>
              <th class="pb-2 pr-4">Loom / Out</th>
              <th class="pb-2 w-10"></th>
            </tr>
          </thead>
          <tbody id="pr-rows"></tbody>
          <tfoot>
            <tr class="border-t-2">
              <td class="py-2 font-bold text-[#1e2a5e] align-top">Total</td>
              <td class="py-2"><div id="pr-column-totals" class="flex flex-wrap gap-2"></div></td>
              <td></td>
            </tr>
          </tfoot>
        </table>
      </div>

      <button onclick="addProductionRow()" class="mt-2 text-sm font-semibold text-blue-700 hover:text-blue-900">+ Add Row</button>

      <div class="mt-6">
        <button onclick="submitProduction()" id="pr-submit-btn" class="bg-[#1e2a5e] hover:bg-[#16204a] text-white font-semibold px-6 py-2.5 rounded-lg transition">Save Production Entries</button>
      </div>
    </section>

    <!-- ==================== REPORT TAB ==================== -->
    <section id="tab-report" class="bg-white rounded-xl shadow p-6 hidden">
      <h2 class="text-xl font-bold text-[#1e2a5e] mb-1">Report</h2>
      <p class="text-sm text-gray-500 mb-6">Filter by date and/or shift. Leave a field blank to include all.</p>

      <div class="flex flex-wrap gap-4 items-end mb-6">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Date</label>
          <input type="date" id="rp-date" class="border rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-400 outline-none">
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Shift</label>
          <select id="rp-shift" class="border rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-400 outline-none">
            <option value="">All</option>
            <option value="A">A</option>
            <option value="B">B</option>
            <option value="C">C</option>
          </select>
        </div>
        <button onclick="runReport()" class="bg-[#1e2a5e] hover:bg-[#16204a] text-white font-semibold px-6 py-2.5 rounded-lg transition">Search</button>
      </div>

      <div id="rp-summary" class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8"></div>

      <h3 class="text-md font-bold text-[#1e2a5e] mb-2">Log Book Entries</h3>
      <div class="overflow-x-auto mb-8">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="text-left text-gray-500 uppercase text-xs border-b">
              <th class="py-2 pr-3">Date</th><th class="py-2 pr-3">Shift</th>
              <th class="py-2 pr-3">Line Sardar</th><th class="py-2 pr-3">Line Helper</th>
              <th class="py-2 pr-3">Beam Cooley</th><th class="py-2 pr-3">Marka Man</th>
              <th class="py-2 pr-3">Daily Sardar</th><th class="py-2 pr-3">Weaver</th>
              <th class="py-2 pr-3">Total</th><th class="py-2 pr-3">Hours</th>
            </tr>
          </thead>
          <tbody id="rp-logbook-rows"></tbody>
        </table>
      </div>

      <h3 class="text-md font-bold text-[#1e2a5e] mb-2">Production Entries</h3>
      <div class="overflow-x-auto">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="text-left text-gray-500 uppercase text-xs border-b">
              <th class="py-2 pr-3">Date</th><th class="py-2 pr-3">Shift</th>
              <th class="py-2 pr-3">Quality</th><th class="py-2 pr-3">Loom</th><th class="py-2 pr-3">Out</th>
            </tr>
          </thead>
          <tbody id="rp-production-rows"></tbody>
        </table>
      </div>
    </section>

  </main>

  <div id="toast" class="toast"></div>

  <script>
    // ---------------- Tab switching ----------------
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        ['logbook','production','report'].forEach(name => {
          document.getElementById('tab-' + name).classList.toggle('hidden', 'tab-' + name !== 'tab-' + btn.dataset.tab);
        });
      });
    });

    function todayStr() {
      const d = new Date();
      const m = String(d.getMonth()+1).padStart(2,'0');
      const day = String(d.getDate()).padStart(2,'0');
      return d.getFullYear() + '-' + m + '-' + day;
    }

    function showToast(msg, isError) {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.style.background = isError ? '#dc2626' : '#16a34a';
      t.classList.add('show');
      setTimeout(() => t.classList.remove('show'), 2600);
    }

    // ---------------- LOG BOOK ----------------
    document.getElementById('lb-date').value = todayStr();

    document.querySelectorAll('.hc-field').forEach(el => {
      el.addEventListener('input', recalcHandsTotal);
    });

    function recalcHandsTotal() {
      let total = 0;
      document.querySelectorAll('.hc-field').forEach(el => {
        total += Number(el.value) || 0;
      });
      document.getElementById('hc-total').textContent = total;
      return total;
    }

    function submitLogbook() {
      const data = {
        date: document.getElementById('lb-date').value,
        shift: document.getElementById('lb-shift').value,
        hoursWorked: document.getElementById('lb-hours').value,
        instructions: document.getElementById('lb-instructions').value,
        lineSardar: document.getElementById('hc-lineSardar').value,
        lineHelper: document.getElementById('hc-lineHelper').value,
        beamCooley: document.getElementById('hc-beamCooley').value,
        markaMan: document.getElementById('hc-markaMan').value,
        dailySardar: document.getElementById('hc-dailySardar').value,
        weaver: document.getElementById('hc-weaver').value
      };

      if (!data.date) { showToast('Please select a date', true); return; }

      const btn = document.getElementById('lb-submit-btn');
      btn.disabled = true; btn.textContent = 'Saving...';

      google.script.run
        .withSuccessHandler(res => {
          btn.disabled = false; btn.textContent = 'Save Log Book Entry';
          showToast('Log book entry saved. Total hands: ' + res.total);
          document.querySelectorAll('.hc-field').forEach(el => el.value = '');
          document.getElementById('lb-hours').value = '';
          document.getElementById('lb-instructions').value = '';
          recalcHandsTotal();
        })
        .withFailureHandler(err => {
          btn.disabled = false; btn.textContent = 'Save Log Book Entry';
          showToast('Error: ' + err.message, true);
        })
        .saveLogbookEntry(data);
    }

    // ---------------- PRODUCTION ----------------
    document.getElementById('pr-date').value = todayStr();
    let prRowCount = 0;

    function addProductionRow(quality) {
      prRowCount++;
      const tbody = document.getElementById('pr-rows');
      const tr = document.createElement('tr');
      tr.className = 'border-b';
      tr.dataset.rowId = prRowCount;
      tr.innerHTML =
        '<td class="py-2 pr-4 align-top"><input type="text" placeholder="Quality" value="' + (quality||'') + '" class="pr-quality w-40 border rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-400 outline-none"></td>' +
        '<td class="py-2 pr-4 align-top">' +
          '<div class="flex flex-wrap items-end gap-2">' +
            '<div class="pr-pairs flex flex-wrap items-end gap-2"></div>' +
            '<button type="button" onclick="addPairToRow(this)" title="Add another Loom/Out for this quality" class="flex items-center justify-center w-8 h-8 rounded-lg border border-blue-300 text-blue-600 hover:bg-blue-50 font-bold mb-1">+</button>' +
          '</div>' +
        '</td>' +
        '<td class="py-2 align-top"><button onclick="removeProductionRow(this)" class="text-red-500 hover:text-red-700 font-bold px-2">✕</button></td>';
      tbody.appendChild(tr);
      addPairToRow(tr.querySelector('button[title="Add another Loom/Out for this quality"]'));
    }

    function addPairToRow(btnOrContainer, loom, out) {
      const pairsContainer = btnOrContainer.closest ? btnOrContainer.closest('td').querySelector('.pr-pairs') : btnOrContainer;
      const pairDiv = document.createElement('div');
      pairDiv.className = 'flex items-center gap-1 border rounded-lg px-2 py-1 bg-gray-50';
      pairDiv.innerHTML =
        '<input type="number" min="0" placeholder="Loom" value="' + (loom||'') + '" class="pr-loom w-20 border rounded px-2 py-1.5 text-sm focus:ring-2 focus:ring-blue-400 outline-none">' +
        '<span class="text-gray-400 text-xs">/</span>' +
        '<input type="number" min="0" placeholder="Out" value="' + (out||'') + '" class="pr-out w-20 border rounded px-2 py-1.5 text-sm focus:ring-2 focus:ring-blue-400 outline-none">' +
        '<button type="button" onclick="removePair(this)" title="Remove this pair" class="text-red-400 hover:text-red-600 text-xs px-1">✕</button>';
      pairsContainer.appendChild(pairDiv);
      pairDiv.querySelector('.pr-loom').addEventListener('input', recalcProductionTotals);
      pairDiv.querySelector('.pr-out').addEventListener('input', recalcProductionTotals);
      recalcProductionTotals();
    }

    function removePair(btn) {
      const pairsContainer = btn.closest('.pr-pairs');
      btn.closest('div').remove();
      if (pairsContainer.children.length === 0) {
        addPairToRow(pairsContainer); // always keep at least one pair per row
      }
      recalcProductionTotals();
    }

    function removeProductionRow(btn) {
      btn.closest('tr').remove();
      recalcProductionTotals();
    }

    function recalcProductionTotals() {
      const columnTotals = [];

      document.querySelectorAll('#pr-rows tr').forEach(tr => {
        tr.querySelectorAll('.pr-pairs > div').forEach((pairDiv, idx) => {
          const loom = Number(pairDiv.querySelector('.pr-loom').value) || 0;
          const out = Number(pairDiv.querySelector('.pr-out').value) || 0;

          if (!columnTotals[idx]) columnTotals[idx] = { loom: 0, out: 0 };
          columnTotals[idx].loom += loom;
          columnTotals[idx].out += out;
        });
      });

      const container = document.getElementById('pr-column-totals');
      container.innerHTML = columnTotals.map((c, idx) =>
        '<div class="flex flex-col items-center justify-center gap-0.5 border-2 border-[#1e2a5e] rounded-lg px-2 py-1 bg-blue-50 w-[168px]">' +
          '<span class="text-[10px] uppercase font-semibold text-gray-500">Column ' + (idx + 1) + '</span>' +
          '<span class="text-sm font-bold text-[#1e2a5e]">Loom: ' + c.loom + '&nbsp;&nbsp;Out: ' + c.out + '</span>' +
        '</div>'
      ).join('');
    }

    function submitProduction() {
      const date = document.getElementById('pr-date').value;
      const shift = document.getElementById('pr-shift').value;
      if (!date) { showToast('Please select a date', true); return; }

      const rows = [];
      document.querySelectorAll('#pr-rows tr').forEach(tr => {
        const quality = tr.querySelector('.pr-quality').value;
        tr.querySelectorAll('.pr-pairs > div').forEach(pairDiv => {
          const loom = pairDiv.querySelector('.pr-loom').value;
          const out = pairDiv.querySelector('.pr-out').value;
          if (quality || loom || out) {
            rows.push({ quality: quality, loom: loom, out: out });
          }
        });
      });

      if (rows.length === 0) { showToast('Add at least one row', true); return; }

      const btn = document.getElementById('pr-submit-btn');
      btn.disabled = true; btn.textContent = 'Saving...';

      google.script.run
        .withSuccessHandler(res => {
          btn.disabled = false; btn.textContent = 'Save Production Entries';
          showToast(res.rowsSaved + ' row(s) saved. Loom: ' + res.totalLoom + ', Out: ' + res.totalOut);
          document.getElementById('pr-rows').innerHTML = '';
          addProductionRow();
        })
        .withFailureHandler(err => {
          btn.disabled = false; btn.textContent = 'Save Production Entries';
          showToast('Error: ' + err.message, true);
        })
        .saveProductionEntries({ date: date, shift: shift, rows: rows });
    }

    // ---------------- REPORT ----------------
    function runReport() {
      const filters = {
        date: document.getElementById('rp-date').value,
        shift: document.getElementById('rp-shift').value
      };

      google.script.run
        .withSuccessHandler(renderReport)
        .withFailureHandler(err => showToast('Error: ' + err.message, true))
        .getReport(filters);
    }

    function renderReport(res) {
      const summary = document.getElementById('rp-summary');
      summary.innerHTML =
        summaryCard('Total Hands', res.totals.hands) +
        summaryCard('Total Loom', res.totals.loom) +
        summaryCard('Total Out', res.totals.out);

      const lbBody = document.getElementById('rp-logbook-rows');
      lbBody.innerHTML = res.logbook.length ? res.logbook.map(r =>
        '<tr class="border-b"><td class="py-1.5 pr-3">' + r['Date'] + '</td><td class="py-1.5 pr-3">' + r['Shift'] + '</td>' +
        '<td class="py-1.5 pr-3">' + r['Line Sardar'] + '</td><td class="py-1.5 pr-3">' + r['Line Helper'] + '</td>' +
        '<td class="py-1.5 pr-3">' + r['Beam Cooley'] + '</td><td class="py-1.5 pr-3">' + r['Marka Man'] + '</td>' +
        '<td class="py-1.5 pr-3">' + r['Daily Sardar'] + '</td><td class="py-1.5 pr-3">' + r['Weaver'] + '</td>' +
        '<td class="py-1.5 pr-3 font-bold">' + r['Total'] + '</td><td class="py-1.5 pr-3">' + r['Hours Worked'] + '</td></tr>'
      ).join('') : '<tr><td colspan="10" class="py-4 text-center text-gray-400">No entries found</td></tr>';

      const prBody = document.getElementById('rp-production-rows');
      prBody.innerHTML = res.production.length ? res.production.map(r =>
        '<tr class="border-b"><td class="py-1.5 pr-3">' + r['Date'] + '</td><td class="py-1.5 pr-3">' + r['Shift'] + '</td>' +
        '<td class="py-1.5 pr-3">' + r['Quality'] + '</td><td class="py-1.5 pr-3">' + r['Loom'] + '</td><td class="py-1.5 pr-3">' + r['Out'] + '</td></tr>'
      ).join('') : '<tr><td colspan="5" class="py-4 text-center text-gray-400">No entries found</td></tr>';
    }

    function summaryCard(label, value) {
      return '<div class="bg-blue-50 border border-blue-200 rounded-lg px-4 py-3">' +
        '<div class="text-xs uppercase text-gray-500 font-semibold">' + label + '</div>' +
        '<div class="text-2xl font-bold text-[#1e2a5e]">' + value + '</div></div>';
    }

    // ---------------- Init ----------------
    addProductionRow();
    recalcHandsTotal();
  </script>
</body>
</html>

