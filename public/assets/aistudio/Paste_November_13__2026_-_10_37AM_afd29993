    nav.tabs button:hover{ color:#fff; }
    nav.tabs button.active{ color:#fff; border-bottom-color:#4d8dff; }

    main{ max-width:1180px; margin:28px auto; padding:0 20px 60px; }
    .card{
      background:var(--card);
      border:1px solid var(--border);
      border-radius:var(--radius);
      padding:28px 30px;
      box-shadow:0 1px 3px rgba(20,25,40,.04);
    }
    .card + .card{ margin-top:20px; }
    .card h2{ margin:0 0 4px; font-size:20px; color:var(--navy); font-weight:800; }
    .card p.hint{ margin:0 0 22px; color:var(--text-dim); font-size:13.5px; line-height:1.5; }
    .grid{ display:grid; grid-template-columns:repeat(4,1fr); gap:18px 22px; }
    .grid.cols-3{ grid-template-columns:repeat(3,1fr); }
    .grid.cols-4{ grid-template-columns:repeat(4,1fr); }
    .field{ display:flex; flex-direction:column; gap:6px; }
    .field.span-2{ grid-column:span 2; }
    .field.span-4{ grid-column:span 4; }
    label{ font-size:13px; font-weight:700; color:var(--navy); }
    input, select, textarea{
      font-family:inherit;
      font-size:14px;
      padding:10px 12px;
      border:1px solid var(--border);
      border-radius:8px;
      background:#fff;
      color:var(--text);
      outline:none;
    }
    input:focus, select:focus, textarea:focus{
      border-color:var(--blue);
      box-shadow:0 0 0 3px rgba(43,99,201,.14);
    }
    input[readonly]{ background:#f4f6fa; color:var(--text-dim); font-family:'JetBrains Mono',monospace; font-weight:600; }
    textarea{ resize:vertical; min-height:78px; }

    .actions{ display:flex; gap:10px; margin-top:24px; flex-wrap:wrap; align-items:center; }
    button.btn{
      font-family:inherit;
      font-weight:700;
      font-size:14px;
      padding:11px 22px;
      border-radius:8px;
      border:1px solid transparent;
      cursor:pointer;
    }
    .btn-save{ background:var(--blue); color:#fff; }
    .btn-stop{ background:var(--red); color:#fff; }
    .btn-clear{ background:#fff; color:var(--text-dim); border-color:var(--border); }
    .btn-ghost{ background:var(--blue-light); color:var(--blue); }

    .badge-row{ display:flex; gap:10px; align-items:center; flex-wrap:wrap; margin-bottom:20px; }
    .badge{
      display:inline-flex;
      align-items:center;
      gap:7px;
      background:var(--blue-light);
      color:var(--blue);
      font-weight:700;
      font-size:13px;
      padding:7px 13px;
      border-radius:999px;
