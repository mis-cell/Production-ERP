<datalist id="dlOps"></datalist>
<datalist id="dlCos"></datalist>
<div id="toast"></div>

<script>
const $ = s => document.querySelector(s);
const $$ = s => [...document.querySelectorAll(s)];
const esc = s => String(s ?? '').replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const num = v => { const x = parseFloat(v); return isNaN(x) || x < 0 ? 0 : x; };
const fmt = n => (Math.round(n * 10) / 10).toLocaleString('en-IN');
const fmtD = d => d ? d.split('-').reverse().join('/') : '';

function api(fn, ...args) {
  return new Promise((res, rej) => {
    google.script.run.withSuccessHandler(res).withFailureHandler(e => rej(new Error(e.message || e)))[fn](...args);
  });
}
function toast(msg, err) {
  const t = $('#toast'); t.textContent = msg; t.className = 'show' + (err ? ' err' : '');
  clearTimeout(toast.t); toast.t = setTimeout(() => t.className = '', 2800);
}

let M = { operators: [], coolies: [] };
let dirty = false;
const MIN_ROWS = 12;
const setMode = editing => { $('#eMode').value = editing ? 'Editing saved sheet' : 'New entry'; };

/* ---------- Tabs ---------- */
$$('nav button').forEach(b => b.onclick = () => {
  $$('nav button').forEach(x => x.classList.toggle('active', x === b));
  ['entry', 'report', 'logbook'].forEach(id => $('#' + id).classList.toggle('hidden', id !== b.dataset.tab));
  if (b.dataset.tab === 'report' && !R.loaded) loadReport();
  if (b.dataset.tab === 'logbook') renderLogbook();
});

/* ---------- Init ---------- */
(async function init() {
  try {
    const d = await api('getInitData');
    M = d; fillLists();
    $('#eDate').value = d.today;
    setRange(d.today, d.today);
    for (let i = 0; i < MIN_ROWS; i++) addRow();
    recalc();
    await loadShift(true);
  } catch (e) { toast(e.message, true); }
})();

function fillLists() {
  $('#dlOps').innerHTML = M.operators.map(o => `<option value="${esc(o.name)}">${esc(o.no)}</option>`).join('');
  $('#dlCos').innerHTML = M.coolies.map(o => `<option value="${esc(o.name)}">${esc(o.no)}</option>`).join('');
}

/* ---------- Entry grid ---------- */
function addRow(d = {}) {
  const tb = $('#grid tbody'), tr = document.createElement('tr');
  tr.innerHTML = `
    <td class="sn" style="color:var(--muted)"></td>
    <td><input class="nm" data-f="operator" list="dlOps" value="${esc(d.operator)}" aria-label="Name of operator"></td>
    <td><input class="n" data-f="tno" value="${esc(d.tno)}" aria-label="Operator T. No."></td>
    <td><input class="nm" data-f="coolie" list="dlCos" value="${esc(d.coolie)}" aria-label="Coolie"></td>
    <td><input class="n" data-f="fno" value="${esc(d.fno)}" aria-label="Coolie T. No."></td>
    <td><input class="n" type="number" min="0" data-f="bh" value="${esc(d.bh)}" aria-label="B/H"></td>
    <td><input class="n" type="number" min="0" data-f="jb" value="${esc(d.jb)}" aria-label="J/B"></td>
    <td><input class="n" type="number" min="0" data-f="bd" value="${esc(d.bd)}" aria-label="Breakdown minutes"></td>
    <td class="tot">0</td>
    <td><button class="x" title="Remove row" aria-label="Remove row">×</button></td>`;
  tb.appendChild(tr);
  tr.querySelector('.x').onclick = () => { tr.remove(); renumber(); recalc(); dirty = true; };
  tr.addEventListener('input', e => {
    dirty = true;
    const f = e.target.dataset.f;
    if (f === 'operator') {
      const m = M.operators.find(o => o.name.toLowerCase() === e.target.value.trim().toLowerCase());
      const t = tr.querySelector('[data-f=tno]'); if (m && !t.value) t.value = m.no;
    }
    if (f === 'coolie') {
      const m = M.coolies.find(o => o.name.toLowerCase() === e.target.value.trim().toLowerCase());
      const t = tr.querySelector('[data-f=fno]'); if (m && !t.value) t.value = m.no;
    }
    recalc();
  });
  tr.addEventListener('keydown', e => {
    if (e.key === 'Enter' && e.target.dataset.f === 'bd' && tr === tb.lastElementChild) {
      addRow(); renumber(); tb.lastElementChild.querySelector('input').focus();
    }
  });
  renumber();
}
function renumber() { $$('#grid tbody tr').forEach((r, i) => r.querySelector('.sn').textContent = i + 1); }
$('#addRow').onclick = () => { addRow(); $('#grid tbody tr:last-child input').focus(); };

function collect() {
  return $$('#grid tbody tr').map(tr => {
    const o = {}; tr.querySelectorAll('input').forEach(i => o[i.dataset.f] = i.value.trim()); return o;
  }).filter(o => Object.values(o).some(v => v !== ''));
}

function recalc() {
  let bh = 0, jb = 0, bd = 0, hands = 0;
  $$('#grid tbody tr').forEach(tr => {
    const g = f => tr.querySelector(`[data-f=${f}]`).value;
    const a = num(g('bh')), b = num(g('jb')), c = num(g('bd'));
    tr.querySelector('.tot').textContent = (a + b) || 0;
    bh += a; jb += b; bd += c;
    if (g('operator').trim()) hands++;
  });
  const tot = bh + jb;
  $('#tBH').textContent = bh; $('#tJB').textContent = jb; $('#tBD').textContent = bd; $('#tAll').textContent = tot;
  $('#sHands').textContent = hands; $('#sBed').textContent = tot;
  $('#sAvg').textContent = hands ? (tot / hands).toFixed(1) : 0;
  $('#sBD').textContent = bd ? bd + ' min' : 'Nil';
}

['input', 'change'].forEach(ev => document.querySelectorAll('#eSup,#eBDR,#s6,#s2,#s10,#eRem')
  .forEach(el => el.addEventListener(ev, () => dirty = true)));

function resetForm() {
  $('#grid tbody').innerHTML = '';
  for (let i = 0; i < MIN_ROWS; i++) addRow();
  ['#eSup', '#eBDR', '#s6', '#s2', '#s10', '#eRem'].forEach(s => $(s).value = '');
  recalc(); dirty = false;
}

async function loadShift(silent) {
  try {
    const r = await api('getShift', $('#eDate').value, $('#eShift').value);
    resetForm();
    if (r.exists) {
      $('#grid tbody').innerHTML = '';
      r.lines.forEach(l => addRow(l));
      for (let i = r.lines.length; i < MIN_ROWS; i++) addRow();
      if (r.meta) {
        $('#eSup').value = r.meta.supervisor; $('#eBDR').value = r.meta.bdRemark; $('#eRem').value = r.meta.remarks;
        $('#s6').value = r.meta.s6; $('#s2').value = r.meta.s2; $('#s10').value = r.meta.s10;
      }
      recalc();
    }
    dirty = false;
    setMode(r.exists);
    if (r.exists && !silent) toast('Loaded saved sheet');
  } catch (e) { toast(e.message, true); }
}
['#eDate', '#eShift'].forEach(s => $(s).addEventListener('change', () => {
  if (dirty && !confirm('You have unsaved changes. Discard and switch?')) return;
  loadShift();
}));

$('#saveBtn').onclick = async () => {
  const lines = collect().filter(l => l.operator);
  if (!lines.length) return toast('Add at least one operator', true);
  const names = lines.map(l => l.operator.toLowerCase());
  const dup = names.find((n, i) => names.indexOf(n) !== i);
  if (dup && !confirm(`Operator "${dup}" appears more than once. Save anyway?`)) return;
  const btn = $('#saveBtn'); btn.disabled = true; btn.textContent = 'Saving…';
  try {
    await api('saveShift', {
      date: $('#eDate').value, shift: $('#eShift').value, supervisor: $('#eSup').value,
      s6: $('#s6').value, s2: $('#s2').value, s10: $('#s10').value,
      bdRemark: $('#eBDR').value, remarks: $('#eRem').value, lines
    });
    dirty = false; toast('Saved ✔'); setMode(true);
    M = await api('getInitData'); fillLists(); R.loaded = false;
  } catch (e) { toast(e.message, true); }
  btn.disabled = false; btn.textContent = 'Save sheet';
};
$('#clearBtn').onclick = () => { if (confirm('Clear the form? (Saved data is not deleted)')) resetForm(); };
$('#delBtn').onclick = async () => {
  if (!confirm(`Delete saved sheet for ${fmtD($('#eDate').value)} shift ${$('#eShift').value}? This cannot be undone.`)) return;
  try { await api('deleteShift', $('#eDate').value, $('#eShift').value); resetForm();
    setMode(false); R.loaded = false; toast('Deleted'); }
  catch (e) { toast(e.message, true); }
};

/* ---------- Reports ---------- */
const R = { loaded: false, lines: [], shifts: [], mode: 'detail', cols: [], rows: [], foot: null };
const iso = d => d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
function setRange(a, b) { $('#rFrom').value = a; $('#rTo').value = b; }

$$('.chip').forEach(c => c.onclick = () => {
  const t = new Date(), q = c.dataset.q; let a = new Date(t), b = new Date(t);
  if (q === 'yest') { a.setDate(a.getDate() - 1); b = new Date(a); }
  if (q === 'week') a.setDate(a.getDate() - 6);
  if (q === 'month') a = new Date(t.getFullYear(), t.getMonth(), 1);
  if (q === 'lmonth') { a = new Date(t.getFullYear(), t.getMonth() - 1, 1); b = new Date(t.getFullYear(), t.getMonth(), 0); }
  setRange(iso(a), iso(b)); loadReport();
});
$('#rGo').onclick = loadReport;
$('#rShift').onchange = $('#rSearch').oninput = renderReport;
$$('#rMode button').forEach(b => b.onclick = () => {
  R.mode = b.dataset.m; $$('#rMode button').forEach(x => x.classList.toggle('on', x === b)); renderReport();
});

async function loadReport() {
  const a = $('#rFrom').value, b = $('#rTo').value;
  if (!a || !b || a > b) return toast('Choose a valid date range', true);
  $('#rTable').innerHTML = '<tr><td class="empty">Loading…</td></tr>';
  try {
    const d = await api('getReport', a, b);
    R.lines = d.lines; R.shifts = d.shifts; R.loaded = true; renderReport();
  } catch (e) { toast(e.message, true); }
}

function filtered() {
  const sh = $('#rShift').value, q = $('#rSearch').value.trim().toLowerCase();
  const lines = R.lines.filter(l => (!sh || l.shift === sh) &&
    (!q || [l.operator, l.tno, l.coolie, l.fno].some(v => String(v).toLowerCase().includes(q))));
  const shifts = R.shifts.filter(s => !sh || s.shift === sh);
  return { lines, shifts };
}

function renderReport() {
  if (!R.loaded) return;
  const { lines, shifts } = filtered();
  const sum = (arr, k) => arr.reduce((a, x) => a + x[k], 0);
  const sheetKeys = new Set(lines.map(l => l.date + '|' + l.shift));
  const total = sum(lines, 'total');

  const ops = {};
  lines.forEach(l => {
    const o = ops[l.operator] = ops[l.operator] || { operator: l.operator, tno: l.tno, keys: new Set(), bh: 0, jb: 0, bd: 0, total: 0 };
    o.keys.add(l.date + '|' + l.shift); o.bh += l.bh; o.jb += l.jb; o.bd += l.bd; o.total += l.total;
    if (l.tno) o.tno = l.tno;
  });
  const opRows = Object.values(ops).sort((a, b) => b.total - a.total);
  const top = opRows[0];

  $('#rKpis').innerHTML = `
    <div class="kpi"><b>${fmt(total)}</b><span>Total production</span></div>
    <div class="kpi"><b>${sheetKeys.size}</b><span>Shift sheets</span></div>
    <div class="kpi"><b>${lines.length ? fmt(total / lines.length) : 0}</b><span>Avg per hand-shift</span></div>
    <div class="kpi"><b>${fmt(sum(lines, 'bd'))}</b><span>Breakdown (min)</span></div>
    <div class="kpi"><b>${top ? esc(top.operator) : '–'}</b><span>Top operator${top ? ' (' + fmt(top.total) + ')' : ''}</span></div>`;

  const byDate = {};
  lines.forEach(l => byDate[l.date] = (byDate[l.date] || 0) + l.total);
  const dates = Object.keys(byDate).sort(), mx = Math.max(1, ...Object.values(byDate));
  $('#trend').innerHTML = dates.length ? dates.map(d =>
    `<div class="bar" title="${fmtD(d)}: ${byDate[d]}"><em>${fmt(byDate[d])}</em><i style="height:${Math.max(2, byDate[d] / mx * 70)}px"></i><small>${d.slice(8)}/${d.slice(5, 7)}</small></div>`).join('')
    : '<div class="empty" style="width:100%">No data for this range</div>';

  let cols, rows, foot;
  if (R.mode === 'detail') {
    cols = ['Date', 'Shift', 'S.No', 'Operator', 'T.No', 'Coolie', 'Coolie F.No', 'B/H', 'J/B', 'B/D (min)', 'Total'];
    rows = lines.slice().sort((a, b) => (a.date + a.shift).localeCompare(b.date + b.shift) || a.sno - b.sno)
      .map(l => [fmtD(l.date), l.shift, l.sno, l.operator, l.tno, l.coolie, l.fno, l.bh, l.jb, l.bd, l.total]);
    foot = ['Total', '', '', '', '', '', '', sum(lines, 'bh'), sum(lines, 'jb'), sum(lines, 'bd'), total];
  } else if (R.mode === 'operator') {
    cols = ['Operator', 'T.No', 'Shifts Worked', 'B/H', 'J/B', 'B/D (min)', 'Total', 'Avg / Shift'];
    rows = opRows.map(o => [o.operator, o.tno, o.keys.size, o.bh, o.jb, o.bd, o.total, +(o.total / o.keys.size).toFixed(1)]);
    foot = ['Total', '', '', sum(opRows, 'bh'), sum(opRows, 'jb'), sum(opRows, 'bd'), total,
            sheetKeys.size ? +(total / lines.length).toFixed(1) : 0];
  } else {
    const g = {};
    lines.forEach(l => {
      const k = l.date + '|' + l.shift;
      const o = g[k] = g[k] || { date: l.date, shift: l.shift, hands: 0, bh: 0, jb: 0, bd: 0, total: 0 };
      o.hands++; o.bh += l.bh; o.jb += l.jb; o.bd += l.bd; o.total += l.total;
    });
    const meta = {}; shifts.forEach(s => meta[s.date + '|' + s.shift] = s);
    cols = ['Date', 'Shift', 'Supervisor', 'Hands', 'B/H', 'J/B', 'Total (Bed)', 'Avg / Hand', 'B/D (min)', 'Stock 6AM', 'Stock 2PM', 'Stock 10PM', 'B/D Remark', 'Remarks'];
    const list = Object.values(g).sort((a, b) => (a.date + a.shift).localeCompare(b.date + b.shift));
    rows = list.map(o => { const m = meta[o.date + '|' + o.shift] || {};
      return [fmtD(o.date), o.shift, m.supervisor || '', o.hands, o.bh, o.jb, o.total, +(o.total / o.hands).toFixed(1),
              o.bd, m.s6 ?? '', m.s2 ?? '', m.s10 ?? '', m.bdRemark || '', m.remarks || '']; });
    foot = ['Total', '', '', sum(list, 'hands'), sum(list, 'bh'), sum(list, 'jb'), total,
            list.length ? +(total / sum(list, 'hands')).toFixed(1) : 0, sum(list, 'bd'), '', '', '', '', ''];
  }
  R.cols = cols; R.rows = rows; R.foot = rows.length ? foot : null;

  const isNum = v => typeof v === 'number';
  $('#rTable').innerHTML = rows.length
    ? `<thead><tr>${cols.map((c, i) => `<th class="${isNum(rows[0][i]) && i > 2 ? 'num' : ''}">${esc(c)}</th>`).join('')}</tr></thead>
       <tbody>${rows.map(r => `<tr>${r.map((v, i) => `<td class="${isNum(v) && i > 2 ? 'num' : ''}">${esc(isNum(v) ? fmt(v) : v)}</td>`).join('')}</tr>`).join('')}</tbody>
       <tfoot><tr>${foot.map((v, i) => `<td class="${isNum(v) && i > 2 ? 'num' : ''}">${esc(isNum(v) ? fmt(v) : v)}</td>`).join('')}</tr></tfoot>`
    : '<tr><td class="empty">No records for the selected filters. Try a wider date range.</td></tr>';
}

$('#csvBtn').onclick = () => {
  if (!R.rows.length) return toast('Nothing to download', true);
  const q = v => { v = String(v ?? ''); return /[",\n]/.test(v) ? '"' + v.replace(/"/g, '""') + '"' : v; };
  const all = [R.cols, ...R.rows, R.foot].filter(Boolean);
  const csv = '\uFEFF' + all.map(r => r.map(q).join(',')).join('\r\n');
  const a = document.createElement('a');
  a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8;' }));
  a.download = `hemming_${R.mode}_${$('#rFrom').value}_to_${$('#rTo').value}.csv`;
  document.body.appendChild(a); a.click(); a.remove();
  toast('CSV downloaded');
};

/* ---------- Logbook ---------- */
function renderLogbook() {
  const draw = (id, arr, type) => $(id).innerHTML = arr.length
    ? `<thead><tr><th>Name</th><th>${type === 'op' ? 'T. No.' : 'F. No.'}</th><th></th></tr></thead><tbody>` +
      arr.map(o => `<tr><td>${esc(o.name)}</td><td>${esc(o.no)}</td>
        <td style="text-align:right"><button class="btn bad sm" data-del="${type}" data-name="${esc(o.name)}">Delete</button></td></tr>`).join('') + '</tbody>'
    : '<tr><td class="empty">No names yet. Add one above, or save a sheet.</td></tr>';
  draw('#mOps', M.operators, 'op'); draw('#mCos', M.coolies, 'co');
}
document.addEventListener('click', async e => {
  const t = e.target;
  try {
    if (t.dataset.add) {
      const op = t.dataset.add === 'op';
      const name = $(op ? '#mOpName' : '#mCoName').value.trim(), no = $(op ? '#mOpNo' : '#mCoNo').value.trim();
      if (!name) return toast('Enter a name', true);
      M = await api('saveMaster', t.dataset.add, name, no);
      $(op ? '#mOpName' : '#mCoName').value = ''; $(op ? '#mOpNo' : '#mCoNo').value = '';
      fillLists(); renderLogbook(); toast('Added');
    }
    if (t.dataset.del) {
      if (!confirm('Delete ' + t.dataset.name + ' from the Logbook? (Past records stay unchanged)')) return;
      M = await api('deleteMaster', t.dataset.del, t.dataset.name); fillLists(); renderLogbook();
    }
  } catch (err) { toast(err.message, true); }
});
</script>
</body>
</html>

