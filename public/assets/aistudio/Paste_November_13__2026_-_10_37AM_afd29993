   '<button class="btn ghost sm addC">+ Column</button><button class="btn ghost sm addR">+ Row</button><button class="btn ghost sm rmM">Remove machine</button><div class="mt"></div></div>'+
   '<div class="tw"><table><thead><tr><th>#</th>'+INCHES.map(th).join('')+'</tr></thead><tbody>'+rows+'</tbody>'+
   '<tfoot><tr><td>Total</td>'+'<td></td>'.repeat(4)+'</tr><tr><td>Cuts</td>'+'<td></td>'.repeat(4)+'</tr></tfoot></table></div><div class="qs"></div>';
