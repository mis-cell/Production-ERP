</div>

<div class="tabs no-print">
  <button id="tab-logbook" class="active" onclick="showMainTab('logbook')">&#128220; Log Book</button>
  <button id="tab-breakdown" onclick="showMainTab('breakdown')">&#9881; Machine Breakdown</button>
