  <div class="toast" id="toast"></div>

<script>
  /* ============================================================
     AUTH
  ============================================================ */
  function doLogin() {
    var user = document.getElementById('loginUser').value.trim();
    var pass = document.getElementById('loginPass').value.trim();
    var errEl = document.getElementById('loginError');
    var btn = document.getElementById('loginBtn');
    if (!user || !pass) {
      errEl.textContent = 'Please enter username and password.';
      return;
    }
    errEl.textContent = '';
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner"></span>Signing in...';

    google.script.run
      .withSuccessHandler(function (ok) {
        btn.disabled = false;
        btn.textContent = 'Login';
        if (ok) {
          document.getElementById('loginScreen').style.display = 'none';
          document.getElementById('appScreen').style.display = 'block';
          initDefaults();
        } else {
          errEl.textContent = 'Invalid username or password.';
        }
      })
      .withFailureHandler(function (err) {
        btn.disabled = false;
        btn.textContent = 'Login';
        errEl.textContent = 'Error: ' + err.message;
      })
      .checkLogin(user, pass);
  }

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && document.getElementById('loginScreen').style.display !== 'none') {
      doLogin();
    }
  });

  function doLogout() {
    document.getElementById('appScreen').style.display = 'none';
    document.getElementById('loginScreen').style.display = 'flex';
    document.getElementById('loginUser').value = '';
    document.getElementById('loginPass').value = '';
    document.getElementById('loginError').textContent = '';
  }

  /* ============================================================
     TABS
  ============================================================ */
  function showTab(name) {
    document.querySelectorAll('.tabpage').forEach(function (el) { el.style.display = 'none'; });
    document.getElementById('tab-' + name).style.display = 'block';
    document.querySelectorAll('.navtab').forEach(function (el) {
      el.classList.toggle('active', el.getAttribute('data-tab') === name);
    });
  }

  function todayStr() {
    var d = new Date();
    var mm = String(d.getMonth() + 1).padStart(2, '0');
    var dd = String(d.getDate()).padStart(2, '0');
    return d.getFullYear() + '-' + mm + '-' + dd;
  }

  function initDefaults() {
    var t = todayStr();
    [
      'lb-date', 'mb-date', 'pr-date',
      'rp-lb-start', 'rp-lb-end',
      'rp-mb-start', 'rp-mb-end',
      'rp-pr-start', 'rp-pr-end'
    ].forEach(function (id) {
      document.getElementById(id).value = t;
    });
    addBreakdownRow();
    addProductionRow();
    loadLogBookDashboard();
    loadBreakdownDashboard();
    loadProductionDashboard();
  }

  /* ============================================================
     PER-TAB DASHBOARDS (shows entries already saved for the
     currently selected date + shift)
  ============================================================ */
  function dashLabel(date, shift) {
    if (!date) return '';
    return date + ' · Shift ' + shift;
  }

  function loadLogBookDashboard() {
    var date = document.getElementById('lb-date').value;
    var shift = document.getElementById('lb-shift').value;
    document.getElementById('lb-dash-label').textContent = dashLabel(date, shift);
    var target = document.getElementById('lb-dash-table');
    target.innerHTML = '<p class="empty-note">Loading...</p>';
    google.script.run
      .withSuccessHandler(function (block) { target.innerHTML = buildTable(block, true); })
      .withFailureHandler(function (err) { target.innerHTML = '<p class="empty-note">Error: ' + err.message + '</p>'; })
      .getLogBookEntries(date, shift);
  }

  function loadBreakdownDashboard() {
    var date = document.getElementById('mb-date').value;
    var shift = document.getElementById('mb-shift').value;
    document.getElementById('mb-dash-label').textContent = dashLabel(date, shift);
    var target = document.getElementById('mb-dash-table');
    target.innerHTML = '<p class="empty-note">Loading...</p>';
    google.script.run
      .withSuccessHandler(function (block) { target.innerHTML = buildTable(block, true); })
      .withFailureHandler(function (err) { target.innerHTML = '<p class="empty-note">Error: ' + err.message + '</p>'; })
      .getBreakdownEntries(date, shift);
  }

  function loadProductionDashboard() {
    var date = document.getElementById('pr-date').value;
    var shift = document.getElementById('pr-shift').value;
    document.getElementById('pr-dash-label').textContent = dashLabel(date, shift);
    var target = document.getElementById('pr-dash-table');
    target.innerHTML = '<p class="empty-note">Loading...</p>';
    google.script.run
      .withSuccessHandler(function (block) { target.innerHTML = buildTable(block, true); })
      .withFailureHandler(function (err) { target.innerHTML = '<p class="empty-note">Error: ' + err.message + '</p>'; })
      .getProductionEntries(date, shift);
  }

  /* ============================================================
     TOAST
  ============================================================ */
  function showToast(msg, isError) {
    var t = document.getElementById('toast');
    t.textContent = msg;
    t.className = 'toast' + (isError ? ' error' : '');
    t.style.display = 'block';
    setTimeout(function () { t.style.display = 'none'; }, 3200);
  }

  /* ============================================================
     LOG BOOK
  ============================================================ */
  function saveLogBook() {
    var data = {
      date: document.getElementById('lb-date').value,
      shift: document.getElementById('lb-shift').value,
      rotation: document.getElementById('lb-rotation').value,
      idleMachine: document.getElementById('lb-idle').value,
      shiftChange: document.getElementById('lb-shiftchange').value,
      instructions: document.getElementById('lb-instructions').value
    };
    if (!data.date) { showToast('Please select a date.', true); return; }
    var btn = document.getElementById('lb-savebtn');
    btn.disabled = true; btn.innerHTML = '<span class="spinner"></span>Saving...';
    google.script.run
      .withSuccessHandler(function (res) {
        btn.disabled = false; btn.textContent = 'Save Log';
        showToast(res.message, res.status !== 'success');
        if (res.status === 'success') {
          document.getElementById('lb-rotation').value = '';
          document.getElementById('lb-idle').value = '';
          document.getElementById('lb-shiftchange').value = '';
          document.getElementById('lb-instructions').value = '';
          loadLogBookDashboard();
        }
      })
      .withFailureHandler(function (err) {
        btn.disabled = false; btn.textContent = 'Save Log';
        showToast('Error: ' + err.message, true);
      })
      .saveLogBook(data);
  }

  /* ============================================================
     MACHINE BREAKDOWN
  ============================================================ */
  function timeToMinutes(t) {
    if (!t) return null;
    var parts = t.split(':');
    if (parts.length < 2) return null;
    var h = parseInt(parts[0], 10), m = parseInt(parts[1], 10);
    if (isNaN(h) || isNaN(m)) return null;
    return h * 60 + m;
  }
  function minutesToTime(mins) {
    var h = Math.floor(mins / 60), m = mins % 60;
    return String(h).padStart(2, '0') + ':' + String(m).padStart(2, '0');
  }

  function addBreakdownRow() {
    var tbody = document.getElementById('mb-tbody');
    var tr = document.createElement('tr');
    tr.innerHTML =
      '<td><input type="text" class="mb-machine" placeholder="e.g. RF-12"></td>' +
      '<td><input type="text" class="mb-reason" placeholder="Reason"></td>' +
      '<td><input type="time" class="mb-start" onchange="calcBreak(this)"></td>' +
      '<td><input type="time" class="mb-end" onchange="calcBreak(this)"></td>' +
      '<td><input type="text" class="mb-break" readonly></td>' +
      '<td class="row-actions"><button class="del-row" onclick="this.closest(\'tr\').remove()">Remove</button></td>';
    tbody.appendChild(tr);
  }

  function calcBreak(el) {
    var tr = el.closest('tr');
    var start = tr.querySelector('.mb-start').value;
    var end = tr.querySelector('.mb-end').value;
    var breakField = tr.querySelector('.mb-break');
    var sMin = timeToMinutes(start), eMin = timeToMinutes(end);
    if (sMin === null || eMin === null) { breakField.value = ''; return; }
    var diff = eMin - sMin;
    if (diff < 0) diff += 24 * 60; // crosses midnight
    breakField.value = minutesToTime(diff);
  }

  function saveBreakdown() {
    var date = document.getElementById('mb-date').value;
    var shift = document.getElementById('mb-shift').value;
    if (!date) { showToast('Please select a date.', true); return; }
    var rows = [];
    document.querySelectorAll('#mb-tbody tr').forEach(function (tr) {
      var machineNo = tr.querySelector('.mb-machine').value.trim();
      var reason = tr.querySelector('.mb-reason').value.trim();
      var startTime = tr.querySelector('.mb-start').value;
      var endTime = tr.querySelector('.mb-end').value;
      var breakTime = tr.querySelector('.mb-break').value;
      if (machineNo || reason || startTime || endTime) {
        rows.push({ machineNo: machineNo, reason: reason, startTime: startTime, endTime: endTime, breakTime: breakTime });
      }
    });
    if (rows.length === 0) { showToast('Add at least one machine row.', true); return; }
    var btn = document.getElementById('mb-savebtn');
    btn.disabled = true; btn.innerHTML = '<span class="spinner"></span>Saving...';
    google.script.run
      .withSuccessHandler(function (res) {
        btn.disabled = false; btn.textContent = 'Save Log';
        showToast(res.message, res.status !== 'success');
        if (res.status === 'success') {
          document.getElementById('mb-tbody').innerHTML = '';
          addBreakdownRow();
          loadBreakdownDashboard();
        }
      })
      .withFailureHandler(function (err) {
        btn.disabled = false; btn.textContent = 'Save Log';
        showToast('Error: ' + err.message, true);
      })
      .saveMachineBreakdown({ date: date, shift: shift, rows: rows });
  }

  /* ============================================================
     PRODUCTION
  ============================================================ */
  function addProductionRow() {
    var tbody = document.getElementById('pr-tbody');
    var tr = document.createElement('tr');
    tr.innerHTML =
      '<td><input type="text" class="pr-quality" placeholder="e.g. 30s Combed"></td>' +
      '<td><input type="number" class="pr-frame" step="any" onchange="calcProdFrame(this)"></td>' +
      '<td><input type="number" class="pr-production" step="any" onchange="calcProdFrame(this)"></td>' +
      '<td><input type="text" class="pr-pf" readonly></td>' +
      '<td class="row-actions"><button class="del-row" onclick="this.closest(\'tr\').remove()">Remove</button></td>';
    tbody.appendChild(tr);
  }

  function calcProdFrame(el) {
    var tr = el.closest('tr');
    var frame = parseFloat(tr.querySelector('.pr-frame').value);
    var production = parseFloat(tr.querySelector('.pr-production').value);
    var pf = tr.querySelector('.pr-pf');
    if (!frame || isNaN(frame) || isNaN(production)) { pf.value = ''; return; }
    pf.value = Math.round(production / frame);
  }

  function saveProduction() {
    var date = document.getElementById('pr-date').value;
    var shift = document.getElementById('pr-shift').value;
    if (!date) { showToast('Please select a date.', true); return; }
    var rows = [];
    document.querySelectorAll('#pr-tbody tr').forEach(function (tr) {
      var quality = tr.querySelector('.pr-quality').value.trim();
      var frame = tr.querySelector('.pr-frame').value;
      var production = tr.querySelector('.pr-production').value;
      var pf = tr.querySelector('.pr-pf').value;
      if (quality || frame || production) {
        rows.push({ quality: quality, frame: frame, production: production, productionPerFrame: pf });
      }
    });
    if (rows.length === 0) { showToast('Add at least one quality row.', true); return; }
    var btn = document.getElementById('pr-savebtn');
    btn.disabled = true; btn.innerHTML = '<span class="spinner"></span>Saving...';
    google.script.run
      .withSuccessHandler(function (res) {
        btn.disabled = false; btn.textContent = 'Save Log';
        showToast(res.message, res.status !== 'success');
        if (res.status === 'success') {
          document.getElementById('pr-tbody').innerHTML = '';
          addProductionRow();
        }
      })
      .withFailureHandler(function (err) {
        btn.disabled = false; btn.textContent = 'Save Log';
        showToast('Error: ' + err.message, true);
      })
      .saveProduction({ date: date, shift: shift, rows: rows });
  }

  /* ============================================================
     REPORT (each section has its own independent filter)
  ============================================================ */
  function runSectionReport(prefix, backendFn) {
    var filters = {
      startDate: document.getElementById('rp-' + prefix + '-start').value,
      endDate: document.getElementById('rp-' + prefix + '-end').value,
      shift: document.getElementById('rp-' + prefix + '-shift').value
    };
    var btn = document.getElementById('rp-' + prefix + '-btn');
    var target = document.getElementById('rp-' + prefix + '-results');
    btn.disabled = true; btn.innerHTML = '<span class="spinner"></span>Loading...';
    google.script.run
      .withSuccessHandler(function (block) {
        btn.disabled = false; btn.textContent = 'Generate Report';
        target.innerHTML = buildTable(block);
      })
      .withFailureHandler(function (err) {
        btn.disabled = false; btn.textContent = 'Generate Report';
        showToast('Error: ' + err.message, true);
      })
      [backendFn](filters);
  }

  function generateLogBookReport() {
    runSectionReport('lb', 'getLogBookReport');
  }
  function generateBreakdownReport() {
    runSectionReport('mb', 'getBreakdownReport');
  }
  function generateProductionReport() {
    runSectionReport('pr', 'getProductionReport');
  }

  // hideSavedAt: when true, drops the "Saved At" column from the rendered
  // table (used for the per-tab dashboards). The Report tab keeps it.
  function buildTable(block, hideSavedAt) {
    var headers = block.headers;
    var rows = block.rows;
    var skipIndex = -1;

    if (hideSavedAt) {
      skipIndex = headers.indexOf('Saved At');
      if (skipIndex !== -1) {
        headers = headers.filter(function (h, i) { return i !== skipIndex; });
      }
    }

    if (!rows.length) {
      return '<p class="empty-note">No records found for the selected filters.</p>';
    }
    var html = '<div class="table-scroll"><table class="datatable"><thead><tr>';
    headers.forEach(function (h) { html += '<th>' + h + '</th>'; });
    html += '</tr></thead><tbody>';
    rows.forEach(function (row) {
      var displayRow = (skipIndex !== -1) ? row.filter(function (c, i) { return i !== skipIndex; }) : row;
      html += '<tr>';
      displayRow.forEach(function (cell) { html += '<td>' + (cell === '' || cell === null || cell === undefined ? '-' : cell) + '</td>'; });
      html += '</tr>';
    });
    html += '</tbody></table></div>';
    return html;
  }


</script>
