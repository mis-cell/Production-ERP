    <h2>Settings</h2>
    <div class="row">
      <div class="f" style="max-width:260px"><label for="setUnit">Fabric length unit</label>
        <select id="setUnit"><option value="m">Meters (m)</option><option value="yd">Yards (yd)</option></select></div>
      <div class="f" style="max-width:260px"><label for="setTol">Moisture tolerance (± points)</label>
        <input id="setTol" type="number" min="0.1" max="10" step="0.1"></div>
      <button class="btn sec" id="saveTol">Save tolerance</button>
    </div>
    <p class="hint" style="margin:12px 0 0">A run is "OK" when Moisture After is within the tolerance of the Target (for example ±1.0 point around 18%). Above is "Over", below is "Under".</p>
  </div>
  <p class="hint">Names are also added to the Logbook automatically each time you save a sheet.</p>
</section>
</main>

<datalist id="dlOps"></datalist>
<datalist id="dlMcs"></datalist>
<div id="toast"></div>

<script>
const $ = s => document.querySelector(s);
const $$ = s => [...document.querySelectorAll(s)];
const esc = s => String(s ?? '').replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const num = v => { const x = parseFloat(v); return isNaN(x) || x < 0 ? 0 : x; };
const nul = v => v === null || v === undefined;
const fmt = n => nul(n) ? '–' : (Math.round(n * 100) / 100).toLocaleString('en-IN', { maximumFractionDigits: 2 });
const fmtS = n => nul(n) ? '–' : (n > 0 ? '+' : '') + fmt(n);              // signed
const pct = n => nul(n) ? '–' : fmt(n) + '%';
const r2 = v => nul(v) ? null : Math.round(v * 100) / 100;
const fmtD = d => d ? d.split('-').reverse().join('/') : '';

function api(fn, ...args) {
  return new Promise((res, rej) => {
    google.script.run.withSuccessHandler(res).withFailureHandler(e => rej(new Error(e.message || e)))[fn](...args);
  });
}
function toast(msg, err) {
  const t = $('#toast'); t.textContent = msg; t.className = 'show' + (err ? ' err' : '');
  clearTimeout(toast.t); toast.t = setTimeout(() => t.className = '', 3200);
}

let M = { operators: [], machines: [], unit: 'm', tol: 1 };
const VAR_LIMIT = 2;   // weight variance % above which a value is flagged

/* ---------- Calculation core (used by Entry and Reports) ----------
   Every row becomes a small set of "sums". Groups and totals add the sums together and then
   derive the metrics, so weighted averages and percentages are always correct. */
const toS = l => {
  const inWt = num(l.inwt), inLen = num(l.inlen), out = num(l.outwt), used = num(l.used), time = num(l.time),
        mb = num(l.mb), tm = num(l.tm), ma = num(l.ma), has = out > 0, wo = has ? out : inWt;
  const dev = (ma > 0 && tm > 0) ? ma - tm : null;
  const expOk = mb > 0 && ma > 0 && has && inWt > 0;
  const dry = mb > 0 ? inWt * (1 - mb / 100) : 0;
  const exp = expOk ? dry / (1 - ma / 100) : 0;
  const eOk = has && used > 0, tOk = time > 0 && inLen > 0;
  return {
    runs: 1, inWt, inLen, out, used, time, dry,
    mbW: mb > 0 ? inWt * mb : 0, mbB: mb > 0 ? inWt : 0,
    tmW: tm > 0 ? wo * tm : 0, tmB: tm > 0 ? wo : 0,
    maW: ma > 0 ? wo * ma : 0, maB: ma > 0 ? wo : 0,
    devW: dev !== null ? wo * dev : 0, devB: dev !== null ? wo : 0,
    water: has ? out - inWt : 0, wIn: has ? inWt : 0,
    eW: eOk ? out - inWt : 0, eU: eOk ? used : 0,
    exp, vK: expOk ? out - exp : 0,
    tL: tOk ? inLen : 0, tT: tOk ? time : 0,
    st: dev !== null ? 1 : 0, ok: dev !== null && Math.abs(dev) <= M.tol + 1e-9 ? 1 : 0
  };
};
const zeroS = () => Object.keys(toS({})).reduce((a, k) => (a[k] = 0, a), {});
const addS = (a, b) => { for (const k in b) a[k] = (a[k] || 0) + b[k]; return a; };
const metrics = s => ({
  dry: s.dry > 0 ? s.dry : null,
  water: s.wIn > 0 ? s.water : null,                                  // Water Added
  mb: s.mbB > 0 ? s.mbW / s.mbB : null,                               // Avg Moisture Before
  tm: s.tmB > 0 ? s.tmW / s.tmB : null,                               // Avg Target
  ma: s.maB > 0 ? s.maW / s.maB : null,                               // Avg Moisture After
  dev: s.devB > 0 ? s.devW / s.devB : null,                           // Moisture Deviation (pts)
  pickup: s.wIn > 0 ? s.water / s.wIn * 100 : null,                   // Water Pick-up %
  vk: s.exp > 0 ? s.vK : null,                                        // Weight Variance (kg)
  vp: s.exp > 0 ? s.vK / s.exp * 100 : null,                          // Weight Variance %
  eff: s.eU > 0 ? s.eW / s.eU * 100 : null,                           // Water Efficiency %
  thru: s.tT > 0 ? s.tL / s.tT : null,                                // Throughput per minute
  inSpec: s.st > 0 ? s.ok / s.st * 100 : null                         // Runs within tolerance %
});
const statusOf = (s, m) => s.st ? (s.ok ? 'OK' : (m.dev > 0 ? 'Over' : 'Under')) : null;
const hasData = l => !!(l.roll || num(l.inwt) || num(l.inlen) || num(l.outwt) || num(l.used));

let dirty = false;
const MIN_ROWS = 10;
const setMode = editing => { $('#eMode').value = editing ? 'Editing saved sheet' : 'New entry'; };
const applyUnit = () => $$('.lu').forEach(e => e.textContent = M.unit);

/* ---------- Tabs ---------- */
$$('nav button').forEach(b => b.onclick = () => {
  $$('nav button').forEach(x => x.classList.toggle('active', x === b));
  ['entry', 'report', 'logbook'].forEach(id => $('#' + id).classList.toggle('hidden', id !== b.dataset.tab));
  if (b.dataset.tab === 'report' && !R.loaded) loadReport();
  if (b.dataset.tab === 'logbook') renderLogbook();
});

/* ---------- Init ---------- */
(async function init() {
  try {
    const d = await api('getInitData');
    M = d; fillLists(); applyUnit();
    $('#eDate').value = d.today;
    setRange(d.today, d.today);
    for (let i = 0; i < MIN_ROWS; i++) addRow();
    recalc();
    await loadShift(true);
  } catch (e) { toast(e.message, true); }
})();

function fillLists() {
  $('#dlOps').innerHTML = M.operators.map(o => `<option value="${esc(o.name)}">${esc(o.no)}</option>`).join('');
  $('#dlMcs').innerHTML = M.machines.map(o => `<option value="${esc(o.name)}">${esc(o.no)}</option>`).join('');
}

/* ---------- Entry grid ---------- */
const rowData = tr => { const o = {}; tr.querySelectorAll('input').forEach(i => o[i.dataset.f] = i.value.trim()); return o; };

function addRow(d = {}) {
  const tb = $('#grid tbody'), tr = document.createElement('tr');
  const txt = (f, cls, aria, ph) => `<td><input class="${cls}" data-f="${f}" value="${esc(d[f])}" aria-label="${aria}" placeholder="${ph || ''}"></td>`;
  const nm = (f, aria, step) => `<td><input class="n" type="number" min="0" step="${step || 'any'}" inputmode="decimal" data-f="${f}" value="${esc(d[f])}" aria-label="${aria}"></td>`;
  const cc = k => `<td class="calc" data-c="${k}">–</td>`;
  tr.innerHTML = `
    <td class="sn" style="color:var(--muted)"></td>
    <td><input class="nm" data-f="operator" list="dlOps" value="${esc(d.operator)}" aria-label="Operator"></td>
    ${txt('tno', 'n', 'Operator T. No.')}
    <td><input class="nm" data-f="machine" list="dlMcs" value="${esc(d.machine)}" aria-label="Machine"></td>
    ${txt('roll', 'id', 'Roll or beam ID', 'Scan or type')}
    ${nm('inwt', 'Input weight kg')}
    ${nm('inlen', 'Input length')}
    ${nm('mb', 'Moisture before percent', 0.1)}
    ${nm('tm', 'Target moisture percent', 0.1)}
    ${nm('ma', 'Moisture after percent', 0.1)}
    ${nm('outwt', 'Output weight kg')}
    ${nm('used', 'Water used litres')}
    ${nm('time', 'Run time minutes')}
    ${cc('dry')}${cc('water')}${cc('pick')}${cc('dev')}${cc('vk')}${cc('vp')}${cc('eff')}${cc('thru')}
    <td class="calc st" data-c="st">–</td>
    <td><button class="x" title="Remove row" aria-label="Remove row">×</button></td>`;
  tb.appendChild(tr);
  tr.querySelector('.x').onclick = () => { tr.remove(); renumber(); recalc(); dirty = true; };
  tr.addEventListener('input', e => {
    dirty = true;
    if (e.target.dataset.f === 'operator') {
      const m = M.operators.find(o => o.name.toLowerCase() === e.target.value.trim().toLowerCase());
      const t = tr.querySelector('[data-f=tno]'); if (m && !t.value) t.value = m.no;
    }
    recalc();
  });
  tr.addEventListener('keydown', e => {
    if (e.key !== 'Enter' || e.target.tagName !== 'INPUT') return;
    e.preventDefault();                                   // barcode scanners send Enter after each scan
    const ins = [...tr.querySelectorAll('input')], i = ins.indexOf(e.target);
    if (i < ins.length - 1) { ins[i + 1].focus(); ins[i + 1].select(); return; }
    let next = tr.nextElementSibling;
    if (!next) { addRow(inherit(tr)); next = tb.lastElementChild; }
    focusStart(next);
  });
  renumber();
  return tr;
}
const inherit = tr => { const o = rowData(tr); return { operator: o.operator, tno: o.tno, machine: o.machine, tm: o.tm }; };
const focusStart = tr => tr.querySelector(tr.querySelector('[data-f=operator]').value ? '[data-f=roll]' : '[data-f=operator]').focus();
function renumber() { $$('#grid tbody tr').forEach((r, i) => r.querySelector('.sn').textContent = i + 1); }
$('#addRow').onclick = () => {
  const last = $('#grid tbody').lastElementChild;
  const tr = addRow(last ? inherit(last) : {}); recalc(); focusStart(tr);
};

function recalc() {
  const tot = zeroS();
  $$('#grid tbody tr').forEach(tr => {
    const l = rowData(tr), s = toS(l), m = metrics(s), st = statusOf(s, m);
    const set = (k, txt, warn, title, good) => {
      const c = tr.querySelector(`[data-c=${k}]`);
      c.textContent = txt; c.classList.toggle('warn', !!warn); c.classList.toggle('good', !!good);
      c.title = warn ? title : '';
    };
    const badMoist = st === 'Over' || st === 'Under';
    const moistMsg = `Moisture is ${st === 'Over' ? 'above' : 'below'} the target by more than the ±${M.tol} point tolerance.`;
    const varBad = m.vp !== null && Math.abs(m.vp) > VAR_LIMIT;
    const varMsg = 'Output weight differs from what the measured moisture predicts. Check the scale and the moisture meter.';
    set('dry', fmt(m.dry));
    set('water', fmtS(m.water), m.water !== null && m.water < 0, 'Output is lighter than input. Check the weights.');
    set('pick', fmt(m.pickup));
    set('dev', fmtS(m.dev), badMoist, moistMsg);
    set('vk', fmtS(m.vk), varBad, varMsg);
    set('vp', fmtS(m.vp), varBad, varMsg);
    set('eff', fmt(m.eff), m.eff !== null && m.eff > 100, 'More water was absorbed than was used. Check the water reading.');
    set('thru', fmt(m.thru));
    set('st', st || '–', badMoist, moistMsg, st === 'OK');
    if (hasData(l)) addS(tot, s);
  });
  const m = metrics(tot), put = (id, v) => $(id).textContent = v;
  put('#tIW', fmt(tot.inWt)); put('#tIL', fmt(tot.inLen)); put('#tMB', fmt(m.mb)); put('#tTM', fmt(m.tm));
  put('#tMA', fmt(m.ma)); put('#tOW', fmt(tot.out)); put('#tUS', fmt(tot.used)); put('#tTI', fmt(tot.time));
  put('#tDRY', fmt(m.dry)); put('#tWAT', fmtS(m.water)); put('#tPICK', fmt(m.pickup)); put('#tDEV', fmtS(m.dev));
  put('#tVK', fmtS(m.vk)); put('#tVP', fmtS(m.vp)); put('#tEFF', fmt(m.eff)); put('#tTHR', fmt(m.thru));
  put('#tST', tot.st ? `${tot.ok}/${tot.st} OK` : '–');
  put('#kRuns', tot.runs); put('#kIW', fmt(tot.inWt)); put('#kOW', fmt(tot.out)); put('#kUS', fmt(tot.used));
  put('#kMB', pct(m.mb)); put('#kTM', pct(m.tm)); put('#kMA', pct(m.ma)); put('#kDEV', fmtS(m.dev));
  put('#kWAT', fmtS(m.water)); put('#kPICK', pct(m.pickup)); put('#kEFF', pct(m.eff)); put('#kVP', nul(m.vp) ? '–' : fmtS(m.vp) + '%');
  put('#kTHR', fmt(m.thru)); put('#kOK', tot.st ? `${tot.ok}/${tot.st}` : '–');
}

['input', 'change'].forEach(ev => document.querySelectorAll('#eSup,#eRem')
  .forEach(el => el.addEventListener(ev, () => dirty = true)));

function resetForm() {
  $('#grid tbody').innerHTML = '';
  for (let i = 0; i < MIN_ROWS; i++) addRow();
  ['#eSup', '#eRem'].forEach(s => $(s).value = '');
  recalc(); dirty = false;
}

async function loadShift(silent) {
  try {
    const r = await api('getShift', $('#eDate').value, $('#eShift').value);
    resetForm();
    if (r.exists) {
      $('#grid tbody').innerHTML = '';
      r.lines.forEach(l => addRow(l));
      for (let i = r.lines.length; i < MIN_ROWS; i++) addRow();
      if (r.meta) { $('#eSup').value = r.meta.supervisor; $('#eRem').value = r.meta.remarks; }
      recalc();
    }
    dirty = false;
    setMode(r.exists);
    if (r.exists && !silent) toast('Loaded saved sheet');
  } catch (e) { toast(e.message, true); }
}
['#eDate', '#eShift'].forEach(s => $(s).addEventListener('change', () => {
  if (dirty && !confirm('You have unsaved changes. Discard and switch?')) return;
  loadShift();
}));

$('#saveBtn').onclick = async () => {
  const rows = $$('#grid tbody tr'), lines = [];
  for (let i = 0; i < rows.length; i++) {
    const l = rowData(rows[i]);
    if (!hasData(l)) continue;
    if (!l.operator) return toast(`Row ${i + 1}: enter the operator name`, true);
    lines.push(l);
  }
  if (!lines.length) return toast('Add at least one damping run', true);
  const ids = lines.map(l => l.roll.toLowerCase()).filter(Boolean);
  const dup = ids.find((n, i) => ids.indexOf(n) !== i);
  if (dup && !confirm(`Roll / Beam ID "${dup}" appears more than once on this sheet. Save anyway?`)) return;
  const btn = $('#saveBtn'); btn.disabled = true; btn.textContent = 'Saving…';
  try {
    await api('saveShift', {
      date: $('#eDate').value, shift: $('#eShift').value, supervisor: $('#eSup').value,
      remarks: $('#eRem').value, lines
    });
    dirty = false; toast('Saved ✔'); setMode(true);
    M = await api('getInitData'); fillLists(); R.loaded = false;
  } catch (e) { toast(e.message, true); }
  btn.disabled = false; btn.textContent = 'Save sheet';
};
$('#clearBtn').onclick = () => { if (confirm('Clear the form? (Saved data is not deleted)')) resetForm(); };
$('#delBtn').onclick = async () => {
  if (!confirm(`Delete saved sheet for ${fmtD($('#eDate').value)} shift ${$('#eShift').value}? This cannot be undone.`)) return;
  try { await api('deleteShift', $('#eDate').value, $('#eShift').value); resetForm();
    setMode(false); R.loaded = false; toast('Deleted'); }
  catch (e) { toast(e.message, true); }
};

/* ---------- Reports ---------- */
const R = { loaded: false, lines: [], shifts: [], mode: 'detail', cols: [], rows: [], foot: null, warn: [], nf: 0 };
const iso = d => d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
function setRange(a, b) { $('#rFrom').value = a; $('#rTo').value = b; }

$$('.chip').forEach(c => c.onclick = () => {
  const t = new Date(), q = c.dataset.q; let a = new Date(t), b = new Date(t);
  if (q === 'yest') { a.setDate(a.getDate() - 1); b = new Date(a); }
  if (q === 'week') a.setDate(a.getDate() - 6);
  if (q === 'month') a = new Date(t.getFullYear(), t.getMonth(), 1);
  if (q === 'lmonth') { a = new Date(t.getFullYear(), t.getMonth() - 1, 1); b = new Date(t.getFullYear(), t.getMonth(), 0); }
  setRange(iso(a), iso(b)); loadReport();
});
$('#rGo').onclick = loadReport;
$('#rShift').onchange = $('#rSearch').oninput = renderReport;
$$('#rMode button').forEach(b => b.onclick = () => {
  R.mode = b.dataset.m; $$('#rMode button').forEach(x => x.classList.toggle('on', x === b)); renderReport();
});

async function loadReport() {
  const a = $('#rFrom').value, b = $('#rTo').value;
  if (!a || !b || a > b) return toast('Choose a valid date range', true);
  $('#rTable').innerHTML = '<tr><td class="empty">Loading…</td></tr>';
  try {
    const d = await api('getReport', a, b);
    R.lines = d.lines; R.shifts = d.shifts; R.loaded = true; renderReport();
  } catch (e) { toast(e.message, true); }
}

function filtered() {
  const sh = $('#rShift').value, q = $('#rSearch').value.trim().toLowerCase();
  const lines = R.lines.filter(l => (!sh || l.shift === sh) &&
    (!q || [l.operator, l.tno, l.machine, l.roll].some(v => String(v).toLowerCase().includes(q))));
  const shifts = R.shifts.filter(s => !sh || s.shift === sh);
  return { lines, shifts };
}

function group(lines, keyFn, labelFn) {
  const g = {};
  lines.forEach(l => {
    const k = keyFn(l), lab = labelFn(l);
    const o = g[k] = g[k] || { label: lab.slice(), s: zeroS() };
    lab.forEach((v, i) => { if (v !== '') o.label[i] = v; });
    addS(o.s, toS(l));
  });
  return Object.values(g);
}
const sCells = s => {
  const m = metrics(s);
  return [s.runs, r2(s.inWt), r2(s.out), r2(m.water), r2(s.used), r2(m.mb), r2(m.tm), r2(m.ma), r2(m.dev),
          r2(m.pickup), r2(m.vp), r2(m.eff), r2(m.thru), r2(m.inSpec)];
};

function renderReport() {
  if (!R.loaded) return;
  const u = M.unit, { lines, shifts } = filtered();
  const all = lines.reduce((a, l) => addS(a, toS(l)), zeroS()), am = metrics(all);
  const sheetKeys = new Set(lines.map(l => l.date + '|' + l.shift));

  $('#rKpis').innerHTML = `
    <div class="kpi"><b>${lines.length}</b><span>Damping runs (${sheetKeys.size} sheets)</span></div>
    <div class="kpi"><b>${fmt(all.out)}</b><span>Output fabric (kg)</span></div>
    <div class="kpi"><b>${fmtS(am.water)}</b><span>Water added (kg)</span></div>
    <div class="kpi"><b>${pct(am.ma)}</b><span>Avg moisture after</span></div>
    <div class="kpi"><b>${fmtS(am.dev)}</b><span>Moisture deviation (pts)</span></div>
    <div class="kpi"><b>${pct(am.inSpec)}</b><span>Runs within tolerance</span></div>
    <div class="kpi"><b>${pct(am.eff)}</b><span>Water efficiency</span></div>
    <div class="kpi"><b>${fmt(am.thru)}</b><span>Throughput (${u}/min)</span></div>`;

  const byDate = {};
  lines.forEach(l => byDate[l.date] = (byDate[l.date] || 0) + l.outwt);
  const dates = Object.keys(byDate).sort(), mx = Math.max(1, ...Object.values(byDate));
  $('#trend').innerHTML = dates.length ? dates.map(d =>
    `<div class="bar" title="${fmtD(d)}: ${fmt(byDate[d])} kg"><em>${fmt(byDate[d])}</em><i style="height:${Math.max(2, byDate[d] / mx * 70)}px"></i><small>${d.slice(8)}/${d.slice(5, 7)}</small></div>`).join('')
    : '<div class="empty" style="width:100%">No data for this range</div>';

  const mc = ['Runs', 'Input Wt (kg)', 'Output Wt (kg)', 'Water Added (kg)', 'Water Used (L)', 'Avg Moist Before %',
              'Avg Target %', 'Avg Moist After %', 'Moisture Dev (pts)', 'Pick-up %', 'Wt Variance %', 'Water Eff. %',
              `Throughput (${u}/min)`, 'Runs In Tolerance %'];
  let cols, rows, foot, nf, warn = [];
  if (R.mode === 'detail') {
    nf = 7;
    cols = ['Date', 'Shift', 'S.No', 'Operator', 'T.No', 'Machine', 'Roll / Beam ID', 'Input Wt (kg)', `Input Length (${u})`,
            'Moist Before %', 'Target Moist %', 'Moist After %', 'Output Wt (kg)', 'Water Used (L)', 'Run Time (min)',
            'Dry Wt (kg)', 'Water Added (kg)', 'Pick-up %', 'Moisture Dev (pts)', 'Wt Variance (kg)', 'Wt Variance %',
            'Water Eff. %', `Throughput (${u}/min)`, 'Status'];
    const sorted = lines.slice().sort((a, b) => (a.date + a.shift).localeCompare(b.date + b.shift) || a.sno - b.sno);
    rows = sorted.map(l => {
      const s = toS(l), m = metrics(s), st = statusOf(s, m), w = new Set();
      if (st === 'Over' || st === 'Under') { w.add(18); w.add(23); }
      if (m.vp !== null && Math.abs(m.vp) > VAR_LIMIT) { w.add(19); w.add(20); }
      if (m.eff !== null && m.eff > 100) w.add(21);
      warn.push(w);
      return [fmtD(l.date), l.shift, String(l.sno), l.operator, l.tno, l.machine, l.roll, l.inwt, l.inlen, l.mb, l.tm, l.ma,
              l.outwt, l.used, l.time, r2(m.dry), r2(m.water), r2(m.pickup), r2(m.dev), r2(m.vk), r2(m.vp), r2(m.eff),
              r2(m.thru), st || ''];
    });
    foot = ['Total / avg', '', '', '', '', '', '', r2(all.inWt), r2(all.inLen), r2(am.mb), r2(am.tm), r2(am.ma), r2(all.out),
            r2(all.used), r2(all.time), r2(am.dry), r2(am.water), r2(am.pickup), r2(am.dev), r2(am.vk), r2(am.vp), r2(am.eff),
            r2(am.thru), all.st ? `${all.ok}/${all.st} OK` : ''];
  } else if (R.mode === 'operator') {
    nf = 2; cols = ['Operator', 'T.No', ...mc];
    rows = group(lines, l => l.operator.toLowerCase(), l => [l.operator, l.tno])
      .sort((a, b) => b.s.out - a.s.out).map(o => [...o.label, ...sCells(o.s)]);
    foot = ['Total / avg', '', ...sCells(all)];
  } else if (R.mode === 'machine') {
    nf = 1; cols = ['Machine', ...mc];
    rows = group(lines, l => l.machine.toLowerCase(), l => [l.machine || '(none)'])
      .sort((a, b) => a.label[0].localeCompare(b.label[0])).map(o => [...o.label, ...sCells(o.s)]);
    foot = ['Total / avg', ...sCells(all)];
  } else {
    nf = 3; cols = ['Date', 'Shift', 'Supervisor', ...mc, 'Remarks'];
    const meta = {}; shifts.forEach(s => meta[s.date + '|' + s.shift] = s);
    rows = group(lines, l => l.date + '|' + l.shift, l => [l.date, l.shift])
      .sort((a, b) => (a.label[0] + a.label[1]).localeCompare(b.label[0] + b.label[1]))
      .map(o => { const m = meta[o.label[0] + '|' + o.label[1]] || {};
        return [fmtD(o.label[0]), o.label[1], m.supervisor || '', ...sCells(o.s), m.remarks || '']; });
    foot = ['Total / avg', '', '', ...sCells(all), ''];
  }
  R.cols = cols; R.rows = rows; R.foot = rows.length ? foot : null; R.nf = nf; R.warn = warn;

  const lastTextCol = R.mode === 'day' ? cols.length - 1 : -1;
  const isNumCol = i => i >= nf && i !== lastTextCol && !(R.mode === 'detail' && i === 23);
  const signed = i => R.mode === 'detail' ? (i === 18 || i === 19 || i === 20) : (R.mode !== 'detail' && cols[i] && /Dev|Variance/.test(cols[i]));
  const cell = (v, i, w) => {
    const cls = [isNumCol(i) ? 'num' : '', R.mode === 'detail' && i === 23 ? 'ctr' : '', w && w.has(i) ? 'warn' : ''].join(' ').trim();
    const txt = v === null ? '–' : typeof v === 'number' ? (signed(i) ? fmtS(v) : fmt(v)) : esc(v);
    return `<td class="${cls}">${txt}</td>`;
  };
  $('#rTable').innerHTML = rows.length
    ? `<thead><tr>${cols.map((c, i) => `<th class="${isNumCol(i) ? 'num' : (R.mode === 'detail' && i === 23 ? 'ctr' : '')}">${esc(c)}</th>`).join('')}</tr></thead>
       <tbody>${rows.map((r, ri) => `<tr>${r.map((v, i) => cell(v, i, warn[ri])).join('')}</tr>`).join('')}</tbody>
       <tfoot><tr>${foot.map((v, i) => cell(v, i, null)).join('')}</tr></tfoot>`
    : '<tr><td class="empty">No records for the selected filters. Try a wider date range.</td></tr>';
}

$('#csvBtn').onclick = () => {
  if (!R.rows.length) return toast('Nothing to download', true);
  const q = v => { v = String(v ?? ''); return /[",\n]/.test(v) ? '"' + v.replace(/"/g, '""') + '"' : v; };
  const all = [R.cols, ...R.rows, R.foot].filter(Boolean);
  const csv = '\uFEFF' + all.map(r => r.map(q).join(',')).join('\r\n');
  const a = document.createElement('a');
  a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8;' }));
  a.download = `damping_${R.mode}_${$('#rFrom').value}_to_${$('#rTo').value}.csv`;
  document.body.appendChild(a); a.click(); a.remove();
  toast('CSV downloaded');
};

/* ---------- Logbook ---------- */
function renderLogbook() {
  const draw = (id, arr, type, noLabel) => $(id).innerHTML = arr.length
    ? `<thead><tr><th>Name</th><th>${noLabel}</th><th></th></tr></thead><tbody>` +
      arr.map(o => `<tr><td>${esc(o.name)}</td><td>${esc(o.no)}</td>
        <td style="text-align:right"><button class="btn bad sm" data-del="${type}" data-name="${esc(o.name)}">Delete</button></td></tr>`).join('') + '</tbody>'
    : '<tr><td class="empty">No names yet. Add one above, or save a sheet.</td></tr>';
  draw('#mOps', M.operators, 'op', 'T. No.'); draw('#mMcs', M.machines, 'mc', 'Note');
  $('#setUnit').value = M.unit; $('#setTol').value = M.tol;
}
$('#setUnit').onchange = async e => {
  try { M = await api('saveSetting', 'unit', e.target.value); applyUnit(); R.loaded = false; toast('Unit saved'); }
  catch (err) { toast(err.message, true); }
};
$('#saveTol').onclick = async () => {
  const v = parseFloat($('#setTol').value);
  if (isNaN(v) || v <= 0 || v > 10) return toast('Enter a tolerance between 0.1 and 10', true);
  try { M = await api('saveSetting', 'tol', v); recalc(); R.loaded = false; toast('Tolerance saved'); }
  catch (err) { toast(err.message, true); }
};
document.addEventListener('click', async e => {
  const t = e.target;
  try {
    if (t.dataset.add) {
      const op = t.dataset.add === 'op';
      const nameEl = $(op ? '#mOpName' : '#mMcName'), noEl = $(op ? '#mOpNo' : '#mMcNo');
      if (!nameEl.value.trim()) return toast('Enter a name', true);
      M = await api('saveMaster', t.dataset.add, nameEl.value.trim(), noEl.value.trim());
      nameEl.value = ''; noEl.value = '';
      fillLists(); renderLogbook(); toast('Added');
    }
    if (t.dataset.del) {
      if (!confirm('Delete ' + t.dataset.name + ' from the Logbook? (Past records stay unchanged)')) return;
      M = await api('deleteMaster', t.dataset.del, t.dataset.name); fillLists(); renderLogbook();
    }
  } catch (err) { toast(err.message, true); }
});
</script>
</body>
</html>

