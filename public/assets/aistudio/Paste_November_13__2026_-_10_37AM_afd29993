  var data = {
    date: document.getElementById('pr_date').value,
    shift: document.getElementById('pr_shift').value,
    unit: document.getElementById('pr_unit').value,
    machine: document.getElementById('pr_machine').value,
    beamNumber: document.getElementById('pr_beamnumber').value.trim(),
    worker: worker,
    hoursWorked: hours,
    color: document.getElementById('pr_color').value,
    beamTarget: document.getElementById('pr_beamtarget').value,
    startMeter: document.getElementById('pr_startmeter').value,
    endMeter: document.getElementById('pr_endmeter').value,
    ringLength: document.getElementById('pr_ringlength').value,
    weight: document.getElementById('pr_weight').value,
    action: isStop ? 'stop' : 'save'
  };
  if (!data.date || !data.machine || !data.beamNumber || data.beamTarget === '' || data.endMeter === '') {
    alert('Please fill Date, Machine, Beam Number, Beam Target and End Meter.');
    return;
  }
  var statusEl = document.getElementById('pr_status');
  statusEl.textContent = isStop ? 'Stopping...' : 'Saving...';
