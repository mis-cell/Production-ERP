  <div class="toast" id="toast"></div>

  <script>
    console.log('Narrow Beaming app script loaded.');

    function byId(id) { return document.getElementById(id); }

    function showBanner(msg, kind) {
      var b = byId('status-banner');
      b.textContent = msg;
      b.className = 'show' + (kind === 'ok' ? ' ok' : '');
    }
    function hideBanner() {
      byId('status-banner').className = '';
    }

    function showToast(msg, type) {
      var t = byId('toast');
      t.textContent = msg;
      t.className = 'toast show' + (type ? ' ' + type : '');
      window.clearTimeout(showToast._timer);
      showToast._timer = window.setTimeout(function () { t.className = 'toast'; }, 3200);
    }

    function todayStr() {
      var d = new Date();
      var mm = String(d.getMonth() + 1);
      if (mm.length < 2) mm = '0' + mm;
      var dd = String(d.getDate());
      if (dd.length < 2) dd = '0' + dd;
      return d.getFullYear() + '-' + mm + '-' + dd;
    }

    function fmtDate(v) {
      if (!v) return '';
      if (typeof v === 'string') return v;
      try {
        var d = new Date(v);
        if (isNaN(d.getTime())) return String(v);
        return d.toISOString().slice(0, 10);
      } catch (e) { return String(v); }
    }

    // Calls a server function wrapped with safeRun_ on the backend, so the
    // response is always { ok: true/false, data / error }. A local timeout
    // guarantees onDone always fires even if the server call never returns.
    function callServer(fnName, args, onDone) {
      var finished = false;
      var timer = window.setTimeout(function () {
        if (finished) return;
        finished = true;
        showBanner('No response from the server for "' + fnName + '" after 15 seconds. Check Extensions > Apps Script > Executions in your sheet, and confirm you deployed a NEW VERSION after the last code change.', 'error');
        onDone({ ok: false, error: 'timeout' });
      }, 15000);

      try {
        var runner = google.script.run
          .withSuccessHandler(function (res) {
            if (finished) return;
            finished = true;
            window.clearTimeout(timer);
            if (res && res.ok === false) {
              showBanner('Server error in ' + fnName + ': ' + res.error, 'error');
            } else {
              hideBanner();
            }
            onDone(res);
          })
          .withFailureHandler(function (err) {
            if (finished) return;
            finished = true;
            window.clearTimeout(timer);
            var msg = err && err.message ? err.message : String(err);
            showBanner('Connection error calling ' + fnName + ': ' + msg, 'error');
            onDone({ ok: false, error: msg });
          });
        var callArgs = args || [];

        switch (fnName) {
          case 'getCurrentRound':
            runner.getCurrentRound();
            break;
          case 'getShiftContext':
            runner.getShiftContext();
            break;
          case 'getCutStatus':
            runner.getCutStatus.apply(runner, callArgs);
            break;
          case 'saveLogEntry':
            runner.saveLogEntry.apply(runner, callArgs);
            break;
          case 'getLogEntries':
            runner.getLogEntries();
            break;
          case 'saveProductionEntry':
            runner.saveProductionEntry.apply(runner, callArgs);
            break;
          case 'stopRound':
            runner.stopRound();
            break;
          case 'getCurrentRoundEntries':
            runner.getCurrentRoundEntries();
            break;
          case 'getVerificationData':
            runner.getVerificationData();
            break;
          case 'getReportData':
            runner.getReportData();
            break;
          default:
            throw new Error('Unknown server function: ' + fnName);
        }
      } catch (syncErr) {
        finished = true;
        window.clearTimeout(timer);
        showBanner('Could not call server function ' + fnName + ': ' + syncErr.message, 'error');
        onDone({ ok: false, error: syncErr.message });
      }
    }

    // ---------- TAB SWITCHING ----------
    function switchTab(tabName) {
      var all = document.querySelectorAll('nav.tabs button');
      for (var i = 0; i < all.length; i++) all[i].classList.toggle('active', all[i].dataset.tab === tabName);
      var panels = document.querySelectorAll('.tabpanel');
      for (var j = 0; j < panels.length; j++) panels[j].style.display = 'none';
      byId('tab-' + tabName).style.display = 'block';
      if (tabName === 'production') { loadProductionMeta(); loadShiftContext(); loadCurrentRoundTable(); loadCutStatus(); }
      if (tabName === 'verification') loadVerification();
      if (tabName === 'report') loadReport();
    }

    byId('tabs').addEventListener('click', function (e) {
      var btn = e.target.closest ? e.target.closest('button[data-tab]') : null;
      if (!btn) return;
      switchTab(btn.dataset.tab);
    });

    // ---------- LOG BOOK: TIME FIELDS ----------
    // Start/End Time are native <input type="time"> fields, which give an
    // easy scrollable/clock picker on both desktop and mobile.
    function toMinutes_(t) {
      var p = t.split(':');
      return Number(p[0]) * 60 + Number(p[1]);
    }

    function recomputeHoursWorked() {
      var s = byId('lb-start').value;
      var e = byId('lb-end').value;
      if (!s || !e) { byId('lb-hours').value = ''; return; }
      var diff = toMinutes_(e) - toMinutes_(s);
      if (diff <= 0) diff += 24 * 60; // shift crosses midnight
      var hrs = diff / 60;
      byId('lb-hours').value = hrs.toFixed(2) + ' h';
    }
    byId('lb-start').addEventListener('change', recomputeHoursWorked);
    byId('lb-end').addEventListener('change', recomputeHoursWorked);

    // ---------- LOG BOOK ----------
    function saveLogBook() {
      var data = {
        date: byId('lb-date').value,
        shift: byId('lb-shift').value,
        operator: byId('lb-operator').value.trim(),
        startTime: byId('lb-start').value,
        endTime: byId('lb-end').value,
        hoursWorked: byId('lb-hours').value,
        detentionHours: byId('lb-detention').value,
        idleReason: byId('lb-idle').value,
        instruction: byId('lb-instruction').value
      };
      if (!data.date || !data.operator) { showToast('Please fill Date and Operator Name.', 'error'); return; }
      callServer('saveLogEntry', [data], function (res) {
        if (res.ok) {
          showToast(res.data.message, 'success');
          clearLogBook();
          loadLogTable();
          // Date / Shift / Operator now carry forward - jump to Production.
          switchTab('production');
        } else {
          showToast('Save failed: ' + res.error, 'error');
        }
      });
    }

    function clearLogBook() {
      byId('lb-date').value = todayStr();
      byId('lb-shift').value = 'A';
      byId('lb-operator').value = '';
      byId('lb-start').value = '';
      byId('lb-end').value = '';
      byId('lb-hours').value = '';
      byId('lb-detention').value = '';
      byId('lb-idle').value = '';
      byId('lb-instruction').value = '';
    }

    function loadLogTable() {
      var body = byId('lb-table-body');
      body.innerHTML = '<tr><td class="empty" colspan="9">Loading...</td></tr>';
      callServer('getLogEntries', [], function (res) {
        if (!res.ok) { body.innerHTML = '<tr><td class="empty" colspan="9">Could not load data: ' + res.error + '</td></tr>'; return; }
        var rows = res.data;
        if (!rows || !rows.length) { body.innerHTML = '<tr><td class="empty" colspan="9">No entries yet.</td></tr>'; return; }
        var html = '';
        for (var i = 0; i < Math.min(rows.length, 25); i++) {
          var r = rows[i];
          html += '<tr>' +
            '<td>' + fmtDate(r['Date']) + '</td>' +
            '<td>' + (r['Shift'] || '') + '</td>' +
            '<td>' + (r['Operator Name'] || '') + '</td>' +
            '<td>' + (r['Start Time'] || '') + '</td>' +
            '<td>' + (r['End Time'] || '') + '</td>' +
            '<td>' + (r['Hours Worked'] || '') + '</td>' +
            '<td>' + (r['Detention Hours'] || '') + '</td>' +
            '<td>' + (r['Idle Reason'] || '') + '</td>' +
            '<td>' + (r['Instruction'] || '') + '</td>' +
            '</tr>';
        }
        body.innerHTML = html;
      });
    }

    // ---------- PRODUCTION ----------
    function loadProductionMeta() {
      callServer('getCurrentRound', [], function (res) {
        if (res.ok) byId('prod-round').textContent = res.data;
      });
    }

    function loadShiftContext() {
      callServer('getShiftContext', [], function (res) {
        var warn = byId('ctx-missing-warning');
        if (!res.ok) { warn.style.display = 'block'; return; }
        var ctx = res.data;
        byId('ctx-date').value = ctx.date ? fmtDate(ctx.date) : '';
        byId('ctx-shift').value = ctx.shift || '';
        byId('ctx-operator').value = ctx.operator || '';
        warn.style.display = (ctx.date && ctx.shift && ctx.operator) ? 'none' : 'block';
      });
    }
    byId('btn-ctx-refresh').addEventListener('click', loadShiftContext);

    // ---------- CUT METER TRACKING ----------
    function setCutFieldsEditable(targetEditable) {
      byId('p-cutstarget').readOnly = !targetEditable;
    }

    function recomputeCutsCalc() {
      var start = parseFloat(byId('p-startcut').value);
      var end = parseFloat(byId('p-endcut').value);
      var el = byId('p-cuts-calc');
      if (isNaN(start) || isNaN(end)) { el.value = ''; return; }
      var cuts = end - start + 1;
      el.value = cuts >= 1 ? cuts : 'End Cut must be >= Start Cut';
    }
    byId('p-endcut').addEventListener('input', recomputeCutsCalc);

    byId('p-newcutrun').addEventListener('change', function () {
      if (this.checked) {
        setCutFieldsEditable(true);
        byId('p-cutstarget').value = '';
        byId('p-startcut').value = '1';
      } else {
        loadCutStatus();
      }
      recomputeCutsCalc();
    });

    byId('p-machine').addEventListener('change', function () {
      byId('p-newcutrun').checked = false;
      loadCutStatus();
    });

    function loadCutStatus() {
      var machineNo = byId('p-machine').value.trim();
      var statusEl = byId('p-cut-status');
      if (!machineNo) {
        statusEl.className = 'cut-status warn';
        statusEl.textContent = 'Enter a Machine No above to check its cut status.';
        setCutFieldsEditable(true);
        byId('p-newcutrun').checked = true;
        byId('p-cutstarget').value = '';
        byId('p-startcut').value = '1';
        byId('p-endcut').value = '';
        recomputeCutsCalc();
        return;
      }
      statusEl.className = 'cut-status warn';
      statusEl.textContent = 'Checking cut status...';
      callServer('getCutStatus', [machineNo], function (res) {
        if (!res.ok) {
          statusEl.className = 'cut-status done';
          statusEl.textContent = 'Could not load cut status: ' + res.error;
          return;
        }
        var d = res.data;
        if (!d.hasRunningTarget) {
          statusEl.className = 'cut-status warn';
          statusEl.textContent = 'No running cut target on Machine ' + machineNo + ' - enter a Cuts Target Today to start.';
          setCutFieldsEditable(true);
          byId('p-newcutrun').checked = true;
          byId('p-cutstarget').value = '';
          byId('p-startcut').value = '1';
        } else if (d.completed) {
          statusEl.className = 'cut-status done';
          statusEl.textContent = 'Target reached at cut ' + d.lastCut + ' / ' + d.target + ' on Machine ' + machineNo + '. Starting a new cut run - Start Cut resets to 1. Change the Target below if it is different this time.';
          setCutFieldsEditable(true);
          byId('p-newcutrun').checked = true;
          byId('p-cutstarget').value = d.target;
          byId('p-startcut').value = '1';
        } else {
          statusEl.className = 'cut-status ok';
          statusEl.textContent = 'Running on Machine ' + machineNo + ' - up to cut ' + d.lastCut + ' of ' + d.target + ' (' + d.remaining + ' remaining). Next entry starts at cut ' + d.startCut + '.';
          setCutFieldsEditable(false);
          byId('p-newcutrun').checked = false;
          byId('p-cutstarget').value = d.target;
          byId('p-startcut').value = d.startCut;
        }
        byId('p-endcut').value = '';
        recomputeCutsCalc();
      });
    }

    function saveProduction() {
      var data = {
        machineNo: byId('p-machine').value.trim(),
        quality: byId('p-quality').value.trim(),
        slNo: byId('p-slno').value.trim(),
        formaNo: byId('p-formano').value.trim(),
        lengthPerCut: byId('p-lengthpercut').value,
        startNewCut: byId('p-newcutrun').checked,
        cutsTarget: byId('p-cutstarget').value,
        endCut: byId('p-endcut').value
      };
      if (!data.machineNo || !data.quality || !data.slNo || !data.formaNo) {
        showToast('Please fill Machine No, Quality, Sl No and Forma No.', 'error');
        return;
      }
      if (!data.lengthPerCut) {
        showToast('Please select a Length per Cut.', 'error');
        return;
      }
      if (data.endCut === '') {
        showToast('Please enter the End Cut reading.', 'error');
        return;
      }
      callServer('saveProductionEntry', [data], function (res) {
        if (res.ok) {
          var d = res.data;
          var msg = d.message + ' (' + d.slNo + ') - Cuts ' + d.cuts + ', Production ' + d.production;
          if (d.completed) msg += ' - Target reached!';
          showToast(msg, 'success');
          byId('p-quality').value = '';
          byId('p-slno').value = '';
          byId('p-formano').value = '';
          byId('prod-round').textContent = d.round;
          loadCurrentRoundTable();
          loadCutStatus();
        } else {
          showToast('Save failed: ' + res.error, 'error');
        }
      });
    }

    function stopRoundClick() {
      if (!window.confirm('Stop the current round? A new round will start for the next entries.')) return;
      callServer('stopRound', [], function (res) {
        if (res.ok) {
          showToast(res.data.message, 'success');
          loadProductionMeta();
          loadCurrentRoundTable();
        } else {
          showToast('Could not stop round: ' + res.error, 'error');
