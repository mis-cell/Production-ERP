</div> <!-- /#app -->

<script>
/* ================= LOGIN ================= */
function doLogin(){
  const u = document.getElementById('login_user').value.trim();
  const p = document.getElementById('login_pass').value;
  const errEl = document.getElementById('login_err');
  errEl.textContent = '';
  if(!u || !p){ errEl.textContent = 'Please enter username and password.'; return; }

  // Client-side fallback check (works even before Apps Script round trip)
  // Server-side check via checkLogin() is authoritative when available.
  if (typeof google !== 'undefined' && google.script && google.script.run) {
    google.script.run
      .withSuccessHandler(function(ok){
        if(ok){ enterApp(); }
        else { errEl.textContent = 'Invalid username or password.'; }
      })
      .withFailureHandler(function(){
        // Fallback if server call fails for any reason
        if(u === 'admin' && p === '1234'){ enterApp(); }
        else { errEl.textContent = 'Invalid username or password.'; }
      })
      .checkLogin(u, p);
  } else {
    if(u === 'admin' && p === '1234'){ enterApp(); }
    else { errEl.textContent = 'Invalid username or password.'; }
  }
}
function enterApp(){
  document.getElementById('page-login').style.display = 'none';
  document.getElementById('app').style.display = 'block';
  initBreakdownTabs();
  initWastageTable();
}
function doLogout(){
  if(confirm('Logout?')){
    document.getElementById('app').style.display = 'none';
    document.getElementById('page-login').style.display = 'flex';
    document.getElementById('login_user').value = '';
    document.getElementById('login_pass').value = '';
    document.getElementById('login_err').textContent = '';
  }
}
// Allow Enter key to submit login
document.addEventListener('keydown', function(e){
  if(e.key === 'Enter'){
    const loginVisible = document.getElementById('page-login').style.display !== 'none';
    if(loginVisible) doLogin();
  }
});

/* ---------- MAIN TAB SWITCH ---------- */
function showMainTab(name){
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.tabs button').forEach(b=>b.classList.remove('active'));
  document.getElementById('page-'+name).classList.add('active');
  document.getElementById('tab-'+name).classList.add('active');
}

/* ---------- LOG BOOK ---------- */
function saveLogBook(){
  const data = {
    date: document.getElementById('lb_date').value,
    shift: document.getElementById('lb_shift').value,
    rotation: document.getElementById('lb_rotation').value,
    idleMachine: document.getElementById('lb_idle').value,
    batch: document.getElementById('lb_batch').value,
    ifBatchChange: document.getElementById('lb_batchchange').value,
    instruction: document.getElementById('lb_instruction').value
  };
  if(!data.date){ setStatus('lb_status','Please select a date.',false); return; }
  setStatus('lb_status','Saving...',true);
  google.script.run.withSuccessHandler(()=>{
      setStatus('lb_status','Saved successfully.',true);
      clearLogBook(true); // auto-refresh form for next entry, keep date/shift
    })
    .withFailureHandler(e=>setStatus('lb_status','Error: '+e.message,false))
    .saveLogBook(data);
}
function clearLogBook(keepDateShift){
  ['lb_rotation','lb_idle','lb_batch','lb_batchchange','lb_instruction'].forEach(id=>document.getElementById(id).value='');
  if(!keepDateShift){
    document.getElementById('lb_status').textContent='';
  }
}

/* ---------- MACHINE BREAKDOWN ---------- */
const MB_TYPES = [
  {key:'Teaser', label:'Teaser', count:2},
  {key:'Hopper', label:'Hopper', count:3},
  {key:'FC', label:'F/C (Finisher Card)', count:32},
  {key:'BC', label:'B/C (Breaker Card)', count:22},
  {key:'IC', label:'I/C (Inter Card)', count:7}
];
let mbCurrent = 'Teaser';
let mbStore = {};

function shortLabel(t){ return t.label.split(' (')[0]; }

function initBreakdownTabs(){
  const subtabs = document.getElementById('mb_subtabs');
  subtabs.innerHTML = '';
  MB_TYPES.forEach(t=>{
    const b = document.createElement('button');
    b.textContent = t.label;
    b.id = 'mbtab_'+t.key;
    b.onclick = ()=>{ stashMbValues(); selectMbType(t.key); };
    subtabs.appendChild(b);
  });
  selectMbType('Teaser');
}

function selectMbType(key){
  mbCurrent = key;
  document.querySelectorAll('#mb_subtabs button').forEach(b=>b.classList.remove('active'));
  document.getElementById('mbtab_'+key).classList.add('active');
  const t = MB_TYPES.find(x=>x.key===key);
  document.getElementById('mb_title').textContent = t.label + ' Machine';
  renderMbTable(t);
}

function renderMbTable(t){
  const tbody = document.getElementById('mb_tbody');
  tbody.innerHTML = '';
  for(let i=1;i<=t.count;i++){
    const rowId = t.key+'_'+i;
    const tr = document.createElement('tr');
    tr.innerHTML =
      '<td><input value="'+shortLabel(t)+' '+i+'" id="mno_'+rowId+'" readonly></td>'+
      '<td><input id="reason_'+rowId+'"></td>'+
      '<td><input type="time" id="start_'+rowId+'" onchange="calcBreakTime(\''+rowId+'\')"></td>'+
      '<td><input type="time" id="end_'+rowId+'" onchange="calcBreakTime(\''+rowId+'\')"></td>'+
      '<td><input type="number" min="0" id="break_'+rowId+'" readonly></td>';
    tbody.appendChild(tr);
  }
  restoreMbValues(t);
  calcMbTotal();
}

/* Auto-calculate break time (in minutes) from Start Time and End Time.
   Handles shifts that cross midnight (end time earlier than start time). */
function calcBreakTime(rowId){
  const startVal = val('start_'+rowId);
  const endVal = val('end_'+rowId);
  const breakInput = document.getElementById('break_'+rowId);
  if(startVal && endVal){
    const [sh, sm] = startVal.split(':').map(Number);
    const [eh, em] = endVal.split(':').map(Number);
    let startMinutes = sh*60 + sm;
    let endMinutes = eh*60 + em;
    let diff = endMinutes - startMinutes;
    if(diff < 0) diff += 24*60; // crossed midnight
    breakInput.value = diff;
  } else {
    breakInput.value = '';
  }
  calcMbTotal();
}

function stashMbValues(){
  const t = MB_TYPES.find(x=>x.key===mbCurrent);
  if(!t) return;
  for(let i=1;i<=t.count;i++){
    const rowId = t.key+'_'+i;
    mbStore[rowId] = {
      reason: val('reason_'+rowId), start: val('start_'+rowId), end: val('end_'+rowId), breakTime: val('break_'+rowId)
    };
  }
}
function restoreMbValues(t){
  for(let i=1;i<=t.count;i++){
    const rowId = t.key+'_'+i;
    const s = mbStore[rowId];
    if(s){
      document.getElementById('reason_'+rowId).value = s.reason||'';
      document.getElementById('start_'+rowId).value = s.start||'';
      document.getElementById('end_'+rowId).value = s.end||'';
      document.getElementById('break_'+rowId).value = s.breakTime||'';
    }
  }
}
function calcMbTotal(){
  const t = MB_TYPES.find(x=>x.key===mbCurrent);
  let sum=0;
  for(let i=1;i<=t.count;i++){
    const v = parseFloat(val('break_'+t.key+'_'+i));
    if(!isNaN(v)) sum += v;
  }
  document.getElementById('mb_total').value = sum;
}
function val(id){ const e=document.getElementById(id); return e?e.value:''; }

function saveBreakdown(){
  stashMbValues();
  const date = document.getElementById('mb_date').value;
  const shift = document.getElementById('mb_shift').value;
  if(!date){ setStatus('mb_status','Please select a date.',false); return; }
  const rows = [];
  MB_TYPES.forEach(t=>{
    for(let i=1;i<=t.count;i++){
      const rowId = t.key+'_'+i;
      const s = mbStore[rowId] || {};
      if(s.reason||s.start||s.end||s.breakTime){
        rows.push({type:shortLabel(t), machineNo:shortLabel(t)+' '+i, reason:s.reason||'', start:s.start||'', end:s.end||'', breakTime:s.breakTime||''});
      }
    }
  });
  if(rows.length===0){ setStatus('mb_status','No breakdown data entered.',false); return; }
  setStatus('mb_status','Saving...',true);
  google.script.run.withSuccessHandler((res)=>{
      setStatus('mb_status','Saved successfully. ('+res.count+' rows)',true);
      clearBreakdown(true); // auto-refresh for next entry
    })
    .withFailureHandler(e=>setStatus('mb_status','Error: '+e.message,false))
    .saveMachineBreakdown({date, shift, rows});
}
function clearBreakdown(keepDateShift){
  mbStore = {};
  const t = MB_TYPES.find(x=>x.key===mbCurrent);
  renderMbTable(t);
  if(!keepDateShift){
    document.getElementById('mb_status').textContent='';
  }
}

/* ---------- PILE STOCK BOOK ---------- */

/* Total (kg) = Batch & Preparation + SPG & WDG + S4 + Skg V/L & N/L + Finishing
   Dust Percentage (%) = Total / Jute Issue * 100  (how much of the jute
   issued ended up as dust) */
function calcDustTotals(){
  const batchPrep = parseFloat(val('ps_batchprep')) || 0;
  const spgWdg = parseFloat(val('ps_spgwdg')) || 0;
  const s4 = parseFloat(val('ps_s4')) || 0;
  const skgVlNl = parseFloat(val('ps_skgvlnl')) || 0;
  const finishing = parseFloat(val('ps_finishing')) || 0;
  const juteIssue = parseFloat(val('ps_juteissue')) || 0;

  const total = batchPrep + spgWdg + s4 + skgVlNl + finishing;
  document.getElementById('ps_dusttotal').value = total;

  const pctEl = document.getElementById('ps_dustpct');
  pctEl.value = juteIssue > 0 ? ((total / juteIssue) * 100).toFixed(2) : '';
}

const WASTAGE_TYPES = ['Rejection','Cutting','Habi Jabi','Tb/Waste','L/Waste','Rope','Rope Waste'];
function initWastageTable(){
  const tbody = document.getElementById('ps_wastage_body');
  tbody.innerHTML = '';
  WASTAGE_TYPES.forEach((name, idx)=>{
    const tr = document.createElement('tr');
    tr.innerHTML =
      '<td><input value="'+name+'" id="w_name_'+idx+'" readonly></td>'+
      '<td><input type="number" id="w_open_'+idx+'" oninput="calcWastageRow('+idx+')"></td>'+
      '<td><input type="number" id="w_gen_'+idx+'" oninput="calcWastageRow('+idx+')"></td>'+
      '<td><input type="number" id="w_recv_'+idx+'"></td>'+
      '<td><input type="number" id="w_total_'+idx+'" readonly></td>'+
      '<td><input type="number" id="w_cons_'+idx+'" oninput="calcWastageRow('+idx+')"></td>'+
      '<td><input type="number" id="w_close_'+idx+'" readonly></td>';
    tbody.appendChild(tr);
  });
}
function calcWastageRow(idx){
  const open = parseFloat(val('w_open_'+idx))||0;
  const gen = parseFloat(val('w_gen_'+idx))||0;
  const cons = parseFloat(val('w_cons_'+idx))||0;
  const total = open + gen;
  document.getElementById('w_total_'+idx).value = total;
  document.getElementById('w_close_'+idx).value = total - cons;
}

function savePileStock(){
  const date = document.getElementById('ps_date').value;
  const shift = document.getElementById('ps_shift').value;
  if(!date){ setStatus('ps_status','Please select a date.',false); return; }
  const wastage = WASTAGE_TYPES.map((name,idx)=>({
    type:name,
    opening: val('w_open_'+idx) || 0,
    generation: val('w_gen_'+idx) || 0,
    receivedOS: val('w_recv_'+idx) || 0,
    total: val('w_total_'+idx) || 0,
    consumption: val('w_cons_'+idx) || 0,
    closing: val('w_close_'+idx) || 0
  }));
  const data = {
    date, shift,
    dust: {
      batchPrep: val('ps_batchprep'), spgWdg: val('ps_spgwdg'), s4: val('ps_s4'),
      skgVlNl: val('ps_skgvlnl'), finishing: val('ps_finishing'), total: val('ps_dusttotal'),
      juteIssue: val('ps_juteissue'), dustPct: val('ps_dustpct')
    },
    oil: { ecoFin: val('ps_ecofin'), fintex: val('ps_fintex'), cwRolls: val('ps_cwrolls') },
    wastage
  };
  setStatus('ps_status','Saving...',true);
  google.script.run.withSuccessHandler(()=>{
      setStatus('ps_status','Saved successfully.',true);
      clearPileStock(true); // auto-refresh for next entry
    })
    .withFailureHandler(e=>setStatus('ps_status','Error: '+e.message,false))
    .savePileStock(data);
}
function clearPileStock(keepDateShift){
  ['ps_batchprep','ps_spgwdg','ps_s4','ps_skgvlnl','ps_finishing','ps_dusttotal','ps_juteissue','ps_dustpct','ps_ecofin','ps_fintex','ps_cwrolls'].forEach(id=>document.getElementById(id).value='');
  initWastageTable();
  if(!keepDateShift){
    document.getElementById('ps_status').textContent='';
  }
}

/* ---------- REPORT ---------- */
let rpLastType = '';

function runReport(){
  const filters = {
    fromDate: document.getElementById('rp_from').value,
    toDate: document.getElementById('rp_to').value,
    shift: document.getElementById('rp_shift').value,
    reportType: document.getElementById('rp_type').value,
    search: document.getElementById('rp_search').value
  };
  rpLastType = filters.reportType;
  google.script.run.withSuccessHandler(renderReport).withFailureHandler(e=>alert('Error: '+e.message)).getReport(filters);
}

function renderReport(result){
  const tableWrap = document.getElementById('rp_table_wrap');
  const cardsWrap = document.getElementById('rp_cards_wrap');

  if(rpLastType === 'Pile Stock Book'){
    tableWrap.style.display = 'none';
    cardsWrap.style.display = 'flex';
    renderPileStockCards(result);
  } else {
    cardsWrap.style.display = 'none';
    cardsWrap.innerHTML = '';
    tableWrap.style.display = 'block';
    renderStandardTable(result);
  }
}

function renderStandardTable(result){
  const table = document.getElementById('rp_table');
  const head = document.getElementById('rp_head');
  const body = document.getElementById('rp_body');
  head.innerHTML=''; body.innerHTML='';
  table.classList.add('sticky-first'); // keep Date column visible while scrolling sideways

  result.headers.forEach(h=>{
    const th = document.createElement('th'); th.textContent = h; head.appendChild(th);
  });
  result.rows.forEach(r=>{
    const tr = document.createElement('tr');
    r.forEach(c=>{ const td=document.createElement('td'); td.textContent=c; tr.appendChild(td); });
    body.appendChild(tr);
  });
  if(result.rows.length===0){
    const tr = document.createElement('tr');
    const td = document.createElement('td');
    td.colSpan = result.headers.length||1;
    td.textContent = 'No records found.';
    td.style.textAlign='center';
    tr.appendChild(td);
    body.appendChild(tr);
  }
}

/* Groups the wide, flat Pile Stock columns back into readable sections
   (Date/Shift, Dust to Boiler, Oil Consumption, Wastage per type) and
   renders each record as a collapsible card instead of one giant table. */
function renderPileStockCards(result){
  const wrap = document.getElementById('rp_cards_wrap');
  wrap.innerHTML = '';

  if(result.rows.length===0){
    wrap.innerHTML = '<div class="rp_empty">No records found.</div>';
    return;
  }

  const DUST_FIELDS = ['Batch & Preparation (kg)','SPG & WDG (kg)','S4 (kg)','Skg V/L & N/L (kg)','Finishing (kg)','Dust Total (kg)','Jute Issue (kg)','Dust Percentage (%)'];
  const OIL_FIELDS = ['Eco Fin (N)','Fintex (N)','C/W Rolls'];

  result.rows.forEach((row, rowIdx) => {
    const record = {};
    result.headers.forEach((h,i)=>{ record[h] = row[i]; });

    // Identify wastage columns (format "TypeName - Field") and group by type, preserving order of first appearance.
    const wastageTypes = [];
    const wastageData = {};
    result.headers.forEach(h=>{
      const m = h.match(/^(.*) - (Opening|Generation|Received O\/S|Total|Consumption|Closing Balance)$/);
      if(m){
        const type = m[1], field = m[2];
        if(!wastageData[type]){ wastageData[type] = {}; wastageTypes.push(type); }
        wastageData[type][field] = record[h];
      }
    });

    const card = document.createElement('div');
    card.className = 'rp_card';

    const cardId = 'rpc_' + rowIdx;
    const head = document.createElement('div');
    head.className = 'rp_card_head';
    head.innerHTML =
      '<div class="rp_meta">'+
        '<span class="rp_date">'+ (record['Date']||'') +'</span>'+
        '<span class="rp_shift_badge">Shift '+ (record['Shift']||'') +'</span>'+
      '</div>'+
      '<span class="rp_chevron">&#9656;</span>';
    head.onclick = ()=>{
      head.classList.toggle('open');
      document.getElementById(cardId).classList.toggle('open');
    };

    const body = document.createElement('div');
    body.className = 'rp_card_body';
    body.id = cardId;

    let html = '<div class="rp_section-label">Dust to Boiler</div><div class="rp_kv_grid">';
    DUST_FIELDS.forEach(f=>{
      html += '<div class="rp_kv"><div class="rp_kv_label">'+f+'</div><div class="rp_kv_val">'+(record[f]!==undefined?record[f]:'-')+'</div></div>';
    });
    html += '</div>';

    html += '<div class="rp_section-label">Oil Consumption</div><div class="rp_kv_grid">';
    OIL_FIELDS.forEach(f=>{
      html += '<div class="rp_kv"><div class="rp_kv_label">'+f+'</div><div class="rp_kv_val">'+(record[f]!==undefined?record[f]:'-')+'</div></div>';
    });
    html += '</div>';

    if(wastageTypes.length){
      html += '<div class="rp_section-label">Wastage Report</div>';
      html += '<table class="rp_waste_table"><thead><tr><th>Type</th><th>Opening</th><th>Generation</th><th>Received O/S</th><th>Total</th><th>Consumption</th><th>Closing</th></tr></thead><tbody>';
      wastageTypes.forEach(t=>{
        const w = wastageData[t];
        html += '<tr><td>'+t+'</td><td>'+(w['Opening']||0)+'</td><td>'+(w['Generation']||0)+'</td><td>'+(w['Received O/S']||0)+'</td><td>'+(w['Total']||0)+'</td><td>'+(w['Consumption']||0)+'</td><td>'+(w['Closing Balance']||0)+'</td></tr>';
      });
      html += '</tbody></table>';
    }

    body.innerHTML = html;
    card.appendChild(head);
    card.appendChild(body);
    wrap.appendChild(card);
  });

  // Auto-expand the first (most relevant) record for convenience.
  const firstHead = wrap.querySelector('.rp_card_head');
  const firstBody = wrap.querySelector('.rp_card_body');
  if(firstHead && firstBody){ firstHead.classList.add('open'); firstBody.classList.add('open'); }
}

function refreshReport(){
  document.getElementById('rp_from').value='';
  document.getElementById('rp_to').value='';
  document.getElementById('rp_shift').value='All Shift';
  document.getElementById('rp_search').value='';
  document.getElementById('rp_head').innerHTML='';
  document.getElementById('rp_body').innerHTML='';
  document.getElementById('rp_cards_wrap').innerHTML='';
  document.getElementById('rp_cards_wrap').style.display='none';
  document.getElementById('rp_table_wrap').style.display='block';
}

/* ---------- HELPERS ---------- */
function setStatus(id,msg,ok){
  const el = document.getElementById(id);
  el.textContent = msg;
  el.className = 'status-msg ' + (ok?'status-ok':'status-err');
}
</script>
