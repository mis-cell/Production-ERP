    box-shadow:var(--shadow);
  }
  header.topbar h1{
    font-size:19px;
    margin:0;
    font-weight:700;
    letter-spacing:.02em;
  }
  header.topbar .mill{
    font-size:12px;
    font-weight:400;
    opacity:.8;
    display:block;
  }
  .topbar-right{display:flex;align-items:center;gap:14px;}
  .user-chip{
    background:rgba(255,255,255,0.12);
    padding:6px 14px;
    border-radius:20px;
    font-size:13px;
  }
  #logoutBtn{
    background:var(--danger);
    color:#fff;
    border:none;
    padding:8px 16px;
    border-radius:8px;
    cursor:pointer;
    font-size:13px;
    font-weight:600;
  }
  #logoutBtn:hover{background:var(--danger-dark);}

  nav.tabs{
    background:var(--primary-dark);
    display:flex;
    flex-wrap:wrap;
    padding:0 16px;
  }
  nav.tabs button{
    background:transparent;
    border:none;
    color:#c9d6e6;
    padding:14px 18px;
    font-size:14px;
    cursor:pointer;
    border-bottom:3px solid transparent;
    transition:.15s;
    font-weight:500;
  }
  nav.tabs button:hover{color:#fff;background:rgba(255,255,255,0.06);}
  nav.tabs button.active{
    color:#fff;
    border-bottom:3px solid var(--accent);
    background:rgba(255,255,255,0.08);
  }

  main{padding:24px;max-width:1400px;margin:0 auto;}
  .card{
    background:var(--card);
    border-radius:var(--radius);
    box-shadow:var(--shadow);
    padding:22px 24px;
    margin-bottom:22px;
  }
  .card h2{
    margin:0 0 18px;
    font-size:17px;
    color:var(--primary);
    display:flex;
    align-items:center;
    gap:8px;
  }
  .grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:18px;
  }
  .field label{
    display:block;
    font-size:12px;
    font-weight:600;
    color:var(--text-light);
    margin-bottom:5px;
    text-transform:uppercase;
    letter-spacing:.02em;
  }
  .field input, .field select, .field textarea{
    width:100%;
    padding:9px 11px;
    border:1px solid var(--border);
    border-radius:7px;
    font-size:14px;
    font-family:inherit;
    outline:none;
    background:#fbfcfe;
    transition:border .15s;
  }
  .field input:focus, .field select:focus, .field textarea:focus{
    border-color:var(--accent);
    background:#fff;
  }
  .field textarea{resize:vertical;min-height:70px;}
  .field.full{grid-column:1/-1;}

  .btn-row{margin-top:20px;display:flex;gap:12px;flex-wrap:wrap;}
  .btn{
    padding:10px 22px;
    border:none;
    border-radius:8px;
    font-size:14px;
    font-weight:600;
    cursor:pointer;
    transition:.15s;
  }
  .btn-save{background:var(--accent);color:#fff;}
  .btn-save:hover{background:var(--accent-dark);}
  .btn-clear{background:#fff;color:var(--danger);border:1px solid var(--danger);}
  .btn-clear:hover{background:#fef2f2;}
  .btn-filter{background:var(--primary);color:#fff;}
  .btn-filter:hover{background:var(--primary-dark);}
  .btn-outline{background:#fff;color:var(--primary);border:1px solid var(--primary);}
  .btn-outline:hover{background:#f1f5fb;}

  table{
    width:100%;
    border-collapse:collapse;
    font-size:13.5px;
  }
  table thead th{
    background:var(--primary);
    color:#fff;
    padding:10px 8px;
    text-align:left;
    font-weight:600;
    position:sticky;
    top:0;
  }
  table tbody td{
    padding:6px 8px;
    border-bottom:1px solid var(--border);
  }
  table tbody tr:hover{background:#f6f9fc;}
  table input[type="text"], table input[type="number"], table input[type="time"]{
    width:100%;
    padding:7px 8px;
    border:1px solid var(--border);
    border-radius:6px;
    font-size:13px;
    background:#fbfcfe;
  }
  table input.readonly{
    background:#eef2f7;
    color:var(--text-light);
    font-weight:600;
  }
  table input:disabled{
    background:#f1f1f4;
    color:#b3bac5;
    cursor:not-allowed;
  }
  .table-wrap{overflow-x:auto;}
  tfoot td{
    font-weight:700;
    background:#f1f5fb;
    padding:9px 8px;
  }

  .badge{
    display:inline-block;
    padding:2px 9px;
    border-radius:12px;
    font-size:11.5px;
    font-weight:700;
  }
  .badge.A{background:#dbeafe;color:#1d4ed8;}
  .badge.B{background:#fef3c7;color:#b45309;}
  .badge.C{background:#e9d5ff;color:#7e22ce;}

  .toast{
    position:fixed;
    top:20px;right:20px;
    background:var(--success);
    color:#fff;
    padding:13px 20px;
    border-radius:8px;
    box-shadow:0 8px 24px rgba(0,0,0,0.2);
    font-size:14px;
    font-weight:600;
    z-index:999;
    display:none;
  }
  .toast.error{background:var(--danger);}

  .empty-state{
    text-align:center;
    padding:30px;
    color:var(--text-light);
    font-size:14px;
  }
  .loader{
    display:inline-block;width:16px;height:16px;
    border:2px solid #ffffff55;border-top-color:#fff;
    border-radius:50%;
    animation:spin .7s linear infinite;
    vertical-align:middle;margin-right:6px;
  }
  @keyframes spin{to{transform:rotate(360deg);}}

  .section-note{
    font-size:12px;
    color:var(--text-light);
    margin-top:-10px;
    margin-bottom:16px;
  }

  @media(max-width:700px){
    main{padding:14px;}
    header.topbar{padding:12px 16px;flex-wrap:wrap;gap:10px;}
    nav.tabs{overflow-x:auto;flex-wrap:nowrap;}
  }
</style>
</head>
<body>

<!-- ============ LOGIN SCREEN ============ -->
<div id="loginScreen">
  <div class="login-card">
    <div class="factory-icon">🏭</div>
    <h1>Spreader &amp; Softener</h1>
    <p class="sub">Bally Jute Mill &mdash; Production ERP</p>
    <label>Username</label>
    <input type="text" id="loginUsername" placeholder="Enter username" autocomplete="username">
    <label>Password</label>
    <input type="password" id="loginPassword" placeholder="Enter password" autocomplete="current-password">
    <button id="loginBtn" onclick="doLogin()">Login</button>
    <div id="loginError"></div>
    <div class="login-hint">Bally Jute Mill</div>
  </div>
</div>

<!-- ============ APP SCREEN ============ -->
<div id="appScreen">
  <header class="topbar">
    <div>
      <h1>Spreader &amp; Softener ERP</h1>
      <span class="mill">Bally Jute Mill</span>
    </div>
    <div class="topbar-right">
      <span class="user-chip">👤 <span id="loggedUser"></span></span>
      <button id="logoutBtn" onclick="doLogout()">Logout</button>
    </div>
  </header>

  <nav class="tabs">
    <button class="tab-btn active" data-tab="logbook" onclick="switchTab('logbook')">📘 Log Book</button>
    <button class="tab-btn" data-tab="breakdown" onclick="switchTab('breakdown')">⚙️ Machine Breakdown</button>
    <button class="tab-btn" data-tab="meter" onclick="switchTab('meter')">📟 Spreader Meter Reading</button>
    <button class="tab-btn" data-tab="roll" onclick="switchTab('roll')">🧵 Spreader Roll Production</button>
    <button class="tab-btn" data-tab="report" onclick="switchTab('report')">📊 Report</button>
  </nav>

  <main>

    <!-- ===== LOG BOOK ===== -->
    <section id="tab-logbook" class="tab-content">
      <div class="card">
        <h2>📘 Log Book Entry</h2>
        <div class="grid">
          <div class="field"><label>Date</label><input type="date" id="lb_date"></div>
          <div class="field"><label>Shift</label>
            <select id="lb_shift"><option>A</option><option>B</option><option>C</option></select>
          </div>
          <div class="field"><label>Rotation of Staff</label><input type="text" id="lb_rotation" placeholder="e.g. Ramesh -> Suresh"></div>
          <div class="field"><label>Idle Machine When Shift Will Be Changed</label><input type="text" id="lb_idle"></div>
          <div class="field"><label>Batch</label><input type="text" id="lb_batch"></div>
          <div class="field"><label>If Batch Change</label><input type="text" id="lb_batchchange"></div>
          <div class="field full"><label>Instruction Given by Senior</label><textarea id="lb_instruction"></textarea></div>
        </div>
        <div class="btn-row">
          <button class="btn btn-save" onclick="saveLogBook()">💾 Save</button>
          <button class="btn btn-clear" onclick="clearLogBook()">Clear</button>
        </div>
      </div>

      <div class="card">
        <h2>Recent Entries</h2>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Date</th><th>Shift</th><th>Rotation</th><th>Idle Machine</th><th>Batch</th><th>Batch Change</th><th>Instruction</th><th>Saved By</th></tr></thead>
            <tbody id="lb_recent_body"><tr><td colspan="8" class="empty-state">No entries yet</td></tr></tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ===== MACHINE BREAKDOWN ===== -->
    <section id="tab-breakdown" class="tab-content" style="display:none;">
      <div class="card">
        <h2>⚙️ Machine Breakdown</h2>
        <div class="grid" style="margin-bottom:6px;">
          <div class="field"><label>Date</label><input type="date" id="mb_date"></div>
          <div class="field"><label>Shift</label>
            <select id="mb_shift"><option>A</option><option>B</option><option>C</option></select>
          </div>
        </div>
        <p class="section-note">Enter Start &amp; End Time (HH:MM) — Break Time is calculated automatically.</p>
        <div class="table-wrap">
          <table>
            <thead><tr><th style="width:80px;">Machine No.</th><th>Breakdown Reason</th><th style="width:130px;">Start Time</th><th style="width:130px;">End Time</th><th style="width:120px;">Break Time (Min.)</th></tr></thead>
            <tbody id="mb_body"></tbody>
            <tfoot><tr><td colspan="4" style="text-align:right;">Total Breakdown Time (Min.)</td><td><input class="readonly" id="mb_total" readonly></td></tr></tfoot>
          </table>
        </div>
        <div class="btn-row">
          <button class="btn btn-save" onclick="saveBreakdown()">💾 Save</button>
          <button class="btn btn-clear" onclick="renderBreakdownTable()">Clear</button>
        </div>
      </div>
    </section>

    <!-- ===== METER READING ===== -->
    <section id="tab-meter" class="tab-content" style="display:none;">
      <div class="card">
        <h2>📟 Spreader Meter Reading</h2>
        <div class="grid" style="margin-bottom:6px;">
          <div class="field"><label>Date</label><input type="date" id="mr_date"></div>
          <div class="field"><label>Shift</label>
            <select id="mr_shift"><option>A</option><option>B</option><option>C</option></select>
          </div>
          <div class="field"><label>Target per Machine (for Efficiency)</label><input type="number" id="mr_target" value="8" step="0.01"></div>
        </div>
        <p class="section-note">Difference = Shift End Reading &minus; Shift Start Reading. Efficiency = Difference / Target. Calculated automatically. Only machines with a reading saved here will be available for Net Roll entry in the Roll Production tab. <strong>Enter all active machines for this Date &amp; Shift before clicking Save</strong> &mdash; each Save replaces the entire Meter Reading entry for that Date &amp; Shift (it does not merge with an earlier save), so it always matches exactly what's on screen.</p>
        <div class="table-wrap">
          <table>
            <thead><tr><th style="width:80px;">Machine No.</th><th>Shift Start Reading</th><th>Shift End Reading</th><th>Difference</th><th>Efficiency</th></tr></thead>
            <tbody id="mr_body"></tbody>
          </table>
        </div>
        <div class="btn-row">
          <button class="btn btn-save" onclick="saveMeter()">💾 Save</button>
          <button class="btn btn-clear" onclick="renderMeterTable()">Clear</button>
        </div>
      </div>
    </section>

    <!-- ===== ROLL PRODUCTION ===== -->
    <section id="tab-roll" class="tab-content" style="display:none;">
      <div class="card">
        <h2>🧵 Spreader Roll Production</h2>
        <div class="grid" style="margin-bottom:6px;">
          <div class="field"><label>Date</label><input type="date" id="rp_date"></div>
          <div class="field"><label>Shift</label>
            <select id="rp_shift"><option>A</option><option>B</option><option>C</option></select>
          </div>
        </div>
        <p class="section-note">
          Only machines that have a <strong>Spreader Meter Reading</strong> saved for this Date &amp; Shift accept Net Roll input here (others are greyed out).
          <strong>Allocated Machine</strong> = count of those machines. <strong>Efficiency</strong> = average of those machines' Meter Reading efficiency. Both sync automatically from Meter Reading.
        </p>
        <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(280px,1fr));align-items:start;">
          <div class="table-wrap">
            <table>
              <thead><tr><th>Machine No.</th><th>Net Roll</th></tr></thead>
              <tbody id="rp_machine_body"></tbody>
              <tfoot>
                <tr><td>Total</td><td><input class="readonly" id="rp_machine_total" readonly></td></tr>
                <tr><td>Avg</td><td><input class="readonly" id="rp_machine_avg" readonly></td></tr>
              </tfoot>
            </table>
          </div>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Quality</th><th>Net Roll</th></tr></thead>
              <tbody id="rp_quality_body"></tbody>
              <tfoot><tr><td>Total</td><td><input class="readonly" id="rp_quality_total" readonly></td></tr></tfoot>
            </table>
          </div>
          <div>
            <table>
              <thead><tr><th>Allocated Machine</th><th>Efficiency</th></tr></thead>
              <tbody>
                <tr>
                  <td><input type="text" class="readonly" id="rp_allocated" readonly></td>
                  <td><input type="text" class="readonly" id="rp_efficiency" readonly></td>
                </tr>
              </tbody>
            </table>
            <p class="section-note" id="rp_sync_status" style="margin-top:10px;"></p>
          </div>
        </div>
        <div class="btn-row">
          <button class="btn btn-save" onclick="saveRoll()">💾 Save</button>
          <button class="btn btn-clear" onclick="renderRollTables()">Clear</button>
          <button class="btn btn-outline" onclick="syncRollWithMeter()">🔄 Sync with Meter Reading</button>
        </div>
      </div>
    </section>

    <!-- ===== REPORT ===== -->
    <section id="tab-report" class="tab-content" style="display:none;">
      <div class="card">
        <h2>📊 Report</h2>
        <div class="grid">
          <div class="field">
            <label>Module</label>
            <select id="rep_module" onchange="onReportModuleChange()">
              <option value="LogBook">Log Book</option>
              <option value="MachineBreakdown">Machine Breakdown</option>
              <option value="MeterReading">Spreader Meter Reading</option>
              <option value="RollProduction">Roll Production (Summary)</option>
              <option value="RollProductionMachine">Roll Production (Machine-wise)</option>
              <option value="RollProductionQuality">Roll Production (Quality-wise)</option>
            </select>
          </div>
          <div class="field"><label>Date From</label><input type="date" id="rep_from"></div>
          <div class="field"><label>Date To</label><input type="date" id="rep_to"></div>
          <div class="field"><label>Shift</label>
            <select id="rep_shift"><option value="All">All</option><option>A</option><option>B</option><option>C</option></select>
          </div>
          <div class="field" id="rep_machine_field" style="display:none;">
            <label>Machine No.</label>
            <select id="rep_machine">
              <option value="">All</option>
              <script>for(var i=1;i<=11;i++){document.write('<option value="'+i+'">'+i+'</option>');}</script>
            </select>
          </div>
        </div>
        <div class="btn-row">
          <button class="btn btn-filter" onclick="runReport()">🔍 Generate Report</button>
          <button class="btn btn-outline" onclick="exportReportCsv()">⬇ Export CSV</button>
        </div>
      </div>
      <div class="card">
        <h2 id="rep_result_title">Results</h2>
        <div class="table-wrap">
          <table id="rep_table">
            <thead id="rep_thead"><tr></tr></thead>
            <tbody id="rep_tbody"><tr><td class="empty-state">Run a report to see results</td></tr></tbody>
          </table>
        </div>
      </div>
    </section>

  </main>
</div>

<div class="toast" id="toast"></div>

<script>
  var CURRENT_USER = null;
  var LAST_REPORT_ROWS = [];
  var MACHINE_COUNT = 11;
  var QUALITY_TYPES = ['V Loom','D TD5','D TD6','Uncut 6','J TD6','Rej'];

  // machineNo (string) -> Meter Reading efficiency, for the currently
  // selected Roll Production Date + Shift. Rebuilt by syncRollWithMeter().
  var ACTIVE_METER_MACHINES = {};

  // ---------------- INIT ----------------
  window.onload = function(){
    document.getElementById('lb_date').valueAsDate = new Date();
    document.getElementById('mb_date').valueAsDate = new Date();
    document.getElementById('mr_date').valueAsDate = new Date();
    document.getElementById('rp_date').valueAsDate = new Date();
    renderBreakdownTable();
    renderMeterTable();
    renderRollTables();

    document.getElementById('rp_date').addEventListener('change', syncRollWithMeter);
    document.getElementById('rp_shift').addEventListener('change', syncRollWithMeter);

    document.getElementById('loginPassword').addEventListener('keydown', function(e){
      if(e.key === 'Enter') doLogin();
    });
  };

  // ---------------- LOGIN / LOGOUT ----------------
  function doLogin(){
    var u = document.getElementById('loginUsername').value.trim();
    var p = document.getElementById('loginPassword').value.trim();
    var errEl = document.getElementById('loginError');
    errEl.textContent = '';
    if(!u || !p){ errEl.textContent = 'Please enter username and password.'; return; }

    var btn = document.getElementById('loginBtn');
    btn.innerHTML = '<span class="loader"></span>Logging in...';
    btn.disabled = true;

    google.script.run
      .withSuccessHandler(function(res){
        btn.innerHTML = 'Login'; btn.disabled = false;
        if(res.success){
          CURRENT_USER = res.username;
          document.getElementById('loggedUser').textContent = res.username + ' (' + res.role + ')';
          document.getElementById('loginScreen').style.display = 'none';
          document.getElementById('appScreen').style.display = 'block';
          loadLogBookRecent();
        } else {
          errEl.textContent = res.message || 'Login failed';
        }
      })
      .withFailureHandler(function(err){
        btn.innerHTML = 'Login'; btn.disabled = false;
        errEl.textContent = 'Server error: ' + err.message;
      })
      .authenticateUser(u, p);
  }

  function doLogout(){
    CURRENT_USER = null;
    document.getElementById('appScreen').style.display = 'none';
    document.getElementById('loginScreen').style.display = 'flex';
    document.getElementById('loginUsername').value = '';
    document.getElementById('loginPassword').value = '';
  }

  // ---------------- TABS ----------------
  function switchTab(tab){
    document.querySelectorAll('.tab-content').forEach(function(el){ el.style.display = 'none'; });
    document.querySelectorAll('.tab-btn').forEach(function(el){ el.classList.remove('active'); });
    document.getElementById('tab-' + tab).style.display = 'block';
    document.querySelector('.tab-btn[data-tab="' + tab + '"]').classList.add('active');
    if(tab === 'roll'){ syncRollWithMeter(); }
  }

  // ---------------- TOAST ----------------
  function showToast(msg, isError){
    var t = document.getElementById('toast');
    t.textContent = msg;
    t.className = 'toast' + (isError ? ' error' : '');
    t.style.display = 'block';
    setTimeout(function(){ t.style.display = 'none'; }, 3000);
  }

  // ================= LOG BOOK =================
  function saveLogBook(){
    var data = {
      date: document.getElementById('lb_date').value,
      shift: document.getElementById('lb_shift').value,
      rotationOfStaff: document.getElementById('lb_rotation').value,
      idleMachine: document.getElementById('lb_idle').value,
      batch: document.getElementById('lb_batch').value,
      batchChange: document.getElementById('lb_batchchange').value,
      instruction: document.getElementById('lb_instruction').value,
      savedBy: CURRENT_USER
    };
    if(!data.date){ showToast('Please select a date', true); return; }
    google.script.run
      .withSuccessHandler(function(res){
        if(res.success){ showToast('Log Book entry saved'); clearLogBook(); loadLogBookRecent(); }
        else showToast(res.message || 'Save failed', true);
      })
      .withFailureHandler(function(err){ showToast('Error: ' + err.message, true); })
      .saveLogBook(data);
  }

  function clearLogBook(){
    document.getElementById('lb_rotation').value = '';
    document.getElementById('lb_idle').value = '';
    document.getElementById('lb_batch').value = '';
    document.getElementById('lb_batchchange').value = '';
    document.getElementById('lb_instruction').value = '';
  }

  function loadLogBookRecent(){
    google.script.run
      .withSuccessHandler(function(rows){
        var body = document.getElementById('lb_recent_body');
        body.innerHTML = '';
        if(!rows || rows.length === 0){
          body.innerHTML = '<tr><td colspan="8" class="empty-state">No entries yet</td></tr>';
          return;
        }
        rows.slice(0,15).forEach(function(r){
          var tr = document.createElement('tr');
          tr.innerHTML = '<td>' + r.Date + '</td><td><span class="badge ' + r.Shift + '">' + r.Shift + '</span></td>' +
            '<td>' + (r.RotationOfStaff||'') + '</td><td>' + (r.IdleMachine||'') + '</td>' +
            '<td>' + (r.Batch||'') + '</td><td>' + (r.BatchChange||'') + '</td>' +
            '<td>' + (r.Instruction||'') + '</td><td>' + (r.SavedBy||'') + '</td>';
          body.appendChild(tr);
        });
      })
      .getLogBookEntries({});
  }

  // ================= MACHINE BREAKDOWN =================
  function timeToMinutes(t){
    if(!t) return null;
    var parts = t.split(':');
    if(parts.length < 2) return null;
    return parseInt(parts[0],10) * 60 + parseInt(parts[1],10);
  }

  function computeBreakTime(startVal, endVal, cell){
    var s = timeToMinutes(startVal);
    var e = timeToMinutes(endVal);
    if(s === null || e === null){ cell.value = ''; updateBreakdownTotal(); return; }
    var diff = e - s;
    if(diff < 0) diff += 24 * 60; // overnight shift handling
    cell.value = diff;
    updateBreakdownTotal();
  }

  function updateBreakdownTotal(){
    var total = 0;
    document.querySelectorAll('.mb-break').forEach(function(inp){
      var v = parseFloat(inp.value);
      if(!isNaN(v)) total += v;
    });
    document.getElementById('mb_total').value = total;
  }

  function renderBreakdownTable(){
    var body = document.getElementById('mb_body');
    body.innerHTML = '';
    for(var i=1;i<=MACHINE_COUNT;i++){
      var tr = document.createElement('tr');
      tr.innerHTML =
        '<td><input type="text" class="mb-machine" value="' + i + '" readonly></td>' +
        '<td><input type="text" class="mb-reason" placeholder="Reason"></td>' +
        '<td><input type="time" class="mb-start"></td>' +
        '<td><input type="time" class="mb-end"></td>' +
        '<td><input type="text" class="mb-break readonly" readonly></td>';
      body.appendChild(tr);
    }
    document.getElementById('mb_total').value = '';
    // attach listeners
    body.querySelectorAll('.mb-start, .mb-end').forEach(function(inp){
      inp.addEventListener('change', function(){
        var row = this.closest('tr');
        var start = row.querySelector('.mb-start').value;
        var end = row.querySelector('.mb-end').value;
        var cell = row.querySelector('.mb-break');
        computeBreakTime(start, end, cell);
      });
    });
  }

  function saveBreakdown(){
    var rows = [];
    document.querySelectorAll('#mb_body tr').forEach(function(tr){
      rows.push({
        machineNo: tr.querySelector('.mb-machine').value,
        reason: tr.querySelector('.mb-reason').value,
        startTime: tr.querySelector('.mb-start').value,
        endTime: tr.querySelector('.mb-end').value,
        breakTimeMin: tr.querySelector('.mb-break').value
      });
    });
    var payload = {
      date: document.getElementById('mb_date').value,
      shift: document.getElementById('mb_shift').value,
      rows: rows,
      savedBy: CURRENT_USER
    };
    if(!payload.date){ showToast('Please select a date', true); return; }
    google.script.run
      .withSuccessHandler(function(res){
        if(res.success){ showToast('Machine Breakdown saved'); renderBreakdownTable(); }
        else showToast(res.message || 'Save failed', true);
      })
      .withFailureHandler(function(err){ showToast('Error: ' + err.message, true); })
      .saveMachineBreakdown(payload);
  }

  // ================= METER READING =================
  function renderMeterTable(){
    var body = document.getElementById('mr_body');
    body.innerHTML = '';
    for(var i=1;i<=MACHINE_COUNT;i++){
      var tr = document.createElement('tr');
      tr.innerHTML =
        '<td><input type="text" class="mr-machine" value="' + i + '" readonly></td>' +
        '<td><input type="number" step="0.01" class="mr-start" placeholder="0"></td>' +
        '<td><input type="number" step="0.01" class="mr-end" placeholder="0"></td>' +
        '<td><input type="text" class="mr-diff readonly" readonly></td>' +
        '<td><input type="text" class="mr-eff readonly" readonly></td>';
      body.appendChild(tr);
    }
    body.querySelectorAll('.mr-start, .mr-end').forEach(function(inp){
      inp.addEventListener('input', function(){
        var row = this.closest('tr');
        computeMeterRow(row);
      });
    });
  }

  function computeMeterRow(row){
    var s = parseFloat(row.querySelector('.mr-start').value);
    var e = parseFloat(row.querySelector('.mr-end').value);
    var diffCell = row.querySelector('.mr-diff');
    var effCell = row.querySelector('.mr-eff');
    if(isNaN(s) || isNaN(e)){ diffCell.value = ''; effCell.value = ''; return; }
    var diff = e - s;
    diffCell.value = diff.toFixed(2);
    var target = parseFloat(document.getElementById('mr_target').value) || 8;
    var eff = target > 0 ? (diff / target) : 0;
    effCell.value = eff.toFixed(2);
  }

  document.addEventListener('DOMContentLoaded', function(){
    var t = document.getElementById('mr_target');
    if(t){
      t.addEventListener('input', function(){
        document.querySelectorAll('#mr_body tr').forEach(computeMeterRow);
      });
    }
  });

  function saveMeter(){
    var rows = [];
    document.querySelectorAll('#mr_body tr').forEach(function(tr){
      rows.push({
        machineNo: tr.querySelector('.mr-machine').value,
        startReading: tr.querySelector('.mr-start').value,
        endReading: tr.querySelector('.mr-end').value
      });
    });
    var payload = {
      date: document.getElementById('mr_date').value,
      shift: document.getElementById('mr_shift').value,
      target: document.getElementById('mr_target').value,
      rows: rows,
      savedBy: CURRENT_USER
    };
    if(!payload.date){ showToast('Please select a date', true); return; }
    google.script.run
      .withSuccessHandler(function(res){
        if(res.success){
          showToast('Meter Reading saved');
          renderMeterTable();
          // If the Roll Production tab is already open on the same Date/Shift,
          // refresh it so the newly saved machines become available immediately.
          syncRollWithMeter();
        }
        else showToast(res.message || 'Save failed', true);
      })
      .withFailureHandler(function(err){ showToast('Error: ' + err.message, true); })
      .saveMeterReading(payload);
  }

  // ================= ROLL PRODUCTION =================
  function renderRollTables(){
    var mBody = document.getElementById('rp_machine_body');
    mBody.innerHTML = '';
    for(var i=1;i<=MACHINE_COUNT;i++){
      var tr = document.createElement('tr');
      tr.innerHTML =
        '<td><input type="text" class="rp-m-no" value="Machine ' + i + '" readonly></td>' +
        '<td><input type="number" step="0.01" class="rp-m-roll"></td>';
      mBody.appendChild(tr);
    }
    mBody.querySelectorAll('.rp-m-roll').forEach(function(inp){
      inp.addEventListener('input', function(){ updateRollMachineTotals(); });
    });
    updateRollMachineTotals();

    var qBody = document.getElementById('rp_quality_body');
    qBody.innerHTML = '';
    QUALITY_TYPES.forEach(function(q){
      var tr = document.createElement('tr');
      tr.innerHTML =
        '<td><input type="text" class="rp-q-name" value="' + q + '" readonly></td>' +
        '<td><input type="number" step="0.01" class="rp-q-roll"></td>';
      qBody.appendChild(tr);
    });
    qBody.querySelectorAll('.rp-q-roll').forEach(function(inp){
      inp.addEventListener('input', updateRollQualityTotal);
    });
    updateRollQualityTotal();

    // Allocated Machine / Efficiency are derived from Meter Reading —
    // this call also enables/disables the correct machine rows.
    syncRollWithMeter();
  }

  function updateRollMachineTotals(){
    var total = 0, count = 0;
    document.querySelectorAll('.rp-m-roll').forEach(function(inp){
      var v = parseFloat(inp.value);
      if(!isNaN(v)){ total += v; count++; }
    });
    document.getElementById('rp_machine_total').value = total.toFixed(2);
    document.getElementById('rp_machine_avg').value = count > 0 ? (total/count).toFixed(2) : '0.00';
  }

  function updateRollQualityTotal(){
    var total = 0;
    document.querySelectorAll('.rp-q-roll').forEach(function(inp){
      var v = parseFloat(inp.value);
      if(!isNaN(v)) total += v;
    });
    document.getElementById('rp_quality_total').value = total.toFixed(2);
  }

  // Pulls Meter Reading data for the current Roll Production Date + Shift,
  // then:
  //   - enables Net Roll input only for machines with a Meter Reading
  //   - sets Allocated Machine = count of those machines
  //   - sets Efficiency = average of those machines' Meter Reading efficiency
  function syncRollWithMeter(){
    if(!CURRENT_USER) return;
    var date = document.getElementById('rp_date').value;
    var shift = document.getElementById('rp_shift').value;
    var statusEl = document.getElementById('rp_sync_status');
    if(!date){
      applyMeterSync([]);
      if(statusEl) statusEl.textContent = '';
      return;
    }
    if(statusEl) statusEl.textContent = 'Syncing with Meter Reading...';
    google.script.run
      .withSuccessHandler(function(rows){
        applyMeterSync(rows);
        if(statusEl){
          var n = (rows || []).length;
          statusEl.textContent = n > 0
            ? ('Synced: ' + n + ' machine(s) have a Meter Reading for ' + date + ' / Shift ' + shift + '.')
            : ('No Meter Reading found for ' + date + ' / Shift ' + shift + '. Save Meter Reading first.');
        }
      })
      .withFailureHandler(function(err){
        showToast('Meter sync error: ' + err.message, true);
        if(statusEl) statusEl.textContent = '';
      })
      .getMeterReadingForDateShift(date, shift);
  }

  function applyMeterSync(rows){
    ACTIVE_METER_MACHINES = {};
    (rows || []).forEach(function(r){
      ACTIVE_METER_MACHINES[String(r.machineNo)] = parseFloat(r.efficiency) || 0;
    });

    var trs = document.querySelectorAll('#rp_machine_body tr');
    trs.forEach(function(tr, idx){
      var machineNo = String(idx + 1);
      var input = tr.querySelector('.rp-m-roll');
      var isActive = ACTIVE_METER_MACHINES.hasOwnProperty(machineNo);
      if(isActive){
        input.disabled = false;
        input.classList.remove('readonly');
        input.placeholder = '';
        tr.style.opacity = '';
      } else {
        input.value = '';
        input.disabled = true;
        input.classList.add('readonly');
        input.placeholder = 'No meter reading';
        tr.style.opacity = '0.55';
      }
    });
    updateRollMachineTotals();

    var keys = Object.keys(ACTIVE_METER_MACHINES);
    var count = keys.length;
    document.getElementById('rp_allocated').value = count;
    if(count > 0){
      var sum = 0;
      keys.forEach(function(k){ sum += ACTIVE_METER_MACHINES[k]; });
      document.getElementById('rp_efficiency').value = (sum / count).toFixed(2);
    } else {
      document.getElementById('rp_efficiency').value = '';
    }
  }

  function saveRoll(){
    if(Object.keys(ACTIVE_METER_MACHINES).length === 0){
      showToast('No Meter Reading found for this Date & Shift. Please save Meter Reading first.', true);
      return;
    }
    var machineRows = [];
    document.querySelectorAll('#rp_machine_body tr').forEach(function(tr, idx){
      var val = tr.querySelector('.rp-m-roll').value;
      machineRows.push({ machineNo: idx + 1, netRoll: val === '' ? '' : parseFloat(val) });
    });
    var qualityRows = [];
    document.querySelectorAll('#rp_quality_body tr').forEach(function(tr){
      var val = tr.querySelector('.rp-q-roll').value;
      qualityRows.push({ quality: tr.querySelector('.rp-q-name').value, netRoll: val === '' ? '' : parseFloat(val) });
    });
    var payload = {
      date: document.getElementById('rp_date').value,
      shift: document.getElementById('rp_shift').value,
      machineRows: machineRows,
      qualityRows: qualityRows,
      totalNetRoll: document.getElementById('rp_machine_total').value,
      avgNetRoll: document.getElementById('rp_machine_avg').value,
      allocatedMachine: document.getElementById('rp_allocated').value,
      efficiency: document.getElementById('rp_efficiency').value,
      savedBy: CURRENT_USER
    };
    if(!payload.date){ showToast('Please select a date', true); return; }
    google.script.run
      .withSuccessHandler(function(res){
        if(res.success){ showToast('Roll Production saved'); renderRollTables(); }
        else showToast(res.message || 'Save failed', true);
      })
      .withFailureHandler(function(err){ showToast('Error: ' + err.message, true); })
      .saveRollProduction(payload);
  }

  // ================= REPORT =================
  function onReportModuleChange(){
    var m = document.getElementById('rep_module').value;
    var showMachine = (m === 'MachineBreakdown' || m === 'MeterReading' || m === 'RollProductionMachine');
    document.getElementById('rep_machine_field').style.display = showMachine ? 'block' : 'none';
  }

  function runReport(){
    var payload = {
      module: document.getElementById('rep_module').value,
      filters: {
        dateFrom: document.getElementById('rep_from').value,
        dateTo: document.getElementById('rep_to').value,
        shift: document.getElementById('rep_shift').value,
        machineNo: document.getElementById('rep_machine') ? document.getElementById('rep_machine').value : ''
      }
    };
    var thead = document.getElementById('rep_thead');
    var tbody = document.getElementById('rep_tbody');
    tbody.innerHTML = '<tr><td class="empty-state"><span class="loader" style="border-top-color:#123a63;border-color:#12406355;"></span>Loading...</td></tr>';

    google.script.run
      .withSuccessHandler(function(res){
        if(!res.success){ showToast(res.message || 'Report failed', true); return; }
        LAST_REPORT_ROWS = res.rows;
        renderReportTable(res.rows);
      })
      .withFailureHandler(function(err){ showToast('Error: ' + err.message, true); })
      .getReportData(payload);
  }

  function renderReportTable(rows){
    var thead = document.getElementById('rep_thead');
    var tbody = document.getElementById('rep_tbody');
    thead.innerHTML = '';
    tbody.innerHTML = '';
    if(!rows || rows.length === 0){
      tbody.innerHTML = '<tr><td class="empty-state">No records found for selected filters</td></tr>';
      return;
    }
    var cols = Object.keys(rows[0]).filter(function(c){ return c !== 'ID' && c !== 'BatchId'; });
    var headRow = document.createElement('tr');
    cols.forEach(function(c){
      var th = document.createElement('th');
      th.textContent = c;
      headRow.appendChild(th);
    });
    thead.appendChild(headRow);

    rows.forEach(function(r){
      var tr = document.createElement('tr');
      cols.forEach(function(c){
        var td = document.createElement('td');
        td.textContent = (r[c] === undefined || r[c] === null) ? '' : r[c];
        tr.appendChild(td);
      });
      tbody.appendChild(tr);
    });
  }

  function exportReportCsv(){
    if(!LAST_REPORT_ROWS || LAST_REPORT_ROWS.length === 0){ showToast('Run a report first', true); return; }
    var cols = Object.keys(LAST_REPORT_ROWS[0]).filter(function(c){ return c !== 'ID' && c !== 'BatchId'; });
    var csv = cols.join(',') + '\n';
    LAST_REPORT_ROWS.forEach(function(r){
      csv += cols.map(function(c){
        var v = r[c] === undefined || r[c] === null ? '' : String(r[c]).replace(/"/g,'""');
        return '"' + v + '"';
      }).join(',') + '\n';
    });
    var blob = new Blob([csv], {type:'text/csv'});
    var link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = document.getElementById('rep_module').value + '_report.csv';
    link.click();
  }
</script>
</body>
