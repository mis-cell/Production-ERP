/* ---------------- LIVE PER-ROUND LOG (TABLES) ---------------- */
function refreshProductionLog() {
  var machine = document.getElementById('pr_machine').value;
  var container = document.getElementById('pr_log_container');
  if (!machine) {
    container.innerHTML = '<div class="text-sm text-gray-500">Select a machine to see its round-by-round log.</div>';
    return;
  }
  container.innerHTML = '<div class="text-sm text-gray-500">Loading log…</div>';
  google.script.run.withSuccessHandler(function (rows) {
    renderProductionLog(machine, rows);
  }).getProductionLogForMachine(machine);
}

function renderProductionLog(machine, rows) {
  var container = document.getElementById('pr_log_container');
  container.innerHTML = '';

  if (!rows || rows.length === 0) {
    container.innerHTML = '<div class="text-sm text-gray-500">No production entries yet for Machine ' + machine + '.</div>';
    return;
  }

  // Group entries by Round, preserving order of first appearance
  var roundOrder = [];
  var groups = {};
  rows.forEach(function (r) {
    var rnd = r.Round || 1;
    if (!groups[rnd]) { groups[rnd] = []; roundOrder.push(rnd); }
    groups[rnd].push(r);
  });

  // Show most recent round first
  roundOrder.slice().reverse().forEach(function (rnd) {
    var entries = groups[rnd];
    var lastEntry = entries[entries.length - 1];
    var beamNum = lastEntry.BeamNumber || '—';
    var beamTarget = lastEntry.BeamTarget || '—';
    // Only count HoursWorked once per Date+Shift in this round — it's the
    // same value on every entry saved during that shift, not additive per save.
    var seenHourKeys = {};
    var roundHours = entries.reduce(function (sum, r) {
      var key = r.Date + '|' + r.Shift;
      if (seenHourKeys[key]) return sum;
      seenHourKeys[key] = true;
      return sum + (Number(r.HoursWorked) || 0);
    }, 0);
    var statusBadge = lastEntry.BeamStatus === 'Completed'
      ? '<span class="ml-2 px-2 py-0.5 rounded text-xs font-semibold bg-green-100 text-green-700">Completed</span>'
      : (lastEntry.BeamStatus === 'Stopped'
        ? '<span class="ml-2 px-2 py-0.5 rounded text-xs font-semibold bg-amber-100 text-amber-700">Stopped</span>'
        : '<span class="ml-2 px-2 py-0.5 rounded text-xs font-semibold bg-blue-100 text-blue-700">Running</span>');

    var block = document.createElement('div');
    block.className = 'border rounded-lg overflow-hidden';

    var header = document.createElement('div');
    header.className = 'bg-blue-50 px-4 py-2 flex items-center flex-wrap gap-x-4 gap-y-1';
    header.innerHTML =
      '<span class="font-bold text-blue-900">Round ' + rnd + '</span>' +
      '<span class="text-sm text-gray-700">Beam ' + beamNum + '</span>' +
      '<span class="text-sm text-gray-700">Target ' + beamTarget + ' m</span>' +
      '<span class="text-sm text-gray-700">Total Hours ' + roundHours + '</span>' +
      statusBadge;

    var tableWrap = document.createElement('div');
    tableWrap.className = 'overflow-x-auto';

    var cols = ['Date','Shift','Worker','HoursWorked','Color','StartMeter','EndMeter','Production','BeamStatus'];
    var table = document.createElement('table');
    table.className = 'w-full text-sm border-collapse';
    var thead = '<thead class="bg-gray-100 text-gray-700"><tr>' +
      cols.map(function (c) { return '<th class="px-3 py-2 text-left">' + c + '</th>'; }).join('') +
      '</tr></thead>';

    var tbody = '<tbody>' + entries.map(function (r, i) {
      var sc = r.BeamStatus === 'Completed' ? 'text-green-700 font-semibold'
        : (r.BeamStatus === 'Stopped' ? 'text-amber-600 font-semibold' : 'text-blue-700');
      return '<tr class="' + (i % 2 ? 'bg-gray-50' : '') + ' border-b">' +
        cols.map(function (c) {
          if (c === 'BeamStatus') return '<td class="px-3 py-2 ' + sc + '">' + r[c] + '</td>';
          return '<td class="px-3 py-2">' + r[c] + '</td>';
        }).join('') + '</tr>';
    }).join('') + '</tbody>';

    table.innerHTML = thead + tbody;
    tableWrap.appendChild(table);
    block.appendChild(header);
    block.appendChild(tableWrap);
    container.appendChild(block);
  });
}

/* ---------------- VERIFICATION ---------------- */
var pvRoundSummary = [];

function onVerifyUnitChange() {
  populateMachineDropdown('pv_machine', document.getElementById('pv_unit').value);
  onVerifyMachineChange();
}

function onVerifyMachineChange() {
  var machine = document.getElementById('pv_machine').value;
  if (!machine) return;
  google.script.run.withSuccessHandler(function (rows) {
    pvRoundSummary = rows;
    populateRoundDropdown(rows);
    renderVerificationTable(rows);
  }).getRoundSummaryForMachine(machine);
}

function populateRoundDropdown(rows) {
  var sel = document.getElementById('pv_round');
  var current = sel.value;
  sel.innerHTML = '';
  rows.forEach(function (r) {
    var o = document.createElement('option');
    o.value = r.round;
    o.textContent = 'Round ' + r.round;
    sel.appendChild(o);
  });
  if ([...sel.options].some(function (o) { return o.value === current; })) sel.value = current;
  onVerifyRoundChange();
}

function onVerifyRoundChange() {
  var round = document.getElementById('pv_round').value;
  var row = pvRoundSummary.find(function (r) { return String(r.round) === String(round); });
  document.getElementById('pv_beamnumber').value = row ? row.beamNumber : '';
}

function saveVerification() {
  var data = {
    date: document.getElementById('pv_date').value,
    shift: document.getElementById('pv_shift').value,
    unit: document.getElementById('pv_unit').value,
    machine: document.getElementById('pv_machine').value,
    round: document.getElementById('pv_round').value,
    beamNumber: document.getElementById('pv_beamnumber').value,
    manualProduction: document.getElementById('pv_manual').value,
    verifiedBy: document.getElementById('pv_verifiedby').value,
    remarks: document.getElementById('pv_remarks').value
  };
  if (!data.date || !data.machine || !data.round || data.manualProduction === '') {
    alert('Please fill Date, Machine, Round and Actual Machine Production.');
    return;
  }
  var statusEl = document.getElementById('pv_status');
  statusEl.textContent = 'Saving...'; statusEl.className = 'self-center text-sm font-semibold text-gray-500';
  google.script.run
    .withSuccessHandler(function (res) {
      if (!res.success) {
        statusEl.textContent = 'Error: ' + res.error; statusEl.className = 'self-center text-sm font-semibold text-red-600';
        return;
      }
      statusEl.textContent = 'Saved ✓'; statusEl.className = 'self-center text-sm font-semibold text-green-600';
      document.getElementById('pv_manual').value = '';
      document.getElementById('pv_remarks').value = '';
      onVerifyMachineChange();
    })
    .withFailureHandler(function (err) {
      statusEl.textContent = 'Error: ' + err.message; statusEl.className = 'self-center text-sm font-semibold text-red-600';
    })
    .saveVerification(data);
}

function clearVerificationFields() {
  document.getElementById('pv_manual').value = '';
  document.getElementById('pv_verifiedby').value = '';
  document.getElementById('pv_remarks').value = '';
  document.getElementById('pv_status').textContent = '';
}

function renderVerificationTable(rows) {
  var body = document.getElementById('pv_table_body');
  var empty = document.getElementById('pv_empty');
  if (!rows || rows.length === 0) {
    body.innerHTML = '';
    empty.classList.remove('hidden');
    return;
  }
  empty.classList.add('hidden');
  body.innerHTML = rows.map(function (r, i) {
    var diffCell, diffClass;
    if (r.manualProduction === null) {
      diffCell = 'Not verified';
      diffClass = 'text-gray-400';
    } else if (r.difference === 0) {
      diffCell = '0 m — Matches';
      diffClass = 'text-green-700 font-semibold';
    } else {
      diffCell = (r.difference > 0 ? '+' : '') + r.difference + ' m';
      diffClass = 'text-red-600 font-semibold';
    }
    return '<tr class="' + (i % 2 ? 'bg-gray-50' : '') + ' border-b">' +
      '<td class="px-3 py-2 font-semibold">' + r.round + '</td>' +
      '<td class="px-3 py-2">' + (r.beamNumber || '—') + '</td>' +
      '<td class="px-3 py-2">' + (r.beamTarget || '—') + '</td>' +
      '<td class="px-3 py-2">' + r.status + '</td>' +
      '<td class="px-3 py-2">' + r.systemTotal + ' m</td>' +
      '<td class="px-3 py-2">' + r.totalHours + ' hrs</td>' +
      '<td class="px-3 py-2">' + (r.manualProduction === null ? '—' : r.manualProduction + ' m') + '</td>' +
      '<td class="px-3 py-2 ' + diffClass + '">' + diffCell + '</td>' +
      '<td class="px-3 py-2">' + (r.verifiedBy || '—') + '</td>' +
      '</tr>';
  }).join('');
}

