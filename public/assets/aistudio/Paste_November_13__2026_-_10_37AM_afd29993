<!DOCTYPE html>
<html>
<head>
  <base target="_top">
  <meta charset="UTF-8">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { font-family: 'Segoe UI', Arial, sans-serif; }
    .tab-btn { color: rgba(255,255,255,0.7); border-bottom: 3px solid transparent; }
    .tab-btn.active { color: #fff; border-bottom: 3px solid #fff; }
    input[readonly] { background:#f3f4f6; }
    button:disabled { opacity: 0.5; cursor: not-allowed; }
    .spinner { border:3px solid #e5e7eb; border-top:3px solid #1e3a8a; border-radius:50%; width:18px; height:18px; animation:spin 0.8s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
  </style>
</head>
<body class="bg-gray-100 min-h-screen">

  <!-- NAV -->
  <div class="bg-blue-900 text-white flex items-center px-2 shadow flex-wrap">
    <span class="font-bold text-lg px-4 py-3">S4 Beaming — Bally Jute Mill</span>
    <button class="tab-btn active px-5 py-4 font-semibold" onclick="showTab('logbook', this)">📘 Log Book</button>
    <button class="tab-btn px-5 py-4 font-semibold" onclick="showTab('production', this)">⚙️ Production</button>
    <button class="tab-btn px-5 py-4 font-semibold" onclick="showTab('verification', this)">✅ Verification</button>
    <button class="tab-btn px-5 py-4 font-semibold" onclick="showTab('purchaseorder', this)">🧾 Purchase Order</button>
    <button class="tab-btn px-5 py-4 font-semibold" onclick="showTab('report', this)">📄 Report</button>
  </div>

  <div class="max-w-6xl mx-auto p-6">

    <!-- ===================== LOG BOOK TAB ===================== -->
    <div id="logbook" class="bg-white rounded-lg shadow p-8">
      <h2 class="text-xl font-bold text-blue-900 mb-2">Log Book Entry</h2>
      <p class="text-sm text-gray-600 mb-6">Fill this in first at the start of every round / shift. The Rotation of Staff name and Hours Worked entered here will automatically carry over to the Production tab.</p>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div>
          <label class="block font-semibold text-blue-900 mb-1">Date</label>
          <input id="lb_date" type="date" class="w-full border rounded px-3 py-2">
        </div>
        <div>
          <label class="block font-semibold text-blue-900 mb-1">Shift</label>
          <select id="lb_shift" class="w-full border rounded px-3 py-2">
            <option value="A">A</option><option value="B">B</option><option value="C">C</option>
          </select>
        </div>
        <div>
          <label class="block font-semibold text-blue-900 mb-1">Rotation of Staff</label>
          <input id="lb_rotation" type="text" class="w-full border rounded px-3 py-2" placeholder="Staff / worker name">
        </div>
        <div>
          <label class="block font-semibold text-blue-900 mb-1">Hours Worked</label>
          <input id="lb_hours" type="number" step="0.25" min="0" max="24" class="w-full border rounded px-3 py-2" placeholder="e.g. 8">
        </div>
        <div>
          <label class="block font-semibold text-blue-900 mb-1">Idle Machine When Shift Will Be Changed</label>
          <input id="lb_idle" type="text" class="w-full border rounded px-3 py-2">
        </div>
        <div>
          <label class="block font-semibold text-blue-900 mb-1">Batch</label>
          <input id="lb_batch" type="text" class="w-full border rounded px-3 py-2">
        </div>
        <div>
          <label class="block font-semibold text-blue-900 mb-1">If Batch Change</label>
          <input id="lb_batchchange" type="text" class="w-full border rounded px-3 py-2">
        </div>
        <div class="md:col-span-4">
          <label class="block font-semibold text-blue-900 mb-1">Instruction Given by Senior</label>
          <textarea id="lb_instruction" rows="4" class="w-full border rounded px-3 py-2"></textarea>
        </div>
      </div>
      <div class="mt-6 flex gap-3">
        <button onclick="saveLogBook()" class="bg-green-600 hover:bg-green-700 text-white font-bold px-6 py-2 rounded">Save</button>
        <button onclick="clearLogBook()" class="bg-red-600 hover:bg-red-700 text-white font-bold px-6 py-2 rounded">Clear</button>
        <span id="lb_status" class="self-center text-sm font-semibold"></span>
      </div>
    </div>

    <!-- ===================== PRODUCTION TAB ===================== -->
    <div id="production" class="hidden bg-white rounded-lg shadow p-8">
      <h2 class="text-xl font-bold text-blue-900 mb-6">Machine-wise Production Entry</h2>

      <div id="pr_logbook_status" class="mb-6 text-sm font-semibold px-4 py-3 rounded border"></div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div>
          <label class="block font-semibold text-blue-900 mb-1">Unit</label>
          <select id="pr_unit" class="w-full border rounded px-3 py-2" onchange="onUnitChange()">
            <option value="Indotex">Indotex</option>
            <option value="Krishna">Krishna</option>
          </select>
        </div>
        <div>
          <label class="block font-semibold text-blue-900 mb-1">Machine No</label>
          <select id="pr_machine" class="w-full border rounded px-3 py-2" onchange="onMachineChange()"></select>
        </div>
        <div>
          <label class="block font-semibold text-blue-900 mb-1">Beam Number</label>
          <input id="pr_beamnumber" type="text" class="w-full border rounded px-3 py-2" placeholder="e.g. BM-2451">
        </div>
        <div>
          <label class="block font-semibold text-blue-900 mb-1">Date</label>
          <input id="pr_date" type="date" class="w-full border rounded px-3 py-2" onchange="refreshLogBookInfo()">
        </div>
        <div>
          <label class="block font-semibold text-blue-900 mb-1">Shift</label>
          <select id="pr_shift" class="w-full border rounded px-3 py-2" onchange="refreshLogBookInfo()">
            <option value="A">A</option><option value="B">B</option><option value="C">C</option>
          </select>
        </div>

        <div>
          <label class="block font-semibold text-blue-900 mb-1">Worker (from Log Book)</label>
          <input id="pr_worker" type="text" class="w-full border rounded px-3 py-2" readonly>
        </div>
        <div>
          <label class="block font-semibold text-blue-900 mb-1">Hours Worked (from Log Book)</label>
          <input id="pr_hours" type="text" class="w-full border rounded px-3 py-2" readonly>
        </div>
        <div>
          <label class="block font-semibold text-blue-900 mb-1">Color</label>
          <select id="pr_color" class="w-full border rounded px-3 py-2">
            <option value="Red">Red</option>
            <option value="Red-Black">Red-Black</option>
            <option value="Blue">Blue</option>
            <option value="Blue-Black">Blue-Black</option>
          </select>
        </div>
        <div>
          <label class="block font-semibold text-blue-900 mb-1">Ring Length</label>
          <select id="pr_ringlength" class="w-full border rounded px-3 py-2">
            <option value="36 inch">36 inch</option>
            <option value="40 inch">40 inch</option>
          </select>
        </div>
        <div>
          <label class="block font-semibold text-blue-900 mb-1">Weight</label>
